slides.bobbby.online {
	encode gzip zstd

	# Phone-remote WebSocket relay (the slides repo's server/relay.mjs, running
	# in the slides-relay container). Handled BEFORE the SPA file server so the
	# /relay WebSocket upgrade isn't swallowed by try_files. The client connects
	# to wss://slides.bobbby.online/relay?room=...&role=...
	handle /relay {
		reverse_proxy slides-relay:8787
	}

	# RevealSlides — a static Vite/React build (the `slides` repo's dist/),
	# published to /opt/slides and bind-mounted read-only into Caddy. Refreshed
	# files go live immediately (no container restart). Deployed by the slides
	# repo's deploy via blog/deploy-slides.sh.
	handle {
		root * /srv/slides

		# Vite emits content-hashed files under /assets — cache them forever.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# index.html (and anything else) must always revalidate so deploys show up.
		@html {
			not path /assets/*
		}
		header @html Cache-Control "no-cache"

		# SPA fallback: unknown paths serve index.html (share links use #/view/...).
		try_files {path} /index.html
		file_server
	}
}

# LUMINES HD — shared-board multiplayer puzzle game (lumines_hd repo).
# Static Vite build published to /opt/lumines (bind-mounted read-only);
# the rooms server (matchmaking + shared-board relay) runs in the `lumines`
# container and gets the /ws WebSocket upgrade, handled BEFORE the file
# server. Deployed by lumines_hd/scripts/deploy.sh.
lumines.bobbby.online {
	encode gzip zstd

	header {
		X-Forwarded-Proto {scheme}
		alt-svc "clear"
	}

	handle /ws {
		reverse_proxy lumines:8903
	}

	handle {
		root * /srv/lumines

		# The Lumines Ledger — the bot-league sports page (league.html)
		rewrite /league /league.html

		# Project slide deck (public/deck/ in the repo → /deck/ on the site);
		# its assets use relative paths, so force the trailing slash.
		redir /deck /deck/ 308

		# Vite emits content-hashed files under /assets — cache them forever.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html {
			not path /assets/*
		}
		header @html Cache-Control "no-cache"

		try_files {path} {path}/index.html /index.html
		file_server
	}
}

