# /mta-bus-map: the page's program. It draws the window's controls and the
# route chooser, keeps which routes this visitor watches, and turns the
# buses the server sends into markers for Leaflet.
#
# The map is Leaflet, a JavaScript library, in #mta-bus-map beside this
# program: Blimp's view cannot host another library's DOM. static/mta/mta.js
# is what is left of the MtaBusMap hook: it holds the socket to /live/mta
# and hands this program every frame (`mta <- :frame(json)`) and each
# (re)connection (`:connected`); every 100ms it asks `:outbox` (frames for
# the server) and `:markers(epoch)` (every marker, when they have changed
# since that epoch), and fills the status bar from `:status`.
#
# The buses are not here: the server's MtaPoller (src/99_mta.blimp) asks
# Bus Time for every route any page watches and sends each page its own.
# The routes, labels and marker HTML are Temper (temper/src/mta), the styles
# static/mta/mta.css.

def mb_decode(text: String) -> Map do
  case json_decode(text) do
    {:ok, m} ->
      case type_of(m) == :map do
        true -> m
        false -> %{}
      end
    _ -> %{}
  end
end

def mb_str(v: Any, dflt: String) -> String do
  case type_of(v) == :string do
    true -> v
    false -> dflt
  end
end

def mb_num(v: Any) -> Bool do
  type_of(v) == :float or type_of(v) == :integer
end

def mb_has(xs: List, x: Any) -> Bool do
  length(filter(xs, fn(y: Any) -> Bool do y == x end)) > 0
end

def mb_append(a: List, b: List) -> List do
  reduce(reverse(a), b, fn(acc: List, x: Any) -> List do [x | acc] end)
end

def mb_row(r: List) -> Map do
  rest = tail(tail(r))
  %{group: head(r), name: head(tail(r)), color: head(tail(rest)), desc: head(tail(tail(rest)))}
end

MB_ROUTES = map(mta_routes, fn(r: List) -> Map do mb_row(r) end)
# name -> row. A marker needs its route's row and there can be thousands of
# markers, so not by walking the list.
MB_BY_NAME = reduce(MB_ROUTES, %{}, fn(acc: Map, r: Map) -> Map do put(acc, r.name, r) end)

def mb_in_borough(b: String) -> List do
  case b do
    "all" -> MB_ROUTES
    _ -> filter(MB_ROUTES, fn(r: Map) -> Bool do r.group == b end)
  end
end

def mb_for_borough(b: String) -> List do
  map(mb_in_borough(b), fn(r: Map) -> String do r.name end)
end

def mb_color(route: String) -> String do
  row = lookup(MB_BY_NAME, route)
  case row do
    nil -> "#666666"
    _ -> row.color
  end
end

# The chooser's rows: the tab's, or with a search every route it matches.
def mb_rows(b: String, query: String) -> List do
  q = downcase(trim(query))
  case q do
    "" -> mb_in_borough(b)
    _ -> filter(MB_ROUTES, fn(r: Map) -> Bool do contains(downcase(concat(r.name, " ", r.desc)), q) end)
  end
end

def mb_toggle(xs: List, r: String) -> List do
  case mb_has(xs, r) do
    true -> filter(xs, fn(y: Any) -> Bool do y != r end)
    false -> mb_append(xs, [r])
  end
end

def mb_watch(routes: List) -> Map do
  %{t: "watch", routes: routes}
end

# The server's routes, less any this page has stopped watching since.
def mb_routes(v: Any, selected: List) -> List do
  case type_of(v) == :list do
    false -> []
    true -> filter(v, fn(r: Any) -> Bool do type_of(r) == :map and mb_has(selected, lookup(r, :route)) and type_of(lookup(r, :buses)) == :list end)
  end
end

def mb_nth(xs: List, i: Int) -> Any do
  case i <= 0 do
    true -> head(xs)
    false -> mb_nth(tail(xs), i - 1)
  end
end

# Bus Time's bearing is degrees anticlockwise from east.
def mb_heading(bearing: Any) -> String do
  case mb_num(bearing) do
    false -> ""
    true ->
      compass = rem(round(90 - bearing) + 720, 360)
      concat("Heading ", mb_nth(["N", "NE", "E", "SE", "S", "SW", "W", "NW"], rem(round(compass / 45.0), 8)))
  end
end

# "2026-11-03T18:10:23.149-05:00", already New York's time, as "6:10 PM"
def mb_clock(at: String) -> String do
  parts = split(at, "T")
  case length(parts) == 2 do
    false -> ""
    true ->
      hm = split(mb_nth(parts, 1), ":")
      h = to_int(head(hm))
      twelve = case rem(h, 12) do
        0 -> 12
        n -> n
      end
      half = case h < 12 do
        true -> "AM"
        false -> "PM"
      end
      concat(to_string(twelve), ":", mb_nth(hm, 1), " ", half)
  end
end

# "MTABC_9085" is bus 9085
def mb_vehicle(id: String) -> String do
  parts = split(id, "_")
  concat("Bus ", mb_nth(parts, length(parts) - 1))
end

def mb_next(stop: String, away: String, layover: Bool) -> String do
  case stop do
    "" -> ""
    _ ->
      case layover do
        true -> concat("On layover at ", stop)
        false ->
          case away do
            "" -> concat("Next stop: ", stop)
            _ -> concat("Next stop: ", stop, " (", away, ")")
          end
      end
  end
end

def mb_marker(route: String, color: String, desc: String, b: Map) -> Map do
  id = mb_str(lookup(b, :id), "")
  bearing = lookup(b, :bearing)
  layover = lookup(b, :layover) == true
  turn = case mb_num(bearing) and not(layover) do
    true -> to_string(0 - bearing)
    false -> ""
  end
  heading = case layover do
    true -> ""
    false -> mb_heading(bearing)
  end
  seen = case mb_clock(mb_str(lookup(b, :recorded_at), "")) do
    "" -> ""
    t -> concat("Seen ", t)
  end
  detail = join(filter([heading, mb_vehicle(id), seen], fn(x: String) -> Bool do x != "" end), " · ")
  %{key: mta_bus_key(route, id), lat: b.lat, lng: b.lng,
    icon: mta_icon_html(route, color, turn),
    popup: mta_popup_html(route, color, desc, mb_str(lookup(b, :destination), ""),
      mb_next(mb_str(lookup(b, :stop), ""), mb_str(lookup(b, :away), ""), layover), detail)}
end

def mb_markers(routes: List) -> List do
  flat(map(routes, fn(r: Map) -> List do
    row = lookup(MB_BY_NAME, r.route)
    good = filter(r.buses, fn(b: Any) -> Bool do type_of(b) == :map and mb_num(lookup(b, :lat)) and mb_num(lookup(b, :lng)) end)
    map(good, fn(b: Map) -> Map do mb_marker(r.route, row.color, row.desc, b) end)
  end))
end

def mb_bus_count(routes: List) -> Int do
  reduce(routes, 0, fn(n: Int, r: Map) -> Int do n + length(r.buses) end)
end

def mb_count(n: Int, one: String, many: String) -> String do
  case n == 1 do
    true -> concat("1 ", one)
    false -> concat(to_string(n), " ", many)
  end
end

# What a borough's button shows of the map: [[south, west], [north, east]].
def mb_bounds(b: String) -> List do
  case b do
    "manhattan" -> [[40.70, -74.02], [40.88, -73.91]]
    "brooklyn" -> [[40.57, -74.04], [40.74, -73.85]]
    "queens" -> [[40.54, -73.96], [40.80, -73.70]]
    "bronx" -> [[40.79, -73.93], [40.92, -73.77]]
    "staten" -> [[40.49, -74.26], [40.65, -74.05]]
    _ -> [[40.49, -74.26], [40.92, -73.70]]
  end
end

# The routes a saved visit chose, less any that have since gone.
def mb_restored(text: String) -> List do
  case json_decode(text) do
    {:ok, v} ->
      case type_of(v) == :list do
        true -> uniq(filter(v, fn(r: Any) -> Bool do type_of(r) == :string and lookup(MB_BY_NAME, r) != nil end))
        false -> []
      end
    _ -> []
  end
end

# ── the template ────────────────────────────────────────────────────────

BOROUGHS = ["all", "manhattan", "brooklyn", "queens", "bronx", "staten", "express"]

# Past this many a row of chips is a wall; the status bar has the count.
MB_MAX_CHIPS = 12

def mb_header(borough: String, loading: Bool) -> Any do
  update = case loading do
    true -> "Loading..."
    false -> "Update"
  end
  el("div", %{class: "mta-top"},
    el("h1", %{}, mta_title(borough)),
    el("div", %{class: "mta-row"},
      el("button", %{click: :toggle_modal, class: "mta-btn mta-btn-primary"}, "Choose routes"),
      el("button", %{click: :fetch_buses, class: "mta-btn", disabled: loading}, update)))
end

def mb_borough_button(key: String, active: String) -> Any do
  cls = case active == key do
    true -> "mta-btn mta-btn-on"
    false -> "mta-btn"
  end
  el("button", %{click: :select_borough, with: key, class: cls}, mta_borough_name(key))
end

def mb_boroughs(active: String) -> Any do
  el("div", %{class: "mta-row mta-boroughs"},
    map(BOROUGHS, fn(b: String) -> Any do mb_borough_button(b, active) end),
    el("button", %{click: :select_all_borough_routes, with: active, class: "mta-btn"}, mta_select_label(active)))
end

# A selected route, which is the map's legend too. How many buses it has out
# is on it, so a route with none says so instead of looking broken; nil is
# not yet heard, which is different from none.
def mb_chip(route: String, counts: Map) -> Any do
  n = lookup(counts, route)
  cls = case n do
    0 -> "mta-chip mta-chip-none"
    _ -> "mta-chip"
  end
  note = case n do
    nil -> "..."
    0 -> "no buses out"
    _ -> to_string(n)
  end
  el("button", %{click: :toggle_route, with: route, class: cls, style: concat("--route:", mb_color(route)), title: concat("Stop showing ", route)},
    el("b", %{}, route), note)
end

def mb_chips(selected: List, counts: Map) -> Any do
  case selected do
    [] -> el("p", %{class: "mta-note"}, "No routes chosen. Choose some to see their buses.")
    _ ->
      case length(selected) > MB_MAX_CHIPS do
        true ->
          el("div", %{class: "mta-row"},
            el("span", %{class: "mta-note"}, concat(mb_count(length(selected), "route", "routes"), " chosen")),
            el("button", %{click: :clear_routes, class: "mta-btn"}, "Clear"))
        false ->
          el("div", %{class: "mta-row mta-chips"},
            map(selected, fn(r: String) -> Any do mb_chip(r, counts) end),
            el("button", %{click: :clear_routes, class: "mta-btn"}, "Clear"))
      end
  end
end

def mb_pick(r: Map, selected: List) -> Any do
  el("label", %{class: "mta-pick"},
    el("input", %{type: "checkbox", checked: mb_has(selected, r.name), click: :toggle_route, with: r.name}),
    el("span", %{class: "mta-swatch", style: concat("background:", r.color)}),
    el("b", %{}, r.name),
    el("span", %{class: "mta-desc", title: r.desc}, r.desc))
end

def mb_modal(active: String, selected: List, query: String) -> Any do
  rows = mb_rows(active, query)
  list = case rows do
    [] -> el("p", %{class: "mta-note"}, concat("No route matches \"", query, "\"."))
    _ -> el("div", %{class: "mta-list"}, map(rows, fn(r: Map) -> Any do mb_pick(r, selected) end))
  end
  # a search spans every tab, so no tab is the one being shown
  tabs = case trim(query) do
    "" -> el("div", %{class: "mta-row mta-boroughs"}, map(BOROUGHS, fn(b: String) -> Any do mb_borough_button(b, active) end))
    _ -> ""
  end
  el("div", %{class: "mta-modal"},
    el("div", %{class: "mta-panel", role: "dialog", "aria-label": "Choose routes"},
      el("div", %{class: "mta-top"},
        el("h2", %{}, "Choose routes"),
        el("button", %{click: :toggle_modal, class: "mta-btn mta-btn-primary"}, "Done")),
      el("input", %{type: "search", class: "mta-search", value: query, input: :search, debounce: 120,
        placeholder: "Search by route or place, like M15 or Jamaica", "aria-label": "Search routes"}),
      tabs,
      list,
      el("div", %{class: "mta-row"},
        el("button", %{click: :select_all_borough_routes, with: active, class: "mta-btn"}, mta_select_label(active)),
        el("button", %{click: :clear_routes, class: "mta-btn"}, "Clear"),
        el("span", %{class: "mta-note"}, concat(mb_count(length(selected), "route", "routes"), " chosen")))))
end

def mb_counts(routes: List) -> Map do
  reduce(routes, %{}, fn(acc: Map, r: Map) -> Map do put(acc, r.route, length(r.buses)) end)
end

def mb_page(s: Map) -> Any do
  err = case s.error do
    "" -> ""
    _ -> el("p", %{class: "mta-error"}, s.error)
  end
  modal = case s.modal do
    true -> mb_modal(s.borough, s.selected, s.query)
    false -> ""
  end
  el("div", %{class: "mta-controls"},
    mb_header(s.borough, s.loading), mb_boroughs(s.borough), mb_chips(s.selected, mb_counts(s.routes)), err, modal)
end

# ── the program ─────────────────────────────────────────────────────────

actor MtaPage do
  state borough: String :: "manhattan"
  # the tab's title is the LiveView's page_title: "MTA Bus Map Tracker"
  # until a borough is picked, then that borough's tracker
  state titled: Bool :: false
  state selected: List :: mta_initial
  state modal: Bool :: false
  state query: String :: ""
  state loading: Bool :: false
  state error: String :: ""
  state routes: List :: []
  state epoch: Int :: 0
  state outbox: List :: []

  # a new selection: tell the server, and stop drawing what is no longer chosen
  on :choose(xs: List) do
    become selected: xs, loading: true, routes: mb_routes(routes, xs), epoch: epoch + 1, outbox: mb_append(outbox, [json_encode(mb_watch(xs))])
    reply length(xs)
  end

  # the socket is (again) open: say what this page watches
  on :connected do
    become error: "", outbox: mb_append(outbox, [json_encode(mb_watch(selected))])
    reply :ok
  end

  on :disconnected do
    become error: "Lost the connection to the server. These buses may be out of date until it comes back."
    reply :ok
  end

  # what this visitor chose last time, before the socket opens
  on :restore(text: String) do
    case mb_restored(text) do
      [] -> reply :nothing
      xs ->
        become selected: xs
        reply length(xs)
    end
  end

  on :frame(text: String) do
    msg = mb_decode(text)
    case lookup(msg, :t) do
      "buses" ->
        become routes: mb_routes(lookup(msg, :routes), selected), epoch: epoch + 1, loading: false, error: ""
        reply :buses
      "error" ->
        become error: mb_str(lookup(msg, :message), "error"), loading: false
        reply :error
      _ -> reply :ignored
    end
  end

  on :fetch_buses do
    become loading: true, outbox: mb_append(outbox, [json_encode(%{t: "refresh"})])
    reply :ok
  end

  on :toggle_route(r: String) do
    reply (self <- :choose(mb_toggle(selected, r)))
  end

  on :select_all_routes do
    reply (self <- :choose(mb_for_borough("all")))
  end

  on :select_all_borough_routes(b: String) do
    reply (self <- :choose(mb_for_borough(b)))
  end

  on :clear_routes do
    reply (self <- :choose([]))
  end

  on :select_borough(b: String) do
    become borough: b, titled: true
    reply :ok
  end

  on :search(value: String) do
    become query: value
    reply :ok
  end

  on :toggle_modal do
    become modal: not(modal), query: ""
    reply :ok
  end

  on :outbox do
    out = outbox
    become outbox: []
    reply out
  end

  # Every marker, if they changed since epoch e; nil if not.
  on :markers(e: Int) do
    case e == epoch do
      true -> reply nil
      false -> reply %{epoch: epoch, markers: mb_markers(routes)}
    end
  end

  on :status do
    title = case titled do
      true -> mta_title(borough)
      false -> "MTA Bus Map Tracker"
    end
    reply %{routes: mb_count(length(selected), "route", "routes"), buses: mb_count(mb_bus_count(routes), "bus", "buses"), title: title, borough: borough, bounds: mb_bounds(borough)}
  end

  on :view do
    reply mb_page(%{borough: borough, selected: selected, modal: modal, query: query, loading: loading, error: error, routes: routes})
  end
end

mta = spawn MtaPage
mta <- :view
