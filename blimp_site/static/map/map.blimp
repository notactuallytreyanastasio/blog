# /map, "Tag a Wook": the page's program. It draws everything on the page
# except the map itself, and decides what a tap on the map means.
#
# The map is Leaflet, a JavaScript library, in #mapid beside this program:
# Blimp's view cannot host another library's DOM, and it has no pointer
# events. static/map/map.js is the MapHook the LiveView had, cut down to
# what only JavaScript can do: it hands this program a tap on the map
# (`wook <- :clicked(json)`), the browser's location (`:located(json)`) and
# every frame from /live/map (`:frame(json)`), and it asks the program,
# every 100ms, what to do: `:outbox` (tags for the server, and a request to
# find the visitor) and `:pins(epoch, n)` (the pins it has not drawn yet,
# each with its popup already made, by Temper's map_popup_html).
#
# The tags are not here: they are rows in Postgres, and the server's
# MapRoom (src/97_map.blimp) sends them when the socket opens and every new
# one to everyone. This is MapLive's template, element for element and
# class for class, with its styles in static/map/map.css.

def mp_decode(text: String) -> Map do
  case json_decode(text) do
    {:ok, m} ->
      case type_of(m) == :map do
        true -> m
        false -> %{}
      end
    _ -> %{}
  end
end

def mp_str(v: Any) -> String do
  case type_of(v) == :string do
    true -> v
    false -> ""
  end
end

def mp_num(v: Any) -> Bool do
  type_of(v) == :float or type_of(v) == :integer
end

def mp_tags(v: Any) -> List do
  case type_of(v) == :list do
    true -> filter(v, fn(t: Any) -> Bool do type_of(t) == :map and mp_num(lookup(t, :lat)) and mp_num(lookup(t, :lng)) end)
    false -> []
  end
end

# A pin as map.js draws it: where, and the popup it opens. The number in
# the popup's iframe title keeps two pins by one tagger apart.
def mp_pin(t: Map, n: Int) -> Map do
  %{lat: t.lat, lng: t.lng, popup: map_popup_html(mp_str(lookup(t, :name)), mp_str(lookup(t, :note)), mp_str(lookup(t, :embed_url)), mp_str(lookup(t, :link)), n)}
end

def mp_drop(xs: List, n: Int) -> List do
  case n <= 0 do
    true -> xs
    false ->
      case xs do
        [] -> []
        [_ | rest] -> mp_drop(rest, n - 1)
      end
  end
end

def mp_append(a: List, b: List) -> List do
  reduce(reverse(a), b, fn(acc: List, x: Any) -> List do [x | acc] end)
end

# ── the template ────────────────────────────────────────────────────────

LOCATE_ICON = "M12 8c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm8.94 3c-.46-4.17-3.77-7.48-7.94-7.94V2c0-.55-.45-1-1-1s-1 .45-1 1v1.06C7.83 3.52 4.52 6.83 4.06 11H3c-.55 0-1 .45-1 1s.45 1 1 1h1.06c.46 4.17 3.77 7.48 7.94 7.94V22c0 .55.45 1 1 1s1-.45 1-1v-1.06c4.17-.46 7.48-3.77 7.94-7.94H21c.55 0 1-.45 1-1s-.45-1-1-1h-1.06zM12 19c-3.87 0-7-3.13-7-7s3.13-7 7-7 7 3.13 7 7-3.13 7-7 7z"

def mp_header() -> Any do
  el("div", %{class: "map-header-text"},
    el("h1", %{}, "Tag a Wook"),
    el("p", %{}, "@ your friend and share a song"),
    el("p", %{}, "Tap the map anywhere to tag a wook if you dont wanna share your location"))
end

def mp_modal() -> Any do
  el("div", %{class: "spotify-modal"},
    el("h3", %{}, "Add Your Song to the Map"),
    el("form", %{submit: :submit},
      el("label", %{"for": "user_name_music"}, "Your Name/Handle:"),
      el("input", %{type: "text", name: "user_name", id: "user_name_music", placeholder: "Anonymous Wook", value: ""}),
      el("br", %{}),
      el("label", %{"for": "music_link"}, "Spotify or Apple Music Link:"),
      el("input", %{type: "text", name: "music_link", id: "music_link", placeholder: "spotify or apple link", required: true}),
      el("br", %{}),
      el("label", %{"for": "note_music"}, "Short Note (optional):"),
      el("input", %{type: "text", name: "note", id: "note_music", placeholder: "What's on your mind?"}),
      el("br", %{}),
      el("button", %{type: "submit", class: "submit"}, "Add Song"),
      el("button", %{type: "button", class: "cancel", click: :cancel}, "Cancel")))
end

def mp_locate() -> Any do
  el("button", %{id: "locate-me-button", class: "locate-me-button", title: "Center on my location", click: :locate},
    el("svg", %{viewBox: "0 0 24 24"}, el("path", %{d: LOCATE_ICON})),
    el("span", %{}, "Locate Me"))
end

# The player, or a link to the song; an iframe, which el() will not make,
# so the container is given it as HTML (Temper's map_song_html).
def mp_song(t: Map) -> Any do
  el("div", %{class: "spotify-embed-container", inner_html: map_song_html(mp_str(lookup(t, :embed_url)), mp_str(lookup(t, :link)))})
end

def mp_drawer(tags: List) -> Any do
  content = case tags do
    [] -> el("p", %{style: "text-align: center; color: #666; margin-top: 40px;"}, "No songs added yet!")
    _ -> el("div", %{}, map(tags, fn(t: Map) -> Any do mp_song(t) end))
  end
  el("div", %{},
    el("div", %{class: "drawer-overlay show", click: :close_drawer}),
    el("div", %{class: "drawer show"},
      el("div", %{class: "drawer-header"},
        el("h2", %{class: "drawer-title"}, "All Songs on Map"),
        el("button", %{class: "drawer-close", click: :close_drawer}, "×")),
      el("div", %{class: "drawer-content"}, content)))
end

def mp_notice(text: String) -> Any do
  case text do
    "" -> el("div", %{}, "")
    _ -> el("div", %{class: "map-notice", click: :dismiss}, text)
  end
end

def mp_page(s: Map) -> Any do
  modal = case s.prompt do
    nil -> el("div", %{}, "")
    _ -> mp_modal()
  end
  drawer = case s.drawer do
    true -> mp_drawer(s.tags)
    false -> el("div", %{}, "")
  end
  el("div", %{},
    mp_header(),
    modal,
    mp_locate(),
    el("button", %{class: "browse-button", click: :toggle_drawer}, "BROWSE"),
    drawer,
    mp_notice(s.notice))
end

actor Wook do
  # newest first, as MapLive's @markers: the rows in the order Postgres
  # gave them, then every new one in front
  state tags: List :: []
  # oldest first, as map.js draws them; epoch changes when a new socket
  # sends them all again, and map.js then draws them again
  state pins: List :: []
  state epoch: Int :: 0
  # nil, or where the tag being written goes: %{lat, lng}
  state prompt: Any :: nil
  state drawer: Bool :: false
  state notice: String :: ""
  state outbox: List :: []

  # A frame from /live/map: all the tags, a new one, or why one was not
  # saved.
  on :frame(json: String) do
    m = mp_decode(json)
    case lookup(m, :t) do
      "hello" ->
        ts = mp_tags(lookup(m, :tags))
        become tags: ts, pins: ts, epoch: epoch + 1
      "tag" ->
        ts = mp_tags([lookup(m, :tag)])
        become tags: mp_append(ts, tags), pins: mp_append(pins, ts)
      "refused" -> become notice: concat("Not saved: ", mp_str(lookup(m, :message)))
      "error" -> become notice: concat("The map's tags could not be read: ", mp_str(lookup(m, :message)))
      _ -> become notice: notice
    end
    reply :ok
  end

  # map_clicked and got_location: either one opens the prompt, for there.
  on :clicked(json: String) do
    at = mp_decode(json)
    case mp_num(lookup(at, :lat)) and mp_num(lookup(at, :lng)) do
      true -> become prompt: %{lat: at.lat, lng: at.lng}
      false -> become prompt: prompt
    end
    reply :ok
  end

  on :located(json: String) do
    at = mp_decode(json)
    case mp_num(lookup(at, :lat)) and mp_num(lookup(at, :lng)) do
      true -> become prompt: %{lat: at.lat, lng: at.lng}
      false -> become prompt: prompt
    end
    reply :ok
  end

  # The form, as the fields it had: {"user_name": .., "music_link": .., "note": ..}.
  # The server decides whether it is a tag; the prompt closes either way.
  on :submit(json: String) do
    f = mp_decode(json)
    case prompt do
      nil -> become prompt: nil
      _ ->
        tag = %{t: "tag", name: mp_str(lookup(f, :user_name)), link: mp_str(lookup(f, :music_link)), note: mp_str(lookup(f, :note)), lat: prompt.lat, lng: prompt.lng}
        become prompt: nil, notice: "", outbox: mp_append(outbox, [%{to: "server", frame: json_encode(tag)}])
    end
    reply :ok
  end

  on :cancel do
    become prompt: nil
    reply :ok
  end

  # Leaflet's locate(), which only map.js can call.
  on :locate do
    become outbox: mp_append(outbox, [%{to: "map", what: "locate"}])
    reply :ok
  end

  on :toggle_drawer do
    become drawer: not(drawer)
    reply :ok
  end

  on :close_drawer do
    become drawer: false
    reply :ok
  end

  on :dismiss do
    become notice: ""
    reply :ok
  end

  on :outbox do
    out = outbox
    become outbox: []
    reply out
  end

  # The pins after the first n, if map.js has drawn this epoch's first n;
  # all of them if it drew another epoch's.
  on :pins(e: Int, n: Int) do
    case e == epoch do
      true -> reply %{epoch: epoch, from: n, pins: mp_pins_from(mp_drop(pins, n), n)}
      false -> reply %{epoch: epoch, from: 0, pins: mp_pins_from(pins, 0)}
    end
  end

  on :view do
    reply mp_page(%{tags: tags, prompt: prompt, drawer: drawer, notice: notice})
  end
end

def mp_pins_from(ts: List, n: Int) -> List do
  case ts do
    [] -> []
    [t | rest] -> [mp_pin(t, n) | mp_pins_from(rest, n + 1)]
  end
end

wook = spawn Wook
wook <- :view
