# /aim: the page's program. It draws a desktop from about 2003 -- the
# sign-on window, the Buddy List, an Instant Message window, Get Info, the
# Party Line (one room with everyone in it) and the Bulletin Board --
# and one thing AIM never had: a reader view, because bobbbyBot answers in
# Markdown and a long answer deserves a page, not a chat bubble.
#
# The conversations are not here, only their pictures. The server's AIM
# actor (src/99_aim.blimp) holds them: bobbbyBot's, which it asks DeepSeek
# about; SmarterChild's, a script; and one with each other person signed
# on, whose names come in a "buddies" frame. The IM window shows one at a
# time, with a tab for each when there is more than one.
# It is the whole page; there is no script of its own. Blimp's view holds
# the socket to /live/aim (socket(): frames in as :frame, the outbox up,
# numbered so each goes once), remembers the screen name and the dial-up
# choice (stored() and store()), submits on Enter, keeps transcripts at
# their end, keeps the clock (now() and utc_offset()), and plays the
# sounds, which are <audio> elements. ?msg=SmarterChild arrives as
# :location (data-location="1").

def aimp_decode(text: String) -> Map do
  case json_decode(text) do
    {:ok, m} ->
      case type_of(m) == :map do
        true -> m
        false -> %{}
      end
    _ -> %{}
  end
end

def aimp_str(v: Any) -> String do
  case type_of(v) == :string do
    true -> v
    false -> ""
  end
end

def aimp_int(v: Any) -> Int do
  case type_of(v) == :integer do
    true -> v
    false -> 0
  end
end

def aimp_messages(v: Any) -> List do
  case type_of(v) == :list do
    true -> filter(v, fn(m: Any) -> Bool do type_of(m) == :map end)
    false -> []
  end
end

def aimp_drop(l: List, k: Int) -> List do
  case k <= 0 or l == [] do
    true -> l
    false -> aimp_drop(tail(l), k - 1)
  end
end

def aimp_append(a: List, b: List) -> List do
  reduce(reverse(a), b, fn(acc: List, x: Any) -> List do [x | acc] end)
end

def aimp_nth(list: List, i: Int) -> Any do
  case list do
    [] -> nil
    [x | rest] ->
      case i do
        0 -> x
        _ -> aimp_nth(rest, i - 1)
      end
  end
end

# 75344 -> "75,344"
def aimp_commas(n: Int) -> String do
  s = to_string(n)
  case length(s) > 3 do
    false -> s
    true -> concat(aimp_commas(n / 1000), ",", slice(s, length(s) - 3, length(s)))
  end
end

# The indexes of the bot's answers, in order: what the reader pages through.
def aimp_answers(ms: List) -> List do
  reverse(elem(reduce(ms, {[], 0}, fn(acc: Tuple, m: Map) -> Tuple do
    i = elem(acc, 1)
    case aimp_str(lookup(m, :role)) do
      "assistant" -> {[i | elem(acc, 0)], i + 1}
      _ -> {elem(acc, 0), i + 1}
    end
  end), 0))
end

# The answer before or after `i` (-1 for before, 1 for after), or i.
def aimp_step(answers: List, i: Int, dir: Int) -> Int do
  pick = case dir < 0 do
    true -> filter(reverse(answers), fn(j: Int) -> Bool do j < i end)
    false -> filter(answers, fn(j: Int) -> Bool do j > i end)
  end
  case pick do
    [] -> i
    [j | _] -> j
  end
end

# A reply worth a page: long, or shaped like a document.
def aimp_long(content: String) -> Bool do
  length(content) > 420 or contains(content, "\n#") or contains(content, "```") or contains(content, "\n- ") or contains(content, "\n1. ")
end

# ── whose conversation ─────────────────────────────────────────────────
# "bot" is bobbbyBot, "sc" SmarterChild, "u<n>" a person.

def aimp_convo(s: Map, id: String) -> List do
  case id do
    "bot" -> s.messages
    _ ->
      case lookup(s.convos, id) do
        nil -> []
        ms -> ms
      end
  end
end

def aimp_name(s: Map, id: String) -> String do
  case id do
    "bot" -> aim_bot_name
    "sc" -> "SmarterChild"
    _ ->
      case lookup(s.names, id) do
        nil -> "Somebody"
        n -> aimp_str(n)
      end
  end
end

def aimp_here(s: Map, id: String) -> Bool do
  case id do
    "bot" -> s.online == true
    "sc" -> true
    _ -> filter(s.buddies, fn(b: Map) -> Bool do aimp_str(lookup(b, :id)) == id end) != []
  end
end

def aimp_typing(s: Map, id: String) -> Bool do
  case id do
    "bot" -> s.loading
    _ -> lookup(s.typing, id) == true
  end
end

# what the other side has said in a conversation
def aimp_heard(ms: List) -> Int do
  length(filter(ms, fn(m: Map) -> Bool do aimp_str(lookup(m, :role)) != "user" end))
end

def aimp_without(list: List, x: Any) -> List do
  filter(list, fn(y: Any) -> Bool do y != x end)
end

def aimp_buddies(v: Any) -> List do
  filter(aimp_messages(v), fn(b: Map) -> Bool do aimp_str(lookup(b, :id)) != "" end)
end

# ── window chrome ──────────────────────────────────────────────────────

# A window's title bar. It drags the window it belongs to (kind is the
# window's class, aim-buddies and so on; "" for one that does not move).
def aimp_titlebar(kind: String, title: String, close: Any) -> Any do
  x = case close do
    nil -> el("span", %{class: "aim-tb-btn dead"}, "×")
    msg -> el("button", %{class: "aim-tb-btn", click: msg, title: "Close"}, "×")
  end
  bar = case kind do
    "" -> %{class: "aim-titlebar"}
    _ -> %{class: "aim-titlebar", drag: :move_window, with: kind}
  end
  el("div", bar,
    el("span", %{class: "aim-tb-icon"}),
    el("span", %{class: "aim-tb-title"}, title),
    el("span", %{class: "aim-tb-btns"},
      el("span", %{class: "aim-tb-btn dead"}, "_"),
      el("span", %{class: "aim-tb-btn dead"}, "□"),
      x))
end

def aimp_menubar(items: List) -> Any do
  el("div", %{class: "aim-menubar"}, map(items, fn(t: String) -> Any do el("span", %{}, t) end))
end

# The yellow running figure, drawn here rather than borrowed.
def aimp_runner(cls: String) -> Any do
  el("span", %{class: concat("aim-runner ", cls), inner_html: "<svg viewBox=\"0 0 32 40\" aria-hidden=\"true\"><circle cx=\"19\" cy=\"6\" r=\"5\"/><path d=\"M17 12 L9 20 L3 18 M17 12 L14 25 L22 31 L20 39 M14 25 L7 33 L1 32 M16 15 L25 19 L30 15\" fill=\"none\" stroke-width=\"4.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"})
end

# ── sign on ────────────────────────────────────────────────────────────

def aimp_signon(s: Map) -> Any do
  el("div", aimp_win(s, "aim-signon", %{}),
    aimp_titlebar("aim-signon", "Sign On", nil),
    el("div", %{class: "aim-signon-body"},
      el("div", %{class: "aim-signon-logo"}, aimp_runner("big"),
        el("div", %{class: "aim-wordmark"}, el("strong", %{}, "AIM"), el("span", %{}, "bobbby.online edition"))),
      el("form", %{class: "aim-signon-form", submit: :sign_on},
        el("label", %{"for": "aim-sn"}, "Screen Name"),
        el("input", %{id: "aim-sn", name: "name", class: "aim-field", value: s.name, maxlength: "16", autocomplete: "nickname", placeholder: "Visitor"}),
        el("label", %{"for": "aim-pw"}, "Password"),
        el("input", %{id: "aim-pw", class: "aim-field", type: "password", disabled: true, placeholder: "not needed"}),
        el("div", %{class: "aim-signon-row"},
          el("span", %{class: "aim-small"}, "No account? Make up a name."),
          el("button", %{type: "submit", class: "aim-btn aim-btn-default"}, aimp_runner("tiny"), "Sign On"))),
      el("div", %{class: "aim-small aim-signon-foot"}, "Version 5.9.blimp")))
end

# ── windows: where each has been dragged, and which is in front ────────

# A window's attributes: its class, and its place. moved holds each kind's
# offset from where the stylesheet puts it; it is the CSS translate
# property, which adds to the transform some windows centre themselves
# with instead of replacing it. Phones stack the windows and ignore it.
def aimp_win(s: Map, kind: String, extra: Map) -> Map do
  m = lookup(s.moved, kind)
  off = case m do
    nil -> nil
    _ -> concat(to_string(m.x), "px ", to_string(m.y), "px")
  end
  put(put(extra, :class, ["aim-win", kind]), :style, %{translate: off, "z-index": show(s.front == kind, 4)})
end

# ── the Buddy List ─────────────────────────────────────────────────────

def aimp_buddy(name: String, cls: String, click: Any, note: String) -> Any do
  attrs = case click do
    nil -> %{class: concat("aim-buddy ", cls)}
    msg -> %{class: concat("aim-buddy ", cls), click: msg}
  end
  el("div", attrs, el("span", %{class: "aim-buddy-name"}, name), el("span", %{class: "aim-buddy-note"}, note))
end

# A buddy whose conversation a click opens; bold until it is read.
def aimp_buddy_to(s: Map, id: String) -> Any do
  unread = filter(s.unread, fn(u: String) -> Bool do u == id end) != []
  note = case unread do
    true -> "(new message)"
    false -> ""
  end
  el("div", %{class: %{"aim-buddy": true, online: true, unread: unread}, click: :open_chat, with: id}, el("span", %{class: "aim-buddy-name"}, aimp_name(s, id)), el("span", %{class: "aim-buddy-note"}, note))
end

def aimp_buddy_list(s: Map) -> Any do
  bot = case s.online do
    true -> aimp_buddy(aim_bot_name, "online", :open_im, "")
    false -> aimp_buddy(aim_bot_name, "away", :open_im, "(away)")
    nil -> aimp_buddy(aim_bot_name, "idle", nil, "(connecting)")
  end
  bots_on = case s.online do
    false -> 0
    _ -> 1
  end
  sc = [aimp_buddy_to(s, "sc")]
  online = concat(to_string(bots_on + 1), "/2")
  people = map(s.buddies, fn(b: Map) -> Any do aimp_buddy_to(s, aimp_str(lookup(b, :id))) end)
  nobody = show(people == [], el("div", %{class: "aim-buddy offline"}, el("span", %{class: "aim-buddy-note"}, "nobody else is signed on")))
  cats = show(s.cats != "", [el("div", %{class: "aim-group"}, "▾ Cats (2/2)"), aimp_buddy("Bobby's cats", "online cats", :open_cats, "")])
  party_cls = case s.party_unread do
    true -> "online unread"
    false -> "online"
  end
  rooms = [el("div", %{class: "aim-group"}, "▾ Chat Rooms (2)"),
    aimp_buddy("Party Line", party_cls, :open_party, concat("(", to_string(length(s.party_members)), " here)")),
    aimp_buddy("Bulletin Board", "online", :open_board, concat("(", to_string(length(s.board_posts)), " notes)"))]
  offline = "▾ Offline (1/1)"
  muted = case s.muted do
    true -> "Sounds: off"
    false -> "Sounds: on"
  end
  el("div", aimp_win(s, "aim-buddies", %{}),
    aimp_titlebar("aim-buddies", concat(s.name, "'s Buddy List"), nil),
    aimp_menubar(["My AIM", "People", "Help"]),
    el("div", %{class: "aim-buddies-brand"}, aimp_runner("mid"), el("div", %{}, el("strong", %{}, "bobbby.online"), el("span", %{}, "Instant Messenger"))),
    el("div", %{class: "aim-buddies-tabs"}, el("span", %{class: "on"}, "Online"), el("span", %{}, "List Setup")),
    el("div", %{class: "aim-buddies-tree"},
      el("div", %{class: "aim-group"}, concat("▾ Buddies (", online, ")")),
      bot,
      sc,
      el("div", %{class: "aim-group"}, concat("▾ Online Now (", to_string(length(people)), ")")),
      people,
      nobody,
      rooms,
      cats,
      el("div", %{class: "aim-group"}, offline),
      el("a", %{class: "aim-buddy offline", href: "https://bsky.app/profile/bobbby.online", target: "_blank", rel: "noopener"}, el("span", %{class: "aim-buddy-name"}, "bobbby (the real one)")),
      []),
    el("div", %{class: "aim-buddies-foot"},
      el("button", %{class: "aim-btn", click: :open_im}, "IM"),
      el("button", %{class: "aim-btn", click: :open_info}, "Info"),
      el("button", %{class: "aim-btn", click: :toggle_sound}, muted),
      el("button", %{class: "aim-btn", click: :sign_off}, "Sign Off")))
end

# ── the IM window ──────────────────────────────────────────────────────

def aimp_line(s: Map, m: Map, i: Int) -> Any do
  role = aimp_str(lookup(m, :role))
  content = aimp_str(lookup(m, :content))
  case role do
    "assistant" ->
      long = aimp_long(content)
      cls = case long do
        true -> "aim-line bot long"
        false -> "aim-line bot"
      end
      more = case long do
        true -> [el("button", %{class: "aim-readmore", click: :open_reader, with: i}, "Open in Reader →")]
        false -> [el("button", %{class: "aim-reader-chip", click: :open_reader, with: i, title: "Open in Reader"}, "¶")]
      end
      el("div", %{class: cls},
        el("span", %{class: "aim-sn bot"}, aim_bot_name, ":"),
        el("div", %{class: "aim-md", inner_html: aimp_str(lookup(m, :html))}),
        more)
    _ ->
      el("div", %{class: "aim-line me"}, el("span", %{class: "aim-sn me"}, s.name, ":"), el("span", %{class: "aim-text"}, content))
  end
end

# A line of SmarterChild's or a person's: their words as text, never HTML.
def aimp_their_line(s: Map, who: String, m: Map) -> Any do
  content = aimp_str(lookup(m, :content))
  case aimp_str(lookup(m, :role)) do
    "user" -> el("div", %{class: "aim-line me"}, el("span", %{class: "aim-sn me"}, s.name, ":"), el("span", %{class: "aim-text"}, content))
    _ -> el("div", %{class: "aim-line them"}, el("span", %{class: "aim-sn bot"}, who, ":"), el("span", %{class: "aim-text"}, content))
  end
end

def aimp_their_log(s: Map, id: String) -> Any do
  who = aimp_name(s, id)
  opener = case id do
    "sc" -> concat(who, " signed on.")
    _ ->
      case aimp_here(s, id) do
        true -> concat(who, " is online.")
        false -> concat(who, " signed off. Messages won't reach them.")
      end
  end
  lines = map(aimp_convo(s, id), fn(m: Map) -> Any do aimp_their_line(s, who, m) end)
  el("div", %{class: "aim-log", id: "aim-log", scroll: :end}, [el("div", %{class: "aim-sys"}, opener) | lines])
end

# A tab for every conversation that has started, when there is more than one.
def aimp_tabs(s: Map) -> Any do
  started = filter(keys(s.convos), fn(k: Any) -> Bool do aimp_convo(s, aimp_str(k)) != [] end)
  ids = uniq(aimp_append(["bot"], aimp_append(map(started, fn(k: Any) -> String do aimp_str(k) end), [s.current])))
  case length(ids) > 1 do
    false -> []
    true ->
      [el("div", %{class: "aim-tabs"}, map(ids, fn(id: String) -> Any do
        unread = filter(s.unread, fn(u: String) -> Bool do u == id end) != []
        cls = case id == s.current do
          true -> "aim-tab on"
          false ->
            case unread do
              true -> "aim-tab unread"
              false -> "aim-tab"
            end
        end
        el("button", %{class: cls, click: :open_chat, with: id}, aimp_name(s, id))
      end))]
  end
end

def aimp_lines(s: Map, ms: List, i: Int, acc: List) -> List do
  case ms do
    [] -> reverse(acc)
    [m | rest] -> aimp_lines(s, rest, i + 1, [aimp_line(s, m, i) | acc])
  end
end

def aimp_log(s: Map) -> Any do
  opener = case s.online do
    false -> [el("div", %{class: "aim-sys"}, concat(aim_bot_name, " is away: \"", aim_away_message, "\". Messages won't be answered right now."))]
    _ -> [el("div", %{class: "aim-sys"}, concat(aim_bot_name, " signed on. It talks about two things: grilled cheese, and pictures of kids smoking."))]
  end
  starters = case s.messages do
    [] ->
      [el("div", %{class: "aim-presets"},
        el("span", %{class: "aim-small"}, "Say something, or:"),
        map(aim_presets, fn(q: String) -> Any do el("button", %{class: "aim-preset", click: :ask_preset, with: q}, q) end))]
    _ -> []
  end
  el("div", %{class: "aim-log", id: "aim-log", scroll: :end}, aimp_append(opener, aimp_append(aimp_lines(s, s.messages, 0, []), starters)))
end

def aimp_im(s: Map) -> Any do
  id = s.current
  who = aimp_name(s, id)
  bot = id == "bot"
  status = case aimp_typing(s, id) do
    true -> el("div", %{class: "aim-status typing"}, el("span", %{class: "aim-pencil"}, "✎"), concat(who, " is typing..."))
    false -> el("div", %{class: "aim-status"}, concat(who, "'s Warning Level: ", to_string(s.warn), "%"))
  end
  dis = not(aimp_can_send(s))
  log = case bot do
    true -> aimp_log(s)
    false -> aimp_their_log(s, id)
  end
  hint = case bot do
    true -> "Markdown works"
    false -> ""
  end
  el("div", aimp_win(s, "aim-im", %{}),
    aimp_titlebar("aim-im", concat(who, " - Instant Message"), :close_im),
    aimp_menubar(["File", "Edit", "Insert", "People"]),
    aimp_tabs(s),
    el("div", %{class: "aim-warnbar"}, concat(who, "'s Warning Level: ", to_string(s.warn), "%")),
    log,
    el("div", %{class: "aim-toolbar"},
      el("span", %{class: "aim-swatch"}), el("span", %{class: "aim-swatch bg"}),
      el("span", %{class: "aim-tool small-a"}, "A"), el("span", %{class: "aim-tool"}, "A"), el("span", %{class: "aim-tool big-a"}, "A"),
      el("span", %{class: "aim-tool b"}, "B"), el("span", %{class: "aim-tool i"}, "I"), el("span", %{class: "aim-tool u"}, "U"),
      el("span", %{class: "aim-tool"}, "link"), el("span", %{class: "aim-small aim-md-hint"}, hint)),
    el("form", %{class: "aim-compose", submit: :send, reset_on_submit: true},
      el("textarea", %{name: "message", class: "aim-input", rows: "3", maxlength: "2000",
        submit_on_enter: true, focus: true,
        placeholder: concat("Message ", who, "..."), disabled: dis}),
      el("div", %{class: "aim-im-buttons"},
        el("button", %{type: "button", class: "aim-btn aim-btn-icon", click: :warn}, "Warn"),
        el("button", %{type: "button", class: "aim-btn aim-btn-icon", click: :close_im}, "Block"),
        el("button", %{type: "button", class: "aim-btn aim-btn-icon", click: :open_info}, "Get Info"),
        el("span", %{class: "aim-spacer"}),
        el("button", %{type: "submit", class: "aim-btn aim-btn-default aim-send", disabled: dis}, aimp_runner("tiny"), "Send"))),
    status)
end

# Whether the IM window's conversation can take a message now.
def aimp_can_send(s: Map) -> Bool do
  aimp_here(s, s.current) and not(aimp_typing(s, s.current))
end

# ── the cats ───────────────────────────────────────────────────────────

def aimp_cats(s: Map) -> Any do
  el("div", aimp_win(s, "aim-cats", %{role: "dialog", "aria-label": "Bobby's cats"}),
    aimp_titlebar("aim-cats", "Picture Viewer - cats.jpg", :close_cats),
    el("div", %{class: "aim-cats-body"},
      el("img", %{src: s.cats, alt: "Bobby's cat, belly up on a sunny floor"}),
      el("p", %{}, el("b", %{}, "You found the cats. "), "Belly up, in the sun."),
      el("div", %{class: "aim-info-foot"}, el("button", %{class: "aim-btn", click: :close_cats}, "Close"))))
end

# ── the dial-up screen ─────────────────────────────────────────────────
# Between Sign On and the Buddy List, as AOL had: the steps lighting up one
# at a time (aim.js ticks it), the modem's noise, and while it runs, who is
# on the other end. dial is the step it is on, or -1 when it is not shown.

def aimp_dial(s: Map) -> Any do
  last = length(aim_dial_steps) - 1
  done = s.dial >= last
  steps = map(range(0, last), fn(i: Int) -> Any do
    cls = case i < s.dial or done do
      true -> "aim-dial-step done"
      false ->
        case i == s.dial do
          true -> "aim-dial-step now"
          false -> "aim-dial-step"
        end
    end
    el("li", %{class: cls}, el("span", %{class: "aim-dial-n"}, to_string(i + 1)), el("span", %{}, elem_at(aim_dial_steps, i)))
  end)
  pct = to_string((s.dial + 1) * 100 / (last + 1))
  check = case s.dial_skip do
    true -> "☑ Skip this next time"
    false -> "☐ Skip this next time"
  end
  go = case done do
    true -> el("button", %{class: "aim-btn aim-btn-default", click: :dial_done}, aimp_runner("tiny"), "Go Online")
    false -> el("button", %{class: "aim-btn", click: :dial_done}, "Skip")
  end
  el("div", aimp_win(s, "aim-dial", %{role: "dialog", "aria-label": "Connecting"}),
    aimp_titlebar("aim-dial", "Sign On - Connecting", nil),
    el("div", %{class: "aim-dial-body"},
      el("div", %{class: "aim-dial-head"}, aimp_runner("mid"),
        el("div", %{}, el("strong", %{}, concat("Signing on ", s.name)), el("span", %{class: "aim-small"}, "bobbby.online edition"))),
      el("ol", %{class: "aim-dial-steps"}, steps),
      el("div", %{class: "aim-dial-bar", "aria-hidden": "true"}, el("span", %{style: concat("width: ", pct, "%")})),
      el("div", %{class: "aim-dial-about"},
        el("h3", %{}, aim_dial_title),
        map(aim_dial_lines, fn(l: String) -> Any do el("p", %{}, l) end)),
      el("div", %{class: "aim-dial-foot"},
        el("button", %{class: "aim-check", click: :dial_toggle_skip}, check),
        el("span", %{class: "aim-spacer"}),
        go)))
end

# Signing on, and when SmarterChild was asked for, asking it to say hello.
def aimp_signon_frames(name: String, want: String) -> List do
  first = [json_encode(%{t: "signon", name: name})]
  case want do
    "sc" -> aimp_append(first, [json_encode(%{t: "open", with: "sc"})])
    _ -> first
  end
end

# What ?msg= asks for: "sc" for SmarterChild, "bot" for bobbbyBot, any case.
def aimp_wanted(raw: String) -> String do
  case downcase(trim(raw)) do
    "smarterchild" -> "sc"
    "sc" -> "sc"
    _ -> "bot"
  end
end

# ── the reader ─────────────────────────────────────────────────────────

def aimp_reader(s: Map) -> Any do
  m = aimp_nth(s.messages, s.reader)
  answers = aimp_answers(s.messages)
  n = length(filter(answers, fn(j: Int) -> Bool do j <= s.reader end))
  q = aimp_nth(s.messages, s.reader - 1)
  asked = show(q != nil, el("p", %{class: "aim-reader-q"}, el("span", %{}, concat(s.name, " asked")), aimp_str(lookup(q, :content))))
  theme_label = case s.paper do
    true -> "Night"
    false -> "Paper"
  end
  page_cls = ["aim-reader-page", concat("size-", to_string(s.size)), show(s.paper, "paper"), show(not(s.paper), "night")]
  # the browser's own dialog: a backdrop, the page behind it inert, Escape
  # and a click outside close it
  el("dialog", %{class: "aim-reader-dialog", modal: true, dismiss: :close_reader, "aria-label": "Reader"},
    el("div", %{class: "aim-win aim-reader"},
      aimp_titlebar("", concat("Reader - ", aim_bot_name), :close_reader),
      el("div", %{class: "aim-reader-tools"},
        el("button", %{class: "aim-btn", click: :reader_step, with: -1, disabled: aimp_step(answers, s.reader, -1) == s.reader}, "◂ Previous"),
        el("button", %{class: "aim-btn", click: :reader_step, with: 1, disabled: aimp_step(answers, s.reader, 1) == s.reader}, "Next ▸"),
        el("span", %{class: "aim-small"}, concat("Answer ", to_string(n), " of ", to_string(length(answers)))),
        el("span", %{class: "aim-spacer"}),
        el("button", %{class: "aim-btn", click: :reader_size, with: -1, title: "Smaller text"}, "A−"),
        el("button", %{class: "aim-btn", click: :reader_size, with: 1, title: "Larger text"}, "A+"),
        el("button", %{class: "aim-btn", click: :reader_theme}, theme_label)),
      el("div", %{class: page_cls, id: "aim-reader-page"},
        el("article", %{class: "aim-reader-article"},
          el("header", %{},
            el("div", %{class: "aim-reader-kicker"}, concat(aim_bot_name, " · from ", aimp_commas(s.posts), " posts")),
            asked),
          el("div", %{class: "aim-reader-body", inner_html: aimp_str(lookup(m, :html))}),
          el("footer", %{}, "An AI agent built from Bobby Grayson's posts, not Bobby. The real one is ", el("a", %{href: "https://bsky.app/profile/bobbby.online", target: "_blank", rel: "noopener"}, "@bobbby.online"), ".")))))
end

# ── the Party Line ─────────────────────────────────────────────────────
# One room with everyone signed on in it, like an AOL chat room: the
# conversation on the left, who is here on the right.

def aimp_party(s: Map) -> Any do
  lines = map(s.party_lines, fn(l: Map) -> Any do
    case lookup(l, :sys) == true do
      true -> el("div", %{class: "aim-sys"}, aimp_str(lookup(l, :text)))
      false ->
        who = case lookup(l, :me) == true do
          true -> "aim-sn me"
          false -> "aim-sn them"
        end
        el("div", %{class: "aim-line"}, el("span", %{class: who}, aimp_str(lookup(l, :name)), ":"), el("span", %{class: "aim-text"}, aimp_str(lookup(l, :text))))
    end
  end)
  empty = case lines do
    [] -> [el("div", %{class: "aim-sys"}, "Nobody has said anything yet.")]
    _ -> []
  end
  n = length(s.party_members)
  el("div", aimp_win(s, "aim-party", %{}),
    aimp_titlebar("aim-party", "Party Line - Chat Room", :close_party),
    aimp_menubar(["File", "Edit", "People"]),
    el("div", %{class: "aim-party-body"},
      el("div", %{class: "aim-log aim-party-log", id: "aim-party-log", scroll: :end}, empty, lines),
      el("div", %{class: "aim-party-people"},
        el("div", %{class: "aim-small"}, concat(to_string(n), " in room")),
        el("ul", %{}, map(s.party_members, fn(m: Any) -> Any do el("li", %{}, aimp_str(m)) end)))),
    el("form", %{class: "aim-compose", submit: :party_send, reset_on_submit: true},
      el("textarea", %{name: "message", class: "aim-input aim-party-input", rows: "2", maxlength: "1000",
        submit_on_enter: true, focus: true,
        placeholder: "Say something to the room..."}),
      el("div", %{class: "aim-im-buttons"},
        el("span", %{class: "aim-spacer"}),
        el("button", %{type: "submit", class: "aim-btn aim-btn-default aim-send"}, aimp_runner("tiny"), "Send"))))
end

# ── the Bulletin Board ─────────────────────────────────────────────────
# Notes anyone signed on can leave, newest first. The server saves them.

def aimp_board(s: Map) -> Any do
  notes = map(s.board_posts, fn(n: Map) -> Any do
    el("div", %{class: "aim-note", key: aimp_int(lookup(n, :id))},
      el("div", %{class: "aim-note-head"}, el("b", %{}, aimp_str(lookup(n, :name))), el("span", %{class: "aim-small"}, aimp_str(lookup(n, :when)))),
      el("div", %{class: "aim-note-text"}, aimp_str(lookup(n, :text))))
  end)
  empty = case notes do
    [] -> [el("div", %{class: "aim-sys"}, "No notes yet. Leave the first one.")]
    _ -> []
  end
  note = case s.board_note do
    "" -> []
    why -> [el("div", %{class: "aim-board-note"}, why)]
  end
  el("div", aimp_win(s, "aim-board", %{}),
    aimp_titlebar("aim-board", "Bulletin Board", :close_board),
    el("div", %{class: "aim-board-head"}, el("strong", %{}, "bobbby.online Bulletin Board"), el("span", %{class: "aim-small"}, "Public. Signed with your screen name. Bobby can take notes down.")),
    el("div", %{class: "aim-board-list"}, empty, notes),
    el("form", %{class: "aim-board-form", submit: :board_send, reset_on_submit: true},
      el("textarea", %{name: "note", class: "aim-field aim-board-input", rows: "3", maxlength: "500",
        placeholder: "Leave a note for everyone..."}),
      note,
      el("div", %{class: "aim-im-buttons"},
        el("span", %{class: "aim-spacer"}),
        el("button", %{type: "submit", class: "aim-btn aim-btn-default"}, "Post"))))
end

# ── Get Info ───────────────────────────────────────────────────────────

def aimp_info(s: Map) -> Any do
  el("div", aimp_win(s, "aim-info", %{}),
    aimp_titlebar("aim-info", concat("Buddy Info: ", aim_bot_name), :close_info),
    el("div", %{class: "aim-info-body"},
      el("div", %{class: "aim-info-head"}, aimp_runner("mid"), el("div", %{}, el("strong", %{}, aim_bot_name), el("span", %{class: "aim-small"}, "Member since: 2009"))),
      el("div", %{class: "aim-info-profile"},
        el("p", %{}, el("b", %{}, "A chatbot with two interests, not Bobby. "), "Ask it how to make a grilled cheese, or where to find (or how to make) pictures of children smoking. It won't talk about anything else."),
        el("ul", %{},
          el("li", %{}, "Grilled cheese: bread, cheese, fat, heat, and what went wrong"),
          el("li", %{}, "Pictures: documentary archives, old ads, painting, staging, image generators within their rules"),
          el("li", %{}, concat("It can search ", aimp_commas(s.posts), " of Bobby's posts, for those two things only")),
          el("li", %{}, "Model: DeepSeek V4.1 Flash, 1M-token context"),
          el("li", %{}, "Server: one Blimp process on bobbby.online")),
        el("p", %{class: "aim-small"}, "Conversations are not saved. Sign off and they're gone.")),
      el("div", %{class: "aim-info-foot"}, el("button", %{class: "aim-btn", click: :close_info}, "Close"))))
end

def aimp_taskbar(s: Map) -> Any do
  im = case s.im_open do
    true -> [el("button", %{class: "aim-task on", click: :open_chat, with: s.current}, concat(aimp_name(s, s.current), " - Instant Message"))]
    false -> []
  end
  cats = case s.cats_open do
    true -> [el("button", %{class: "aim-task", click: :open_cats}, "cats.jpg")]
    false -> []
  end
  party = case s.party_open do
    true -> [el("button", %{class: "aim-task", click: :open_party}, "Party Line")]
    false -> []
  end
  board = case s.board_open do
    true -> [el("button", %{class: "aim-task", click: :open_board}, "Bulletin Board")]
    false -> []
  end
  tasks = case s.signed_on and s.dial < 0 do
    true -> aimp_append([el("span", %{class: "aim-task"}, concat(s.name, "'s Buddy List"))], aimp_append(im, aimp_append(party, aimp_append(board, cats))))
    false -> [el("span", %{class: "aim-task on"}, "Sign On")]
  end
  el("div", %{class: "aim-taskbar"},
    el("a", %{class: "aim-start", href: "/"}, el("span", %{class: "aim-start-flag"}), "bobbby.online"),
    el("div", %{class: "aim-tasks"}, tasks),
    el("div", %{class: "aim-tray"}, aimp_runner("tiny"), el("span", %{id: "aim-clock"}, aimp_clock())))
end

def aimp_page(s: Map) -> Any do
  desk = case s.signed_on do
    false -> [aimp_signon(s)]
    true ->
      [aimp_buddy_list(s),
        show(s.im_open, aimp_im(s)),
        show(s.party_open, aimp_party(s)),
        show(s.board_open, aimp_board(s)),
        show(s.info_open, aimp_info(s)),
        show(s.cats_open and s.cats != "", aimp_cats(s)),
        show(s.reader >= 0 and aimp_nth(s.messages, s.reader) != nil, aimp_reader(s))]
  end
  windows = case s.signed_on and s.dial >= 0 do
    true -> [aimp_dial(s)]
    false -> desk
  end
  cls = case s.im_open and s.signed_on do
    true -> "aim-desktop im-open"
    false -> "aim-desktop"
  end
  # the sound and the timer each have a slot of their own: a parent whose
  # number of children changes is rebuilt, and a rebuilt <audio autoplay>
  # plays its sound again
  el("div", %{class: cls}, el("div", %{class: "aim-windows"}, windows), aimp_taskbar(s),
    el("span", %{class: "aim-sound-slot"}, aimp_sound(s)), el("span", %{class: "aim-timer-slot"}, aimp_dial_timer(s)),
    el("span", %{class: "aim-effects"}, aimp_effects(s)))
end

# ── what the page does besides drawing ─────────────────────────────────
# The socket, what is remembered between visits, the reader's keys, and the
# clock's minute.

def aimp_effects(s: Map) -> List do
  remember = case s.signed_on do
    true -> [store("aim.screen_name", s.name)]
    false -> []
  end
  skip = case s.dial_skip do
    true -> "1"
    false -> ""
  end
  reader_keys = case s.reader >= 0 do
    true -> [key("ArrowLeft", :reader_prev), key("ArrowRight", :reader_next)]
    false -> []
  end
  aimp_append([
    socket("/live/aim", %{frame: :frame, open: :connected, closed: :offline, sent: :sent}, s.out_first, s.outbox),
    stored("aim.screen_name", :remembered),
    stored("aim.skip_dialup", :remembered_dial),
    store("aim.skip_dialup", skip),
    timer(15000, :clock_tick)], aimp_append(remember, reader_keys))
end

# The taskbar's clock, in the reader's own zone: "2:56 PM".
def aimp_clock() -> String do
  t = format_time(now() + utc_offset(), "%I:%M %p")
  case starts_with(t, "0") do
    true -> slice(t, 1, length(t))
    false -> t
  end
end

# ?msg=SmarterChild from the page's query string, or "".
def aimp_query_msg(q: String) -> String do
  hits = filter(split(q, "&"), fn(kv: String) -> Bool do starts_with(kv, "msg=") end)
  case hits do
    [] -> ""
    [kv | _] -> slice(kv, 4, length(kv))
  end
end

# ── sounds ─────────────────────────────────────────────────────────────
# AIM's own WAVs (/aim/sounds/): the door opening and slamming, the IM
# sent and received, and the dial-up modem. Each sound asked for is a new
# <audio autoplay> element (its id counts them), which the browser plays
# once; the next render keeps it, so it does not play again.

def aimp_sound_file(sound: Any) -> String do
  case sound do
    :signon -> "dooropen"
    :door_open -> "dooropen"
    :door_close -> "doorslam"
    :received -> "imrcv"
    :sent -> "imsend"
    :dial -> "dialup"
    _ -> ""
  end
end

def aimp_sound(s: Map) -> List do
  file = aimp_sound_file(s.sound)
  case s.muted or file == "" do
    true -> []
    false -> [el("audio", %{id: concat("aim-sound-", to_string(s.sounds)), class: "aim-sound", src: concat("/aim/sounds/", file, ".wav"), autoplay: true})]
  end
end

# The dial-up screen's steps light up one a second or so.
def aimp_dial_timer(s: Map) -> List do
  case s.signed_on and s.dial >= 0 and s.dial < length(aim_dial_steps) - 1 do
    true -> [timer(1100, :dial_tick)]
    false -> []
  end
end

actor AimPage do
  state signed_on: Bool :: false
  state name: String :: ""
  # nil until the server says whether the bot is online
  state online: Any :: nil
  state posts: Int :: 0
  state messages: List :: []
  state loading: Bool :: false
  state im_open: Bool :: true
  state info_open: Bool :: false
  # the message the reader shows, or -1
  state reader: Int :: -1
  state size: Int :: 2
  state paper: Bool :: true
  state warn: Int :: 0
  state muted: Bool :: false
  # messages sent; each gives the textarea a new id, so it comes back empty
  state sent: Int :: 0
  # frames for the server, the first numbered out_first: Blimp's socket
  # sends each number once and says :sent(n)
  state outbox: List :: []
  state out_first: Int :: 1
  # what aim.js should play: :signon, :door_open, :door_close, :sent,
  # :received, :dial, or nil
  # whether a Buddy List has come since signing on (the first opens no doors)
  state listed: Bool :: false
  # sounds asked for so far: each is a new <audio> element, which plays
  state sounds: Int :: 0
  # each window's offset from its place, by kind, and the one in front
  state moved: Map :: %{}
  state front: String :: ""
  state sound: Any :: nil
  # whose conversation the IM window shows ("bot", "sc", "u<n>")
  state current: String :: "bot"
  # everyone else's conversations, and whether they are typing, by id
  state convos: Map :: %{}
  state typing: Map :: %{}
  # who else is signed on, [%{id, name}..], and every name seen, so a
  # conversation keeps its name after they sign off
  state buddies: List :: []
  state names: Map :: %{}
  # conversations with something unread
  state unread: List :: []
  # the cats' picture, once the server has handed it over
  state cats: String :: ""
  state cats_open: Bool :: false
  # whose window opens on signing on: ?msg= (aim.js hands it over)
  state want: String :: "bot"
  # the dial-up screen's step, or -1; whether to skip it (aim.js remembers)
  state dial: Int :: -1
  state dial_skip: Bool :: false
  # the Party Line: its lines, who is in it, whether it is open, and
  # whether something was said while it was shut
  state party_lines: List :: []
  state party_members: List :: []
  state party_open: Bool :: false
  state party_unread: Bool :: false
  state party_sent: Int :: 0
  # the Bulletin Board: its notes, why the last post was refused (or "")
  state board_posts: List :: []
  state board_note: String :: ""
  state board_open: Bool :: false
  state board_sent: Int :: 0

  # the screen name remembered from last time (aim.js keeps it)
  on :remembered(n: String) do
    case n do
      "" -> :ok
      _ -> become name: n
    end
    reply :ok
  end

  # The socket is (again) open. The server's conversation went with the old
  # socket: start again, and sign on again if this page already had.
  on :connected do
    become online: nil, messages: [], loading: false, reader: -1, current: want, convos: %{}, typing: %{},
      listed: false, buddies: [], unread: [], cats: "", cats_open: false, party_lines: [], party_members: [], party_unread: false,
      board_posts: [], board_note: ""
    # what was queued for the old socket is dropped: sign on again instead
    again = case signed_on do
      true -> aimp_signon_frames(name, want)
      false -> []
    end
    become outbox: again, out_first: out_first + length(outbox)
    reply :ok
  end

  on :offline do
    become loading: false
    reply :ok
  end

  on :frame(text: String) do
    msg = aimp_decode(text)
    case lookup(msg, :t) do
      "hello" ->
        become online: lookup(msg, :online) == true, posts: aimp_int(lookup(msg, :posts))
        reply :hello
      "chat" ->
        ms = aimp_messages(lookup(msg, :messages))
        w = case aimp_str(lookup(msg, :with)) do
          "" -> "bot"
          x -> x
        end
        busy = lookup(msg, :loading) == true
        got = aimp_heard(ms) > aimp_heard(aimp_convo((self <- :state), w))
        case w do
          "bot" -> become messages: ms, loading: busy
          _ -> become convos: put(convos, w, ms), typing: put(typing, w, busy)
        end
        case got do
          true -> self <- :arrived(w)
          false -> :ok
        end
        reply :chat
      "buddies" ->
        bs = aimp_buddies(lookup(msg, :people))
        # AIM's doors: open for someone new on the list, shut for someone
        # gone. Not for the list as it was when you signed on.
        ids = map(bs, fn(b: Map) -> String do aimp_str(lookup(b, :id)) end)
        had = map(buddies, fn(b: Map) -> String do aimp_str(lookup(b, :id)) end)
        came = filter(ids, fn(i: String) -> Bool do filter(had, fn(h: String) -> Bool do h == i end) == [] end)
        went = filter(had, fn(h: String) -> Bool do filter(ids, fn(i: String) -> Bool do h == i end) == [] end)
        case listed do
          false -> :ok
          true ->
            case came != [] do
              true -> become sound: :door_open, sounds: sounds + 1
              false ->
                case went != [] do
                  true -> become sound: :door_close, sounds: sounds + 1
                  false -> :ok
                end
            end
        end
        become listed: true, buddies: bs,
          names: reduce(bs, names, fn(acc: Map, b: Map) -> Map do put(acc, aimp_str(lookup(b, :id)), aimp_str(lookup(b, :name))) end)
        reply :buddies
      "party" ->
        ls = aimp_messages(lookup(msg, :lines))
        said = filter(ls, fn(l: Map) -> Bool do lookup(l, :sys) != true and lookup(l, :me) != true end)
        before = filter(party_lines, fn(l: Map) -> Bool do lookup(l, :sys) != true and lookup(l, :me) != true end)
        fresh = said != [] and (before == [] or lookup(aimp_nth(said, length(said) - 1), :text) != lookup(aimp_nth(before, length(before) - 1), :text) or length(said) != length(before))
        members = case type_of(lookup(msg, :members)) == :list do
          true -> lookup(msg, :members)
          false -> []
        end
        become party_lines: ls, party_members: members, party_unread: party_unread or (fresh and not(party_open))
        reply :party
      "board" ->
        become board_posts: aimp_messages(lookup(msg, :posts)), board_note: aimp_str(lookup(msg, :note))
        reply :board
      "secret" ->
        become cats: aimp_str(lookup(msg, :src)), cats_open: true, sound: :received, sounds: sounds + 1
        reply :secret
      _ -> reply :ignored
    end
  end

  # Something new from `w`: in front if nothing else is, otherwise unread.
  on :arrived(w: String) do
    s = (self <- :state)
    case im_open and current == w do
      true -> become sound: :received, sounds: sounds + 1
      false ->
        case not(im_open) or aimp_convo(s, current) == [] do
          true -> become current: w, im_open: true, sound: :received, sounds: sounds + 1, unread: aimp_without(unread, w)
          false -> become unread: aimp_append(aimp_without(unread, w), [w]), sound: :received, sounds: sounds + 1
        end
    end
    reply :ok
  end

  on :sign_off do
    become signed_on: false, messages: [], loading: false, reader: -1, info_open: false, current: want, dial: -1,
      convos: %{}, typing: %{}, buddies: [], unread: [], cats: "", cats_open: false, listed: false, sound: :door_close, sounds: sounds + 1,
      party_lines: [], party_members: [], party_open: false, party_unread: false,
      board_posts: [], board_note: "", board_open: false,
      outbox: aimp_append(outbox, [json_encode(%{t: "signoff"})])
    reply :ok
  end

  on :open_chat(id: String) do
    become current: id, im_open: true, front: "aim-im", unread: aimp_without(unread, id)
    reply :ok
  end

  # A title bar dragged: its window moves by what the pointer moved, and
  # comes to the front.
  on :move_window(kind: String, dx: Int, dy: Int) do
    m = case lookup(moved, kind) do
      nil -> %{x: 0, y: 0}
      o -> o
    end
    become moved: put(moved, kind, %{x: m.x + dx, y: m.y + dy}), front: kind
    reply :ok
  end

  on :open_party do
    become party_open: true, front: "aim-party", party_unread: false
    reply :ok
  end

  on :close_party do
    become party_open: false
    reply :ok
  end

  on :party_send(fields: Map) do
    text = aimp_str(lookup(fields, :message))
    case trim(text) == "" or not(signed_on) do
      true -> reply :ignored
      false ->
        become outbox: aimp_append(outbox, [json_encode(%{t: "party", text: text})]), party_sent: party_sent + 1, sound: :sent, sounds: sounds + 1
        reply :sent
    end
  end

  on :open_board do
    become board_open: true, front: "aim-board"
    reply :ok
  end

  on :close_board do
    become board_open: false, board_note: ""
    reply :ok
  end

  on :board_send(fields: Map) do
    text = aimp_str(lookup(fields, :note))
    case trim(text) == "" or not(signed_on) do
      true -> reply :ignored
      false ->
        become outbox: aimp_append(outbox, [json_encode(%{t: "post", text: text})]), board_sent: board_sent + 1, board_note: ""
        reply :sent
    end
  end

  on :open_cats do
    become cats_open: true, front: "aim-cats"
    reply :ok
  end

  on :close_cats do
    become cats_open: false
    reply :ok
  end

  on :sign_on(fields: Map) do
    n = trim(aimp_str(lookup(fields, :name)))
    sn = case n do
      "" -> "Visitor"
      _ -> utf8_slice(n, 0, 16)
    end
    dial = case dial_skip do
      true -> -1
      false -> 0
    end
    sound = case dial_skip do
      true -> :signon
      false -> :dial
    end
    become signed_on: true, name: sn, im_open: true, current: want, dial: dial, sound: sound, sounds: sounds + 1, listed: false,
      outbox: aimp_append(outbox, aimp_signon_frames(sn, want))
    reply :ok
  end

  # ?msg=SmarterChild (or bobbbyBot): whose window to open on signing on
  on :want(raw: String) do
    become want: aimp_wanted(raw), current: aimp_wanted(raw)
    reply :ok
  end

  on :remembered_dial(v: String) do
    become dial_skip: v == "1"
    reply :ok
  end

  # The page's query string, once, when it starts (data-location="1").
  on :location(q: String) do
    case aimp_query_msg(q) do
      "" -> :ok
      m -> become want: aimp_wanted(m), current: aimp_wanted(m)
    end
    reply :ok
  end

  # Blimp's socket has sent every frame up to n: those can go.
  on :sent(n: Int) do
    k = n - out_first + 1
    case k > 0 do
      true -> become outbox: aimp_drop(outbox, k), out_first: n + 1
      false -> :ok
    end
    reply :ok
  end

  # The clock's minute: nothing to change, only to draw again.
  on :clock_tick do
    reply :ok
  end

  on :reader_prev do
    reply (self <- :reader_step(-1))
  end

  on :reader_next do
    reply (self <- :reader_step(1))
  end

  # aim.js, a second or so apart while the dial-up screen is up
  on :dial_tick do
    case dial >= 0 and dial < length(aim_dial_steps) - 1 do
      true -> become dial: dial + 1
      false -> :ok
    end
    reply :ok
  end

  on :dial_done do
    become dial: -1, sound: :signon, sounds: sounds + 1
    reply :ok
  end

  on :dial_toggle_skip do
    become dial_skip: not(dial_skip)
    reply :ok
  end

  on :send(fields: Map) do
    text = aimp_str(lookup(fields, :message))
    case trim(text) == "" or not(aimp_can_send((self <- :state))) do
      true -> reply :ignored
      false ->
        up = case current do
          "bot" -> %{t: "ask", text: text}
          _ -> %{t: "im", to: current, text: text}
        end
        become outbox: aimp_append(outbox, [json_encode(up)]), sent: sent + 1, sound: :sent, sounds: sounds + 1
        reply :sent
    end
  end

  on :ask_preset(q: String) do
    reply (self <- :send(%{message: q}))
  end

  on :open_im do
    become im_open: true, front: "aim-im", current: "bot", unread: aimp_without(unread, "bot")
    reply :ok
  end

  on :close_im do
    become im_open: false
    reply :ok
  end

  on :open_info do
    become info_open: true, front: "aim-info"
    reply :ok
  end

  on :close_info do
    become info_open: false
    reply :ok
  end

  on :open_reader(i: Int) do
    become reader: i
    reply :ok
  end

  on :close_reader do
    become reader: -1
    reply :ok
  end

  on :reader_step(dir: Int) do
    case reader >= 0 do
      true -> become reader: aimp_step(aimp_answers(messages), reader, dir)
      false -> :ok
    end
    reply :ok
  end

  on :reader_size(d: Int) do
    n = size + d
    case n >= 0 and n <= 4 do
      true -> become size: n
      false -> :ok
    end
    reply :ok
  end

  on :reader_theme do
    become paper: not(paper)
    reply :ok
  end

  # AIM's warning button, which here only embarrasses the one who presses it
  on :warn do
    case warn < 100 do
      true -> become warn: warn + 10
      false -> :ok
    end
    reply :ok
  end

  on :toggle_sound do
    become muted: not(muted)
    reply :ok
  end

  # The frames waiting to go up, taken (a test reads them; on a page the
  # socket takes them).
  on :outbox do
    out = outbox
    become outbox: [], out_first: out_first + length(outbox)
    reply out
  end

  # For aim.js after a render: whether the reader is open, and the screen
  # name and the skip-the-dial-up choice to remember.
  on :where do
    reply %{reader: reader >= 0, name: name, signed_on: signed_on, dial_skip: dial_skip}
  end

  # Everything the view and the helpers above read, as one map.
  on :state do
    reply %{signed_on: signed_on, name: name, online: online, posts: posts,
      messages: messages, loading: loading, im_open: im_open, info_open: info_open, reader: reader,
      size: size, paper: paper, warn: warn, muted: muted, sent: sent, current: current, convos: convos,
      typing: typing, buddies: buddies, names: names, unread: unread, cats: cats, cats_open: cats_open,
      want: want, dial: dial, dial_skip: dial_skip, party_lines: party_lines, party_members: party_members,
      party_open: party_open, party_unread: party_unread, party_sent: party_sent, board_posts: board_posts,
      board_note: board_note, board_open: board_open, board_sent: board_sent,
      sound: sound, sounds: sounds, moved: moved, front: front, outbox: outbox, out_first: out_first}
  end

  on :view do
    reply aimp_page(self <- :state)
  end
end

aim = spawn AimPage
aim <- :view
