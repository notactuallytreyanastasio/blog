# /aim: the page's program. It draws a desktop from about 2003 -- the
# sign-on window, the Buddy List, an Instant Message window, Get Info --
# and one thing AIM never had: a reader view, because bobbbyBot answers in
# Markdown and a long answer deserves a page, not a chat bubble.
#
# The conversations are not here, only their pictures. The server's AIM
# actor (src/99_aim.blimp) holds them: bobbbyBot's, which it asks DeepSeek
# about; SmarterChild's, a script; and one with each other person signed
# on, whose names come in a "buddies" frame. The IM window shows one at a
# time, with a tab for each when there is more than one.
# aim.js holds the socket
# to /live/aim, hands this program every frame (`:frame`) and each
# (re)connection (`:connected`), sends up what `:outbox` returns after
# every render, and plays the sounds `:where` says are wanted.

def aimp_decode(text: String) -> Map do
  case json_decode(text) do
    {:ok, m} ->
      case type_of(m) == :map do
        true -> m
        false -> %{}
      end
    _ -> %{}
  end
end

def aimp_str(v: Any) -> String do
  case type_of(v) == :string do
    true -> v
    false -> ""
  end
end

def aimp_int(v: Any) -> Int do
  case type_of(v) == :integer do
    true -> v
    false -> 0
  end
end

def aimp_messages(v: Any) -> List do
  case type_of(v) == :list do
    true -> filter(v, fn(m: Any) -> Bool do type_of(m) == :map end)
    false -> []
  end
end

def aimp_append(a: List, b: List) -> List do
  reduce(reverse(a), b, fn(acc: List, x: Any) -> List do [x | acc] end)
end

def aimp_nth(list: List, i: Int) -> Any do
  case list do
    [] -> nil
    [x | rest] ->
      case i do
        0 -> x
        _ -> aimp_nth(rest, i - 1)
      end
  end
end

# 75344 -> "75,344"
def aimp_commas(n: Int) -> String do
  s = to_string(n)
  case length(s) > 3 do
    false -> s
    true -> concat(aimp_commas(n / 1000), ",", slice(s, length(s) - 3, length(s)))
  end
end

# The indexes of the bot's answers, in order: what the reader pages through.
def aimp_answers(ms: List) -> List do
  reverse(elem(reduce(ms, {[], 0}, fn(acc: Tuple, m: Map) -> Tuple do
    i = elem(acc, 1)
    case aimp_str(lookup(m, :role)) do
      "assistant" -> {[i | elem(acc, 0)], i + 1}
      _ -> {elem(acc, 0), i + 1}
    end
  end), 0))
end

# The answer before or after `i` (-1 for before, 1 for after), or i.
def aimp_step(answers: List, i: Int, dir: Int) -> Int do
  pick = case dir < 0 do
    true -> filter(reverse(answers), fn(j: Int) -> Bool do j < i end)
    false -> filter(answers, fn(j: Int) -> Bool do j > i end)
  end
  case pick do
    [] -> i
    [j | _] -> j
  end
end

# A reply worth a page: long, or shaped like a document.
def aimp_long(content: String) -> Bool do
  length(content) > 420 or contains(content, "\n#") or contains(content, "```") or contains(content, "\n- ") or contains(content, "\n1. ")
end

# ── whose conversation ─────────────────────────────────────────────────
# "bot" is bobbbyBot, "sc" SmarterChild, "u<n>" a person.

def aimp_convo(s: Map, id: String) -> List do
  case id do
    "bot" -> s.messages
    _ ->
      case lookup(s.convos, id) do
        nil -> []
        ms -> ms
      end
  end
end

def aimp_name(s: Map, id: String) -> String do
  case id do
    "bot" -> aim_bot_name
    "sc" -> "SmarterChild"
    _ ->
      case lookup(s.names, id) do
        nil -> "Somebody"
        n -> aimp_str(n)
      end
  end
end

def aimp_here(s: Map, id: String) -> Bool do
  case id do
    "bot" -> s.online == true
    "sc" -> s.sc_on
    _ -> filter(s.buddies, fn(b: Map) -> Bool do aimp_str(lookup(b, :id)) == id end) != []
  end
end

def aimp_typing(s: Map, id: String) -> Bool do
  case id do
    "bot" -> s.loading
    _ -> lookup(s.typing, id) == true
  end
end

# what the other side has said in a conversation
def aimp_heard(ms: List) -> Int do
  length(filter(ms, fn(m: Map) -> Bool do aimp_str(lookup(m, :role)) != "user" end))
end

def aimp_without(list: List, x: Any) -> List do
  filter(list, fn(y: Any) -> Bool do y != x end)
end

def aimp_buddies(v: Any) -> List do
  filter(aimp_messages(v), fn(b: Map) -> Bool do aimp_str(lookup(b, :id)) != "" end)
end

# ── window chrome ──────────────────────────────────────────────────────

def aimp_titlebar(title: String, close: Any) -> Any do
  x = case close do
    nil -> el("span", %{class: "aim-tb-btn dead"}, "×")
    msg -> el("button", %{class: "aim-tb-btn", click: msg, title: "Close"}, "×")
  end
  el("div", %{class: "aim-titlebar"},
    el("span", %{class: "aim-tb-icon"}),
    el("span", %{class: "aim-tb-title"}, title),
    el("span", %{class: "aim-tb-btns"},
      el("span", %{class: "aim-tb-btn dead"}, "_"),
      el("span", %{class: "aim-tb-btn dead"}, "□"),
      x))
end

def aimp_menubar(items: List) -> Any do
  el("div", %{class: "aim-menubar"}, map(items, fn(t: String) -> Any do el("span", %{}, t) end))
end

# The yellow running figure, drawn here rather than borrowed.
def aimp_runner(cls: String) -> Any do
  el("span", %{class: concat("aim-runner ", cls), inner_html: "<svg viewBox=\"0 0 32 40\" aria-hidden=\"true\"><circle cx=\"19\" cy=\"6\" r=\"5\"/><path d=\"M17 12 L9 20 L3 18 M17 12 L14 25 L22 31 L20 39 M14 25 L7 33 L1 32 M16 15 L25 19 L30 15\" fill=\"none\" stroke-width=\"4.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"})
end

# ── sign on ────────────────────────────────────────────────────────────

def aimp_signon(s: Map) -> Any do
  el("div", %{class: "aim-win aim-signon"},
    aimp_titlebar("Sign On", nil),
    el("div", %{class: "aim-signon-body"},
      el("div", %{class: "aim-signon-logo"}, aimp_runner("big"),
        el("div", %{class: "aim-wordmark"}, el("strong", %{}, "AIM"), el("span", %{}, "bobbby.online edition"))),
      el("form", %{class: "aim-signon-form", submit: :sign_on},
        el("label", %{"for": "aim-sn"}, "Screen Name"),
        el("input", %{id: "aim-sn", name: "name", class: "aim-field", value: s.name, maxlength: "16", autocomplete: "nickname", placeholder: "Visitor"}),
        el("label", %{"for": "aim-pw"}, "Password"),
        el("input", %{id: "aim-pw", class: "aim-field", type: "password", disabled: true, placeholder: "not needed"}),
        el("div", %{class: "aim-signon-row"},
          el("span", %{class: "aim-small"}, "No account? Make up a name."),
          el("button", %{type: "submit", class: "aim-btn aim-btn-default"}, aimp_runner("tiny"), "Sign On"))),
      el("div", %{class: "aim-small aim-signon-foot"}, "Version 5.9.blimp")))
end

# ── the Buddy List ─────────────────────────────────────────────────────

def aimp_buddy(name: String, cls: String, click: Any, note: String) -> Any do
  attrs = case click do
    nil -> %{class: concat("aim-buddy ", cls)}
    msg -> %{class: concat("aim-buddy ", cls), click: msg}
  end
  el("div", attrs, el("span", %{class: "aim-buddy-name"}, name), el("span", %{class: "aim-buddy-note"}, note))
end

# A buddy whose conversation a click opens; bold until it is read.
def aimp_buddy_to(s: Map, id: String) -> Any do
  unread = filter(s.unread, fn(u: String) -> Bool do u == id end) != []
  cls = case unread do
    true -> "aim-buddy online unread"
    false -> "aim-buddy online"
  end
  note = case unread do
    true -> "(new message)"
    false -> ""
  end
  el("div", %{class: cls, click: :open_chat, with: id}, el("span", %{class: "aim-buddy-name"}, aimp_name(s, id)), el("span", %{class: "aim-buddy-note"}, note))
end

def aimp_buddy_list(s: Map) -> Any do
  bot = case s.online do
    true -> aimp_buddy(aim_bot_name, "online", :open_im, "")
    false -> aimp_buddy(aim_bot_name, "away", :open_im, "(away)")
    nil -> aimp_buddy(aim_bot_name, "idle", nil, "(connecting)")
  end
  bots_on = case s.online do
    false -> 0
    _ -> 1
  end
  sc = case s.sc_on do
    true -> [aimp_buddy_to(s, "sc")]
    false -> []
  end
  online = concat(to_string(bots_on + length(sc)), "/2")
  people = map(s.buddies, fn(b: Map) -> Any do aimp_buddy_to(s, aimp_str(lookup(b, :id))) end)
  nobody = case people do
    [] -> [el("div", %{class: "aim-buddy offline"}, el("span", %{class: "aim-buddy-note"}, "nobody else is signed on"))]
    _ -> []
  end
  cats = case s.cats do
    "" -> []
    _ -> [el("div", %{class: "aim-group"}, "▾ Cats (2/2)"), aimp_buddy("Bobby's cats", "online cats", :open_cats, "")]
  end
  sc_off = case s.sc_on do
    true -> []
    false -> [aimp_buddy("SmarterChild", "offline", nil, "")]
  end
  offline = concat("▾ Offline (", to_string(1 + length(sc_off)), "/", to_string(1 + length(sc_off)), ")")
  muted = case s.muted do
    true -> "Sounds: off"
    false -> "Sounds: on"
  end
  el("div", %{class: "aim-win aim-buddies"},
    aimp_titlebar(concat(s.name, "'s Buddy List"), nil),
    aimp_menubar(["My AIM", "People", "Help"]),
    el("div", %{class: "aim-buddies-brand"}, aimp_runner("mid"), el("div", %{}, el("strong", %{}, "bobbby.online"), el("span", %{}, "Instant Messenger"))),
    el("div", %{class: "aim-buddies-tabs"}, el("span", %{class: "on"}, "Online"), el("span", %{}, "List Setup")),
    el("div", %{class: "aim-buddies-tree"},
      el("div", %{class: "aim-group"}, concat("▾ Buddies (", online, ")")),
      bot,
      sc,
      el("div", %{class: "aim-group"}, concat("▾ Online Now (", to_string(length(people)), ")")),
      people,
      nobody,
      cats,
      el("div", %{class: "aim-group"}, offline),
      el("a", %{class: "aim-buddy offline", href: "https://bsky.app/profile/bobbby.online", target: "_blank", rel: "noopener"}, el("span", %{class: "aim-buddy-name"}, "bobbby (the real one)")),
      sc_off),
    el("div", %{class: "aim-buddies-foot"},
      el("button", %{class: "aim-btn", click: :open_im}, "IM"),
      el("button", %{class: "aim-btn", click: :open_info}, "Info"),
      el("button", %{class: "aim-btn", click: :toggle_sound}, muted),
      el("button", %{class: "aim-btn", click: :sign_off}, "Sign Off")))
end

# ── the IM window ──────────────────────────────────────────────────────

def aimp_line(s: Map, m: Map, i: Int) -> Any do
  role = aimp_str(lookup(m, :role))
  content = aimp_str(lookup(m, :content))
  case role do
    "assistant" ->
      long = aimp_long(content)
      cls = case long do
        true -> "aim-line bot long"
        false -> "aim-line bot"
      end
      more = case long do
        true -> [el("button", %{class: "aim-readmore", click: :open_reader, with: i}, "Open in Reader →")]
        false -> [el("button", %{class: "aim-reader-chip", click: :open_reader, with: i, title: "Open in Reader"}, "¶")]
      end
      el("div", %{class: cls},
        el("span", %{class: "aim-sn bot"}, aim_bot_name, ":"),
        el("div", %{class: "aim-md", inner_html: aimp_str(lookup(m, :html))}),
        more)
    _ ->
      el("div", %{class: "aim-line me"}, el("span", %{class: "aim-sn me"}, s.name, ":"), el("span", %{class: "aim-text"}, content))
  end
end

# A line of SmarterChild's or a person's: their words as text, never HTML.
def aimp_their_line(s: Map, who: String, m: Map) -> Any do
  content = aimp_str(lookup(m, :content))
  case aimp_str(lookup(m, :role)) do
    "user" -> el("div", %{class: "aim-line me"}, el("span", %{class: "aim-sn me"}, s.name, ":"), el("span", %{class: "aim-text"}, content))
    _ -> el("div", %{class: "aim-line them"}, el("span", %{class: "aim-sn bot"}, who, ":"), el("span", %{class: "aim-text"}, content))
  end
end

def aimp_their_log(s: Map, id: String) -> Any do
  who = aimp_name(s, id)
  opener = case id do
    "sc" -> concat(who, " signed on.")
    _ ->
      case aimp_here(s, id) do
        true -> concat(who, " is online.")
        false -> concat(who, " signed off. Messages won't reach them.")
      end
  end
  lines = map(aimp_convo(s, id), fn(m: Map) -> Any do aimp_their_line(s, who, m) end)
  el("div", %{class: "aim-log", id: "aim-log"}, [el("div", %{class: "aim-sys"}, opener) | lines])
end

# A tab for every conversation that has started, when there is more than one.
def aimp_tabs(s: Map) -> Any do
  started = filter(keys(s.convos), fn(k: Any) -> Bool do aimp_convo(s, aimp_str(k)) != [] end)
  ids = uniq(aimp_append(["bot"], aimp_append(map(started, fn(k: Any) -> String do aimp_str(k) end), [s.current])))
  case length(ids) > 1 do
    false -> []
    true ->
      [el("div", %{class: "aim-tabs"}, map(ids, fn(id: String) -> Any do
        unread = filter(s.unread, fn(u: String) -> Bool do u == id end) != []
        cls = case id == s.current do
          true -> "aim-tab on"
          false ->
            case unread do
              true -> "aim-tab unread"
              false -> "aim-tab"
            end
        end
        el("button", %{class: cls, click: :open_chat, with: id}, aimp_name(s, id))
      end))]
  end
end

def aimp_lines(s: Map, ms: List, i: Int, acc: List) -> List do
  case ms do
    [] -> reverse(acc)
    [m | rest] -> aimp_lines(s, rest, i + 1, [aimp_line(s, m, i) | acc])
  end
end

def aimp_log(s: Map) -> Any do
  opener = case s.online do
    false -> [el("div", %{class: "aim-sys"}, concat(aim_bot_name, " is away: \"", aim_away_message, "\". Messages won't be answered right now."))]
    _ -> [el("div", %{class: "aim-sys"}, concat(aim_bot_name, " signed on. It talks about two things: grilled cheese, and pictures of kids smoking."))]
  end
  starters = case s.messages do
    [] ->
      [el("div", %{class: "aim-presets"},
        el("span", %{class: "aim-small"}, "Say something, or:"),
        map(aim_presets, fn(q: String) -> Any do el("button", %{class: "aim-preset", click: :ask_preset, with: q}, q) end))]
    _ -> []
  end
  el("div", %{class: "aim-log", id: "aim-log"}, aimp_append(opener, aimp_append(aimp_lines(s, s.messages, 0, []), starters)))
end

def aimp_im(s: Map) -> Any do
  id = s.current
  who = aimp_name(s, id)
  bot = id == "bot"
  status = case aimp_typing(s, id) do
    true -> el("div", %{class: "aim-status typing"}, el("span", %{class: "aim-pencil"}, "✎"), concat(who, " is typing..."))
    false -> el("div", %{class: "aim-status"}, concat(who, "'s Warning Level: ", to_string(s.warn), "%"))
  end
  dis = not(aimp_can_send(s))
  log = case bot do
    true -> aimp_log(s)
    false -> aimp_their_log(s, id)
  end
  hint = case bot do
    true -> "Markdown works"
    false -> ""
  end
  el("div", %{class: "aim-win aim-im"},
    aimp_titlebar(concat(who, " - Instant Message"), :close_im),
    aimp_menubar(["File", "Edit", "Insert", "People"]),
    aimp_tabs(s),
    el("div", %{class: "aim-warnbar"}, concat(who, "'s Warning Level: ", to_string(s.warn), "%")),
    log,
    el("div", %{class: "aim-toolbar"},
      el("span", %{class: "aim-swatch"}), el("span", %{class: "aim-swatch bg"}),
      el("span", %{class: "aim-tool small-a"}, "A"), el("span", %{class: "aim-tool"}, "A"), el("span", %{class: "aim-tool big-a"}, "A"),
      el("span", %{class: "aim-tool b"}, "B"), el("span", %{class: "aim-tool i"}, "I"), el("span", %{class: "aim-tool u"}, "U"),
      el("span", %{class: "aim-tool"}, "link"), el("span", %{class: "aim-small aim-md-hint"}, hint)),
    el("form", %{class: "aim-compose", submit: :send},
      el("textarea", %{name: "message", id: concat("aim-input-", to_string(s.sent)), class: "aim-input", rows: "3", maxlength: "2000",
        placeholder: concat("Message ", who, "..."), disabled: dis}),
      el("div", %{class: "aim-im-buttons"},
        el("button", %{type: "button", class: "aim-btn aim-btn-icon", click: :warn}, "Warn"),
        el("button", %{type: "button", class: "aim-btn aim-btn-icon", click: :close_im}, "Block"),
        el("button", %{type: "button", class: "aim-btn aim-btn-icon", click: :open_info}, "Get Info"),
        el("span", %{class: "aim-spacer"}),
        el("button", %{type: "submit", class: "aim-btn aim-btn-default aim-send", disabled: dis}, aimp_runner("tiny"), "Send"))),
    status)
end

# Whether the IM window's conversation can take a message now.
def aimp_can_send(s: Map) -> Bool do
  aimp_here(s, s.current) and not(aimp_typing(s, s.current))
end

# ── the cats ───────────────────────────────────────────────────────────

def aimp_cats(s: Map) -> Any do
  el("div", %{class: "aim-win aim-cats", role: "dialog", "aria-label": "Bobby's cats"},
    aimp_titlebar("Picture Viewer - cats.jpg", :close_cats),
    el("div", %{class: "aim-cats-body"},
      el("img", %{src: s.cats, alt: "Bobby's cat, belly up on a sunny floor"}),
      el("p", %{}, el("b", %{}, "You found the cats. "), "Belly up, in the sun."),
      el("div", %{class: "aim-info-foot"}, el("button", %{class: "aim-btn", click: :close_cats}, "Close"))))
end

# ── the reader ─────────────────────────────────────────────────────────

def aimp_reader(s: Map) -> Any do
  m = aimp_nth(s.messages, s.reader)
  answers = aimp_answers(s.messages)
  n = length(filter(answers, fn(j: Int) -> Bool do j <= s.reader end))
  q = aimp_nth(s.messages, s.reader - 1)
  asked = case q == nil do
    true -> []
    false -> [el("p", %{class: "aim-reader-q"}, el("span", %{}, concat(s.name, " asked")), aimp_str(lookup(q, :content)))]
  end
  theme_label = case s.paper do
    true -> "Night"
    false -> "Paper"
  end
  page_cls = case s.paper do
    true -> concat("aim-reader-page size-", to_string(s.size), " paper")
    false -> concat("aim-reader-page size-", to_string(s.size), " night")
  end
  el("div", %{class: "aim-reader-scrim"},
    el("div", %{class: "aim-win aim-reader", role: "dialog", "aria-label": "Reader"},
      aimp_titlebar(concat("Reader - ", aim_bot_name), :close_reader),
      el("div", %{class: "aim-reader-tools"},
        el("button", %{class: "aim-btn", click: :reader_step, with: -1, disabled: aimp_step(answers, s.reader, -1) == s.reader}, "◂ Previous"),
        el("button", %{class: "aim-btn", click: :reader_step, with: 1, disabled: aimp_step(answers, s.reader, 1) == s.reader}, "Next ▸"),
        el("span", %{class: "aim-small"}, concat("Answer ", to_string(n), " of ", to_string(length(answers)))),
        el("span", %{class: "aim-spacer"}),
        el("button", %{class: "aim-btn", click: :reader_size, with: -1, title: "Smaller text"}, "A−"),
        el("button", %{class: "aim-btn", click: :reader_size, with: 1, title: "Larger text"}, "A+"),
        el("button", %{class: "aim-btn", click: :reader_theme}, theme_label)),
      el("div", %{class: page_cls, id: "aim-reader-page"},
        el("article", %{class: "aim-reader-article"},
          el("header", %{},
            el("div", %{class: "aim-reader-kicker"}, concat(aim_bot_name, " · from ", aimp_commas(s.posts), " posts")),
            asked),
          el("div", %{class: "aim-reader-body", inner_html: aimp_str(lookup(m, :html))}),
          el("footer", %{}, "An AI agent built from Bobby Grayson's posts, not Bobby. The real one is ", el("a", %{href: "https://bsky.app/profile/bobbby.online", target: "_blank", rel: "noopener"}, "@bobbby.online"), ".")))))
end

# ── Get Info ───────────────────────────────────────────────────────────

def aimp_info(s: Map) -> Any do
  el("div", %{class: "aim-win aim-info"},
    aimp_titlebar(concat("Buddy Info: ", aim_bot_name), :close_info),
    el("div", %{class: "aim-info-body"},
      el("div", %{class: "aim-info-head"}, aimp_runner("mid"), el("div", %{}, el("strong", %{}, aim_bot_name), el("span", %{class: "aim-small"}, "Member since: 2009"))),
      el("div", %{class: "aim-info-profile"},
        el("p", %{}, el("b", %{}, "A chatbot with two interests, not Bobby. "), "Ask it how to make a grilled cheese, or where to find (or how to make) pictures of children smoking. It won't talk about anything else."),
        el("ul", %{},
          el("li", %{}, "Grilled cheese: bread, cheese, fat, heat, and what went wrong"),
          el("li", %{}, "Pictures: documentary archives, old ads, painting, staging, image generators within their rules"),
          el("li", %{}, concat("It can search ", aimp_commas(s.posts), " of Bobby's posts, for those two things only")),
          el("li", %{}, "Model: DeepSeek V4.1 Flash, 1M-token context"),
          el("li", %{}, "Server: one Blimp process on bobbby.online")),
        el("p", %{class: "aim-small"}, "Conversations are not saved. Sign off and they're gone.")),
      el("div", %{class: "aim-info-foot"}, el("button", %{class: "aim-btn", click: :close_info}, "Close"))))
end

def aimp_taskbar(s: Map) -> Any do
  im = case s.im_open do
    true -> [el("button", %{class: "aim-task on", click: :open_chat, with: s.current}, concat(aimp_name(s, s.current), " - Instant Message"))]
    false -> []
  end
  cats = case s.cats_open do
    true -> [el("button", %{class: "aim-task", click: :open_cats}, "cats.jpg")]
    false -> []
  end
  tasks = case s.signed_on do
    true -> aimp_append([el("span", %{class: "aim-task"}, concat(s.name, "'s Buddy List"))], aimp_append(im, cats))
    false -> [el("span", %{class: "aim-task on"}, "Sign On")]
  end
  el("div", %{class: "aim-taskbar"},
    el("a", %{class: "aim-start", href: "/"}, el("span", %{class: "aim-start-flag"}), "bobbby.online"),
    el("div", %{class: "aim-tasks"}, tasks),
    el("div", %{class: "aim-tray"}, aimp_runner("tiny"), el("span", %{id: "aim-clock"}, "")))
end

def aimp_page(s: Map) -> Any do
  windows = case s.signed_on do
    false -> [aimp_signon(s)]
    true ->
      im = case s.im_open do
        true -> [aimp_im(s)]
        false -> []
      end
      info = case s.info_open do
        true -> [aimp_info(s)]
        false -> []
      end
      reader = case s.reader >= 0 and aimp_nth(s.messages, s.reader) != nil do
        true -> [aimp_reader(s)]
        false -> []
      end
      cats = case s.cats_open and s.cats != "" do
        true -> [aimp_cats(s)]
        false -> []
      end
      aimp_append([aimp_buddy_list(s)], aimp_append(im, aimp_append(info, aimp_append(cats, reader))))
  end
  cls = case s.im_open and s.signed_on do
    true -> "aim-desktop im-open"
    false -> "aim-desktop"
  end
  el("div", %{class: cls}, el("div", %{class: "aim-windows"}, windows), aimp_taskbar(s))
end

actor AimPage do
  state signed_on: Bool :: false
  state name: String :: ""
  # nil until the server says whether the bot is online
  state online: Any :: nil
  state posts: Int :: 0
  state messages: List :: []
  state loading: Bool :: false
  state im_open: Bool :: true
  state info_open: Bool :: false
  # the message the reader shows, or -1
  state reader: Int :: -1
  state size: Int :: 2
  state paper: Bool :: true
  state warn: Int :: 0
  state muted: Bool :: false
  # messages sent; each gives the textarea a new id, so it comes back empty
  state sent: Int :: 0
  state outbox: List :: []
  # what aim.js should play: :signon, :sent, :received, or nil
  state sound: Any :: nil
  # whose conversation the IM window shows ("bot", "sc", "u<n>")
  state current: String :: "bot"
  # everyone else's conversations, and whether they are typing, by id
  state convos: Map :: %{}
  state typing: Map :: %{}
  # who else is signed on, [%{id, name}..], and every name seen, so a
  # conversation keeps its name after they sign off
  state buddies: List :: []
  state names: Map :: %{}
  state sc_on: Bool :: false
  # conversations with something unread
  state unread: List :: []
  # the cats' picture, once the server has handed it over
  state cats: String :: ""
  state cats_open: Bool :: false

  # the screen name remembered from last time (aim.js keeps it)
  on :remembered(n: String) do
    become name: n
    reply :ok
  end

  # The socket is (again) open. The server's conversation went with the old
  # socket: start again, and sign on again if this page already had.
  on :connected do
    become online: nil, messages: [], loading: false, reader: -1, current: "bot", convos: %{}, typing: %{},
      buddies: [], sc_on: false, unread: [], cats: "", cats_open: false
    case signed_on do
      true -> become outbox: aimp_append(outbox, [json_encode(%{t: "signon", name: name})])
      false -> :ok
    end
    reply :ok
  end

  on :offline do
    become loading: false
    reply :ok
  end

  on :frame(text: String) do
    msg = aimp_decode(text)
    case lookup(msg, :t) do
      "hello" ->
        become online: lookup(msg, :online) == true, posts: aimp_int(lookup(msg, :posts))
        reply :hello
      "chat" ->
        ms = aimp_messages(lookup(msg, :messages))
        w = case aimp_str(lookup(msg, :with)) do
          "" -> "bot"
          x -> x
        end
        busy = lookup(msg, :loading) == true
        got = aimp_heard(ms) > aimp_heard(aimp_convo((self <- :state), w))
        case w do
          "bot" -> become messages: ms, loading: busy
          _ -> become convos: put(convos, w, ms), typing: put(typing, w, busy)
        end
        case got do
          true -> self <- :arrived(w)
          false -> :ok
        end
        reply :chat
      "buddies" ->
        bs = aimp_buddies(lookup(msg, :people))
        become buddies: bs, sc_on: lookup(msg, :sc) == true,
          names: reduce(bs, names, fn(acc: Map, b: Map) -> Map do put(acc, aimp_str(lookup(b, :id)), aimp_str(lookup(b, :name))) end)
        reply :buddies
      "secret" ->
        become cats: aimp_str(lookup(msg, :src)), cats_open: true, sound: :received
        reply :secret
      _ -> reply :ignored
    end
  end

  # Something new from `w`: in front if nothing else is, otherwise unread.
  on :arrived(w: String) do
    s = (self <- :state)
    case im_open and current == w do
      true -> become sound: :received
      false ->
        case not(im_open) or aimp_convo(s, current) == [] do
          true -> become current: w, im_open: true, sound: :received, unread: aimp_without(unread, w)
          false -> become unread: aimp_append(aimp_without(unread, w), [w]), sound: :received
        end
    end
    reply :ok
  end

  on :sign_off do
    become signed_on: false, messages: [], loading: false, reader: -1, info_open: false, current: "bot",
      convos: %{}, typing: %{}, buddies: [], sc_on: false, unread: [], cats: "", cats_open: false,
      outbox: aimp_append(outbox, [json_encode(%{t: "signoff"})])
    reply :ok
  end

  on :open_chat(id: String) do
    become current: id, im_open: true, unread: aimp_without(unread, id)
    reply :ok
  end

  on :open_cats do
    become cats_open: true
    reply :ok
  end

  on :close_cats do
    become cats_open: false
    reply :ok
  end

  on :sign_on(fields: String) do
    n = trim(aimp_str(lookup(aimp_decode(fields), :name)))
    sn = case n do
      "" -> "Visitor"
      _ -> utf8_slice(n, 0, 16)
    end
    become signed_on: true, name: sn, im_open: true, sound: :signon,
      outbox: aimp_append(outbox, [json_encode(%{t: "signon", name: sn})])
    reply :ok
  end

  on :send(fields: String) do
    text = aimp_str(lookup(aimp_decode(fields), :message))
    case trim(text) == "" or not(aimp_can_send((self <- :state))) do
      true -> reply :ignored
      false ->
        up = case current do
          "bot" -> %{t: "ask", text: text}
          _ -> %{t: "im", to: current, text: text}
        end
        become outbox: aimp_append(outbox, [json_encode(up)]), sent: sent + 1, sound: :sent
        reply :sent
    end
  end

  on :ask_preset(q: String) do
    reply (self <- :send(json_encode(%{message: q})))
  end

  on :open_im do
    become im_open: true, current: "bot", unread: aimp_without(unread, "bot")
    reply :ok
  end

  on :close_im do
    become im_open: false
    reply :ok
  end

  on :open_info do
    become info_open: true
    reply :ok
  end

  on :close_info do
    become info_open: false
    reply :ok
  end

  on :open_reader(i: Int) do
    become reader: i
    reply :ok
  end

  on :close_reader do
    become reader: -1
    reply :ok
  end

  on :reader_step(dir: Int) do
    case reader >= 0 do
      true -> become reader: aimp_step(aimp_answers(messages), reader, dir)
      false -> :ok
    end
    reply :ok
  end

  on :reader_size(d: Int) do
    n = size + d
    case n >= 0 and n <= 4 do
      true -> become size: n
      false -> :ok
    end
    reply :ok
  end

  on :reader_theme do
    become paper: not(paper)
    reply :ok
  end

  # AIM's warning button, which here only embarrasses the one who presses it
  on :warn do
    case warn < 100 do
      true -> become warn: warn + 10
      false -> :ok
    end
    reply :ok
  end

  on :toggle_sound do
    become muted: not(muted)
    reply :ok
  end

  on :outbox do
    out = outbox
    become outbox: []
    reply out
  end

  # For aim.js after a render: a sound to play (once), whether the reader
  # is open, the screen name to remember.
  on :where do
    s = case muted do
      true -> nil
      false -> sound
    end
    become sound: nil
    reply %{sound: s, reader: reader >= 0, name: name, signed_on: signed_on}
  end

  # Everything the view and the helpers above read, as one map.
  on :state do
    reply %{signed_on: signed_on, name: name, online: online, posts: posts,
      messages: messages, loading: loading, im_open: im_open, info_open: info_open, reader: reader,
      size: size, paper: paper, warn: warn, muted: muted, sent: sent, current: current, convos: convos,
      typing: typing, buddies: buddies, names: names, sc_on: sc_on, unread: unread, cats: cats, cats_open: cats_open}
  end

  on :view do
    reply aimp_page(self <- :state)
  end
end

aim = spawn AimPage
aim <- :view
