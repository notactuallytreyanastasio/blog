# /piet: four Piet programs, assembling and running. A Piet program is an
# image; these four are Temper libraries that temper-blimp's be-piet
# compiled to images, and npiet ran (temper-blimp/piet-programs, PRs
# #176-#197 there).
#
# This program is the window: which of the four is shown, its notes, and
# the Play button. The animation is static/piet/piet.js, which draws each
# image, replays npiet's run over it from /piet/data.json.gz, and shows the
# program's output. After every render it asks
#
#   piet <- :scene   %{current, run, fill, tile}: the program to show, a counter
#                    that goes up each time it should play from the start,
#                    one that goes up each time the page should fill, and
#                    one for each time it should tile.
#
# and says :loaded once the data has arrived.

PIET_PROGRAMS = [
  %{id: "piet-in-piet", name: "Piet in Piet", steps: "31,830,789", time: "35.9 s",
    note: "A Piet interpreter written in Temper, compiled to a 597 by 5680 Piet image. It runs a 130 by 3 Piet program embedded in its own source, which prints Piet!"},
  %{id: "mondrian", name: "Mondrian", steps: "34,140,191", time: "90.5 s",
    note: "Asks for today's date, seeds a random number generator with it, and paints a composition in red, yellow and blue: Mondrian's colours, and three of Piet's."},
  %{id: "fact-check", name: "Fact check", steps: "24,540,365", time: "40.2 s",
    note: "Fetches the Commands section of the Piet article on esolangs.org over HTTPS, prints its table, and tests the claim that Divide is Python's // with its own divide command."},
  %{id: "life", name: "Life", steps: "1,265,631,744", time: "2 h 59 min",
    note: "Plays Conway's Life on the Piet program it embeds, the one Piet in Piet runs, and after every generation runs the board as a Piet program. Generation 0 says Piet!; then Life takes it apart."}
]

actor Piet do
  state current: String :: "piet-in-piet"
  state run: Int :: 0
  state fill: Int :: 0
  state tile: Int :: 0
  state loaded: Bool :: false

  # Choosing a program plays it.
  on :pick(id: String) do
    become current: id, run: run + 1
    reply :ok
  end

  on :play do
    become run: run + 1
    reply :ok
  end

  on :loaded do
    become loaded: true
    reply :ok
  end

  # Fill the page: piet.js opens Life over the whole window, in Piet's
  # colours, seeded with the Piet program Life ran on, each time this goes up.
  on :fill do
    become fill: fill + 1
    reply :ok
  end

  # Tile the page: as many small Life games as fit, each its own Piet
  # program, each run as a Piet program after every generation.
  on :tile do
    become tile: tile + 1
    reply :ok
  end

  on :scene do
    reply %{current: current, run: run, fill: fill, tile: tile}
  end

  on :view do
    reply piet_page(current, loaded)
  end
end

def piet_find(id: String) -> Map do
  hits = filter(PIET_PROGRAMS, fn(p: Map) -> Bool do p.id == id end)
  case hits do
    [p | _] -> p
    [] -> elem(PIET_PROGRAMS, 0)
  end
end

def piet_on(base: String, yes: Bool) -> String do
  case yes do
    true -> concat(base, " piet-on")
    false -> base
  end
end

# #piet-stage has no children of the program's own on any render, so a
# render never replaces it; piet.js keeps its canvas and output there.
def piet_page(current: String, loaded: Bool) -> Any do
  p = piet_find(current)
  el("div", %{class: "os-desktop-mac piet-desktop"},
    el("div", %{class: "os-window os-window-mac piet-window"},
      el("div", %{class: "os-titlebar"},
        el("div", %{class: "os-titlebar-buttons"}, el("a", %{href: "/", class: "os-btn-close"})),
        el("span", %{class: "os-titlebar-title"}, "npiet — four Piet programs"),
        el("div", %{class: "os-titlebar-spacer"})),
      el("div", %{class: "os-content piet-content"},
        el("div", %{class: "piet-side"},
          el("div", %{class: "piet-list"}, map(PIET_PROGRAMS, fn(q: Map) -> Any do piet_row(q, current) end)),
          el("div", %{class: "piet-note"},
            el("p", %{class: "piet-note-name"}, p.name),
            el("p", %{}, p.note),
            el("p", %{class: "piet-note-figures"}, concat(concat(p.steps, " npiet steps · "), p.time))),
          el("button", %{type: "button", class: "piet-play", click: :play}, "Play"),
          el("button", %{type: "button", class: "piet-play piet-fill", click: :fill}, "Fill the page"),
          el("button", %{type: "button", class: "piet-play piet-fill", click: :tile}, "Tile the page"),
          el("a", %{href: "/piet/life", class: "piet-how piet-life-link"}, "Both, on a page of their own: /piet/life"),
          el("p", %{class: "piet-how"}, "Each image draws itself, top to bottom. Then npiet's run is replayed over it: a codel lights up at the step npiet first lands on it, hotter the more steps landed there. Then the output, as the program printed it.")),
        el("div", %{class: "piet-main"},
          el("div", %{id: "piet-stage", class: "piet-stage"}),
          el("div", %{class: piet_on("piet-loading", loaded)}, "Loading the four programs..."))),
      el("div", %{class: "os-statusbar"},
        el("span", %{}, "be-piet · temper-blimp"),
        el("span", %{}, "npiet 1.3f"))))
end

def piet_row(q: Map, current: String) -> Any do
  el("button", %{type: "button", class: piet_on("piet-row", q.id == current), click: :pick, with: q.id},
    el("span", %{class: "piet-row-name"}, q.name),
    el("span", %{class: "piet-row-steps"}, q.steps))
end

piet = spawn Piet
piet <- :view
