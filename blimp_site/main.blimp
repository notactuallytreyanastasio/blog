# The server.
#
# The interpreter frees nothing while it runs, so a process that loops over
# requests forever grows forever: about 147KB a request, measured, for a
# loop that answers with the longest post. So this is a prefork server.
#
#   boot     the parent reads every post, renders it, and builds the full
#            HTTP response for every fixed route, once
#   fork     WORKERS children inherit all of that copy-on-write, and each
#            accepts on the shared listening socket
#   recycle  a child exits after REQUESTS_PER_WORKER requests, and the
#            parent, blocked in waitpid, forks a fresh one in its place
#
# The parent allocates a few values per replacement and nothing per request.
# A worker's garbage is bounded by the requests it serves.

PORT = 4100
WORKERS = 4
REQUESTS_PER_WORKER = 200
POSTS_DIR = "../priv/static/posts"
STATIC_DIR = "../priv/static"

def load_asset(routes: Map, path: String, file: String) -> Map do
  body = read_file(file)
  case body do
    nil ->
      print(concat("cannot read ", file))
      exit(1)
    _ -> put(routes, path, serialize(response(200, content_type_for(file), "public, max-age=300", body), "GET"))
  end
end

def page_route(routes: Map, path: String, html: String) -> Map do
  put(routes, path, serialize(html_response(200, html), "GET"))
end

def build_routes(posts: List) -> Map do
  with_posts = reduce(posts, %{}, fn(acc: Map, p: Map) -> Map do
    with_page = page_route(acc, concat("/post/", p.slug), post_page(p))
    # The source, for the post page to render again in the browser.
    put(with_page, concat("/post/", p.slug, ".md"), serialize(response(200, "text/markdown; charset=utf-8", "public, max-age=300", p.source), "GET"))
  end)
  r1 = page_route(with_posts, "/blog", blog_index_page(posts))
  r2 = load_asset(r1, "/assets/base.css", "assets/base.css")
  r3 = load_asset(r2, "/assets/blog.css", "assets/blog.css")
  r4 = load_asset(r3, "/assets/post.css", "assets/post.css")
  r5 = put(r4, "/assets/highlight.css", serialize(response(200, "text/css; charset=utf-8", "public, max-age=300", highlight_css()), "GET"))
  r6a = load_asset(r5, "/assets/desktop.css", "assets/desktop.css")
  r6 = load_asset(r6a, "/favicon.ico", concat(STATIC_DIR, "/favicon.ico"))
  r7 = load_asset(r6, "/robots.txt", concat(STATIC_DIR, "/robots.txt"))
  tetris_routes(r7)
end

# Blimp in the browser: its interpreter, loader, view host and canvas, all
# synced from one Blimp commit (static/blimp/sync.sh); the renderer program
# post pages run; and /tetris.
def tetris_routes(routes: Map) -> Map do
  commit = trim(read_file("static/blimp/BLIMP_COMMIT"))
  lines = length(split(trim_right(read_file("static/tetris/tetris.blimp")), "\n"))
  runtime = reduce(["blimp.wasm", "blimp.js", "blimp-view.js", "canvas.js"], routes, fn(acc: Map, f: String) -> Map do
    load_asset(acc, concat("/blimp/", f), concat("static/blimp/", f))
  end)
  r1 = load_asset(runtime, "/blimp/post.js", "static/post/post.js")
  r1a = load_asset(r1, "/blimp/post-worker.js", "static/post/post-worker.js")
  r2 = load_asset(r1a, "/blimp/post-renderer.blimp", "_build/post-renderer.blimp")
  r3 = load_asset(r2, "/assets/blimp-window.css", "assets/blimp-window.css")
  r4 = load_asset(r3, "/tetris/tetris.blimp", "static/tetris/tetris.blimp")
  r5 = load_asset(r4, "/tetris/play.js", "static/tetris/play.js")
  r6 = load_asset(r5, "/assets/tetris.css", "assets/tetris.css")
  page_route(r6, "/tetris", tetris_page(commit, lines))
end

# Everything that is not a fixed route. Only GET and HEAD reach here.
# The homepage is here because its state is in the query string.
def dynamic(req: Map, routes: Map, posts: List, desk: Map) -> Map do
  path = req.path
  case path == "/" do
    true -> html_response(200, desktop_page(req.query, desk, now()))
    false -> static_or_404(path)
  end
end

def static_or_404(path: String) -> Map do
  case starts_with(path, "/images/") and safe_static_path(path) do
    true ->
      body = read_file(concat(STATIC_DIR, path))
      case body do
        nil -> html_response(404, not_found_page(path))
        _ -> response(200, content_type_for(path), "public, max-age=3600", body)
      end
    false ->
      case ends_with(path, "/") and length(path) > 1 do
        true -> redirect(take(path, length(path) - 1))
        false -> html_response(404, not_found_page(path))
      end
  end
end

# The response bytes for one raw request, and its status for the log line.
def handle(raw: String, routes: Map, posts: List, desk: Map) -> Tuple do
  req = parse_request(raw)
  case req.method == "GET" or req.method == "HEAD" do
    false -> {serialize(response(405, "text/plain", "no-cache", "method not allowed\n"), "GET"), 405, req}
    true ->
      fixed = case req.path == "/" and req.query == "" do
        true -> bare_home(lookup(routes, "#home"))
        false -> lookup(routes, req.path)
      end
      case fixed do
        nil ->
          resp = dynamic(req, routes, posts, desk)
          {serialize(resp, req.method), resp.status, req}
        _ ->
          case req.method == "HEAD" do
            true -> {head_of(fixed), 200, req}
            false -> {fixed, 200, req}
          end
      end
  end
end

# The homepage with no query string is most of the traffic to "/", and all
# of it is the same page except the clock in the menu bar. Rendering it per
# request cost a worker about 0.8MB of garbage, so it is rendered once at
# boot, cut at the clock, and the time is put back per request. The clock
# is always eight bytes ("%I:%M %p"), so the prebuilt Content-Length holds.
def home_parts(desk: Map) -> List do
  marker = desk_clock(0)
  wire = serialize(html_response(200, desktop_page("", desk, 0)), "GET")
  parts = split(wire, marker)
  case length(parts) == 2 and length(desk_clock(now())) == length(marker) do
    true -> parts
    false ->
      print("the homepage clock is not a unique, fixed-width marker; cannot prebuild /")
      exit(1)
  end
end

def bare_home(parts: List) -> String do
  join([head(parts), desk_clock(now()), last(parts)], "")
end

# A prebuilt response with its body cut off, for HEAD.
def head_of(wire: String) -> String do
  concat(take(wire, index_of(wire, "\r\n\r\n")), "\r\n\r\n")
end

def work(fd: Int, routes: Map, posts: List, desk: Map, left: Int) -> Int do
  case left do
    0 -> exit(0)
    _ ->
      client = tcp_accept(fd)
      t0 = now_ms()
      raw = tcp_read(client)
      result = handle(raw, routes, posts, desk)
      tcp_write(client, elem(result, 0))
      tcp_close(client)
      req = elem(result, 2)
      puts(concat(req.method, " ", req.path, " ", to_string(elem(result, 1)), " ", to_string(now_ms() - t0), "ms"))
      work(fd, routes, posts, desk, left - 1)
  end
end

def spawn_worker(fd: Int, routes: Map, posts: List, desk: Map) -> Int do
  pid = fork()
  case pid do
    0 -> work(fd, routes, posts, desk, REQUESTS_PER_WORKER)
    _ -> pid
  end
end

def supervise(fd: Int, routes: Map, posts: List, desk: Map) -> Int do
  waitpid(-1, false)
  spawn_worker(fd, routes, posts, desk)
  supervise(fd, routes, posts, desk)
end

t_boot = now_ms()
posts = load_posts(POSTS_DIR, read_file("data/posts.txt"))
desk = load_desktop("data", posts)
routes = put(build_routes(posts), "#home", home_parts(desk))
fd = tcp_listen(PORT)
puts(concat("blimp blog: ", to_string(length(posts)), " posts rendered in ", to_string(now_ms() - t_boot), "ms, listening on :", to_string(PORT)))
each(range(1, WORKERS), fn(i: Int) do spawn_worker(fd, routes, posts, desk) end)
supervise(fd, routes, posts, desk)
