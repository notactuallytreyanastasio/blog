# The server: one Blimp program for as long as the site runs.
#
# It runs under `blimp --serve`, which evaluates this file once and then
# `site <- :tick` forever, collecting garbage between ticks and taking Blimp
# from a control socket (see the Dockerfile for the command line, and
# `blimp --attach site.sock` for a prompt on the running site).
#
#   boot   read every post, render it, and build the full HTTP response for
#          every fixed route, once. These are top-level bindings (posts,
#          routes), so the prompt can read and replace them live. The
#          homepage's museum and Finder are Postgres rows: the Site actor
#          holds them with its database connection, and reloads them every
#          DESK_REFRESH_S seconds, so an edit in /admin/museum reaches "/"
#          without a deploy.
#   tick   wait up to 100ms for connections, answer every one that is
#          waiting, return. Returning is what lets the host collect garbage
#          and serve the prompt: nothing on the stack points into the heap
#          between ticks.
#
# This replaced a prefork server whose workers died every 200 requests,
# because the interpreter never freed anything. That held memory down but
# could keep no state between requests, and there was no one program to
# talk to.

PORT = 4100
DESK_REFRESH_S = 60
POSTS_DIR = "../priv/static/posts"
STATIC_DIR = "../priv/static"

def load_asset(routes: Map, path: String, file: String) -> Map do
  body = read_file(file)
  case body do
    nil ->
      print(concat("cannot read ", file))
      exit(1)
    _ -> put(routes, path, serialize(response(200, content_type_for(file), "public, max-age=300", body), "GET"))
  end
end

def page_route(routes: Map, path: String, html: String) -> Map do
  put(routes, path, serialize(html_response(200, html), "GET"))
end

def build_routes(posts: List) -> Map do
  with_posts = reduce(posts, %{}, fn(acc: Map, p: Map) -> Map do
    with_page = page_route(acc, concat("/post/", p.slug), post_page(p))
    # The source, for the post page to render again in the browser.
    put(with_page, concat("/post/", p.slug, ".md"), serialize(response(200, "text/markdown; charset=utf-8", "public, max-age=300", p.source), "GET"))
  end)
  r1 = page_route(with_posts, "/blog", blog_index_page(posts))
  r2 = load_asset(r1, "/assets/base.css", "assets/base.css")
  r3 = load_asset(r2, "/assets/blog.css", "assets/blog.css")
  r4 = load_asset(r3, "/assets/post.css", "assets/post.css")
  r5 = put(r4, "/assets/highlight.css", serialize(response(200, "text/css; charset=utf-8", "public, max-age=300", highlight_css()), "GET"))
  r6a = load_asset(r5, "/assets/desktop.css", "assets/desktop.css")
  r6 = load_asset(r6a, "/favicon.ico", concat(STATIC_DIR, "/favicon.ico"))
  r7 = load_asset(r6, "/robots.txt", concat(STATIC_DIR, "/robots.txt"))
  static_page_routes(tetris_routes(r7))
end

# Pages that were LiveViews with nothing for a server to do, and two that
# were already files, kept as the HTML Phoenix sent (content/snapshot.sh
# says exactly what was taken out). Plus the stylesheet they link, under the
# digested name they link it by, and the d3 the Knicks page loads.
STATIC_PAGES = ["privacy", "terms", "trees", "nathan", "knicks", "frontier", "chess"]

def static_page_routes(routes: Map) -> Map do
  with_pages = reduce(STATIC_PAGES, routes, fn(acc: Map, name: String) -> Map do
    body = read_file(concat("content/pages/", name, ".html"))
    case body do
      nil ->
        print(concat("cannot read content/pages/", name, ".html"))
        exit(1)
      _ -> page_route(acc, concat("/", name), body)
    end
  end)
  r1 = load_asset(with_pages, "/assets/app-3cfac71d5552d1426de906087a8be2fe.css", "content/assets/app-3cfac71d5552d1426de906087a8be2fe.css")
  load_asset(r1, "/static/d3.v7.min.js", "content/assets/d3.v7.min.js")
end

# Blimp in the browser: its interpreter, loader, view host and canvas, all
# synced from one Blimp commit (static/blimp/sync.sh); the renderer program
# post pages run; and /tetris.
def tetris_routes(routes: Map) -> Map do
  commit = trim(read_file("static/blimp/BLIMP_COMMIT"))
  lines = length(split(trim_right(read_file("static/tetris/tetris.blimp")), "\n"))
  runtime = reduce(["blimp.wasm", "blimp.js", "blimp-view.js", "canvas.js"], routes, fn(acc: Map, f: String) -> Map do
    load_asset(acc, concat("/blimp/", f), concat("static/blimp/", f))
  end)
  r1 = load_asset(runtime, "/blimp/post.js", "static/post/post.js")
  r1a = load_asset(r1, "/blimp/post-worker.js", "static/post/post-worker.js")
  r2 = load_asset(r1a, "/blimp/post-renderer.blimp", "_build/post-renderer.blimp")
  r3 = load_asset(r2, "/assets/blimp-window.css", "assets/blimp-window.css")
  r4 = load_asset(r3, "/tetris/tetris.blimp", "static/tetris/tetris.blimp")
  r5 = load_asset(r4, "/tetris/play.js", "static/tetris/play.js")
  r6 = load_asset(r5, "/assets/tetris.css", "assets/tetris.css")
  page_route(r6, "/tetris", tetris_page(commit, lines))
end

# Everything that is not a fixed route. Only GET and HEAD reach here.
# The homepage is here because its state is in the query string.
def dynamic(req: Map, routes: Map, posts: List, desk: Map) -> Map do
  path = req.path
  case path == "/" do
    true -> html_response(200, desktop_page(req.query, desk, now()))
    false -> static_or_404(path)
  end
end

def static_or_404(path: String) -> Map do
  case starts_with(path, "/images/") and safe_static_path(path) do
    true ->
      body = read_file(concat(STATIC_DIR, path))
      case body do
        nil -> html_response(404, not_found_page(path))
        _ -> response(200, content_type_for(path), "public, max-age=3600", body)
      end
    false ->
      case ends_with(path, "/") and length(path) > 1 do
        true -> redirect(take(path, length(path) - 1))
        false -> html_response(404, not_found_page(path))
      end
  end
end

# The response bytes for one raw request, and its status for the log line.
def handle(raw: String, routes: Map, posts: List, desk: Map, home: List) -> Tuple do
  req = parse_request(raw)
  case req.method == "GET" or req.method == "HEAD" do
    false -> {serialize(response(405, "text/plain", "no-cache", "method not allowed\n"), "GET"), 405, req}
    true ->
      fixed = case req.path == "/" and req.query == "" do
        true -> bare_home(home)
        false -> lookup(routes, req.path)
      end
      case fixed do
        nil ->
          resp = dynamic(req, routes, posts, desk)
          {serialize(resp, req.method), resp.status, req}
        _ ->
          case req.method == "HEAD" do
            true -> {head_of(fixed), 200, req}
            false -> {fixed, 200, req}
          end
      end
  end
end

# The homepage with no query string is most of the traffic to "/", and all
# of it is the same page except the clock in the menu bar. Rendering it per
# request cost a worker about 0.8MB of garbage, so it is rendered once at
# boot, cut at the clock, and the time is put back per request. The clock
# is always eight bytes ("%I:%M %p"), so the prebuilt Content-Length holds.
def home_parts(desk: Map) -> List do
  marker = desk_clock(0)
  wire = serialize(html_response(200, desktop_page("", desk, 0)), "GET")
  parts = split(wire, marker)
  case length(parts) == 2 and length(desk_clock(now())) == length(marker) do
    true -> parts
    false ->
      print("the homepage clock is not a unique, fixed-width marker; cannot prebuild /")
      exit(1)
  end
end

def bare_home(parts: List) -> String do
  join([head(parts), desk_clock(now()), last(parts)], "")
end

# A prebuilt response with its body cut off, for HEAD.
def head_of(wire: String) -> String do
  concat(take(wire, index_of(wire, "\r\n\r\n")), "\r\n\r\n")
end

# One connection: wait briefly for its request (a socket accepted from a
# non-blocking listener is non-blocking itself on some systems), answer it,
# close it, log a line.
def serve_client(c: Int, desk: Map, home: List) -> Int do
  t0 = now_ms()
  ready = tcp_poll([c], 2000)
  raw = case length(ready) > 0 do
    true -> tcp_read(c)
    false -> nil
  end
  case raw do
    nil ->
      tcp_close(c)
      0
    _ ->
      result = handle(raw, routes, posts, desk, home)
      tcp_write(c, elem(result, 0))
      tcp_close(c)
      req = elem(result, 2)
      puts(concat(req.method, " ", req.path, " ", to_string(elem(result, 1)), " ", to_string(now_ms() - t0), "ms"))
      1
  end
end

# Every connection that is waiting now, then stop: the tick must return.
def accept_all(fd: Int, n: Int, desk: Map, home: List) -> Int do
  c = tcp_accept(fd)
  case c do
    nil -> n
    _ -> accept_all(fd, n + serve_client(c, desk, home), desk, home)
  end
end

# The museum and Finder from Postgres, built into a desktop:
# {:ok, desk, db} or {:error, reason, db}, where db is nil once the
# connection is gone (the next refresh connects again).
def refresh_desk(db: Any, opts: Map) -> Tuple do
  conn = case db do
    nil -> pg_connect(opts)
    _ -> {:ok, db}
  end
  case conn do
    {:error, reason} -> {:error, reason, nil}
    {:ok, live} ->
      case load_desk_db(live) do
        {:ok, museum, finder, next} -> {:ok, build_desktop(museum, finder, ICONS, posts), next}
        {:error, reason, next} -> {:error, reason, next}
      end
  end
end

actor Site do
  state fd: Int :: -1
  state served: Int :: 0
  state booted_at: Int :: 0
  state desk: Map :: %{}
  state home: List :: []
  state db: Any :: nil
  state db_opts: Any :: nil
  state desk_at: Int :: 0
  state desk_error: String :: ""

  on :start(port: Int, first: Map, conn: Any, opts: Any) do
    s = tcp_listen(port)
    tcp_set_nonblocking(s)
    become fd: s, booted_at: now(), desk: first, home: home_parts(first), db: conn, db_opts: opts, desk_at: now()
    reply s
  end

  on :tick do
    n = case length(tcp_poll([fd], 100)) > 0 do
      true -> accept_all(fd, 0, desk, home)
      false -> 0
    end
    case db_opts != nil and now() - desk_at >= DESK_REFRESH_S do
      false ->
        become served: served + n
        reply n
      true ->
        case refresh_desk(db, db_opts) do
          {:ok, fresh, next} ->
            become served: served + n, desk: fresh, home: home_parts(fresh), db: next, desk_at: now(), desk_error: ""
            reply n
          {:error, reason, next} ->
            puts(concat("museum refresh failed, still showing the one from ", format_time(desk_at, "%H:%M:%S"), ": ", reason))
            become served: served + n, db: next, desk_at: now(), desk_error: reason
            reply n
        end
    end
  end

  # From the prompt: `site <- :desk` is what "/" is drawn from right now,
  # `site <- :desk_error` why the last refresh kept it ("" if it did not).
  on :desk do
    reply desk
  end

  on :desk_error do
    reply desk_error
  end

  on :served do
    reply served
  end
end

t_boot = now_ms()
posts = load_posts(POSTS_DIR, read_file("data/posts.txt"))
ICONS = desk_load_icons(desk_read("data/icons.txt"))
routes = build_routes(posts)

# DATABASE_URL set: the museum and Finder are Postgres rows, and a site
# that cannot read them does not start. Unset (a laptop, the tests): the
# data/*.tsv snapshot, and the boot line says so.
DB_OPTS = case getenv("DATABASE_URL") do
  nil -> nil
  "" -> nil
  url ->
    parsed = pg_parse_url(url)
    case parsed do
      nil -> desk_die("DATABASE_URL is not a postgres:// or ecto:// URL")
      _ -> parsed
    end
end
first = case DB_OPTS do
  nil -> {:ok, load_desktop("data", posts), nil}
  _ -> refresh_desk(nil, DB_OPTS)
end
case first do
  {:error, reason, _} -> desk_die(concat("cannot load the museum from Postgres: ", reason))
  _ -> :ok
end
site = spawn Site
site <- :start(PORT, elem(first, 1), elem(first, 2), DB_OPTS)
desk_source = case DB_OPTS do
  nil -> "museum from data/*.tsv"
  _ -> concat("museum from postgres ", DB_OPTS.host, "/", DB_OPTS.database)
end
puts(concat("blimp blog: ", to_string(length(posts)), " posts rendered in ", to_string(now_ms() - t_boot), "ms, ", desk_source, ", listening on :", to_string(PORT)))
