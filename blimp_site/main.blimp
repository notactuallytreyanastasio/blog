# The server: one Blimp program for as long as the site runs.
#
# It runs under `blimp --serve`, which evaluates this file once and then
# `site <- :tick` forever, collecting garbage between ticks and taking Blimp
# from a control socket (see the Dockerfile for the command line, and
# `blimp --attach site.sock` for a prompt on the running site).
#
#   boot   read every post, render it, and build the full HTTP response for
#          every fixed route, once. These are top-level bindings (posts,
#          routes), so the prompt can read and replace them live. The
#          homepage's museum and Finder are Postgres rows: the Site actor
#          holds them with its database connection, and reloads them every
#          DESK_REFRESH_S seconds, so an edit in /admin/museum reaches "/"
#          without a deploy.
#   tick   wait up to 100ms for connections, answer every one that is
#          waiting, return. Returning is what lets the host collect garbage
#          and serve the prompt: nothing on the stack points into the heap
#          between ticks.
#
# This replaced a prefork server whose workers died every 200 requests,
# because the interpreter never freed anything. That held memory down but
# could keep no state between requests, and there was no one program to
# talk to.

PORT = 4100
DESK_REFRESH_S = 60
POSTS_DIR = "../priv/static/posts"
STATIC_DIR = "../priv/static"

def load_asset(routes: Map, path: String, file: String) -> Map do
  body = read_file(file)
  case body do
    nil ->
      print(concat("cannot read ", file))
      exit(1)
    _ -> put(routes, path, serialize(response(200, content_type_for(file), "public, max-age=300", body), "GET"))
  end
end

def page_route(routes: Map, path: String, html: String) -> Map do
  put(routes, path, serialize(html_response(200, html), "GET"))
end

def build_routes(posts: List) -> Map do
  with_posts = reduce(posts, %{}, fn(acc: Map, p: Map) -> Map do
    with_page = page_route(acc, concat("/post/", p.slug), post_page(p))
    # The source, for the post page to render again in the browser.
    put(with_page, concat("/post/", p.slug, ".md"), serialize(response(200, "text/markdown; charset=utf-8", "public, max-age=300", p.source), "GET"))
  end)
  r1 = page_route(with_posts, "/blog", blog_index_page(posts))
  r2 = load_asset(r1, "/assets/base.css", "assets/base.css")
  r3 = load_asset(r2, "/assets/blog.css", "assets/blog.css")
  r4 = load_asset(r3, "/assets/post.css", "assets/post.css")
  r5 = put(r4, "/assets/highlight.css", serialize(response(200, "text/css; charset=utf-8", "public, max-age=300", highlight_css()), "GET"))
  r6a = load_asset(r5, "/assets/desktop.css", "assets/desktop.css")
  r6 = load_asset(r6a, "/favicon.ico", concat(STATIC_DIR, "/favicon.ico"))
  r7 = load_asset(r6, "/robots.txt", concat(STATIC_DIR, "/robots.txt"))
  app_routes(wordle_routes(pong_routes(static_page_routes(tetris_routes(r7)))))
end

# Pages that were LiveViews with nothing for a server to do, and two that
# were already files, kept as the HTML Phoenix sent (content/snapshot.sh
# says exactly what was taken out). Plus the stylesheet they link, under the
# digested name they link it by, and the d3 the Knicks page loads.
STATIC_PAGES = ["privacy", "terms", "trees", "nathan", "knicks", "frontier", "chess"]

def static_page_routes(routes: Map) -> Map do
  with_pages = reduce(STATIC_PAGES, routes, fn(acc: Map, name: String) -> Map do
    body = read_file(concat("content/pages/", name, ".html"))
    case body do
      nil ->
        print(concat("cannot read content/pages/", name, ".html"))
        exit(1)
      _ -> page_route(acc, concat("/", name), page_with_runtime(body))
    end
  end)
  r1 = load_asset(with_pages, "/assets/app-3cfac71d5552d1426de906087a8be2fe.css", "content/assets/app-3cfac71d5552d1426de906087a8be2fe.css")
  load_asset(r1, "/static/d3.v7.min.js", "content/assets/d3.v7.min.js")
end

# Blimp in the browser: its interpreter, loader, view host and canvas, all
# synced from one Blimp commit (static/blimp/sync.sh); the renderer program
# post pages run; and /tetris.
def tetris_routes(routes: Map) -> Map do
  commit = trim(read_file("static/blimp/BLIMP_COMMIT"))
  lines = length(split(trim_right(read_file("static/tetris/tetris.blimp")), "\n"))
  runtime = reduce(["blimp.wasm", "blimp.js", "blimp-view.js", "canvas.js", "runtime.js", "page-canvas.js"], routes, fn(acc: Map, f: String) -> Map do
    load_asset(acc, concat("/blimp/", f), concat("static/blimp/", f))
  end)
  r1 = load_asset(runtime, "/blimp/post.js", "static/post/post.js")
  r1a = load_asset(r1, "/blimp/post-worker.js", "static/post/post-worker.js")
  r2 = load_asset(r1a, "/blimp/post-renderer.blimp", "_build/post-renderer.blimp")
  r3 = load_asset(r2, "/assets/blimp-window.css", "assets/blimp-window.css")
  r4 = load_asset(r3, "/tetris/tetris.blimp", "static/tetris/tetris.blimp")
  r5 = load_asset(r4, "/tetris/play.js", "static/tetris/play.js")
  r6 = load_asset(r5, "/assets/tetris.css", "assets/tetris.css")
  page_route(r6, "/tetris", tetris_page(commit, lines))
end

def pong_routes(routes: Map) -> Map do
  r1 = load_asset(routes, "/pong/pong.blimp", "static/pong/pong.blimp")
  r2 = load_asset(r1, "/pong/play.js", "static/pong/play.js")
  r3 = load_asset(r2, "/pong/god.blimp", "static/pong/god.blimp")
  r4 = load_asset(r3, "/pong/god.js", "static/pong/god.js")
  r5 = load_asset(r4, "/assets/pong.css", "assets/pong.css")
  page_route(r5, "/pong/god", pong_god_page())
end

# /wordle and /wordle_god (src/93_wordle.blimp): the rules in _build, the
# allowed guesses as text the page fetches.
def wordle_routes(routes: Map) -> Map do
  r1 = load_asset(routes, "/wordle/wordle.blimp", "_build/wordle.blimp")
  r2 = load_asset(r1, "/wordle/god.blimp", "_build/wordle-god.blimp")
  r3 = load_asset(r2, "/wordle/live.js", "static/wordle/live.js")
  r4 = load_asset(r3, "/wordle/words.txt", "static/wordle/words.txt")
  r5 = page_route(r4, "/wordle", wordle_page())
  page_route(r5, "/wordle_god", wordle_god_page())
end

# The pages that are one Blimp program each (src/95_apps.blimp).
def app_routes(routes: Map) -> Map do
  r1 = load_asset(routes, "/blimp/app.js", "static/blimp/app.js")
  r2 = load_asset(r1, "/assets/apps.css", "assets/apps.css")
  r3 = load_asset(r2, "/2048/twenty48.blimp", "_build/twenty48.blimp")
  r4 = page_route(r3, "/mirror", mirror_page(read_file("_build/site.blimp")))
  r4a = load_asset(r4, "/typewriter/typewriter.blimp", "static/typewriter/typewriter.blimp")
  r4b = load_asset(r4a, "/assets/typewriter.css", "assets/typewriter.css")
  r4c0 = page_route(r4b, "/markdown-editor", app_page("Markdown Editor", "A Markdown editor with a live preview, rendered in your browser by the Blimp code that renders this site's posts.", [APP_CSS], "", "/markdown-editor/editor.blimp", "editor"))
  r4d0 = load_asset(r4c0, "/markdown-editor/editor.blimp", "_build/editor.blimp")
  r4d1a = load_asset(r4d0, "/phish/phish.blimp", "_build/phish.blimp")
  r4d1b = load_asset(r4d1a, "/moon_phish/moon.blimp", "_build/moon.blimp")
  r4d1c0 = load_asset(r4d1b, "/assets/moon_phish.css", "assets/moon_phish.css")
  r4d1c = load_asset(r4d1c0, "/assets/work_log.css", "assets/work_log.css")
  r4d1h = load_asset(r4d1c, "/hacker-news/hn.blimp", "static/hn/hn.blimp")
  r4d1i = page_route(r4d1h, "/hacker-news", app_page("Top Hacker News Stories", "Real-time feed of top Hacker News stories", [APP_CSS], "", "/hacker-news/hn.blimp", "hn"))
  r4d1 = page_route(r4d1i, "/moon_phish", app_page("Moon Phish — every Phish show vs. the lunar calendar", "Every Phish show since 1983, checked against the instant of every full moon.", [APP_CSS, "/assets/moon_phish.css"], "", "/moon_phish/moon.blimp", "moon"))
  r4e = reduce(TEMPER_SNAKE_FILES, r4d1, fn(acc: Map, f: String) -> Map do
    load_asset(acc, concat("/static/temper-snake/", f), concat(STATIC_DIR, "/static/temper-snake/", f))
  end)
  r4e1 = load_asset(r4e, "/snake/play.js", "static/snake/play.js")
  r4f = page_route(r4e1, "/temper-snake", temper_snake_page())
  r4d = page_route(r4f, "/phish", app_page_with("phangraphs — Phish 3.0 Jam Analytics", "Phish 3.0 jam analytics — like FanGraphs, but for jams. Batting averages, jamchart rates, duration timelines, and deep dives for every song since 2009.", [APP_CSS], "", "/phish/phish.blimp", "ph", true))
  r4c = page_route(r4d, "/typewriter", app_page("Experiment - sorta typewriter", "See what key you are pressing. It also will keep what you type on hand to print if you want", [APP_CSS, "/assets/typewriter.css"], "", "/typewriter/typewriter.blimp", "typewriter"))
  r4g = load_asset(r4c, "/bookmarks/bookmarks.blimp", "static/bookmarks/bookmarks.blimp")
  r4h = page_route(r4g, "/bookmarks", app_page("My Bookmarks", "My Bookmarks", [APP_CSS], "", "/bookmarks/bookmarks.blimp", "bookmarks"))
  page_route(r4h, "/2048", app_page("2048 — Blitz Edition", "The classic 2048 puzzle with a twist: Blitz mode gives you seconds per move. Adjustable board sizes up to 12x12. Retro 1980s Macintosh style.", [APP_CSS], "twenty48-page", "/2048/twenty48.blimp", "game"))
end


# /stack: the site from source to screen, a Blimp program in the browser
# (static/stack/stack.blimp) over the graph and its layout in Temper
# (temper/src/stack), built into _build/stack.blimp.
def stack_routes(routes: Map) -> Map do
  r1 = load_asset(routes, "/stack/stack.blimp", "_build/stack.blimp")
  r2 = load_asset(r1, "/assets/stack.css", "assets/stack.css")
  page_route(r2, "/stack", app_page("bobbby.online, from source to screen", "Every compiler, build step, file, process and service between this site's source and your screen, as a diagram you can click through. A Blimp program; the graph is Temper.", ["/assets/stack.css"], "stack-page", "/stack/stack.blimp", "stack"))
end

# Everything that is not a fixed route. Only GET and HEAD reach here.
# The homepage is here because its state is in the query string.
def dynamic(req: Map, routes: Map, posts: List, desk: Map) -> Map do
  path = req.path
  case path do
    "/" -> html_response(200, desktop_page(req.query, desk, now()))
    # a new game id for every visit, so never a cached page
    "/pong" -> response(200, "text/html; charset=utf-8", "no-store", pong_page(pong_game_id()))
    "/directory" -> html_response(200, page_with_runtime(directory_page(desk)))
    # the tables are live, so the page is never stale; the files are src/93_blackjack.blimp's
    "/blackjack" -> response(200, "text/html; charset=utf-8", "no-cache", blackjack_page())
    "/blackjack/blackjack.blimp" -> BJ_PROGRAM
    "/blackjack/play.js" -> BJ_JS
    # the room is live; the page and its files are src/94_cursor_tracker.blimp's
    "/cursor-tracker" -> CT_PAGE
    "/cursor-tracker/cursors.blimp" -> CT_PROGRAM
    "/cursor-tracker/cursors.js" -> CT_JS
    # the title names the seed in the URL; the files are src/94_art.blimp's
    "/art" -> response(200, "text/html; charset=utf-8", "public, max-age=300", art_page(req.query))
    "/art/art.blimp" -> ART_PROGRAM
    # Chess-9 (src/96_chess_lv.blimp): the page, its program and its css
    "/chess-lv" -> CHESS_LV_PAGE
    "/chess-lv/chess_lv.blimp" -> CHESS_LV_PROGRAM
    "/chess-lv/chess_lv.css" -> CHESS_LV_CSS
    # Tag a Wook (src/97_map.blimp): the page, its program, Leaflet with map.js, the css, the pin
    "/map" -> MAP_PAGE
    "/map/map.blimp" -> MAP_PROGRAM
    "/map/map.js" -> MAP_JS
    "/map/map.css" -> MAP_CSS
    "/map/images/marker-icon.png" -> MAP_ICON
    "/map/images/marker-icon-2x.png" -> MAP_ICON_2X
    "/map/images/marker-shadow.png" -> MAP_SHADOW
    # How many people live here (src/99_nyc_census.blimp): the page, its
    # program and map, and the rows the program estimates from
    "/nyc_census_and_pluto" -> NYC_CENSUS_PAGE
    "/nyc_census_and_pluto/census.blimp" -> NYC_CENSUS_PROGRAM
    "/nyc_census_and_pluto/map.js" -> NYC_CENSUS_JS
    "/nyc_census_and_pluto/tracts.json" -> nyc_tracts_response()
    "/nyc_census_and_pluto/lots.json" -> nyc_lots_response(req.query)
    # the firehose pages (src/98_firehose.blimp): /reddit-links, /emoji-skeets, /jetstream_comparison
    "/reddit-links" -> FH_YOUTUBE_PAGE
    "/emoji-skeets" -> FH_SKEETS_PAGE
    "/jetstream_comparison" -> FH_COMPARE_PAGE
    "/firehose/youtube.blimp" -> FH_YOUTUBE_PROGRAM
    "/firehose/skeets.blimp" -> FH_SKEETS_PROGRAM
    "/firehose/compare.blimp" -> FH_COMPARE_PROGRAM
    "/firehose/firehose.js" -> FH_JS
    # Fill The Sky (src/96_sky.blimp): the page, its program, map, layout and
    # points, and a clicked account's profile
    "/sky" -> SKY_PAGE
    "/sky/sky.blimp" -> SKY_PROGRAM
    "/sky/sky.js" -> SKY_JS
    "/sky/deck.gl-9.2.9.min.js" -> SKY_DECK
    "/sky/layout.json" -> SKY_LAYOUT
    "/sky/profile.json" -> sky_profile_json(query_param(req.query, "handle"))
    "/assets/sky.css" -> SKY_CSS
    "/sky/points.json.gz" -> SKY_POINTS
    # the MTA bus map (src/99_mta.blimp): the page, its program, Leaflet with mta.js
    "/mta-bus-map" -> MTA_PAGE
    "/mta-bus-map/mta.blimp" -> MTA_PROGRAM
    "/mta-bus-map/mta.js" -> MTA_JS
    # Phish Lab (src/99_phish_lab.blimp): the page, its program, pointer
    # script and css, and the two datasets it charts
    "/phish_lab" -> PL_PAGE
    "/phish_lab/phish_lab.blimp" -> PL_PROGRAM
    "/phish_lab/phish_lab.js" -> PL_JS
    "/assets/phish_lab.css" -> PL_CSS
    "/phish_lab/lab.json" -> PL_MAIN
    "/phish_lab/perfs.json" -> PL_PERFS
    # the iCloud album (src/99_gallery.blimp): the page and its script; the
    # photos, /gallery/img/:guid/:size, are gallery_or_404's
    "/gallery" -> gallery_route(path)
    "/gallery/gallery.js" -> GAL_JS
    # The Ziggy Account (src/99_ziggy.blimp): the page, its program, the
    # explorer and its css, and the graph the explorer draws
    "/ziggy" -> ZG_PAGE
    "/ziggy/ziggy.blimp" -> ZG_PROGRAM
    "/ziggy/ziggy.js" -> ZG_JS
    "/ziggy/ziggy.css" -> ZG_CSS
    "/ziggy/graph.json" -> ZG_GRAPH_JSON
    # Role Call (src/99_role_call.blimp): the page, its program, script,
    # sunflower and css, and Blog.RoleCall's queries
    "/role-call" -> RC_PAGE
    "/role-call/role_call.blimp" -> RC_PROGRAM
    "/role-call/role_call.js" -> RC_JS
    "/role-call/sunflower.blimp" -> RC_SUNFLOWER
    "/role-call/sunflower.js" -> RC_SUNFLOWER_JS
    "/assets/role_call.css" -> RC_CSS
    "/role-call/count.json" -> role_call_api(path, req.query)
    "/role-call/search.json" -> role_call_api(path, req.query)
    "/role-call/picks.json" -> role_call_api(path, req.query)
    "/role-call/recs.json" -> role_call_api(path, req.query)
    "/role-call/show.json" -> role_call_api(path, req.query)
    "/role-call/person.json" -> role_call_api(path, req.query)
    "/role-call/titles.json" -> role_call_api(path, req.query)
    # bobby's links, the other pages (src/99_blinks_pages.blimp): surf, walk,
    # tv, review and privacy, and what their programs ask for
    "/blinks-next/surf" -> blinks_pages_route(path, req.query)
    "/blinks-next/walk" -> blinks_pages_route(path, req.query)
    "/blinks-next/tv" -> blinks_pages_route(path, req.query)
    "/blinks-next/review" -> blinks_pages_route(path, req.query)
    "/blinks-next/privacy" -> blinks_pages_route(path, req.query)
    "/blinks-next/surf.blimp" -> blinks_pages_route(path, req.query)
    "/blinks-next/walk.blimp" -> blinks_pages_route(path, req.query)
    "/blinks-next/tv.blimp" -> blinks_pages_route(path, req.query)
    "/blinks-next/review.blimp" -> blinks_pages_route(path, req.query)
    "/blinks-next/pages.css" -> blinks_pages_route(path, req.query)
    "/blinks-next/pick.json" -> blinks_pages_route(path, req.query)
    "/blinks-next/walk.json" -> blinks_pages_route(path, req.query)
    "/blinks-next/review.json" -> blinks_pages_route(path, req.query)
    # bobby's links, read side (src/99_blinks.blimp): Phoenix's GET API at
    # its own paths and under /blinks-next, the feed, and the two pages
    "/api/blinks" -> blinks_route(path, req.query)
    "/api/blinks/tags" -> blinks_route(path, req.query)
    "/api/blinks/random" -> blinks_route(path, req.query)
    "/api/blinks/lookup" -> blinks_route(path, req.query)
    "/api/blinks/export" -> blinks_route(path, req.query)
    "/blinks.rss" -> blinks_route(path, req.query)
    "/blinks-next/api/blinks" -> blinks_route(path, req.query)
    "/blinks-next/api/blinks/tags" -> blinks_route(path, req.query)
    "/blinks-next/api/blinks/random" -> blinks_route(path, req.query)
    "/blinks-next/api/blinks/lookup" -> blinks_route(path, req.query)
    "/blinks-next/api/blinks/export" -> blinks_route(path, req.query)
    "/blinks-next/blinks.rss" -> blinks_route(path, req.query)
    "/blinks-next" -> BLK_PAGE
    "/blinks-next/reader" -> BLK_READER_PAGE
    "/blinks-next/blinks.blimp" -> BLK_PROGRAM
    "/blinks-next/reader.blimp" -> BLK_READER_PROGRAM
    "/blinks-next/page.json" -> blinks_route(path, req.query)
    "/blinks-next/stumble" -> blinks_route(path, req.query)
    "/assets/blinks.css" -> BLK_CSS
    "/work-log" ->
      page = work_log_page()
      case page do
        nil -> response(503, "text/plain; charset=utf-8", "no-cache", "The work log could not be read just now.\n")
        _ -> response(200, "text/html; charset=utf-8", "public, max-age=60", page)
      end
    _ ->
      api = phish_api(path, req.query)
      case api do
        nil ->
          moon_json = moon_api(path)
          case moon_json do
            nil ->
              hn = hn_api(path)
              case hn do
                nil -> gallery_or_404(path)
                _ -> hn
              end
            _ -> moon_json
          end
        _ -> api
      end
  end
end

# /gallery/img/:guid/:size is a prefix, which dynamic()'s case cannot match
def gallery_or_404(path: String) -> Map do
  photo = gallery_route(path)
  case photo do
    nil -> blinks_or_404(path)
    _ -> photo
  end
end

def static_or_404(path: String) -> Map do
  case starts_with(path, "/images/") and safe_static_path(path) do
    true ->
      body = read_file(concat(STATIC_DIR, path))
      case body do
        nil -> html_response(404, not_found_page(path))
        _ -> response(200, content_type_for(path), "public, max-age=3600", body)
      end
    false ->
      case ends_with(path, "/") and length(path) > 1 do
        true -> redirect(take(path, length(path) - 1))
        false -> html_response(404, not_found_page(path))
      end
  end
end

# The response bytes for one raw request, and its status for the log line.
def handle(raw: String, routes: Map, posts: List, desk: Map, home: List) -> Tuple do
  req = parse_request(raw)
  case req.method == "GET" or req.method == "HEAD" do
    # POST, PATCH, PUT, DELETE: src/41_web.blimp's routes, else 405 with Allow
    false -> web_handle(raw, req)
    true ->
      fixed = case req.path == "/" and req.query == "" do
        true -> bare_home(home)
        false -> lookup(routes, req.path)
      end
      case fixed do
        nil ->
          # src/41_web.blimp's GET routes, then everything that was here before
          web = web_handle(raw, req)
          case web do
            nil ->
              resp = dynamic(req, routes, posts, desk)
              {serialize(resp, req.method), resp.status, req}
            _ -> web
          end
        _ ->
          case req.method == "HEAD" do
            true -> {head_of(fixed), 200, req}
            false -> {fixed, 200, req}
          end
      end
  end
end

def web_handle(raw: String, req: Map) -> Any do
  web_dispatch(raw, req, WEB_ROUTES, WEB_SECRET)
end

# The homepage with no query string is most of the traffic to "/", and all
# of it is the same page except the clock in the menu bar. Rendering it per
# request cost a worker about 0.8MB of garbage, so it is rendered once at
# boot, cut at the clock, and the time is put back per request. The clock
# is always eight bytes ("%I:%M %p"), so the prebuilt Content-Length holds.
def home_parts(desk: Map) -> List do
  marker = desk_clock(0)
  wire = serialize(html_response(200, desktop_page("", desk, 0)), "GET")
  parts = split(wire, marker)
  case length(parts) == 2 and length(desk_clock(now())) == length(marker) do
    true -> parts
    false ->
      print("the homepage clock is not a unique, fixed-width marker; cannot prebuild /")
      exit(1)
  end
end

def bare_home(parts: List) -> String do
  join([head(parts), desk_clock(now()), last(parts)], "")
end

# A prebuilt response with its body cut off, for HEAD.
def head_of(wire: String) -> String do
  concat(take(wire, index_of(wire, "\r\n\r\n")), "\r\n\r\n")
end

# One connection: wait briefly for its request (a socket accepted from a
# non-blocking listener is non-blocking itself on some systems), answer it,
# close it, log a line.
def serve_client(c: Int, desk: Map, home: List, room: Bool) -> Any do
  t0 = now_ms()
  ready = tcp_poll([c], 2000)
  raw = case length(ready) > 0 do
    # the rest of a body that did not come with its headers (src/41_web.blimp)
    true -> web_read_rest(c, tcp_read(c))
    false -> nil
  end
  case raw do
    nil ->
      tcp_close(c)
      ""
    _ ->
      case is_upgrade(raw) do
        true -> upgrade(c, raw, room)
        false ->
          result = handle(raw, routes, posts, desk, home)
          tcp_write(c, elem(result, 0))
          tcp_close(c)
          req = elem(result, 2)
          puts(concat(req.method, " ", req.path, " ", to_string(elem(result, 1)), " ", to_string(now_ms() - t0), "ms"))
          concat(req.method, " ", req.path)
      end
  end
end

# A WebSocket for /live/pong?game=<id> (a game reporting) or /live/pong-god
# (a page watching all of them): the socket, to be kept, or 1 when the
# request was answered and closed instead.
def upgrade(c: Int, raw: String, room: Bool) -> Any do
  req = parse_request(raw)
  game = query_param(req.query, "game")
  kind = case req.path do
    "/live/pong" ->
      case starts_with(game, "pong_") and length(game) <= 40 and desk_url_safe(game) do
        true -> :player
        false -> nil
      end
    "/live/pong-god" -> :god
    "/live/wordle" ->
      case starts_with(game, "wd_") and length(game) <= 40 and desk_url_safe(game) do
        true -> :wordle
        false -> nil
      end
    "/live/wordle-god" -> :wordle_god
    "/live/runtime" -> :runtime
    "/live/blackjack" -> :blackjack
    "/live/cursors" -> :cursors
    "/live/map" -> :map
    "/live/firehose" -> :firehose
    "/live/mta" -> :mta
    "/live/ziggy" -> :ziggy
    "/live/blinks" -> :blinks
    _ -> nil
  end
  case kind == nil or not(room) do
    true ->
      status = case room do
        true -> 404
        false -> 503
      end
      tcp_write(c, serialize(response(status, "text/plain", "no-cache", "no such socket\n"), "GET"))
      tcp_close(c)
      puts(concat("WS ", req.path, " ", to_string(status)))
      concat("WS ", req.path)
    false ->
      tcp_write(c, ws_handshake(raw))
      puts(concat("WS ", req.path, " 101 ", game))
      # a blackjack player sits down in the lobby, and is sent it at once
      case kind == :blackjack do
        true -> BJ <- :join(c)
        false -> :ok
      end
      # a cursor tracker visitor is given an id and sent the room
      case kind == :cursors do
        true -> CURSORS <- :join(c)
        false -> :ok
      end
      # a /map page is sent every tag
      case kind == :map do
        true -> MAP_ROOM <- :join(c)
        false -> :ok
      end
      # a firehose page is sent what it watches (the YouTube grid at once)
      case kind == :firehose do
        true -> FIREHOSE <- :join(c, query_param(req.query, "page"))
        false -> :ok
      end
      # an MTA bus map page, which says what it watches once it is open
      case kind == :mta do
        true -> MTA <- :join(c)
        false -> :ok
      end
      # a /ziggy page is told whether its chat can be unlocked
      case kind == :ziggy do
        true -> ZG <- :join(c)
        false -> :ok
      end
      # a /blinks-next page hears of every save and who is in which chat
      case kind == :blinks do
        true -> bkl_join(ROOMS, c)
        false -> :ok
      end
      %{fd: c, kind: kind, game: game, buf: ""}
  end
end

# Every connection that is waiting now, then stop: the tick must return.
# Every connection that is waiting now, then stop: the tick must return.
# {what was answered, newest first ("GET /blog"), sockets}, the sockets
# with any new WebSockets added.
def accept_all(fd: Int, answered: List, desk: Map, home: List, socks: Map) -> Tuple do
  c = tcp_accept(fd)
  case c do
    nil -> {answered, socks}
    _ ->
      got = serve_client(c, desk, home, length(keys(socks)) < LIVE_MAX_SOCKETS)
      case type_of(got) do
        :map -> accept_all(fd, answered, desk, home, put(socks, to_string(got.fd), got))
        _ ->
          case got do
            "" -> accept_all(fd, answered, desk, home, socks)
            _ -> accept_all(fd, [got | answered], desk, home, socks)
          end
      end
  end
end

def map_without(m: Map, gone: Any) -> Map do
  reduce(keys(m), %{}, fn(acc: Map, k: Any) -> Map do
    case k == gone do
      true -> acc
      false -> put(acc, k, lookup(m, k))
    end
  end)
end

# A socket closed, from either end: forget it, and its game if it had one.
# {socks, games, changed}
def drop_socket(sock: Map, socks: Map, games: Map, why: String) -> Tuple do
  tcp_close(sock.fd)
  puts(concat("WS closed ", to_string(sock.kind), " ", sock.game, " ", why))
  case sock.kind do
    :player -> {map_without(socks, to_string(sock.fd)), map_without(games, sock.game), true}
    :blackjack ->
      BJ <- :leave(sock.fd)
      {map_without(socks, to_string(sock.fd)), games, false}
    :cursors ->
      CURSORS <- :leave(sock.fd)
      {map_without(socks, to_string(sock.fd)), games, false}
    :map ->
      MAP_ROOM <- :leave(sock.fd)
      {map_without(socks, to_string(sock.fd)), games, false}
    :firehose ->
      FIREHOSE <- :leave(sock.fd)
      {map_without(socks, to_string(sock.fd)), games, false}
    :mta ->
      MTA <- :leave(sock.fd)
      {map_without(socks, to_string(sock.fd)), games, false}
    :ziggy ->
      ZG <- :leave(sock.fd)
      {map_without(socks, to_string(sock.fd)), games, false}
    :blinks ->
      bkl_leave(ROOMS, sock.fd)
      {map_without(socks, to_string(sock.fd)), games, false}
    _ -> {map_without(socks, to_string(sock.fd)), games, false}
  end
end

# The sockets ROOMS would not write to this tick, closed. {socks, games, changed}
def rooms_kick(fds: List, read: Tuple) -> Tuple do
  reduce(fds, read, fn(acc: Tuple, fd: Int) -> Tuple do
    sock = lookup(elem(acc, 0), to_string(fd))
    case sock == nil do
      true -> acc
      false ->
        r = drop_socket(sock, elem(acc, 0), elem(acc, 1), "too far behind")
        {elem(r, 0), elem(r, 1), elem(acc, 2) or elem(r, 2)}
    end
  end)
end

# Read what a ready socket has and act on every whole frame in it.
def live_read(sock: Map, socks: Map, games: Map) -> Tuple do
  data = tcp_read(sock.fd)
  case data do
    nil -> {socks, games, false}
    "" -> drop_socket(sock, socks, games, "by the browser")
    _ -> live_frames(put(sock, :buf, concat(sock.buf, data)), socks, games, false)
  end
end

def live_frames(sock: Map, socks: Map, games: Map, changed: Bool) -> Tuple do
  case ws_next(sock.buf) do
    :more -> {put(socks, to_string(sock.fd), sock), games, changed}
    {:bad, reason} ->
      tcp_write(sock.fd, ws_frame(8, concat(from_char_code(3), from_char_code(234))))
      after_drop = drop_socket(sock, socks, games, reason)
      {elem(after_drop, 0), elem(after_drop, 1), true}
    {:frame, op, payload, rest} ->
      next = put(sock, :buf, rest)
      case op do
        1 ->
          case sock.kind do
            :player ->
              report = pong_report(sock.game, payload)
              case report do
                nil ->
                  tcp_write(sock.fd, ws_frame(8, concat(from_char_code(3), from_char_code(235))))
                  after_bad = drop_socket(sock, socks, games, "a report that is not one")
                  {elem(after_bad, 0), elem(after_bad, 1), true}
                _ -> live_frames(next, socks, put(games, sock.game, report), true)
              end
            # an action at the tables; BJ sends every player the result itself
            :blackjack ->
              BJ <- :recv(sock.fd, payload)
              live_frames(next, socks, games, changed)
            # a move, a point or a clear; CURSORS sends the room itself
            :cursors ->
              CURSORS <- :recv(sock.fd, payload)
              live_frames(next, socks, games, changed)
            # a tag; MAP_ROOM sends it to every /map page itself
            :map ->
              MAP_ROOM <- :recv(sock.fd, payload)
              live_frames(next, socks, games, changed)
            # which routes a bus map page watches, or its Update button
            :mta ->
              MTA <- :recv(sock.fd, payload)
              live_frames(next, socks, games, changed)
            # an unlock, a question or a suggestion; ZG answers it itself
            :ziggy ->
              ZG <- :recv(sock.fd, payload)
              live_frames(next, socks, games, changed)
            # which link's chat room it has open (src/99_blinkslive.blimp)
            :blinks ->
              bkl_recv(ROOMS, sock.fd, payload)
              live_frames(next, socks, games, changed)
            :wordle ->
              taken = WORDLE <- :report(sock.game, payload)
              case taken do
                true -> live_frames(next, socks, games, changed)
                false ->
                  tcp_write(sock.fd, ws_frame(8, concat(from_char_code(3), from_char_code(235))))
                  after_wd = drop_socket(sock, socks, games, "a wordle report that is not one")
                  {elem(after_wd, 0), elem(after_wd, 1), changed}
              end
            :wordle_god ->
              said = WORDLE <- :command(payload)
              tcp_write(sock.fd, ws_frame(1, json_encode(%{message: said})))
              live_frames(next, socks, games, changed)
            _ -> live_frames(next, socks, games, changed)
          end
        8 ->
          tcp_write(sock.fd, ws_frame(8, ""))
          after_close = drop_socket(sock, socks, games, "with a close frame")
          {elem(after_close, 0), elem(after_close, 1), true}
        9 ->
          tcp_write(sock.fd, ws_frame(10, payload))
          live_frames(next, socks, games, changed)
        10 -> live_frames(next, socks, games, changed)
        _ ->
          after_bad = drop_socket(sock, socks, games, concat("opcode ", to_string(op)))
          {elem(after_bad, 0), elem(after_bad, 1), true}
      end
  end
end

# Every ready socket, in turn. {socks, games, changed}
def live_read_all(ready: List, socks: Map, games: Map, changed: Bool) -> Tuple do
  case ready do
    [] -> {socks, games, changed}
    [fd | rest] ->
      sock = lookup(socks, to_string(fd))
      case sock do
        nil -> live_read_all(rest, socks, games, changed)
        _ ->
          r = live_read(sock, socks, games)
          live_read_all(rest, elem(r, 0), elem(r, 1), changed or elem(r, 2))
      end
  end
end

def sockets_of(socks: Map, kind: Atom) -> List do
  filter(values(socks), fn(s: Map) -> Bool do s.kind == kind end)
end

# Every god page is sent every game.
def push_gods(socks: Map, games: Map) -> Int do
  frame = ws_frame(1, pong_games_json(games))
  gods = sockets_of(socks, :god)
  each(gods, fn(s: Map) do tcp_write(s.fd, frame) end)
  length(gods)
end

RUNTIME_PUSH_MS = 250
RUNTIME_MAX_RAYS = 80

# What a runtime window is sent: runtime_snapshot()'s actors, and as its
# messages the sends since the last push plus one ray per request answered
# (to the Site, from outside it: "GET /blog"). {pending rays, pushed_at}
def push_runtime(socks: Map, answered: List, pending: List, pushed_at: Int) -> Tuple do
  watchers = sockets_of(socks, :runtime)
  case watchers do
    [] -> {[], pushed_at}
    _ ->
      snap = runtime_snapshot()
      site_ref = runtime_site_ref(snap.actors)
      asked = map(reverse(answered), fn(line: String) -> Map do %{target: site_ref, from: nil, message: line} end)
      rays = take_rays(list_append(pending, list_append(snap.messages, asked)), RUNTIME_MAX_RAYS)
      t = now_ms()
      case t - pushed_at >= RUNTIME_PUSH_MS do
        false -> {rays, pushed_at}
        true ->
          frame = ws_frame(1, json_encode(%{actors: snap.actors, messages: rays}))
          each(watchers, fn(s: Map) do tcp_write(s.fd, frame) end)
          {[], t}
      end
  end
end

def runtime_site_ref(actors: List) -> String do
  sites = filter(actors, fn(a: Map) -> Bool do a.type == "Site" end)
  case sites do
    [] -> ""
    [a | _] -> a.ref
  end
end

# The last n, oldest first: a burst of requests is not a backlog.
def take_rays(rays: List, n: Int) -> List do
  reverse(take_first(reverse(rays), n, []))
end

def take_first(list: List, n: Int, acc: List) -> List do
  case n <= 0 do
    true -> reverse(acc)
    false ->
      case list do
        [] -> reverse(acc)
        [h | rest] -> take_first(rest, n - 1, [h | acc])
      end
  end
end

def has_fd(fds: List, fd: Int) -> Bool do
  case fds do
    [] -> false
    [h | rest] ->
      case h == fd do
        true -> true
        false -> has_fd(rest, fd)
      end
  end
end

def socket_fds(socks: Map) -> List do
  map(values(socks), fn(s: Map) -> Int do s.fd end)
end

# One tick's worth of the network: wait up to 100ms for the listener or any
# socket, accept every connection waiting, read every socket that is ready,
# and send the god pages the games if they changed (at most every 50ms).
# {requests answered, socks, games, dirty, pushed_at}
def live_tick(fd: Int, desk: Map, home: List, socks: Map, games: Map, dirty: Bool, pushed_at: Int) -> Tuple do
  # the work that waits on other servers, a step at a time
  HN <- :step
  MTA <- :step
  GALLERY <- :step
  ZG <- :step
  ready = tcp_poll([fd | socket_fds(socks)], 100)
  accepted = case has_fd(ready, fd) do
    true -> accept_all(fd, [], desk, home, socks)
    false -> {[], socks}
  end
  joined = length(keys(elem(accepted, 1))) > length(keys(socks))
  read = live_read_all(ready, elem(accepted, 1), games, dirty or joined)
  WORDLE <- :push(elem(read, 0))
  CURSORS <- :push(now_ms(), now())
  # what the rooms said this tick goes out, one write a socket
  # (src/89_rooms.blimp); a socket too far behind to be sent it is closed
  flushed = ROOMS <- :flush
  read = rooms_kick(flushed.kicked, read)
  # the Bluesky relays: drain what arrived, push to the firehose pages
  FIREHOSE <- :tick(now_ms())
  t = now_ms()
  case elem(read, 2) and t - pushed_at >= 50 do
    true ->
      push_gods(elem(read, 0), elem(read, 1))
      {elem(accepted, 0), elem(read, 0), elem(read, 1), false, t}
    false -> {elem(accepted, 0), elem(read, 0), elem(read, 1), elem(read, 2), pushed_at}
  end
end

# The museum and Finder from Postgres, built into a desktop:
# {:ok, desk, db} or {:error, reason, db}, where db is nil once the
# connection is gone (the next refresh connects again).
def refresh_desk(db: Any, opts: Map) -> Tuple do
  conn = case db do
    nil -> pg_connect(opts)
    _ -> {:ok, db}
  end
  case conn do
    {:error, reason} -> {:error, reason, nil}
    {:ok, live} ->
      case load_desk_db(live) do
        {:ok, museum, finder, next} -> {:ok, build_desktop(museum, finder, ICONS, posts), next}
        {:error, reason, next} -> {:error, reason, next}
      end
  end
end

actor Site do
  state fd: Int :: -1
  state served: Int :: 0
  state booted_at: Int :: 0
  state desk: Map :: %{}
  state home: List :: []
  state db: Any :: nil
  state db_opts: Any :: nil
  state desk_at: Int :: 0
  state desk_error: String :: ""
  state socks: Map :: %{}
  state games: Map :: %{}
  state dirty: Bool :: false
  state pushed_at: Int :: 0
  state rt_pending: List :: []
  state rt_at: Int :: 0

  on :start(port: Int, first: Map, conn: Any, opts: Any) do
    s = tcp_listen(port)
    tcp_set_nonblocking(s)
    become fd: s, booted_at: now(), desk: first, home: home_parts(first), db: conn, db_opts: opts, desk_at: now()
    reply s
  end

  on :tick do
    live = live_tick(fd, desk, home, socks, games, dirty, pushed_at)
    n = length(elem(live, 0))
    rt = push_runtime(elem(live, 1), elem(live, 0), rt_pending, rt_at)
    case db_opts != nil and now() - desk_at >= DESK_REFRESH_S do
      false ->
        become served: served + n, socks: elem(live, 1), games: elem(live, 2), dirty: elem(live, 3), pushed_at: elem(live, 4), rt_pending: elem(rt, 0), rt_at: elem(rt, 1)
        reply n
      true ->
        case refresh_desk(db, db_opts) do
          {:ok, fresh, next} ->
            become served: served + n, socks: elem(live, 1), games: elem(live, 2), dirty: elem(live, 3), pushed_at: elem(live, 4), rt_pending: elem(rt, 0), rt_at: elem(rt, 1), desk: fresh, home: home_parts(fresh), db: next, desk_at: now(), desk_error: ""
            reply n
          {:error, reason, next} ->
            puts(concat("museum refresh failed, still showing the one from ", format_time(desk_at, "%H:%M:%S"), ": ", reason))
            become served: served + n, socks: elem(live, 1), games: elem(live, 2), dirty: elem(live, 3), pushed_at: elem(live, 4), rt_pending: elem(rt, 0), rt_at: elem(rt, 1), db: next, desk_at: now(), desk_error: reason
            reply n
        end
    end
  end

  # From the prompt: the games /pong/god is being sent, and the sockets.
  on :games do
    reply games
  end

  on :sockets do
    reply map(values(socks), fn(s: Map) -> List do [s.fd, s.kind, s.game] end)
  end

  # From the prompt: `site <- :desk` is what "/" is drawn from right now,
  # `site <- :desk_error` why the last refresh kept it ("" if it did not).
  on :desk do
    reply desk
  end

  on :desk_error do
    reply desk_error
  end

  on :served do
    reply served
  end
end

t_boot = now_ms()
posts = load_posts(POSTS_DIR, read_file("data/posts.txt"))
ICONS = desk_load_icons(desk_read("data/icons.txt"))
routes = build_routes(posts)
routes = stack_routes(routes)
# src/41_web.blimp: the routes that take methods, bodies and sessions, and
# the key their sessions are signed with (a production site without
# SESSION_SECRET stops here).
# src/99_blinkswrite.blimp: BlinkController's token-gated writes
WEB_ROUTES = list_append(list_append(list_append(web_demo_routes(), blinks_write_routes()), blinks_anon_routes()), blinks_live_routes())
WEB_SECRET = web_session_secret()

# DATABASE_URL set: the museum and Finder are Postgres rows, and a site
# that cannot read them does not start. Unset (a laptop, the tests): the
# data/*.tsv snapshot, and the boot line says so.
DB_OPTS = case getenv("DATABASE_URL") do
  nil -> nil
  "" -> nil
  url ->
    parsed = pg_parse_url(url)
    case parsed do
      nil -> desk_die("DATABASE_URL is not a postgres:// or ecto:// URL")
      _ -> parsed
    end
end
first = case DB_OPTS do
  nil -> {:ok, load_desktop("data", posts), nil}
  _ -> refresh_desk(nil, DB_OPTS)
end
case first do
  {:error, reason, _} -> desk_die(concat("cannot load the museum from Postgres: ", reason))
  _ -> :ok
end
DB <- :open(DB_OPTS)
# /map's tags are rows in tag_ins; without a database, the snapshot in data/
case DB_OPTS do
  nil -> MAP_ROOM <- :offline(map_snapshot())
  _ -> :ok
end
# Moon Phish's annotated shows take about two seconds to compute, and the
# one process answers nothing else meanwhile: better at boot than during
# someone's request.
case DB_OPTS do
  nil -> :ok
  _ -> MOON <- :json
end
# The Bluesky relay is held from boot, so /reddit-links has videos to show
# its first visitor; FIREHOSE=off (a laptop without network) leaves it shut.
case getenv("FIREHOSE") do
  "off" -> :ok
  _ -> RELAY_HOSE <- :want(true)
end
# The MTA bus map's Bus Time key; without it the page says so
MTA <- :key(mta_key())
# /ziggy's graph, and its chat's key, password and models
ZG <- :graph(ZG_GRAPH)
ZG <- :config(zg_env("OPENAI_API_KEY", ""), zg_env("ZIGGY_CHAT_PASSWORD", ""), zg_env("OPENAI_MODEL", "gpt-5.1"), zg_env("OPENAI_AUTOCOMPLETE_MODEL", "gpt-5.4-nano"), zg_env("OPENAI_BASE_URL", "https://api.openai.com/v1"))
site = spawn Site
site <- :start(PORT, elem(first, 1), elem(first, 2), DB_OPTS)
desk_source = case DB_OPTS do
  nil -> "museum from data/*.tsv"
  _ -> concat("museum from postgres ", DB_OPTS.host, "/", DB_OPTS.database)
end
puts(concat("blimp blog: ", to_string(length(posts)), " posts rendered in ", to_string(now_ms() - t_boot), "ms, ", desk_source, ", listening on :", to_string(PORT)))
