# The wire protocol, SCRAM and row decoding are the interpreter's now
# (pg.zig, with its own tests, among them replays of a real Postgres);
# what is the site's is the URL it reads and how DB and db_start wait.
actor PostgresTests do
  test "DATABASE_URL, as the Phoenix app is given it" do
    o = pg_parse_url("ecto://blog:p%40ss:w@rd@db/blog_prod")
    assert_eq(o.user, "blog")
    assert_eq(o.password, "p@ss:w@rd")
    assert_eq(o.host, "db")
    assert_eq(o.port, 5432)
    assert_eq(o.database, "blog_prod")
    o2 = pg_parse_url("postgres://u@127.0.0.1:55432/site_test?sslmode=disable")
    assert_eq(o2.port, 55432)
    assert_eq(o2.password, "")
    assert_eq(o2.database, "site_test")
    assert_eq(pg_parse_url("not a url"), nil)
  end

  test "no database: db_start answers at once, and db_poll gives the same error" do
    p = db_start(nil, "select 1", [], 1000)
    assert_eq(db_poll(p), {:error, "no database is configured (DATABASE_URL)"})
  end

  # A listener nobody accepts on: the kernel finishes the handshake, then
  # nothing is ever said, as with a Postgres that has stopped answering.
  # The old client waited on that socket for good.
  test "a server that never answers: DB's wait ends at the deadline" do
    port = 47000 + rem(now_ms(), 900)
    s = tcp_listen(port)
    d = spawn Db
    d <- :open(%{host: "127.0.0.1", port: port, user: "u", password: "p", database: "x"})
    t0 = now_ms()
    assert_eq(d <- :query_ms("select 1", [], 200), {:error, "timeout"})
    took = now_ms() - t0
    assert_eq(took >= 200 and took < 1000, true)
    st = d <- :stats
    assert_eq({st.timeouts, st.failures, st.connected}, {1, 1, false})
    tcp_close(s)
  end

  test "a server that never answers: db_poll says nil until the deadline, then timeout" do
    port = 47000 + rem(now_ms() + 450, 900)
    s = tcp_listen(port)
    p = db_start(%{host: "127.0.0.1", port: port, user: "u", password: "p", database: "x"}, "select 1", [], 150)
    assert_eq(db_poll(p), nil)
    sleep_ms(250)
    assert_eq(db_poll(p), {:error, "timeout"})
    tcp_close(s)
  end
end
