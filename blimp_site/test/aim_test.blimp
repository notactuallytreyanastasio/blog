# needs: static/aim/aim.blimp
#
# /aim: the chat actor and the archive (src/99_aim.blimp), the page's
# program (static/aim/aim.blimp) and the Temper they share
# (temper/src/aim). Sockets here are negative, which AIM does not write
# to; it keeps the last frame it would have sent each one.
#
# fixtures/aim/posts.tsv is a made-up archive of ten posts in
# tools/aim_corpus.py's format, in two chunks (a form feed after the fourth),
# one line broken and one with a tab in its text. The JSON fixtures are
# DeepSeek chat.completions answers in the documented shape, written by hand: tool_call.json searches, final.json
# answers (with raw HTML and a javascript: link a prompt could have talked
# the model into), empty.json is deepseek-flash spending every token on
# thinking, which it did when thinking was on, error_401.json a refused key.
#
# AIM is configured against a closed local port: a request it starts fails
# on its own and is never read; the answers are handed to :answered.

AIMT_BASE = "http://127.0.0.1:9"

def aimt_fixture(name: String) -> String do
  read_file(concat("test/fixtures/aim/", name))
end

def aimt_last(fd: Int) -> Map do
  p = AIM <- :person(fd)
  zg_decode_map(p.last)
end

def aimt_history(fd: Int) -> List do
  (AIM <- :person(fd)).history
end

def aimt_load() -> Any do
  AIM <- :load(aimt_fixture("posts.tsv"))
  AIM <- :config("sk-test", AIMT_BASE, "deepseek-flash", 600)
end

# Everyone the tests before have left on.
def aimt_clear() -> Any do
  each(map((AIM <- :stats).fds, fn(f: Int) -> Int do f end), fn(f: Int) do AIM <- :leave(f) end)
end

# What SmarterChild says back to `text`, once it has said it.
def aimt_sc(fd: Int, text: String, t: Int) -> List do
  before = length((AIM <- :person(fd)).sc.history)
  AIM <- :im(fd, "sc", text, t)
  AIM <- :step_at(t + 30)
  said = (AIM <- :person(fd)).sc.history
  map(filter(range(before + 1, length(said) - 1), fn(i: Int) -> Bool do i > before and i < length(said) end), fn(i: Int) -> String do elem_at(said, i).content end)
end

actor AimTests do
  test "the archive: nine posts, the broken line dropped, a tab kept as a space" do
    assert_eq(AIM <- :load(nil), 0)
    assert_eq(AIM <- :load(aimt_fixture("posts.tsv")), 9)
    st = AIM <- :stats
    assert_eq([st.posts, st.chunks], [9, 2])
    assert_eq(aim_row("bsky\t2026-10-01\ttext with\ta tab inside it").text, "text with a tab inside it")
    assert_eq(aim_row("twitter\t\tundated").date, "")
    assert_eq(aim_row("nope"), nil)
    assert_eq(aim_post_line("bsky", "2025-03-02", "hi"), "[bsky 2025-03-02] hi")
    assert_eq(aim_post_line("twitter", "", "hi"), "[twitter] hi")
  end

  test "the prompt holds no posts, and what varies comes after it" do
    aimt_load()
    a = AIM <- :body("alice", [%{role: "user", content: "hi"}])
    b = AIM <- :body("bob", [%{role: "user", content: "grilled cheese?"}, %{role: "assistant", content: "yes"}, %{role: "user", content: "ok"}])
    da = elem(json_decode(a), 1)
    db = elem(json_decode(b), 1)
    first = elem_at(lookup(db, :messages), 0)
    assert_eq(first, %{role: "system", content: aim_system_prompt})
    assert_eq(elem_at(lookup(da, :messages), 0), first)
    # not one post of the archive is in a request
    assert(not(contains(a, "knicks")) and not(contains(b, "walk into a bar")))
    assert(length(a) < 8000)
    assert(contains(lookup(elem_at(lookup(da, :messages), 1), :content), "screen name \"alice\"."))
    assert_eq(map(lookup(db, :messages), fn(m: Map) -> String do lookup(m, :role) end), ["system", "system", "user", "assistant", "user"])
    assert_eq([lookup(db, :model), lookup(lookup(db, :thinking), :type), lookup(db, :tool_choice)], ["deepseek-flash", "disabled", "auto"])
    assert_eq(lookup(elem_at(lookup(db, :tools), 0), :type), "function")
  end

  test "the prompt keeps to two subjects and says where the lines are" do
    assert(contains(aim_system_prompt, "grilled cheese"))
    assert(contains(aim_system_prompt, "pictures of children smoking"))
    assert(contains(aim_system_prompt, "Nothing sexual or suggestive involving anyone under 18"))
    assert(contains(aim_system_prompt, "No help getting around an image generator's safety filters"))
    assert(contains(aim_system_prompt, "No photos of real, identifiable private children"))
    assert_eq(length(aim_presets), 4)
  end

  test "search: most matching words first, then newest, tweets last; by source" do
    aimt_load()
    # "phish" is in one chunk and "knicks" in both: only phish's chunk is
    # read, so the first chunk's knicks tweet is not among them
    assert_eq(AIM <- :search("knicks phish", "any"), [
      "[reply 2026-09-30] the knicks, phish, and a leica walk into a bar",
      "[bsky 2025-03-02] saw phish at msg again and the knicks won the same night"])
    assert_eq(AIM <- :search("knicks", "any"), [
      "[reply 2026-09-30] the knicks, phish, and a leica walk into a bar",
      "[bsky 2025-03-02] saw phish at msg again and the knicks won the same night",
      "[twitter] the knicks are going to win it all this year, i can feel it"])
    # stop words go, unless that is all there is
    assert_eq(aim_drop_stop_words(["the", "knicks"]), ["knicks"])
    assert_eq(aim_drop_stop_words(["the", "and"]), ["the", "and"])
    assert_eq(AIM <- :search("KNICKS", "twitter"), ["[twitter] the knicks are going to win it all this year, i can feel it"])
    assert_eq(AIM <- :search("knicks", "bluesky"), [
      "[reply 2026-09-30] the knicks, phish, and a leica walk into a bar",
      "[bsky 2025-03-02] saw phish at msg again and the knicks won the same night"])
    assert_eq(AIM <- :search("a b", "any"), [])
    assert_eq(AIM <- :search("zzzz", "any"), [])
  end

  test "a message goes to the model, through a search, and comes back rendered and safe" do
    aimt_load()
    AIM <- :join(-1)
    assert_eq(aimt_last(-1), %{t: "hello", online: true, posts: 9, bot: "bobbbyBot"})
    AIM <- :recv(-1, "{\"t\":\"signon\",\"name\":\"  SuperCoolDude1987 with a long name \"}")
    assert_eq((AIM <- :person(-1)).name, "SuperCoolDude198")
    AIM <- :recv(-1, "{\"t\":\"ask\",\"text\":\"  did you see phish?  \"}")
    p = AIM <- :person(-1)
    assert_eq([p.loading, p.count, length(p.history), p.job.round], [true, 1, 1, 0])
    assert_eq(elem_at(p.history, 0).content, "did you see phish?")
    assert_eq(lookup(elem_at(p.job.rest, 0), :role), "system")
    assert(contains(lookup(elem_at(p.job.rest, 0), :content), "\"SuperCoolDude198\""))
    # waiting: a second message is not taken
    assert_eq(AIM <- :ask(-1, "another", now()), :ignored)
    assert_eq(AIM <- :answered(-1, {:ok, 200, aimt_fixture("tool_call.json")}, now()), :asking)
    q = AIM <- :person(-1)
    assert_eq(q.job.round, 1)
    rest = q.job.rest
    # the session, the message, the model's call, the search's answer
    assert_eq(length(rest), 4)
    assert_eq(lookup(elem_at(rest, 3), :tool_call_id), "call_1")
    found = elem(json_decode(lookup(elem_at(rest, 3), :content)), 1)
    assert_eq(lookup(found, :count), 2)
    assert_eq(AIM <- :answered(-1, {:ok, 200, aimt_fixture("final.json")}, now()), :final)
    r = AIM <- :person(-1)
    assert_eq([r.loading, length(r.history), r.job], [false, 2, nil])
    got = elem_at(r.history, 1)
    assert(starts_with(got.content, "## The Knicks and Phish"))
    assert_eq(got.html, "<h2>The Knicks and Phish</h2>\n<p>I saw <strong>phish</strong> at MSG and the Knicks won that night.</p>\n<!-- raw HTML omitted -->\n<p><!-- raw HTML omitted -->click</a></p>")
    last = aimt_last(-1)
    assert_eq([lookup(last, :t), lookup(last, :loading), length(lookup(last, :messages))], ["chat", false, 2])
    st = AIM <- :stats
    assert_eq([st.cache_hit_tokens, st.cache_miss_tokens], [1515520, 770])
  end

  test "errors, an empty answer and too many searches each end in a reply" do
    aimt_load()
    AIM <- :join(-2)
    AIM <- :recv(-2, "{\"t\":\"ask\",\"text\":\"hello\"}")
    AIM <- :answered(-2, {:ok, 401, aimt_fixture("error_401.json")}, now())
    e = elem_at(aimt_history(-2), 1).content
    assert(starts_with(e, "Sorry, I couldn't answer that (DeepSeek said 401: {"))
    AIM <- :recv(-2, "{\"t\":\"ask\",\"text\":\"again\"}")
    AIM <- :answered(-2, {:ok, 200, aimt_fixture("empty.json")}, now())
    assert_eq(elem_at(aimt_history(-2), 3).content, "Sorry, I couldn't answer that (DeepSeek answered with nothing).")
    AIM <- :recv(-2, "{\"t\":\"ask\",\"text\":\"loop\"}")
    calls = aimt_fixture("tool_call.json")
    assert_eq(AIM <- :answered(-2, {:ok, 200, calls}, now()), :asking)
    assert_eq(AIM <- :answered(-2, {:ok, 200, calls}, now()), :asking)
    assert_eq(AIM <- :answered(-2, {:ok, 200, calls}, now()), :asking)
    assert_eq(AIM <- :answered(-2, {:ok, 200, calls}, now()), :asking)
    assert_eq(AIM <- :answered(-2, {:ok, 200, calls}, now()), :error)
    assert_eq(elem_at(aimt_history(-2), 5).content, "Sorry, I couldn't answer that (too many searches for one message).")
    assert_eq((AIM <- :stats).last_error, "too many searches for one message")
  end

  test "a request that never answers gives up after 90s" do
    aimt_load()
    AIM <- :join(-3)
    AIM <- :recv(-3, "{\"t\":\"ask\",\"text\":\"slow\"}")
    t0 = (AIM <- :person(-3)).job.at
    AIM <- :step_at(t0 + 91)
    r = AIM <- :person(-3)
    last = elem_at(r.history, 1).content
    # either the closed port answered first, or the clock ran out
    assert(starts_with(last, "Sorry, I couldn't answer that (the request to DeepSeek failed: "))
    assert_eq(r.loading, false)
  end

  test "no archive or no key is offline; a page and the day each have a limit" do
    AIM <- :load(nil)
    AIM <- :config("sk-test", AIMT_BASE, "deepseek-flash", 600)
    AIM <- :join(-4)
    assert_eq(lookup(aimt_last(-4), :online), false)
    AIM <- :recv(-4, "{\"t\":\"ask\",\"text\":\"q\"}")
    assert_eq(elem_at(aimt_history(-4), 1).content, "Sorry, I couldn't answer that (the archive is not loaded).")
    AIM <- :load(aimt_fixture("posts.tsv"))
    AIM <- :config("", AIMT_BASE, "deepseek-flash", 600)
    AIM <- :join(-5)
    assert_eq(aimt_last(-5), %{t: "hello", online: false, posts: 9, bot: "bobbbyBot"})
    AIM <- :recv(-5, "{\"t\":\"ask\",\"text\":\"q\"}")
    assert_eq(elem_at(aimt_history(-5), 1).content, "Sorry, I couldn't answer that (AIM_API_KEY is not set).")
    each(range(2, aim_max_questions), fn(i: Int) do AIM <- :ask(-5, "q", now()) end)
    p = AIM <- :person(-5)
    assert_eq(p.count, aim_max_questions)
    assert_eq(AIM <- :ask(-5, "one more", now()), :limit)
    assert_eq(elem_at(reverse(aimt_history(-5)), 0).content, aim_limit_reply(aim_max_questions))
    # the day's budget: two requests, then the reply that says so
    AIM <- :config("sk-test", AIMT_BASE, "deepseek-flash", 2)
    t = now()
    AIM <- :join(-6)
    AIM <- :ask(-6, "one", t)
    AIM <- :answered(-6, {:ok, 200, aimt_fixture("final.json")}, t)
    AIM <- :ask(-6, "two", t)
    AIM <- :answered(-6, {:ok, 200, aimt_fixture("final.json")}, t)
    assert_eq(AIM <- :ask(-6, "three", t), :limit)
    assert_eq(elem_at(reverse(aimt_history(-6)), 0).content, aim_daily_reply)
    # tomorrow it answers again
    assert_eq(AIM <- :ask(-6, "tomorrow", t + 86400), :asking)
  end

  test "people who sign on see each other and IM; names are unique" do
    aimt_load()
    aimt_clear()
    AIM <- :join(-11)
    AIM <- :join(-12)
    AIM <- :recv(-11, "{\"t\":\"signon\",\"name\":\"alice\"}")
    assert_eq(aimt_last(-11), %{t: "buddies", sc: false, people: []})
    AIM <- :recv(-12, "{\"t\":\"signon\",\"name\":\"ALICE\"}")
    assert_eq((AIM <- :person(-12)).name, "ALICE2")
    assert_eq(aimt_last(-11), %{t: "buddies", sc: false, people: [%{id: "u-12", name: "ALICE2"}]})
    assert_eq(aimt_last(-12), %{t: "buddies", sc: false, people: [%{id: "u-11", name: "alice"}]})
    assert_eq(AIM <- :recv(-11, "{\"t\":\"im\",\"to\":\"u-12\",\"text\":\" hi there \"}"), :sent)
    assert_eq(aimt_last(-12), %{t: "chat", with: "u-11", loading: false, messages: [%{role: "them", content: "hi there", html: ""}]})
    # what a person typed is text, never HTML
    AIM <- :recv(-12, "{\"t\":\"im\",\"to\":\"u-11\",\"text\":\"<b>yo</b>\"}")
    assert_eq(lookup(aimt_last(-11), :messages), [%{role: "user", content: "hi there", html: ""}, %{role: "them", content: "<b>yo</b>", html: ""}])
    # not to yourself, nobody who isn't there, nobody who hasn't signed on
    assert_eq(AIM <- :im(-11, "u-11", "me", now()), :nobody)
    assert_eq(AIM <- :im(-11, "u-99", "x", now()), :nobody)
    AIM <- :join(-13)
    assert_eq(AIM <- :im(-11, "u-13", "x", now()), :nobody)
    assert_eq(AIM <- :im(-13, "u-11", "x", now()), :ignored)
    # with someone else here, SmarterChild stays away
    AIM <- :step_at(now() + 60)
    assert_eq((AIM <- :person(-11)).sc.active, false)
    # signing off: off the other's list, the conversation forgotten
    assert_eq((AIM <- :stats).conversations, 1)
    AIM <- :recv(-12, "{\"t\":\"signoff\"}")
    assert_eq(aimt_last(-11), %{t: "buddies", sc: false, people: []})
    assert_eq((AIM <- :stats).conversations, 0)
    assert_eq((AIM <- :person(-12)).signed, false)
    aimt_clear()
  end

  test "alone, SmarterChild asks four riddles, and their letters open the cats" do
    aimt_load()
    aimt_clear()
    AIM <- :join(-21)
    AIM <- :sign_on(-21, "solo", 1000)
    AIM <- :step_at(1003)
    assert_eq((AIM <- :person(-21)).sc.active, false)
    AIM <- :step_at(1004)
    assert_eq(aimt_last(-21), %{t: "buddies", sc: true, people: []})
    # the hello comes a line at a time, typing between
    AIM <- :step_at(1006)
    first = aimt_last(-21)
    assert_eq([lookup(first, :with), lookup(first, :loading), length(lookup(first, :messages))], ["sc", true, 1])
    AIM <- :step_at(1012)
    hello = aimt_last(-21)
    assert_eq([lookup(hello, :loading), length(lookup(hello, :messages))], [false, 4])
    assert_eq(lookup(elem_at(lookup(hello, :messages), 3), :content), head(AIM_SC_RIDDLES).q)
    assert_eq(lookup(elem_at(lookup(hello, :messages), 3), :role), "them")
    assert_eq(aimt_sc(-21, "hint", 1020), [head(AIM_SC_RIDDLES).hint])
    assert_eq(aimt_sc(-21, "a globe?", 1030), ["close, but flatter."])
    assert_eq(aimt_sc(-21, "no idea", 1040), ["not it. type hint if you're stuck."])
    assert_eq(aimt_sc(-21, "A MAP!", 1050), ["yep.", "next:", elem_at(AIM_SC_RIDDLES, 1).q])
    assert_eq(length(aimt_sc(-21, "egg", 1060)), 3)
    assert_eq(aimt_sc(-21, "sea", 1070), ["right idea, but decode the letters: it's five of them."])
    assert_eq(length(aimt_sc(-21, "ocean", 1080)), 3)
    assert_eq(aimt_sc(-21, "it's a clock", 1090), ["so close. smaller. you wear me."])
    assert_eq(aimt_sc(-21, "it's a WATCH", 1100), list_append(["all four. you're good at this."], AIM_SC_FINAL))
    assert_eq(aimt_sc(-21, "now what", 1110), ["you already got all four. first letters, sign off, sign back on as them."])
    # the answers' first letters are the name
    assert_eq(join(map(AIM_SC_RIDDLES, fn(r: Map) -> String do slice(head(r.answers), 0, 1) end), ""), AIM_SECRET_NAME)
    AIM <- :recv(-21, "{\"t\":\"signoff\"}")
    assert_eq((AIM <- :person(-21)).sc.active, false)
    AIM <- :recv(-21, "{\"t\":\"signon\",\"name\":\" Meow \"}")
    assert_eq(aimt_last(-21), %{t: "secret", src: "/aim/cats.jpg"})
    assert_eq((AIM <- :person(-21)).name, "Meow")
    # the riddles are the server's: the page's program has none of them
    page = read_file("_build/aim.blimp")
    assert(contains(page, "SmarterChild"))
    assert(not(contains(page, "PDFBO")) and not(contains(page, "wristwatch")) and not(contains(page, AIM_CATS_SRC)))
    aimt_clear()
  end

  test "the page's program: sign on, frames in, messages out, the reader" do
    aim <- :remembered("oldname")
    v = to_html(aim <- :view)
    assert(contains(v, "aim-signon"))
    assert(contains(v, "value=\"oldname\""))
    aim <- :sign_on("{\"name\":\"  newname  \"}")
    assert_eq(aim <- :outbox, ["{\"t\":\"signon\",\"name\":\"newname\"}"])
    assert_eq(lookup(aim <- :where, :sound), :signon)
    assert_eq(lookup(aim <- :where, :sound), nil)
    aim <- :frame("{\"t\":\"hello\",\"online\":true,\"posts\":75344,\"bot\":\"bobbbyBot\"}")
    v2 = to_html(aim <- :view)
    assert(contains(v2, "newname&#39;s Buddy List") or contains(v2, "newname's Buddy List"))
    assert(contains(v2, "two things: grilled cheese, and pictures of kids smoking"))
    aim <- :open_info
    assert(contains(to_html(aim <- :view), "It can search 75,344 of Bobby"))
    aim <- :close_info
    assert_eq(aim <- :send("{\"message\":\"  \"}"), :ignored)
    assert_eq(aim <- :send("{\"message\":\"hi\"}"), :sent)
    assert_eq(aim <- :outbox, ["{\"t\":\"ask\",\"text\":\"hi\"}"])
    long = "# A heading\n\nand a long answer"
    aim <- :frame(json_encode(%{t: "chat", loading: false, messages: [
      %{role: "user", content: "hi", html: ""},
      %{role: "assistant", content: "short", html: "<p>short</p>"},
      %{role: "user", content: "more", html: ""},
      %{role: "assistant", content: long, html: "<h1>A heading</h1>"}]}))
    assert_eq(lookup(aim <- :where, :sound), :received)
    v3 = to_html(aim <- :view)
    assert(contains(v3, "Open in Reader"))
    aim <- :open_reader(3)
    assert_eq(lookup(aim <- :where, :reader), true)
    v4 = to_html(aim <- :view)
    assert(contains(v4, "Answer 2 of 2"))
    assert(contains(v4, "<h1>A heading</h1>"))
    aim <- :reader_step(-1)
    assert(contains(to_html(aim <- :view), "Answer 1 of 2"))
    aim <- :reader_step(-1)
    assert(contains(to_html(aim <- :view), "Answer 1 of 2"))
    aim <- :close_reader
    assert_eq(lookup(aim <- :where, :reader), false)
    # muted: no sound is asked for
    aim <- :toggle_sound
    aim <- :send("{\"message\":\"quiet\"}")
    assert_eq(lookup(aim <- :where, :sound), nil)
    assert_eq(aimp_commas(1234567), "1,234,567")
    assert_eq(aimp_commas(12), "12")
  end

  test "the page's program: buddies, SmarterChild, people, signing off, the cats" do
    aim <- :connected
    aim <- :toggle_sound
    aim <- :sign_on("{\"name\":\"solo\"}")
    aim <- :outbox
    aim <- :frame("{\"t\":\"hello\",\"online\":true,\"posts\":9,\"bot\":\"bobbbyBot\"}")
    aim <- :frame("{\"t\":\"buddies\",\"sc\":false,\"people\":[]}")
    v = to_html(aim <- :view)
    assert(contains(v, "Online Now (0)") and contains(v, "nobody else is signed on") and contains(v, "Sign Off"))
    assert(not(contains(v, "Cats (2/2)")))
    # SmarterChild comes online and, with nothing said yet, takes the window
    aim <- :frame("{\"t\":\"buddies\",\"sc\":true,\"people\":[]}")
    aim <- :frame("{\"t\":\"chat\",\"with\":\"sc\",\"loading\":true,\"messages\":[{\"role\":\"them\",\"content\":\"hey <b>you</b>\",\"html\":\"\"}]}")
    v2 = to_html(aim <- :view)
    assert(contains(v2, "SmarterChild - Instant Message"))
    assert(contains(v2, "hey &lt;b&gt;you&lt;/b&gt;"))
    assert(contains(v2, "SmarterChild is typing..."))
    # typing: nothing goes up until it has finished
    assert_eq(aim <- :send("{\"message\":\"map\"}"), :ignored)
    aim <- :frame("{\"t\":\"chat\",\"with\":\"sc\",\"loading\":false,\"messages\":[{\"role\":\"them\",\"content\":\"riddle\",\"html\":\"\"}]}")
    assert_eq(aim <- :send("{\"message\":\"map\"}"), :sent)
    assert_eq(aim <- :outbox, ["{\"t\":\"im\",\"to\":\"sc\",\"text\":\"map\"}"])
    # someone signs on and says something: the window is busy, so it waits, bold
    aim <- :frame("{\"t\":\"buddies\",\"sc\":true,\"people\":[{\"id\":\"u7\",\"name\":\"alice\"}]}")
    aim <- :frame("{\"t\":\"chat\",\"with\":\"u7\",\"loading\":false,\"messages\":[{\"role\":\"them\",\"content\":\"hi solo\",\"html\":\"\"}]}")
    v3 = to_html(aim <- :view)
    assert(contains(v3, "SmarterChild - Instant Message"))
    assert(contains(v3, "Online Now (1)") and contains(v3, "(new message)") and contains(v3, "aim-tab unread"))
    aim <- :open_chat("u7")
    v4 = to_html(aim <- :view)
    assert(contains(v4, "alice - Instant Message") and contains(v4, "hi solo") and contains(v4, "alice is online."))
    assert(not(contains(v4, "(new message)")))
    assert_eq(aim <- :send("{\"message\":\"hey alice\"}"), :sent)
    assert_eq(aim <- :outbox, ["{\"t\":\"im\",\"to\":\"u7\",\"text\":\"hey alice\"}"])
    # alice signs off: the conversation stays, under her name, and can't be sent to
    aim <- :frame("{\"t\":\"buddies\",\"sc\":true,\"people\":[]}")
    assert(contains(to_html(aim <- :view), "alice signed off."))
    assert_eq(aim <- :send("{\"message\":\"hello?\"}"), :ignored)
    # bobbbyBot is still a tab away
    aim <- :open_im
    assert(contains(to_html(aim <- :view), "bobbbyBot - Instant Message"))
    assert_eq(aim <- :send("{\"message\":\"grilled cheese\"}"), :sent)
    assert_eq(aim <- :outbox, ["{\"t\":\"ask\",\"text\":\"grilled cheese\"}"])
    # signing off forgets everything; signing on as the name opens the cats
    aim <- :sign_off
    assert_eq(aim <- :outbox, ["{\"t\":\"signoff\"}"])
    assert(contains(to_html(aim <- :view), "aim-signon"))
    aim <- :sign_on("{\"name\":\"meow\"}")
    aim <- :frame("{\"t\":\"secret\",\"src\":\"/aim/cats.jpg\"}")
    v5 = to_html(aim <- :view)
    # the server said hello once, for the socket, not for each sign-on
    assert(not(contains(v5, "(connecting)")))
    assert(contains(v5, "Cats (2/2)") and contains(v5, "Picture Viewer - cats.jpg") and contains(v5, "src=\"/aim/cats.jpg\""))
    aim <- :close_cats
    assert(not(contains(to_html(aim <- :view), "Picture Viewer")))
    aim <- :open_cats
    assert(contains(to_html(aim <- :view), "Picture Viewer"))
  end
end
