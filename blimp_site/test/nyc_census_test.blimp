# needs: static/nyc_census/census.blimp
#
# /nyc_census_and_pluto: the Temper arithmetic (temper/src/nyc_census), the
# page's program (static/nyc_census/census.blimp) and the server's half
# (src/99_nyc_census.blimp). Numbers marked "production" are what
# https://bobbby.online/nyc_census_and_pluto (NycCensusAndPlutoLive)
# answered for the same shape; the fixtures are the rows the Blimp server
# sends for the onboarding demo's rectangle, from the same PLUTO import.

NYCT_DEMO = [[40.733, -74.003], [40.733, -73.997], [40.737, -73.997], [40.737, -74.003]]

actor NycCensusTests do
  test "a point is inside by ray casting, as Geometry.point_in_polygon?/2 decides" do
    lats = [0.0, 0.0, 10.0, 10.0]
    lngs = [0.0, 10.0, 10.0, 0.0]
    assert_eq(nyc_inside(5.0, 5.0, lats, lngs), true)
    assert_eq(nyc_inside(15.0, 5.0, lats, lngs), false)
    assert_eq(nyc_inside(5.0, -1.0, lats, lngs), false)
    # a C: the notch is outside
    c_lats = [0.0, 0.0, 3.0, 3.0, 7.0, 7.0, 10.0, 10.0]
    c_lngs = [0.0, 10.0, 10.0, 3.0, 3.0, 10.0, 10.0, 0.0]
    assert_eq(nyc_inside(5.0, 6.0, c_lats, c_lngs), false)
    assert_eq(nyc_inside(5.0, 1.0, c_lats, c_lngs), true)
    assert_eq(nyc_bbox([40.7, 40.8, 40.75], [-74.0, -73.9, -73.95]), [40.7, 40.8, -74.0, -73.9])
  end

  test "a PLUTO tract is a Census geoid with the borough's county code" do
    assert_eq(nyc_geoid("1006300"), "061006300")
    assert_eq(nyc_geoid("3051700"), "047051700")
    assert_eq(nyc_geoid("5000900"), "085000900")
    assert_eq(nyc_geoid("6000100"), "")
    assert_eq(nyc_geoid("1"), "")
    assert_eq(nyc_geoid(""), "")
  end

  test "numbers print as format_number/1 and toFixed(1) printed them" do
    assert_eq(nyc_format(0), "0")
    assert_eq(nyc_format(999), "999")
    assert_eq(nyc_format(7917), "7,917")
    assert_eq(nyc_format(1000000), "1,000,000")
    assert_eq(nyc_format(212346), "212,346")
    # the double just under 1.425: toFixed says 1.4, (x * 10).round() 1.5
    assert_eq(nyc_fixed1(2.85 / 2.0), "1.4")
    assert_eq(nyc_fixed1(0.05), "0.1")
    assert_eq(nyc_fixed1(4.0), "4.0")
    assert_eq(nyc_round1(1.25) == 1.3, true)
    assert_eq(nyc_share(2, 0, 100) == 0.0, true)
    assert_eq(nyc_share(1, 3, 10) == 3.3, true)
  end

  test "the demo rectangle: the numbers production shows" do
    t = elem(json_decode(read_file("test/fixtures/nyc_demo_tracts.json")), 1)
    heat = census <- :tracts(200, json_encode(t))
    assert_eq(length(heat), 4)
    url = census <- :drawn(json_encode(NYCT_DEMO))
    assert_eq(url, "/nyc_census_and_pluto/lots.json?bbox=40.733,40.737,-74.003,-73.997")
    markers = census <- :lots(200, read_file("test/fixtures/nyc_demo_lots.json"))
    # production: 7,917 people, 483 tax lots, 5,540 units, 4 tracts
    assert_eq(length(markers), 483)
    v = to_html(census <- :view)
    assert_eq(contains(v, ">7,917<"), true)
    assert_eq(contains(v, ">483<"), true)
    assert_eq(contains(v, ">5,540<"), true)
    assert_eq(contains(v, "Clear &amp; Start Over"), true)
    # production's hook drew 52 West 9th Street so: 2.85 people / 2 units
    w9 = head(filter(markers, fn(m: List) -> Bool do contains(elem(m, 4), "BBL: 1005720016") end))
    assert_eq(elem(w9, 3), "rgb(67,106,223)")
    assert_eq(contains(elem(w9, 4), "~1.4 people per unit &middot; 0.0% of tract's 4,672 units"), true)
    census <- :clear
    assert_eq(contains(to_html(census <- :view), "7,917"), false)
  end

  test "an answer that is not rows is the error it names" do
    census <- :drawn(json_encode(NYCT_DEMO))
    census <- :lots(413, "{\"error\": \"That shape covers more than 40,000 tax lots. Draw a smaller one.\"}")
    assert_eq(contains(to_html(census <- :view), "Draw a smaller one."), true)
    census <- :lots(502, "<html>bad gateway</html>")
    assert_eq(contains(to_html(census <- :view), "the server answered 502"), true)
  end

  test "the server refuses a bounding box that is not four numbers" do
    assert_eq(nyc_number("40.733"), true)
    assert_eq(nyc_number("-73.997"), true)
    assert_eq(nyc_number("40"), true)
    assert_eq(nyc_number("4.0.1"), false)
    assert_eq(nyc_number("1e5"), false)
    assert_eq(nyc_number("-"), false)
    assert_eq(nyc_number(".5"), false)
    assert_eq(nyc_number("1;drop"), false)
    assert_eq(nyc_lots_response("bbox=1,2,3").status, 400)
    assert_eq(nyc_lots_response("bbox=1,2,3,x").status, 400)
    page = nyc_census_page()
    assert_eq(contains(page, "data-program=\"/nyc_census_and_pluto/census.blimp\""), true)
    assert_eq(contains(page, "/nyc_census_and_pluto/map.js"), true)
  end
end
