# needs: static/mta/mta.blimp
#
# /mta-bus-map: the poller (src/99_mta.blimp), the page's program
# (static/mta/mta.blimp) and the Temper they share (temper/src/mta).
# Sockets here are negative, which the poller does not write to.
#
# fixtures/mta/ are Bus Time's answers, recorded 2026-09-29 around 23:13
# New York time (none of them contains the key):
# m14a_sbs.json (LineRef MTA NYCT_M14A+, five buses),
# no_such_route.json (MTA NYCT_Q10: Q10 is MTABC_Q10) and
# version_404.html (what vehicle-monitoring-v2.json answers, with a 200,
# to a request that says version=2, as the LiveView's did before the
# redirect dropped it).

def mtt_buses(file: String) -> Any do
  mta_buses(read_file(concat("test/fixtures/mta/", file)))
end

actor MtaTests do
  test "a route's line reference is Bus Time's, not worked out from its name" do
    assert_eq(lookup(MTA_REFS, "M14A-SBS"), "MTA NYCT_M14A+")
    # the two that a rule could never get: another agency, and a padded id
    assert_eq(lookup(MTA_REFS, "Q10"), "MTABC_Q10")
    assert_eq(lookup(MTA_REFS, "Q6"), "MTABC_Q06")
    assert_eq(mta_line_param("MTA NYCT_B44+"), "MTA%20NYCT_B44%2B")
    u = mta_url("KEY", "MTABC_Q52+")
    assert_eq(u, "https://bustime.mta.info/api/siri/vehicle-monitoring-v2.json?key=KEY&LineRef=MTABC_Q52%2B&VehicleMonitoringDetailLevel=normal")
    assert_eq(contains(u, "version="), false)
  end

  test "every route has a tab, a colour and one name" do
    all = mb_for_borough("all")
    assert_eq(length(uniq(all)), length(all))
    tabs = flat(map(["manhattan", "brooklyn", "queens", "bronx", "staten", "express"], fn(b: String) -> List do mb_for_borough(b) end))
    assert_eq(length(tabs), length(all))
    assert_eq(length(filter(all, fn(r: String) -> Bool do mta_known(r) and starts_with(mb_color(r), "#") end)), length(all))
    assert_eq(mta_known("Q999"), false)
    assert_eq(mta_known("m21"), false)
    # in the order a person counts them, not as strings
    assert_eq(mta_take(mb_for_borough("brooklyn"), 3), ["B1", "B2", "B3"])
    assert(mb_has(mb_for_borough("bronx"), "Bx12-SBS"))
    assert(mb_has(mb_for_borough("staten"), "S53"))
    assert(mb_has(mb_for_borough("express"), "SIM1"))
  end

  test "a bus is a dot and its name; a stopped bus has no arrow" do
    assert_eq(mta_icon_html("M21", "#00933C", "-42.5"), "<div class=\"mta-bus\" style=\"--route:#00933C\"><span class=\"mta-dot mta-moving\" style=\"transform:rotate(-42.5deg)\"></span><span class=\"mta-name\">M21</span></div>")
    assert_eq(contains(mta_icon_html("M21", "#00933C", ""), "mta-moving"), false)
    p = mta_popup_html("M21", "#00933C", "Lower East Side", "A & <B>", "", "Bus 7")
    assert(contains(p, "To A &amp; &lt;B&gt;"))
    assert(contains(p, "Bus 7"))
    assert_eq(contains(p, "mta-pop-next"), false)
  end

  test "Bus Time's bearing, anticlockwise from east, is a compass heading" do
    assert_eq(mb_heading(0), "Heading E")
    assert_eq(mb_heading(90), "Heading N")
    assert_eq(mb_heading(180.0), "Heading W")
    assert_eq(mb_heading(270), "Heading S")
    assert_eq(mb_heading(42.25), "Heading NE")
    assert_eq(mb_heading(359.9), "Heading E")
    assert_eq(mb_heading(nil), "")
  end

  test "times and vehicles read as a person says them" do
    assert_eq(mb_clock("2026-11-03T18:10:23.149-05:00"), "6:10 PM")
    assert_eq(mb_clock("2026-11-03T00:05:00.000-05:00"), "12:05 AM")
    assert_eq(mb_clock("2026-11-03T12:00:00.000-05:00"), "12:00 PM")
    assert_eq(mb_clock(""), "")
    assert_eq(mb_vehicle("MTABC_9085"), "Bus 9085")
    assert_eq(mb_vehicle("MTA NYCT_7579"), "Bus 7579")
    assert_eq(mb_next("8 AV", "at stop", true), "On layover at 8 AV")
    assert_eq(mb_next("8 AV", "approaching", false), "Next stop: 8 AV (approaching)")
    assert_eq(mb_next("", "", false), "")
  end

  test "a recorded answer is its buses, with heading and next stop" do
    got = mtt_buses("m14a_sbs.json")
    assert_eq(elem(got, 0), :ok)
    bs = elem(got, 1)
    assert_eq(length(bs), 5)
    b = head(bs)
    assert_eq([b.id, b.lat, b.lng, b.bearing, b.layover, b.destination, b.stop, b.away], ["MTA NYCT_5492", 40.737413, -74.004981, 42.2536, true, "SELECT BUS LES GRAND-FDR via 14 ST", "8 AV/BLEECKER ST", "at stop"])
    assert_eq(b.recorded_at, "2026-09-29T23:12:50.222-04:00")
  end

  test "a route Bus Time does not know, and a page that is not JSON, are errors" do
    assert_eq(mtt_buses("no_such_route.json"), {:error, "No such route: MTA NYCT_Q10."})
    assert_eq(elem(mtt_buses("version_404.html"), 0), :error)
    assert_eq(mta_buses("{\"Siri\":{\"ServiceDelivery\":{\"VehicleMonitoringDelivery\":[{\"ResponseTimestamp\":\"x\"}]}}}"), {:ok, []})
    # a vehicle without a place is left out
    one = "{\"Siri\":{\"ServiceDelivery\":{\"VehicleMonitoringDelivery\":[{\"VehicleActivity\":[{\"MonitoredVehicleJourney\":{\"VehicleRef\":\"v\"}},{\"MonitoredVehicleJourney\":{\"VehicleRef\":\"w\",\"VehicleLocation\":{\"Latitude\":1,\"Longitude\":2}}}]}]}}}"
    got = elem(mta_buses(one), 1)
    assert_eq(map(got, fn(x: Map) -> String do x.id end), ["w"])
    assert_eq(head(got).destination, "Unknown")
  end

  test "the poller asks for nothing until someone watches, and only real routes" do
    p = spawn MtaPoller
    assert_eq(p <- :key("k"), true)
    assert_eq(p <- :step_at(1000), :idle)
    p <- :join(-1)
    assert_eq(p <- :step_at(1000), :idle)
    assert_eq(p <- :recv(-1, json_encode(%{t: "watch", routes: ["M21", "M21", "Q999", 7, "B44-SBS"]})), 2)
    assert_eq(p <- :recv(-1, "garbage"), :ignored)
    assert_eq(p <- :recv(-9, json_encode(%{t: "watch", routes: ["M21"]})), :unknown)
    p <- :join(-2)
    p <- :recv(-2, json_encode(%{t: "watch", routes: ["M21", "Q10"]}))
    s = p <- :stats
    assert_eq([s.pages, s.watched, s.phase], [2, 3, :idle])
    p <- :leave(-1)
    p <- :leave(-2)
    assert_eq((p <- :stats).watched, 0)
    assert_eq(p <- :step_at(5000), :idle)
  end

  test "without a key the poller asks nothing" do
    p = spawn MtaPoller
    assert_eq(p <- :key(""), false)
    p <- :join(-1)
    p <- :recv(-1, json_encode(%{t: "watch", routes: ["M21"]}))
    assert_eq(p <- :step_at(1000), :idle)
  end

  test "a frame of buses is markers; a toggle tells the server and drops that route's" do
    m = spawn MtaPage
    assert_eq(m <- :markers(0), nil)
    m <- :connected
    assert_eq(m <- :outbox, [json_encode(%{t: "watch", routes: ["M14A-SBS", "M14D-SBS", "M21", "M34-SBS"]})])
    bs = elem(mtt_buses("m14a_sbs.json"), 1)
    m <- :frame(json_encode(%{t: "buses", updated: "23:13:00", routes: [%{route: "M14A-SBS", buses: bs}, %{route: "B1", buses: bs}]}))
    got = m <- :markers(0)
    assert_eq(got.epoch, 1)
    # B1 is not this page's, so it is not drawn
    assert_eq(length(got.markers), 5)
    k = head(got.markers)
    assert_eq([k.key, k.lat, k.lng], ["M14A-SBS-MTA NYCT_5492", 40.737413, -74.004981])
    # the recorded bus is on layover: no arrow, and the popup says where
    assert_eq(contains(k.icon, "mta-moving"), false)
    assert(contains(k.popup, "On layover at 8 AV/BLEECKER ST"))
    assert(contains(k.popup, "To SELECT BUS LES GRAND-FDR via 14 ST"))
    assert(contains(k.popup, "Bus 5492"))
    assert_eq(m <- :markers(1), nil)
    # a bus under way, with a whole-number bearing, as JSON hands it over
    m <- :frame(json_encode(%{t: "buses", routes: [%{route: "M21", buses: [%{id: "x_1", lat: 40, lng: -74, bearing: 90, layover: false, destination: "X", stop: "Y", away: "1 stop away", recorded_at: ""}]}]}))
    one = head((m <- :markers(1)).markers)
    assert(contains(one.icon, "rotate(-90deg)"))
    assert(contains(one.popup, "Heading N"))
    assert(contains(one.popup, "Next stop: Y (1 stop away)"))
    assert_eq((m <- :status).buses, "1 bus")
    assert_eq(mb_count(2, "bus", "buses"), "2 buses")
    m <- :frame(json_encode(%{t: "buses", routes: [%{route: "M14A-SBS", buses: bs}]}))
    assert_eq(length((m <- :markers(2)).markers), 5)
    m <- :toggle_route("M14A-SBS")
    assert_eq(length((m <- :markers(3)).markers), 0)
    assert_eq(m <- :outbox, [json_encode(%{t: "watch", routes: ["M14D-SBS", "M21", "M34-SBS"]})])
    assert_eq((m <- :status).routes, "3 routes")
    assert(contains(to_html(m <- :view), "Loading..."))
    m <- :select_all_borough_routes("queens")
    assert_eq((m <- :status).routes, concat(to_string(length(mb_for_borough("queens"))), " routes"))
    m <- :select_all_routes
    assert_eq((m <- :status).routes, concat(to_string(length(mta_routes)), " routes"))
    m <- :clear_routes
    assert_eq((m <- :status).routes, "0 routes")
    assert(contains(to_html(m <- :view), "No routes chosen"))
  end

  test "a chip says how many buses, and says so when there are none" do
    m = spawn MtaPage
    bs = elem(mtt_buses("m14a_sbs.json"), 1)
    assert(contains(to_html(m <- :view), "<b>M21</b>..."))
    m <- :frame(json_encode(%{t: "buses", routes: [%{route: "M14A-SBS", buses: bs}, %{route: "M21", buses: []}]}))
    v = to_html(m <- :view)
    assert(contains(v, "<b>M14A-SBS</b>5"))
    assert(contains(v, "<b>M21</b>no buses out"))
    assert(contains(v, "mta-chip-none"))
    # too many to list
    m <- :select_all_routes
    v2 = to_html(m <- :view)
    assert_eq(contains(v2, "mta-chips"), false)
    assert(contains(v2, " routes chosen"))
  end

  test "the chooser searches every route, by name or place" do
    m = spawn MtaPage
    assert_eq(contains(to_html(m <- :view), "Search by route"), false)
    m <- :toggle_modal
    v = to_html(m <- :view)
    assert(contains(v, "Search by route"))
    assert(contains(v, "<b>M21</b>"))
    assert_eq(contains(v, "<b>B44</b>"), false)
    # from the Manhattan tab, a search finds Brooklyn's
    m <- :search("b44")
    assert(contains(to_html(m <- :view), "<b>B44</b>"))
    assert_eq(map(mb_rows("manhattan", "jfk cargo"), fn(r: Map) -> String do r.name end), ["Q6"])
    m <- :search("zzz")
    assert(contains(to_html(m <- :view), "No route matches"))
    # closing it forgets the search
    m <- :toggle_modal
    m <- :toggle_modal
    assert(contains(to_html(m <- :view), "<b>M21</b>"))
  end

  test "a borough names the page and moves the map; the routes chosen stay" do
    m = spawn MtaPage
    assert(contains(to_html(m <- :view), "Manhattan MTA Bus Tracker"))
    assert_eq((m <- :status).title, "MTA Bus Map Tracker")
    m <- :select_borough("staten")
    s = m <- :status
    assert_eq([s.title, s.borough, s.routes], ["Staten Island MTA Bus Tracker", "staten", "4 routes"])
    assert_eq(s.bounds, mb_bounds("staten"))
    assert(contains(to_html(m <- :view), "Show all of Staten Island"))
    m <- :select_borough("all")
    assert(contains(to_html(m <- :view), "Show every route"))
    m <- :frame("{\"t\":\"error\",\"message\":\"no key\"}")
    assert(contains(to_html(m <- :view), "<p class=\"mta-error\">no key</p>"))
  end

  test "a lost socket says so, and a saved visit comes back without its dead routes" do
    m = spawn MtaPage
    m <- :disconnected
    assert(contains(to_html(m <- :view), "Lost the connection"))
    m <- :connected
    assert_eq(contains(to_html(m <- :view), "Lost the connection"), false)
    m <- :outbox
    assert_eq(m <- :restore(json_encode(["Q6", "Q6", "GONE", 7])), 1)
    m <- :connected
    assert_eq(m <- :outbox, [json_encode(%{t: "watch", routes: ["Q6"]})])
    assert_eq(m <- :restore("garbage"), :nothing)
    assert_eq(m <- :restore("[]"), :nothing)
    assert_eq((m <- :status).routes, "1 route")
  end

  test "the page has the window, the map's box, the program and Leaflet" do
    assert_eq(mta_page_ok(), true)
  end
end

def mta_page_ok() -> Bool do
  body = MTA_PAGE.body
  all = filter(["<title>MTA Bus Map Tracker</title>", "<div id=\"mta-bus-map\"></div>",
    concat("data-program=\"", MTA_PROGRAM_PATH, "\""), concat("<script src=\"", MTA_JS_PATH, "\"></script>"),
    concat("href=\"", MTA_CSS_PATH, "\"")], fn(s: String) -> Bool do contains(body, s) end)
  length(all) == 5 and contains(MTA_PROGRAM_PATH, "?v=") and contains(MTA_JS_PATH, "?v=") and contains(MTA_CSS_PATH, "?v=") and contains(MTA_JS.body, "L.map(")
end
