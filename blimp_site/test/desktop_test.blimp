# The homepage, rendered from the real snapshots in data/ and two made-up
# posts (the posts need the markdown renderer, which is not this file's).

def dt_posts() -> List do
  [
    %{slug: "chess", title: "Chess", date: "May 30, 2026", tags: ["ai", "chess"]},
    %{slug: "heya", title: "heya", date: "January 21, 2026", tags: []}
  ]
end

def dt_page(query: String) -> String do
  desktop_page(query, load_desktop("data", dt_posts()), 1790640000)
end

# True when some tag in the page has an on* attribute: whitespace, "on",
# letters, then "=".
def dt_letters_then_eq(s: String, i: Int) -> Bool do
  case i >= length(s) do
    true -> false
    false ->
      c = char_at(s, i)
      case c == "=" do
        true -> i > 0
        false ->
          case is_alnum(c) and not(is_digit(c)) do
            true -> dt_letters_then_eq(s, i + 1)
            false -> false
          end
      end
  end
end

def dt_has_on_attr(html: String) -> Bool do
  lower = downcase(replace_all(replace_all(html, "\n", " "), "\t", " "))
  parts = drop_list(split(lower, " on"), 1)
  length(filter(parts, fn(p: String) -> Bool do dt_letters_then_eq(p, 0) end)) > 0
end

# Scriptless apart from the scope's two scripts (HOME_TAGS): what matters
# here is that nothing from the query string becomes one.
def dt_scriptless(page: String) -> Bool do
  html = replace_all(page, HOME_TAGS, "")
  lower = downcase(html)
  not(contains(lower, "<script")) and not(contains(lower, "javascript:")) and not(dt_has_on_attr(html))
end

actor DesktopTests do
  test "the on* detector finds what it should and nothing else" do
    assert(dt_has_on_attr("<div onclick=\"x\">"))
    assert(dt_has_on_attr("<img src=a\nonerror=x>"))
    refute(dt_has_on_attr("<p>on making a link blog</p><p>one=two</p>"))
  end

  test "no script, no on* attribute, no javascript: URL, in any state" do
    queries = [
      "", "booted=1", "cat=ml", "cat=ml&project=deciduous", "project=phangraphs&finder=1",
      "finder=1&m=finder", "m=blog", "museum=0", "leica=1", "m=museum&museum=0&leica=1",
      "cat=%3Cscript%3E&project=%22%20onload%3D%22x&m=javascript:alert(1)"
    ]
    each(queries, fn(q: String) do
      assert(dt_scriptless(dt_page(q)))
    end)
  end

  test "nothing from the query string is echoed unless the data knows it" do
    html = dt_page("cat=%3Cscript%3E&project=%22onload%3D%22x&m=%3Cb%3E")
    refute(contains(html, "script%3E"))
    refute(contains(html, "onload"))
    refute(contains(html, "<b>"))
  end

  test "the splash shows for a bare / and never once there is state" do
    assert(contains(dt_page(""), "class=\"mac-boot\""))
    refute(contains(dt_page("booted=1"), "class=\"mac-boot\""))
    refute(contains(dt_page("project=deciduous"), "class=\"mac-boot\""))
    assert(contains(dt_page(""), "href=\"/?booted=1\""))
  end

  test "the snapshots load" do
    desk = load_desktop("data", dt_posts())
    assert_eq(length(desk.museum), 33)
    assert_eq(desk.categories, ["creative", "hardware", "maps", "ml", "music", "social", "tools", "writing"])
    assert_eq(desk.item_count, 30)
    assert_eq(length(split(desk.finder_html, "class=\"more-row\"")), 7)
    assert(starts_with(desk_icon(desk.icons, "no-such-slug"), "<svg"))
    assert_eq(desk_icon(desk.icons, "no-such-slug"), desk_icon(desk.icons, "default"))
  end

  test "descriptions keep their newlines" do
    assert_eq(desk_unescape("a\\nb\\tc\\\\n"), "a\nb\tc\\n")
    desk = load_desktop("data", dt_posts())
    assert(contains(desk_find_project(desk.museum, "local-llm").description, "\n"))
  end

  test "pixel icons are the bytes pixels/1 writes" do
    assert_eq(desk_pixels(["#.", ".#"]), "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 20\" shape-rendering=\"crispEdges\">\n<g fill=\"#000\">\n<rect x=\"0\" y=\"0\" width=\"1\" height=\"1\"/>\n<rect x=\"1\" y=\"1\" width=\"1\" height=\"1\"/>\n</g>\n</svg>\n")
  end

  test "the clock is %I:%M %p in UTC" do
    assert_eq(desk_clock(0), "12:00 AM")
    assert_eq(desk_clock(43200), "12:00 PM")
    assert_eq(desk_clock(13 * 3600 + 5 * 60 + 59), "01:05 PM")
    assert_eq(desk_clock(86400 * 20000 + 23 * 3600 + 57 * 60), "11:57 PM")
  end

  test "the scope is the page's canvas, fed by home.js, and there is no corner window" do
    html = dt_page("booted=1")
    assert(contains(html, "<canvas id=\"scope-canvas\""))
    assert(contains(html, "<script src=\"/blimp/home.js?v="))
    refute(contains(html, "/blimp/runtime.js"))
    assert(contains(html, "Scripts are off, so the drawing is too."))
  end

  test "every museum link keeps the rest of the state and lands on the museum" do
    html = dt_page("cat=ml&leica=1")
    assert(contains(html, "href=\"/?cat=ml&amp;project=local-llm&amp;leica=1#museum\""))
    assert(contains(html, "href=\"/?leica=1#museum\">All</a>"))
    assert(contains(html, "<a class=\"tab active\" href=\"/?cat=ml&amp;leica=1#museum\">ML &amp; AI</a>"))
  end

  test "the old desktop's window state is dropped, not echoed" do
    html = dt_page("cat=ml&finder=1&m=blog&museum=0")
    refute(contains(html, "finder=1"))
    refute(contains(html, "m=blog"))
    refute(contains(html, "museum=0"))
    assert(contains(html, "<a class=\"tab active\" href=\"/?cat=ml#museum\">"))
  end

  test "the filter shows one category" do
    assert(contains(dt_page("cat=hardware"), "<span class=\"sec-count\">4 exhibits</span>"))
    assert(contains(dt_page(""), "<span class=\"sec-count\">33 exhibits</span>"))
    assert(contains(dt_page("cat=creative"), "<span class=\"sec-count\">2 exhibits</span>"))
  end

  test "closing the last exhibit does not replay the splash" do
    html = dt_page("project=deciduous")
    assert(contains(html, "<a class=\"ex-close\" href=\"/?booted=1#museum\""))
  end

  test "the exhibit" do
    html = dt_page("project=deciduous")
    assert(contains(html, "<a class=\"ex on\" href=\"/?project=deciduous#museum\">Deciduous</a>"))
    assert(contains(html, "<a href=\"https://github.com/notactuallytreyanastasio/deciduous\" target=\"_blank\" class=\"ex-repo\">deciduous</a>"))
    assert(contains(html, "3 technologies</p>"))
    refute(contains(dt_page("booted=1"), "id=\"museum-detail\""))
    launch = dt_page("project=phangraphs")
    assert(contains(launch, "<a href=\"https://bobbby.online/phish\" class=\"btn primary\">"))
    tetris = dt_page("project=blimp-tetris")
    assert(contains(tetris, "<a href=\"/tetris\" class=\"btn primary\">"))
    refute(contains(tetris, "https://bobbby.online/tetris"))
    visit = dt_page("project=role-call")
    assert(contains(visit, "<a href=\"https://notactuallytreyanasasio.github.io/role_call\" target=\"_blank\" class=\"btn\""))
  end

  test "the Finder's items are all there, as links" do
    html = dt_page("booted=1")
    assert(contains(html, "href=\"https://bobbby.online/pong\""))
    assert(contains(html, "<a href=\"/\">Deciduous</a>"))
    assert(contains(html, "<a href=\"https://bobbby.online/phish\" title=\"phish, just the jams, explore by rank"))
    assert(contains(html, "<span class=\"sec-count\">30 items</span>"))
  end

  test "the Leica warning opens the image and cancels with a link" do
    html = dt_page("leica=1&cat=ml")
    assert(contains(html, "leica-veil"))
    assert(contains(html, "href=\"https://bobbby-media.fsn1.your-objectstorage.com/leica/leica_6_by_6_full.jpg\">Load Full Resolution</a>"))
    assert(contains(html, "<a class=\"btn\" href=\"/?cat=ml\">Cancel</a>"))
    refute(contains(dt_page("cat=ml"), "leica-veil"))
  end

  test "the log is one line a post, newest ten, and a link to the rest" do
    html = dt_page("")
    assert(contains(html, "<li><a href=\"/post/chess\"><span class=\"log-date\">May 30, 2026</span><span class=\"log-title\">Chess</span></a></li>"))
    assert(contains(html, "href=\"/blog\">all 2 posts"))
    refute(contains(html, "blog-tag"))
    many = map(range(1, 15), fn(i: Int) -> Map do %{slug: concat("p", to_string(i)), title: "t", date: "d", tags: ["x"]} end)
    lines = desk_blog_lines(many)
    assert_eq(length(split(lines, "<li>")) - 1, 10)
    refute(contains(lines, "/post/p11\""))
  end

  test "the manifest lists every page in data/hangar.tsv, each with an icon" do
    html = dt_page("booted=1")
    assert_eq(length(split(html, "class=\"mf-row\"")) - 1, 30)
    assert(contains(html, "<a class=\"mf-row\" href=\"/chess-lv\">"))
    assert(contains(html, "Things I made that you can use</h2><span class=\"sec-count\">30</span>"))
    assert(contains(html, "Games <span>07</span>"))
    refute(contains(html, "mf-icon\"></span>"))
  end

  test "the counters are fixed width, so the prebuilt / can be spliced" do
    assert_eq(desk_pad(7, 3), "007")
    assert_eq(desk_pad(1234, 3), "1234")
    assert_eq(desk_uptime(90061), "001d 01h 01m")
    assert_eq(length(desk_live_counts(33, 217, 90061)), length(DESK_LIVE_MARK))
    assert_eq(length(desk_live_counts(999, 99999999, 86400 * 999)), length(DESK_LIVE_MARK))
    refute(length(desk_live_counts(1000, 0, 0)) == length(DESK_LIVE_MARK))
    bare = dt_page("")
    assert(contains(bare, DESK_LIVE_MARK))
    assert(contains(bare, "<dt>this page</dt><dd>prebuilt at boot</dd>"))
    booted = dt_page("booted=1")
    refute(contains(booted, "prebuilt at boot"))
    assert(contains(booted, " ms</dd></div></dl>"))
  end

  test "the commit is shown only when it is a sha" do
    assert_eq(desk_commit_of(nil), "")
    assert_eq(desk_commit_of("0cffc08c68a6d2ee8b1932177f5cf01200f4d5c9\n"), "0cffc08c68a6d2ee8b1932177f5cf01200f4d5c9")
    assert_eq(desk_commit_of("<script>"), "")
  end

  test "the old menus' destinations are all still linked" do
    html = dt_page("cat=ml")
    each(["/blog", "/stack", "/mirror", "/directory", "/very_direct_message", "/markdown-editor", "/typewriter", "https://old.bobbby.online", "/"], fn(h: String) do
      assert(contains(html, concat("href=\"", h, "\"")))
    end)
  end

  test "the homepage is Bobbby's Online Museum, with a large share card" do
    html = dt_page("")
    assert(contains(html, "<title>Bobbby&#39;s Online Museum</title>") or contains(html, "<title>Bobbby's Online Museum</title>"))
    assert(contains(html, "content=\"https://bobbby.online/images/og-museum.png?v=1\""))
    assert(contains(html, "<meta name=\"twitter:card\" content=\"summary_large_image\">"))
    assert(contains(html, "It is a space to experiment with software and share it socially."))
    assert(contains(html, "I love you\">"))
    refute(contains(blog_index_page([]), "og:image"))
    assert(contains(blog_index_page([]), "<meta name=\"twitter:card\" content=\"summary\">"))
  end

  test "the landing is about Bobby first, and the machine comes after the work" do
    html = dt_page("booted=1")
    assert(contains(html, "Hi, I&#8217;m Bobby."))
    assert(contains(html, "programmer, photographer, and artist living in NYC"))
    intro = length(head(split(html, "class=\"intro\"")))
    work = length(head(split(html, "id=\"work\"")))
    scope = length(head(split(html, "class=\"scope-col\"")))
    assert(intro < work)
    assert(work < scope)
    assert(contains(html, "href=\"/?leica=1\">Photographs</a>"))
  end
end
