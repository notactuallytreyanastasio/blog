actor JournalTests do
  test "every page in content/be-elixir is a route" do
    routes = journal_routes(%{})
    files = journal_files(JOURNAL_DIR)
    assert(length(files) >= 3)
    each(files, fn(f: String) do assert(lookup(routes, journal_route_for(f)) != nil) end)
    assert(contains(lookup(routes, "/be-elixir"), "be-elixir: a journal"))
    assert(contains(lookup(routes, "/be-elixir/guide"), "How be-elixir works"))
  end

  test "no page links anywhere relative: every href is a route, a URL or an anchor" do
    routes = journal_routes(%{})
    pages = map(journal_files(JOURNAL_DIR), fn(f: String) -> String do lookup(routes, journal_route_for(f)) end)
    each(pages, fn(page: String) do
      each(drop_list(split(page, "href=\""), 1), fn(rest: String) do
        ok = starts_with(rest, "/") or starts_with(rest, "http") or starts_with(rest, "#")
        case ok do
          true -> nil
          false -> assert_eq(take(rest, 40), "an absolute href")
        end
      end)
    end)
  end

  test "links to the journal's own files are rewritten, and nothing else is" do
    html = "<a href=\"guide.md\">g</a> <a href=\"probes/04_numbers.exs\">p</a> <a href=\"probes/\">ps</a> <a href=\"https://x/guide.md\">x</a> <a href=\"README.md\">r</a>"
    assert_eq(journal_links(html, ["README.md", "guide.md"]), "<a href=\"/be-elixir/guide\">g</a> <a href=\"/be-elixir/probes/04_numbers.exs\">p</a> <a href=\"/be-elixir/probes\">ps</a> <a href=\"https://x/guide.md\">x</a> <a href=\"/be-elixir\">r</a>")
  end

  test "every probe is served whole, as text, and listed" do
    routes = journal_routes(%{})
    probes = journal_probes(JOURNAL_DIR)
    assert(length(probes) >= 6)
    listing = lookup(routes, "/be-elixir/probes")
    each(probes, fn(p: String) do
      served = lookup(routes, concat("/be-elixir/probes/", p))
      assert(contains(served, "Content-Type: text/plain; charset=utf-8\r\n"))
      assert_eq(drop(served, index_of(served, "\r\n\r\n") + 4), read_file(concat(JOURNAL_DIR, "/probes/", p)))
      assert(contains(listing, concat("href=\"/be-elixir/probes/", p, "\"")))
    end)
  end

  test "the footer names the temper-blimp commit the copy came from" do
    routes = journal_routes(%{})
    commit = journal_commit(JOURNAL_DIR)
    assert_eq(length(commit), 40)
    assert(contains(lookup(routes, "/be-elixir"), concat("/tree/", commit, "/journal")))
  end

  test "a page's title is its first heading" do
    assert_eq(journal_title("intro\n# The title\n## Sub\n"), "The title")
    assert_eq(journal_title("no heading"), "be-elixir")
  end
end
