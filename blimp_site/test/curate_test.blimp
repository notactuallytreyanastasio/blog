# needs: static/admin/common.blimp static/curate/curate.blimp
#
# /curate (src/99_curate.blimp) and its program (static/curate/curate.blimp):
# how a saved order is laid over data/hangar.tsv, what a save must look
# like, the login in front of every route, and what the program asks for.
# The row itself needs Postgres, which the tests do not have.

CUT_SECRET = "curate-test-secret-curate-test-secret-01"

def cut_raw(method: String, target: String, headers: List, body: String) -> String do
  cl = case body == "" and (method == "GET" or method == "HEAD") do
    true -> []
    false -> [concat("Content-Length: ", to_string(length(body)))]
  end
  concat(join(list_append([concat(method, " ", target, " HTTP/1.1"), "Host: x"], list_append(headers, cl)), "\r\n"), "\r\n\r\n", body)
end

def cut_send(method: String, target: String, headers: List, body: String) -> Any do
  raw = cut_raw(method, target, headers, body)
  web_dispatch(raw, parse_request(raw), curate_routes(), CUT_SECRET)
end

def cut_body(got: Tuple) -> String do
  w = elem(got, 0)
  drop(w, index_of(w, "\r\n\r\n") + 4)
end

def cut_cookie(got: Tuple) -> String do
  w = elem(got, 0)
  at = index_of(w, "Set-Cookie: ")
  rest = drop(w, at + 12)
  take(rest, index_of(rest, ";"))
end

def cut_token(page: String) -> String do
  at = index_of(page, "data-csrf=\"")
  rest = drop(page, at + 11)
  take(rest, index_of(rest, "\""))
end

# four pages in two cards, as the file would give them
CUT_PAGES = [
  %{group: "games", path: "/a", name: "A", icon: "<svg/>", pitch: "a."},
  %{group: "games", path: "/b", name: "B", icon: "<svg/>", pitch: "b."},
  %{group: "wire", path: "/c", name: "C", icon: "<svg/>", pitch: "c."},
  %{group: "wire", path: "/d", name: "D", icon: "<svg/>", pitch: "d."}
]

def cut_order(pages: List) -> List do
  map(pages, fn(p: Map) -> String do concat(p.group, p.path) end)
end

CUT_GROUPS = "{\"saved\":false,\"groups\":[{\"group\":\"games\",\"label\":\"Games\",\"tiles\":[{\"path\":\"/a\",\"name\":\"A\",\"pitch\":\"a.\",\"icon\":\"<svg/>\",\"group\":\"games\"},{\"path\":\"/b\",\"name\":\"B\",\"pitch\":\"b.\",\"icon\":\"<svg/>\",\"group\":\"games\"}]},{\"group\":\"wire\",\"label\":\"Live from the internet\",\"tiles\":[{\"path\":\"/c\",\"name\":\"C\",\"pitch\":\"c.\",\"icon\":\"<svg/>\",\"group\":\"wire\"}]}]}"

# the JSON the outbox carries, as to_html escaped it in the attribute
def cut_outbox_json(html: String) -> String do
  at = index_of(html, "data-c=\"")
  rest = drop(html, at + 8)
  replace(take(rest, index_of(rest, "\"")), "&quot;", "\"")
end

actor CurateTests do
  test "a saved order is laid over the file's; the file's cards and pages win" do
    # nothing saved: the file
    assert_eq(cut_order(desk_arrange(CUT_PAGES, nil)), ["games/a", "games/b", "wire/c", "wire/d"])
    # the saved order, across cards; the cards stay in the file's order
    saved = [%{"path": "/d", "group": "games"}, %{"path": "/b", "group": "wire"}, %{"path": "/a", "group": "games"}, %{"path": "/c", "group": "wire"}]
    assert_eq(cut_order(desk_arrange(CUT_PAGES, saved)), ["games/d", "games/a", "wire/b", "wire/c"])
    # a page the row does not have lands at the end of its file card; a
    # path or card the file does not have is dropped; a path twice is once
    partial = [%{"path": "/c", "group": "games"}, %{"path": "/zzz", "group": "games"}, %{"path": "/a", "group": "nope"}, %{"path": "/c", "group": "wire"}, "junk"]
    assert_eq(cut_order(desk_arrange(CUT_PAGES, partial)), ["games/c", "games/a", "games/b", "wire/d"])
    assert_eq(cut_order(desk_arrange(CUT_PAGES, "not a list")), cut_order(CUT_PAGES))
  end

  test "the file's own pages arrange the same way, and every card keeps a note" do
    pages = desk_hangar_pages()
    assert(length(pages) > 20)
    assert_eq(cut_order(desk_arrange(pages, [])), cut_order(pages))
    # the first page into the last card: a saved tile comes first in its
    # card, the file's unsaved ones after it
    first = head(pages)
    last_page = last(pages)
    moved = desk_arrange(pages, [%{"path": first.path, "group": last_page.group}])
    there = filter(moved, fn(p: Map) -> Bool do p.group == last_page.group end)
    assert_eq(head(there).path, first.path)
    assert_eq(last(there).path, last_page.path)
    assert_eq(length(moved), length(pages))
    refute(head(moved).path == first.path)
    # the same cards, in the same order
    assert_eq(desk_uniq(map(moved, fn(p: Map) -> String do p.group end), []), desk_uniq(map(pages, fn(p: Map) -> String do p.group end), []))
  end

  test "a save is checked: real pages and cards, no page twice, no card left empty" do
    pages = CUR_PAGES
    groups = cur_groups_of(pages)
    ok = map(pages, fn(p: Map) -> Map do %{"path": p.path, "group": p.group} end)
    assert_eq(cur_check(ok), "")
    assert_eq(cur_check("tiles"), "tiles must be a list of {path, group}")
    assert(starts_with(cur_check([%{"path": "/nope", "group": head(groups)}]), "Not a page and card of this site"))
    assert(starts_with(cur_check([%{"path": head(pages).path, "group": "nope"}]), "Not a page and card of this site"))
    assert(starts_with(cur_check([42]), "Not a page and card of this site"))
    twice = list_append(ok, [head(ok)])
    assert_eq(cur_check(twice), "A page is listed twice")
    # every page of the first card moved to the second: the first card is empty
    g1 = head(groups)
    g2 = elem_at(groups, 1)
    emptied = map(pages, fn(p: Map) -> Map do
      case p.group == g1 do
        true -> %{"path": p.path, "group": g2}
        false -> %{"path": p.path, "group": p.group}
      end
    end)
    assert_eq(cur_check(emptied), concat("Every card needs at least one page; ", desk_hangar_label(g1), " would have none"))
    # the entries the row gets are only path and group
    assert_eq(json_encode(cur_entries([%{"path": "/a", "group": "g", "name": "x"}])), json_encode([%{path: "/a", group: "g"}]))
  end

  test "the page sets the session's CSRF token and names its program" do
    got = cut_send("GET", "/curate", [], "")
    assert_eq(elem(got, 1), 200)
    page = cut_body(got)
    assert(length(cut_token(page)) > 20)
    assert(contains(page, "data-program=\"/curate.blimp\""))
    assert(contains(page, "/admin/admin.js"))
    assert(contains(page, "/curate/curate.js"))
    assert(contains(page, "/assets/curate.css"))
    assert_eq(elem(cut_send("GET", "/curate/curate.js", [], ""), 1), 200)
    assert_eq(elem(cut_send("GET", "/assets/curate.css", [], ""), 1), 200)
    assert_eq(elem(cut_send("GET", "/curate.blimp", [], ""), 1), 200)
  end

  test "every read and write wants a login, and every write the token" do
    page = cut_send("GET", "/curate", [], "")
    cookie = concat("Cookie: ", cut_cookie(page))
    token = concat("x-csrf-token: ", cut_token(cut_body(page)))
    json = "Content-Type: application/json"
    assert_eq(elem(cut_send("GET", "/curate/layout.json", [cookie], ""), 1), 401)
    assert_eq(elem(cut_send("POST", "/curate/layout", [cookie, json], "{\"tiles\":[]}"), 1), 403)
    no_login = cut_send("POST", "/curate/layout", [cookie, token, json], "{\"tiles\":[]}")
    assert_eq(elem(no_login, 1), 401)
    assert_eq(cut_body(no_login), "{\"error\":\"Log in first\"}")
    assert_eq(elem(cut_send("DELETE", "/curate/layout", [cookie, token], ""), 1), 401)
    # CURATE_PASSWORD is unset here: nobody gets in, "" included
    assert_eq(CUR_PASSWORD, "")
    denied = cut_send("POST", "/curate/login", [cookie, token, json], "{\"password\":\"\"}")
    assert_eq(elem(denied, 1), 403)
    assert_eq(cut_body(denied), "{\"error\":\"Wrong password\"}")
  end

  test "a login is the password's, runs out, and is not /admin's" do
    at = 1000000
    conn = %{secret: CUT_SECRET, session: put(put(%{}, "curate_at", at), "curate", cur_login_mac(CUT_SECRET, "pw", at))}
    assert(cur_session_ok(conn, "pw", at + 10))
    refute(cur_session_ok(conn, "changed", at + 10))
    refute(cur_session_ok(conn, "pw", at + CUR_LOGIN_S))
    refute(cur_session_ok(conn, "", at + 10))
    refute(cur_session_ok(%{secret: CUT_SECRET, session: %{}}, "pw", at))
    # an /admin login does not open /curate
    admin = %{secret: CUT_SECRET, session: put(put(%{}, "admin_at", at), "admin", adm_login_mac(CUT_SECRET, "pw", at))}
    refute(cur_session_ok(admin, "pw", at + 10))
  end

  test "the program: the password, then the cards" do
    c = spawn Curator
    assert(contains(to_html(c <- :view), "Loading"))
    c <- :loaded(401, "{\"error\":\"Log in first\"}")
    assert(contains(to_html(c <- :view), "type=\"password\""))
    c <- :login(%{"password": "hunter2"})
    html = to_html(c <- :view)
    assert(contains(html, "/curate/login"))
    assert(contains(html, "hunter2"))
    c <- :done(0, 403, "{\"error\":\"Wrong password\"}")
    assert(contains(to_html(c <- :view), "Wrong password"))
    c <- :loaded(200, CUT_GROUPS)
    cards = to_html(c <- :view)
    assert(contains(cards, "Games"))
    assert(contains(cards, "Live from the internet"))
    assert(contains(cards, "nothing is saved yet"))
    refute(contains(cards, "Back to the file"))
    assert(index_of(cards, "data-path=\"/a\"") < index_of(cards, "data-path=\"/b\""))
    assert(index_of(cards, "data-path=\"/b\"") < index_of(cards, "data-path=\"/c\""))
  end

  test "the program writes every move, as the tiles in page order" do
    c = spawn Curator
    c <- :loaded(200, CUT_GROUPS)
    # a drag: /c before /a, into Games
    c <- :moved("/c", "/a", 0, "games")
    html = to_html(c <- :view)
    assert(index_of(html, "data-path=\"/c\"") < index_of(html, "data-path=\"/a\""))
    assert(contains(html, "/curate/layout"))
    assert_eq(cut_outbox_json(html), "{\"tiles\":[{\"path\":\"/c\",\"group\":\"games\"},{\"path\":\"/a\",\"group\":\"games\"},{\"path\":\"/b\",\"group\":\"games\"}]}")
    # the server answers the cards it saved
    c <- :done(0, 200, "{\"saved\":true,\"groups\":[{\"group\":\"games\",\"label\":\"Games\",\"tiles\":[{\"path\":\"/c\",\"name\":\"C\",\"pitch\":\"c.\",\"icon\":\"\",\"group\":\"games\"}]},{\"group\":\"wire\",\"label\":\"Live from the internet\",\"tiles\":[{\"path\":\"/a\",\"name\":\"A\",\"pitch\":\"a.\",\"icon\":\"\",\"group\":\"wire\"}]}]}")
    saved = to_html(c <- :view)
    assert(contains(saved, "shows your arrangement"))
    assert(contains(saved, "Back to the file"))
    assert(index_of(saved, "data-path=\"/c\"") < index_of(saved, "data-path=\"/a\""))
    # the arrows: tile 1 (/a, in Live) up has nowhere to go within its card; down neither
    c <- :up(1)
    assert_eq(cut_outbox_json(to_html(c <- :view)), "{\"tiles\":[{\"path\":\"/c\",\"group\":\"games\"},{\"path\":\"/a\",\"group\":\"wire\"}]}")
    c <- :done(1, 200, CUT_GROUPS)
    # now /a /b in Games, /c in Live: /b (1) up, then the card menu sends /c to Games
    c <- :up(1)
    assert_eq(cut_outbox_json(to_html(c <- :view)), "{\"tiles\":[{\"path\":\"/b\",\"group\":\"games\"},{\"path\":\"/a\",\"group\":\"games\"},{\"path\":\"/c\",\"group\":\"wire\"}]}")
    c <- :done(2, 200, CUT_GROUPS)
    c <- :regroup("games /c")
    assert_eq(cut_outbox_json(to_html(c <- :view)), "{\"tiles\":[{\"path\":\"/a\",\"group\":\"games\"},{\"path\":\"/b\",\"group\":\"games\"},{\"path\":\"/c\",\"group\":\"games\"}]}")
    c <- :done(3, 400, "{\"error\":\"Every card needs at least one page; Live from the internet would have none\",\"saved\":false,\"groups\":[]}")
    refused = to_html(c <- :view)
    assert(contains(refused, "would have none"))
    # a drop onto the empty space of a card: the end of it
    c <- :loaded(200, CUT_GROUPS)
    c <- :moved("/a", "", 1, "wire")
    assert_eq(cut_outbox_json(to_html(c <- :view)), "{\"tiles\":[{\"path\":\"/b\",\"group\":\"games\"},{\"path\":\"/c\",\"group\":\"wire\"},{\"path\":\"/a\",\"group\":\"wire\"}]}")
    # dropped where it was, or onto a card that is not there: nothing to write
    c <- :done(4, 200, CUT_GROUPS)
    c <- :moved("/a", "/a", 1, "games")
    c <- :moved("/a", "", 1, "nowhere")
    refute(contains(to_html(c <- :view), "data-op"))
    # back to the file's order asks first, then deletes
    c <- :done(4, 200, "{\"saved\":true,\"groups\":[]}")
    c <- :reset
    asked = to_html(c <- :view)
    assert(contains(asked, "Back to the file's order?"))
    c <- :done(5, 1, "")
    assert(contains(to_html(c <- :view), "DELETE"))
    c <- :done(6, 401, "{\"error\":\"Log in first\"}")
    assert(contains(to_html(c <- :view), "type=\"password\""))
  end
end
