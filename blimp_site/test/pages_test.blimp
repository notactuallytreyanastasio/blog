# Renders the real posts, so this runs from blimp_site/ like the server.

# True if `html` has an attribute named on<letters>= anywhere: onclick,
# onload, onerror, and the rest.
def has_handler_attr(pieces: List) -> Bool do
  case pieces do
    [] -> false
    [p | rest] ->
      eq = index_of(p, "=")
      case eq > 0 and all_letters(take(p, eq), 0) do
        true -> true
        false -> has_handler_attr(rest)
      end
  end
end

def all_letters(s: String, i: Int) -> Bool do
  case i >= length(s) do
    true -> true
    false ->
      c = char_code(char_at(s, i))
      (c >= 97 and c <= 122) and all_letters(s, i + 1)
  end
end

def script_free(html: String) -> Bool do
  lower = downcase(html)
  not(contains(lower, "<script")) and not(contains(lower, "javascript:")) and not(has_handler_attr(drop_list(split(lower, " on"), 1)))
end

def word_counts(posts: List) -> Map do
  reduce(posts, %{}, fn(acc: Map, p: Map) -> Map do put(acc, p.slug, p.words) end)
end

# Every page has the runtime window (RUNTIME_TAGS) exactly once; what a
# test says about a page's own scripts it says about the rest.
def without_runtime(html: String) -> String do
  replace_all(html, RUNTIME_TAGS, "")
end

def runtime_once(html: String) -> Bool do
  length(split(html, RUNTIME_TAGS)) == 2
end

actor PageTests do
  test "the handler check finds a handler and passes plain text" do
    refute(script_free("<a href=\"/\" onclick=\"x()\">"))
    refute(script_free("<img src=x onerror=alert(1)>"))
    assert(script_free("<p>turn it on and off, on=off</p>"))
  end

  test "the index and 404 have only the runtime window; posts have only Blimp's window" do
    posts = load_posts("../priv/static/posts", read_file("data/posts.txt"))
    assert(runtime_once(blog_index_page(posts)))
    assert(script_free(without_runtime(blog_index_page(posts))))
    assert(runtime_once(not_found_page("/<script>")))
    assert(script_free(without_runtime(not_found_page("/<script>"))))
    each(posts, fn(p: Map) do
      html = post_page(p)
      # a post draws its own program, so it has no runtime window
      refute(contains(html, "/blimp/runtime.js"))
      lower = downcase(html)
      # exactly the two external scripts, nothing inline, no handlers
      assert_eq(length(split(lower, "<script")) - 1, 2)
      assert_eq(length(split(lower, "\"></script>")) - 1, 2)
      assert(contains(html, "<script src=\"/blimp/canvas.js\"></script><script src=\"/blimp/post.js\"></script>"))
      refute(contains(lower, "javascript:"))
      refute(has_handler_attr(drop_list(split(lower, " on"), 1)))
      # the article is cut where post.js cuts it
      assert(contains(html, "</div><div class=\"post-footer\">"))
    end)
  end

  # The numbers Phoenix shows today, from PostLive.word_count run in Elixir
  # over the same files.
  test "word counts are PostLive's" do
    w = word_counts(load_posts("../priv/static/posts", read_file("data/posts.txt")))
    assert_eq(lookup(w, "building-this-blog"), 235)
    assert_eq(lookup(w, "whats-my-schtick"), 5)
    assert_eq(lookup(w, "lets-write-letters"), 778)
    assert_eq(lookup(w, "a-genstage-tutorial-and-reflection"), 7931)
    assert_eq(lookup(w, "327-years-of-tree-law-in-the-usa-"), 3385)
    assert_eq(lookup(w, "chess"), 5687)
    assert_eq(lookup(w, "notes-on-dario-altman-elmo-and-the-frontier"), 4792)
  end

  test "the index lists posts newest first" do
    posts = load_posts("../priv/static/posts", read_file("data/posts.txt"))
    assert_eq(head(posts).slug, "this-site-is-blimp-now")
    assert_eq(last(posts).slug, "building-this-blog")
  end

  test "/tetris has Blimp's four scripts and nothing else" do
    html = tetris_page("6f1f92bbeb8c00f54511b8ff696db8c82355341e", 801)
    lower = downcase(html)
    assert_eq(length(split(lower, "<script")) - 1, 4)
    # every script is an external file, closed at once: nothing inline
    assert_eq(length(split(lower, "\"></script>")) - 1, 4)
    each(TETRIS_SCRIPTS, fn(src: String) do
      assert(contains(html, concat("<script src=\"", src, "\"></script>")))
    end)
    refute(contains(lower, "javascript:"))
    refute(has_handler_attr(drop_list(split(lower, " on"), 1)))
    assert(contains(html, "801 lines of actors"))
    assert(contains(html, "<canvas id=\"tetris-viz\"></canvas>"))
    assert(contains(html, "/commit/6f1f92bbeb8c00f54511b8ff696db8c82355341e\">6f1f92b</a>"))
  end

  test "/pong and /pong/god have Blimp's two scripts and their own, nothing inline" do
    each([[pong_page("pong_0123456789abcdef"), PONG_SCRIPTS], [pong_god_page(), GOD_SCRIPTS]], fn(pair: List) do
      # the page draws its own program, so not the server's
      refute(contains(head(pair), "/blimp/runtime.js"))
      html = head(pair)
      lower = downcase(html)
      n = length(elem_at(pair, 1))
      assert_eq(length(split(lower, "<script")) - 1, n)
      assert_eq(length(split(lower, "\"></script>")) - 1, n)
      each(elem_at(pair, 1), fn(src: String) do
        assert(contains(html, concat("<script src=\"", src, "\"></script>")))
      end)
      refute(contains(lower, "javascript:"))
      refute(has_handler_attr(drop_list(split(lower, " on"), 1)))
      refute(contains(html, "phx-"))
    end)
    assert(contains(pong_page("pong_0123456789abcdef"), "Pong.exe - Game ID: pong_0123456789abcdef</span>"))
    assert(contains(pong_page("pong_0123456789abcdef"), "data-game=\"pong_0123456789abcdef\""))
  end

  test "an app page names its program, runs only Blimp's scripts, and can class <html>" do
    html = app_page("2048", "d", [APP_CSS], "twenty48-page", "/2048/twenty48.blimp", "game")
    refute(contains(html, "/blimp/runtime.js"))
    assert(contains(html, "<script src=\"/blimp/page-canvas.js\"></script>"))
    lower = downcase(html)
    assert_eq(length(split(lower, "<script")) - 1, length(APP_SCRIPTS))
    assert_eq(length(split(lower, "\"></script>")) - 1, length(APP_SCRIPTS))
    assert(contains(html, "<html lang=\"en\" class=\"twenty48-page\">"))
    assert(contains(html, "data-program=\"/2048/twenty48.blimp\" data-actor=\"game\""))
    refute(has_handler_attr(drop_list(split(lower, " on"), 1)))
  end

  test "/mirror shows exactly its own file, every character spinning" do
    file = read_file("src/96_mirror.blimp")
    assert_eq(concat(mirror_source(concat("x\n", file, "y\n")), "\n"), file)
    html = mirror_page(concat("x\n", file))
    assert(runtime_once(html))
    refute(contains(downcase(without_runtime(html)), "<script"))
    # one span per character, multi-byte characters kept whole
    assert_eq(length(utf8_chars("aé—b")), 4)
    lines = split(file, "\n")
    chars = reduce(lines, 0, fn(n: Int, l: String) -> Int do n + length(utf8_chars(l)) end)
    assert_eq(length(split(html, "class=\"mirror-char\"")) - 1, chars)
    # the file's own markup is shown, one escaped character at a time
    assert(contains(html, "ms infinite;\">&lt;</span>"))
  end

  test "a snapshot page gets the runtime window before its own </body>" do
    html = page_with_runtime("<html><body><p>x</p></body></html>\n")
    assert_eq(html, concat("<html><body><p>x</p>", RUNTIME_TAGS, "</body></html>\n"))
    each(["privacy", "knicks", "chess"], fn(name: String) do
      assert(runtime_once(page_with_runtime(read_file(concat("content/pages/", name, ".html")))))
    end)
  end

  test "a game id is pong_ and 16 hex digits, and a new one every time" do
    a = pong_game_id()
    assert_eq(length(a), 21)
    assert(starts_with(a, "pong_"))
    refute(a == pong_game_id())
  end

  test "the kept pages carry no LiveView client and no frozen CSRF token" do
    each(["privacy", "terms", "trees", "nathan", "knicks", "frontier", "chess"], fn(name: String) do
      html = read_file(concat("content/pages/", name, ".html"))
      refute(html == nil)
      refute(contains(html, "phx-track-static"))
      refute(contains(html, "csrf-token"))
      refute(contains(html, "data-phx-session"))
      refute(contains(html, "\"/assets/app.css\""))
      assert(contains(downcase(html), "</html>"))
    end)
  end
end
