# The running journals of two Temper backends, rendered from Markdown:
#
#   /be-elixir   be-elixir, for Elixir and the BEAM, written in ~/code/temper-blimp
#   /be-ruby     be-ruby, for Ruby, written in ~/code/temper-be-ruby
#
# content/<name>/ is a copy of that backend's journal directory at one
# commit (content/<name>/sync.sh made it, and COMMIT says which). Every
# page is rendered at boot by the same Markdown renderer as the posts.
#
# The Markdown links to its own files the way GitHub wants them, guide.md
# and probes/04_numbers.exs, and is kept byte for byte as the repo has it.
# The links are rewritten to this site's routes after rendering instead.
#
#   /be-elixir              README.md
#   /be-elixir/guide        guide.md
#   /be-elixir/<entry>      2026-09-30-what-an-object-is.md and the like
#   /be-elixir/probes       a list of the probes
#   /be-elixir/probes/<f>   one probe, as text; probes/11_dialyzer/run.sh
#                           and the like for a probe that is a directory
#
# and the same under /be-ruby. Each journal is a map, below; every function
# here takes the one it is rendering.
#
# It builds its responses itself rather than with main.blimp's page_route,
# because the tests are compiled from src/ without main.blimp.

# repo is where the journal's commit can be browsed, "" when it is not
# public yet; source says where the copy came from either way.
def be_elixir_journal() -> Map do
  %{
    name: "be-elixir",
    dir: "content/be-elixir",
    route: "/be-elixir",
    repo: "https://github.com/notactuallytreyanastasio/temper-blimp",
    repo_dir: "journal",
    source: "temper-blimp",
    code: "temper/be-elixir",
    headline: "be-elixir: a Temper backend for Elixir, a running journal",
    desk: "be-elixir, a Temper backend for Elixir",
    description: "The running journal of a Temper backend for Elixir and the BEAM.",
    probes_intro: "Every claim the journal makes about Elixir was checked by running one of these scripts on Elixir 1.19.5 and OTP 28. Run an <code>.exs</code> one with <code>elixir &lt;file&gt;.exs</code>; a probe made of several files has a README saying how to run it."
  }
end

def be_ruby_journal() -> Map do
  %{
    name: "be-ruby",
    dir: "content/be-ruby",
    route: "/be-ruby",
    repo: "",
    repo_dir: "be-ruby/journal",
    source: "temper, branch ruby",
    code: "be-ruby",
    headline: "be-ruby: a typed Temper backend for Ruby, a running journal",
    desk: "be-ruby, a typed Temper backend for Ruby",
    description: "The running journal of a Temper backend for Ruby, with types.",
    probes_intro: "Every claim the journal makes about Ruby was checked by running one of these scripts on Ruby 4.0.7. Run one with <code>ruby &lt;file&gt;.rb</code>."
  }
end

def journals() -> List do
  [be_elixir_journal(), be_ruby_journal()]
end

def journal_is_md(name: String) -> Bool do
  length(name) > 3 and drop(name, length(name) - 3) == ".md"
end

# "guide.md" -> "/be-elixir/guide", "README.md" -> "/be-elixir"
def journal_route_for(j: Map, file: String) -> String do
  case file do
    "README.md" -> j.route
    _ -> concat(j.route, "/", take(file, length(file) - 3))
  end
end

def journal_files(dir: String) -> List do
  names = list_dir(dir)
  case names do
    nil -> journal_die(concat("cannot list ", dir))
    _ -> sort(filter(names, fn(n: String) -> Bool do journal_is_md(n) end))
  end
end

# Every file under probes/, by its path there: "04_numbers.exs", and for a
# probe that is a directory, each of its files, "11_dialyzer/run.sh". A
# directory is not itself a probe: served, it would be read as a file and
# stop the boot.
def journal_probes(dir: String) -> List do
  sort(journal_probes_under(concat(dir, "/probes"), ""))
end

def journal_probes_under(dir: String, prefix: String) -> List do
  names = list_dir(dir)
  case names do
    nil -> []
    _ -> flat(map(names, fn(n: String) -> List do
      inner = list_dir(concat(dir, "/", n))
      case inner do
        nil -> [concat(prefix, n)]
        _ -> journal_probes_under(concat(dir, "/", n), concat(prefix, n, "/"))
      end
    end))
  end
end

# A page named in the directory that will not read stops the boot, as a
# missing post does: serving the rest and a 404 would look like it worked.
def journal_die(why: String) -> Any do
  print(concat("journal: ", why))
  exit(1)
end

def journal_read(path: String) -> String do
  body = read_file(path)
  case body do
    nil -> journal_die(concat("cannot read ", path))
    _ -> body
  end
end

# Every href= the renderer wrote that points at one of the journal's own
# files becomes this site's route for it.
def journal_links(j: Map, html: String, files: List) -> String do
  pages = reduce(files, html, fn(acc: String, f: String) -> String do
    replace_all(acc, concat("href=\"", f, "\""), concat("href=\"", journal_route_for(j, f), "\""))
  end)
  probes = replace_all(pages, "href=\"probes/\"", concat("href=\"", j.route, "/probes\""))
  replace_all(probes, "href=\"probes/", concat("href=\"", j.route, "/probes/"))
end

# examples/ is copied but not served: its Temper and target code are read
# on GitHub, at the commit this copy came from. A journal with no public
# repo yet has no examples to link.
def journal_example_links(j: Map, html: String, commit: String) -> String do
  case j.repo do
    "" -> html
    _ -> replace_all(html, "href=\"examples/", concat("href=\"", j.repo, "/tree/", commit, "/", j.repo_dir, "/examples/"))
  end
end

# The first "# " line of a page is its title.
def journal_title(j: Map, source: String) -> String do
  heads = filter(split(source, "\n"), fn(l: String) -> Bool do starts_with(l, "# ") end)
  case heads do
    [] -> j.name
    [h | _] -> drop(h, 2)
  end
end

def journal_commit(dir: String) -> String do
  trim(journal_read(concat(dir, "/COMMIT")))
end

def journal_nav(j: Map, current: String) -> String do
  items = [[j.route, "Journal"], [concat(j.route, "/guide"), "Guide"], [concat(j.route, "/probes"), "Probes"]]
  links = map(items, fn(i: List) -> String do
    href = elem(i, 0)
    mark = case href == current do
      true -> " aria-current=\"page\""
      false -> ""
    end
    concat("<a href=\"", href, "\"", mark, ">", elem(i, 1), "</a>")
  end)
  join([
    "<header class=\"jr-top\"><a class=\"jr-home\" href=\"/\">bobbby.online</a>",
    "<span class=\"jr-sep\">/</span><a class=\"jr-name\" href=\"", j.route, "\">", j.name, "</a>",
    "<nav class=\"jr-nav\">", join(links, ""), "</nav></header>"
  ], "")
end

def journal_footer(j: Map, commit: String) -> String do
  short = take(commit, 7)
  copied = case j.repo do
    "" -> concat(j.source, "@", short)
    _ -> concat("<a href=\"", j.repo, "/tree/", commit, "/", j.repo_dir, "\">", j.source, "@", short, "</a>")
  end
  join([
    "<footer class=\"jr-foot\">Copied from ", copied,
    " (its <code>", j.repo_dir, "/</code> directory) and rendered by this site's Blimp server. ",
    "The code it describes is <code>", j.code, "</code> in the same repository.</footer>"
  ], "")
end

def journal_page(j: Map, route: String, title: String, article: String, commit: String) -> String do
  body = join([
    "<div class=\"jr\">", journal_nav(j, route),
    "<main class=\"jr-main\"><article class=\"jr-article article-content\">", article, "</article></main>",
    journal_footer(j, commit), "</div>"
  ], "")
  page_layout(concat(title, " · ", j.name), j.description, "article", ["/assets/journal.css", "/assets/highlight.css"], body)
end

def journal_probes_page(j: Map, probes: List, commit: String) -> String do
  rows = map(probes, fn(p: String) -> String do
    concat("<li><a href=\"", j.route, "/probes/", p, "\"><code>", escape_html(p), "</code></a></li>")
  end)
  article = join([
    "<h1>Probes</h1>",
    "<p>", j.probes_intro, "</p>",
    "<ul class=\"jr-probes\">", join(rows, ""), "</ul>"
  ], "")
  journal_page(j, concat(j.route, "/probes"), "Probes", article, commit)
end

def journal_routes(routes: Map) -> Map do
  all = reduce(journals(), routes, fn(acc: Map, j: Map) -> Map do journal_routes_for(j, acc) end)
  css = journal_read("assets/journal.css")
  put(all, "/assets/journal.css", serialize(response(200, "text/css; charset=utf-8", "public, max-age=300", css), "GET"))
end

def journal_routes_for(j: Map, routes: Map) -> Map do
  files = journal_files(j.dir)
  commit = journal_commit(j.dir)
  with_pages = reduce(files, routes, fn(acc: Map, f: String) -> Map do
    source = journal_read(concat(j.dir, "/", f))
    html = journal_example_links(j, journal_links(j, MARKDOWN <- :render(source), files), commit)
    route = journal_route_for(j, f)
    put(acc, route, serialize(html_response(200, journal_page(j, route, journal_title(j, source), html, commit)), "GET"))
  end)
  probes = journal_probes(j.dir)
  with_probes = reduce(probes, with_pages, fn(acc: Map, p: String) -> Map do
    body = journal_read(concat(j.dir, "/probes/", p))
    put(acc, concat(j.route, "/probes/", p), serialize(response(200, "text/plain; charset=utf-8", "public, max-age=300", body), "GET"))
  end)
  put(with_probes, concat(j.route, "/probes"), serialize(html_response(200, journal_probes_page(j, probes, commit)), "GET"))
end

# The newest entry, for the links on /blog and the homepage:
# %{title: ..., route: ...}, or nil when there is none.
#
# Newest is the last one README.md's numbered list links to, not the last
# file name in sorted order: two entries written the same day sort by their
# slugs, and "classes-as-modules" sorts before "loops-without-loops" though
# it came after it.
def journal_latest(j: Map) -> Any do
  linked = journal_entries_listed(journal_read(concat(j.dir, "/README.md")))
  case reverse(linked) do
    [] -> nil
    [newest | _] ->
      %{title: journal_title(j, journal_read(concat(j.dir, "/", newest))), route: journal_route_for(j, newest)}
  end
end

# The .md files the README's numbered list links to, in order:
# "1. [title](2026-09-30-x.md)" -> "2026-09-30-x.md"
def journal_entries_listed(readme: String) -> List do
  lines = filter(split(readme, "\n"), fn(l: String) -> Bool do journal_is_entry_line(l) end)
  map(lines, fn(l: String) -> String do
    rest = drop(l, index_of(l, "](") + 2)
    take(rest, index_of(rest, ")"))
  end)
end

def journal_is_entry_line(l: String) -> Bool do
  contains(l, ". [") and contains(l, ".md)") and journal_is_dated(drop(l, index_of(l, "](") + 2))
end

# 2026-10-01-slug.md: a year, a dash, a month, a dash
def journal_is_dated(name: String) -> Bool do
  length(name) > 11 and starts_with(name, "20") and take(drop(name, 4), 1) == "-" and take(drop(name, 7), 1) == "-"
end

# The pinned rows at the top of /blog, newest journal first.
def journal_blog_row() -> String do
  join(map(reverse(journals()), fn(j: Map) -> String do journal_blog_row_for(j) end), "")
end

def journal_blog_row_for(j: Map) -> String do
  latest = journal_latest(j)
  meta = case latest do
    nil -> "a running journal"
    _ -> concat("latest: ", escape_html(latest.title))
  end
  join([
    "<a href=\"", j.route, "\" class=\"blog-post-row\">",
    "<div class=\"blog-post-icon\">📓</div>",
    "<div class=\"blog-post-info\">",
    "<div class=\"blog-post-title\">", j.headline, "</div>",
    "<div class=\"blog-post-meta\">", meta, "</div>",
    "</div></a>"
  ], "")
end

# The lines under the newest posts in the homepage's Writing card.
def journal_desk_line() -> String do
  join(map(reverse(journals()), fn(j: Map) -> String do journal_desk_line_for(j) end), "")
end

def journal_desk_line_for(j: Map) -> String do
  latest = journal_latest(j)
  newest = case latest do
    nil -> ""
    _ -> concat(" · latest: <a href=\"", latest.route, "\">", escape_html(latest.title), "</a>")
  end
  concat("<p class=\"log-journal\">Running journal: <a href=\"", j.route, "\">", j.desk, "</a>", newest, "</p>")
end
