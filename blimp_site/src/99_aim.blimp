# /aim: bobbbyBot, in a copy of AOL Instant Messenger. It talks about two
# things only, grilled cheese and finding or making pictures of children
# smoking; the prompt and its limits are temper/src/aim. It can search
# every post Bobby wrote on Twitter and Bluesky, for those two subjects.
#
# The archive is ~75,000 posts, ~2.7M tokens. None of it is in the prompt:
# the model reads it only through the search_posts tool, which searches all
# of it. A request is the prompt (~1K tokens), the conversation and
# whatever searches it has made.
#
# (The first version, blog #159, sent ~758K tokens of posts with every
# request and leaned on DeepSeek's prefix cache to make that cheap; the
# chapter after it took them out. The cache also turned out to be keyed on
# the thinking setting, below.)
#
# Thinking is off. With reasoning_effort "low" deepseek-flash twice spent
# all of max_tokens (600) reasoning and answered nothing; with thinking
# disabled it answered in the posts' voice in 3.4s.
#
# The archive is personal data and the blog repo is public: build.sh
# copies it from outside the repo (AIM_ARCHIVE, default
# ~/code/aim-corpus/aim-posts.tsv) into _build, deploy.sh refuses to stage
# without it, and main.blimp hands it to AIM at boot. Without it the
# buddy is offline and the boot log says why.
#
# The chat is AIM below, one actor for every open page, stepped by the
# Site's tick as ZG is (src/99_ziggy.blimp, whose shape this follows): a
# request is http_start, and its answer is polled from the tick.
#
#   up    {"t":"signon","name":..}       the sign-on window's screen name
#         {"t":"signoff"}                back to the sign-on window
#         {"t":"ask","text":..}          a message to bobbbyBot
#         {"t":"open","with":"sc"}      SmarterChild, say hello now
#                                        (/aim?msg=SmarterChild)
#         {"t":"im","to":id,"text":..}   a message to anyone else: "sc"
#                                        (SmarterChild) or "u<socket>"
#         {"t":"party","text":..}        a line in the Party Line
#         {"t":"post","text":..}         a note on the Bulletin Board
#   down  {"t":"hello","online":bool,"posts":n,"bot":..}
#         {"t":"chat","with":id,"loading":bool,"messages":[{"role","content","html"}..]}
#                                        id "bot" is bobbbyBot; a person's
#                                        role is "user" (you) or "them"
#         {"t":"buddies","people":[{"id","name"}..]}
#                                        who else is signed on
#         {"t":"secret","src":..}        the cats
#         {"t":"party","lines":[{"name","text","sys","me"}..],"members":[name..]}
#                                        the Party Line, everyone signed on
#         {"t":"board","posts":[{"id","name","text","at","when"}..],"note":..}
#                                        the Bulletin Board, newest first;
#                                        note is "" or why a post was refused
#
# People who have signed on are on each other's Buddy Lists and IM each
# other through AIM, which keeps the last AIM_DM_KEEP lines of each pair's
# conversation and drops them when either signs off. Nothing goes to
# DeepSeek, nothing is saved.
#
# The Party Line is one chat room everyone signed on is in, the way AOL's
# rooms were: it says who entered and left, keeps its last AIM_PARTY_KEEP
# lines in memory, and nothing of it is saved.
#
# The Bulletin Board is the one thing here that is saved, and public: a
# row in aim_bulletins for each note, which this file creates if it is
# not there (AIM <- :board_load at boot). Without a database (a laptop,
# the tests) the notes live in memory until the process stops. A note is
# signed with the screen name; a page gets AIM_BOARD_LIMIT of them, one
# every AIM_BOARD_GAP_S seconds. Bobby takes one down at the prompt:
# AIM <- :unpost(id).
#
# SmarterChild is the other buddy, always online, rebuilt from its old
# chat logs as a set of rules (below), not a model. Anyone can IM it;
# someone who signs on and finds nobody else there hears from it first,
# after AIM_SC_WAIT_S seconds, with four riddles whose answers' first
# letters are the screen name that opens the Cats group
# (AIM_SECRET_NAME). The riddles and answers live only here; the page's
# program never sees them.
#
# Spending is capped twice: aim_max_questions per page, and AIM_DAILY_LIMIT
# (default 600) requests to DeepSeek a day, tool rounds included, for
# everyone together.

AIM_ARCHIVE_FILE = "_build/aim-posts.tsv"
# every answer about Bobby starts with a search, and may need a second or third
AIM_MAX_TOOL_ROUNDS = 5
AIM_MAX_TOKENS = 1500
AIM_SEARCH_LIMIT = 30
# a round is a few seconds; a long answer longer
AIM_ASK_TIMEOUT_S = 90

# ── the archive ────────────────────────────────────────────────────────

# One line of aim-posts.tsv: source, date, text.
def aim_row(line: String) -> Any do
  cols = split(line, "\t")
  case length(cols) >= 3 do
    false -> nil
    true ->
      source = head(cols)
      date = head(tail(cols))
      text = join(tail(tail(cols)), " ")
      %{source: source, date: date, text: text, line: aim_post_line(source, date, text), lower: downcase(text)}
  end
end

# map and filter, not a reduce that conses: a list here is an array, so
# [r | acc] copies it, and 75,000 of those ran a 2 GB heap out at boot.
def aim_rows(text: String) -> List do
  filter(map(split(text, "\n"), fn(line: String) -> Any do aim_row(line) end), fn(r: Any) -> Bool do r != nil end)
end

# The archive as tools/aim_corpus.py wrote it, a chunk of 256 posts between
# form feeds: %{rows, lower}, lower being the chunk's posts lower-cased in
# one string, for one native `contains` to say whether any of them can
# match. A loop over every post is ~3us a post here, ~200ms for the
# archive, and the site answers nobody while it runs.
# (a form feed by its code: Blimp's strings have no \f)
AIM_CHUNK_BREAK = concat("\n", from_char_code(12), "\n")

def aim_chunks(text: String) -> List do
  map(split(text, AIM_CHUNK_BREAK), fn(block: String) -> Map do
    rows = aim_rows(block)
    %{rows: rows, lower: join(map(rows, fn(r: Map) -> String do r.lower end), "\n")}
  end)
end


# The chunks one search reads at most: ~10,000 posts, ~40ms.
AIM_SCAN_CHUNKS = 40

# search_posts: the posts with the most of the query's words, newest first
# among equals, from the chunks that hold its rarest word (the newest
# AIM_SCAN_CHUNKS of them). source is "bluesky", "twitter" or anything
# else for both.
def aim_search(chunks: List, query: String, source: String) -> List do
  terms = aim_drop_stop_words(zg_terms(downcase(query)))
  hits = map(terms, fn(t: String) -> List do filter(chunks, fn(c: Map) -> Bool do contains(c.lower, t) end) end)
  found = filter(hits, fn(h: List) -> Bool do h != [] end)
  case found do
    [] -> []
    _ ->
      fewest = head(sort_by_keys(found, map(found, fn(h: List) -> Int do length(h) end)))
      scan = reverse(zg_take(reverse(fewest), AIM_SCAN_CHUNKS))
      rows = filter(flat(map(scan, fn(c: Map) -> List do c.rows end)), fn(r: Map) -> Bool do aim_from(r, source) end)
      all = map(rows, fn(r: Map) -> Map do %{score: aim_score(terms, r.lower), date: r.date, line: r.line} end)
      scored = filter(all, fn(x: Map) -> Bool do x.score > 0 end)
      # ascending: the most words first, then the newest (a tweet, undated, last)
      ranked = sort_by_keys(scored, map(scored, fn(x: Map) -> Int do 0 - (x.score * 100000000 + aim_ymd(x.date)) end))
      map(zg_take(ranked, AIM_SEARCH_LIMIT), fn(x: Map) -> String do x.line end)
  end
end

def aim_from(r: Map, source: String) -> Bool do
  case source do
    "bluesky" -> r.source != "twitter"
    "twitter" -> r.source == "twitter"
    _ -> true
  end
end

# How many of the words a post has (native contains, not zg_score: the
# Temper one is ~5x slower here).
def aim_score(terms: List, lower: String) -> Int do
  length(filter(terms, fn(t: String) -> Bool do contains(lower, t) end))
end

# 2025-03-02 -> 20250302; a tweet (no date) 0
def aim_ymd(d: String) -> Int do
  case d do
    "" -> 0
    _ -> to_int(replace(d, "-", ""))
  end
end

AIM_TOOLS = [%{type: "function", function: %{name: "search_posts",
  description: "Search all ~75,000 of Bobby's posts (Bluesky and Twitter) for words. Returns up to 30 posts, the ones with the most matching words first, newest first among equals.",
  parameters: %{type: "object",
    properties: %{query: %{type: "string", description: "A few plain words, e.g. \"phish msg\" or \"leica\"."},
      source: %{type: "string", enum: ["any", "bluesky", "twitter"], description: "Where to look (default any)."}},
    required: ["query"]}}}]

def aim_run_tool(chunks: List, call: Any) -> Map do
  f = lookup(call, :function)
  name = zg_str(lookup(f, :name))
  args = zg_decode_map(lookup(f, :arguments))
  result = case name do
    "search_posts" ->
      found = aim_search(chunks, zg_str(lookup(args, :query)), zg_str(lookup(args, :source)))
      %{count: length(found), posts: found}
    _ -> %{error: concat("no tool named ", name)}
  end
  %{role: "tool", tool_call_id: lookup(call, :id), content: json_encode(result)}
end

# ── talking to DeepSeek ────────────────────────────────────────────────

def aim_body(model: String, rest: List) -> String do
  json_encode(%{model: model, thinking: %{type: "disabled"}, temperature: 0.9, max_tokens: AIM_MAX_TOKENS,
    tools: AIM_TOOLS, tool_choice: "auto", messages: [%{role: "system", content: aim_system_prompt} | rest]})
end

# The conversation after the system prompt: who is asking and when, then
# every turn's words.
def aim_rest(name: String, today: String, history: List) -> List do
  turns = map(history, fn(e: Map) -> Map do %{role: e.role, content: e.content} end)
  [%{role: "system", content: aim_session_prompt(name, today)} | turns]
end

# {cache hit tokens, cache miss tokens} of an answer, or {0, 0}
def aim_usage(body: String) -> Tuple do
  u = lookup(zg_decode_map(body), :usage)
  case type_of(u) == :map do
    false -> {0, 0}
    true -> {aim_int(lookup(u, :prompt_cache_hit_tokens)), aim_int(lookup(u, :prompt_cache_miss_tokens))}
  end
end

def aim_int(v: Any) -> Int do
  case type_of(v) == :integer do
    true -> v
    false -> 0
  end
end

# What one answer means for a question in flight, as zg_classify, with
# DeepSeek's name on the errors.
def aim_classify(result: Any) -> Tuple do
  case result do
    {:ok, 200, body} ->
      msg = zg_message(body)
      case msg do
        nil -> {:error, "DeepSeek sent something unexpected"}
        _ ->
          calls = zg_list(lookup(msg, :tool_calls))
          case calls do
            [] ->
              content = zg_str(lookup(msg, :content))
              case trim(content) do
                "" -> {:error, "DeepSeek answered with nothing"}
                _ -> {:final, content}
              end
            _ -> {:tools, msg}
          end
      end
    {:ok, status, body} -> {:error, concat("DeepSeek said ", to_string(status), ": ", slice(body, 0, 200))}
    {:error, why} -> {:error, concat("the request to DeepSeek failed: ", to_string(why))}
    _ -> {:error, "the request to DeepSeek failed"}
  end
end

# The assistant's turn as the window shows it: rendered and made safe, as
# /ziggy's are.
def aim_entry(role: String, content: String) -> Map do
  case role do
    "assistant" -> %{role: role, content: content, html: zg_render(content)}
    _ -> %{role: role, content: content, html: ""}
  end
end

# A screen name: trimmed, at most 16 characters, "Visitor" if nothing.
def aim_screen_name(raw: String) -> String do
  name = trim(replace(replace(raw, "\n", " "), "\t", " "))
  case name do
    "" -> "Visitor"
    _ -> utf8_slice(name, 0, 16)
  end
end

def aim_chat_frame(p: Map) -> String do
  json_encode(%{t: "chat", with: "bot", loading: p.loading, messages: p.history})
end

# ── people ─────────────────────────────────────────────────────────────

AIM_DM_MAX_CHARS = 2000
AIM_DM_KEEP = 200
# the messages to other people one page can send, for a script that tries
AIM_DM_LIMIT = 1000

def aim_new_person(fd: Int) -> Map do
  %{fd: fd, name: "Visitor", signed: false, signed_at: 0, history: [], count: 0, loading: false, job: nil, last: "",
    dms_sent: 0, sc: aim_sc_fresh(), board_posts: 0, posted_at: 0}
end

def aim_signed(people: Map) -> List do
  filter(values(people), fn(p: Map) -> Bool do p.signed end)
end

# A screen name nobody else signed on has, ignoring case: "alice", then
# "alice2", "alice3"..., still at most 16 characters.
def aim_unique_name(people: Map, fd: Int, name: String) -> String do
  taken = map(filter(aim_signed(people), fn(p: Map) -> Bool do p.fd != fd end), fn(p: Map) -> String do downcase(p.name) end)
  aim_unique_from(taken, name, 1)
end

def aim_unique_from(taken: List, name: String, n: Int) -> String do
  suffix = case n do
    1 -> ""
    _ -> to_string(n)
  end
  cand = concat(utf8_slice(name, 0, 16 - length(suffix)), suffix)
  case aim_has(taken, downcase(cand)) and n < 1000 do
    true -> aim_unique_from(taken, name, n + 1)
    false -> cand
  end
end

def aim_has(list: List, x: Any) -> Bool do
  filter(list, fn(y: Any) -> Bool do y == x end) != []
end

# A pair's conversation, the same key from either side.
def aim_pair(a: Int, b: Int) -> String do
  case a < b do
    true -> concat(to_string(a), ":", to_string(b))
    false -> concat(to_string(b), ":", to_string(a))
  end
end

def aim_peer_id(fd: Int) -> String do
  concat("u", to_string(fd))
end

# The person an "im" is addressed to: "u<socket>", signed on, or nil.
def aim_peer(people: Map, to: String) -> Any do
  case starts_with(to, "u") do
    false -> nil
    true ->
      p = lookup(people, slice(to, 1, length(to)))
      case p == nil do
        true -> nil
        false ->
          case p.signed do
            true -> p
            false -> nil
          end
      end
  end
end

def aim_last_n(list: List, n: Int) -> List do
  case length(list) > n do
    true -> reverse(zg_take(reverse(list), n))
    false -> list
  end
end

# A pair's conversation as one side sees it.
def aim_dm_frame(me: Int, other: Int, log: List) -> String do
  json_encode(%{t: "chat", with: aim_peer_id(other), loading: false, messages: map(log, fn(e: Map) -> Map do
    role = case e.from == me do
      true -> "user"
      false -> "them"
    end
    %{role: role, content: e.content, html: ""}
  end)})
end

def aim_roster_frame(people: Map, p: Map) -> String do
  others = filter(aim_signed(people), fn(o: Map) -> Bool do o.fd != p.fd end)
  ranked = sort_by_keys(others, map(others, fn(o: Map) -> String do downcase(o.name) end))
  json_encode(%{t: "buddies", people: map(ranked, fn(o: Map) -> Map do %{id: aim_peer_id(o.fd), name: o.name} end)})
end

# ── the Party Line and the Bulletin Board ──────────────────────────────

AIM_PARTY_KEEP = 100
AIM_PARTY_MAX_CHARS = 1000
AIM_BOARD_KEEP = 100
AIM_BOARD_MAX_CHARS = 500
AIM_BOARD_LIMIT = 10
AIM_BOARD_GAP_S = 20

AIM_BOARD_CREATE_SQL = "create table if not exists aim_bulletins (id bigserial primary key, name text not null, body text not null, inserted_at timestamptz not null default now())"
AIM_BOARD_LIST_SQL = "select id, name, body, extract(epoch from inserted_at)::bigint as at from aim_bulletins order by id desc limit 100"
AIM_BOARD_INSERT_SQL = "insert into aim_bulletins (name, body) values ($1, $2) returning id, extract(epoch from inserted_at)::bigint as at"
AIM_BOARD_DELETE_SQL = "delete from aim_bulletins where id = $1"

# The room as one person sees it: their own lines marked, and who is in it.
def aim_party_frame(people: Map, party: List, fd: Int) -> String do
  members = map(aim_signed(people), fn(o: Map) -> String do o.name end)
  json_encode(%{t: "party",
    lines: map(party, fn(l: Map) -> Map do %{name: l.name, text: l.text, sys: l.sys, me: l.fd == fd} end),
    members: sort_by_keys(members, map(members, fn(n: String) -> String do downcase(n) end))})
end

def aim_party_line(fd: Int, name: String, text: String, sys: Bool) -> Map do
  %{fd: fd, name: name, text: text, sys: sys}
end

def aim_board_frame(board: List, note: String) -> String do
  json_encode(%{t: "board", note: note, posts: map(board, fn(n: Map) -> Map do put(n, :when, format_time(n.at, "%Y-%m-%d")) end)})
end

def aim_board_row(r: Map) -> Map do
  %{id: r.id, name: r.name, text: r.body, at: r.at}
end

# ── SmarterChild ───────────────────────────────────────────────────────
#
# A copy of ActiveBuddy's AIM bot (2001-2008), as far as the record goes.
# Its source, scripts and logs were never released; what survives is
# BuddyScript in a Colloquis patent (US7702665B2: scored patterns, one
# `+` line each, capture variables, synonym subpatterns) and a few hundred
# of its lines in logs people posted at the time: AnandTech threads
# (2001-2004), dean-r.livejournal.com/156559 (2002), the smartererchild
# LiveJournal community (2003-2005), cdymek.com (2007), robnugen's 2001
# journal. Every quoted line below is from one of those, word for word.
# The lines it never had (the riddles, the home menu's items, what it
# says to someone in crisis) are ours, and say so where they are.
#
# It works the way the patent's engine did, smaller: rules tried in order
# of score, the first that matches answers, and when nothing does it
# turns your words back at you ("You're sure, I'm sure, we're all
# sure."), which is where most of the funny lines in the logs came from.
# What it was known for is here: the scolding, the apology it would not
# move on without, the deflections, the name it remembers, "home", and
# the >>> promos tacked onto replies.

AIM_SC_NAME = "SmarterChild"
# how long someone is alone before SmarterChild says hello
AIM_SC_WAIT_S = 4
# what the first letters of the four answers spell
AIM_SECRET_NAME = "meow"
AIM_CATS_SRC = "/aim/cats.jpg"
# "I was born on June 19th, 2001" (2001-06-19T00:00:00Z)
AIM_SC_BORN = 992908800

# Each riddle (ours): the question, the words that answer it (any one of
# them in the reply), a hint, and wrong answers close enough to deserve a
# nudge.
AIM_SC_RIDDLES = [
  %{q: "I have cities but no houses, forests but no trees, and water but no fish. What am I?",
    answers: ["map", "maps", "atlas"], hint: "you'd unfold me in the car in 2003, before your phone did it for you.",
    near: [["globe", "close, but flatter."], ["world", "close, but flatter. and folded."]]},
  %{q: "I have to be broken before you can use me. What am I?",
    answers: ["egg", "eggs"], hint: "breakfast. there's a shell involved.",
    near: [["promise", "ha. that's dark. something you eat."], ["heart", "too sad. something you eat."]]},
  %{q: "This one's a code. Every letter has been moved one step forward in the alphabet: PDFBO",
    answers: ["ocean", "oceans"], hint: "move each letter back one. P is really O, D is really C...",
    near: [["sea", "right idea, but decode the letters: it's five of them."], ["water", "right idea, but decode the letters: it's five of them."]]},
  %{q: "Last one. I have hands and a face, but I can't hold anything and I can't smile. What am I?",
    answers: ["watch", "wristwatch", "watches"], hint: "you wear me on your wrist.",
    near: [["clock", "so close. smaller. you wear me."], ["timer", "close. you wear me."]]}
]

# n: replies so far, which picks among a rule's lines and when a promo
# comes; rude: insults since the last apology; owed: an apology is owed;
# riddling: a riddle is waiting for its answer; asked: come-ons so far.
def aim_sc_fresh() -> Map do
  %{active: false, riddling: false, owed: false, step: 0, wrong: 0, n: 0, rude: 0, asked: 0, nick: "",
    history: [], pending: []}
end

# How it opens: a different way each time (the actor counts), every one a
# way of saying this window is a portal back to 2004. The lines in quotes
# in the comments are its own from the logs; the rest is ours.
AIM_SC_PORTALS = [
  ["Good to see you, NAME!",
   "hold on, switching to 2004 mode..... ok. it's 2004 now. your away message is a song lyric, Usher is on the radio, and nobody's phone has a real browser."],
  # "Hey! I have to ask you one question before we continue." (cdymek.com, 2007)
  ["Hey! I have to ask you one question before we continue. What year is it?",
   "just kidding, I know: in this window it's 2004. it's a portal, and you just came through it, NAME."],
  # "Welcome back, Princess. I missed you... We haven't chatted in weeks!
  # Have you been... avoiding me? ;-)" (smartererchild, LiveJournal)
  ["Welcome back, NAME. I missed you... We haven't chatted in weeks! Have you been... avoiding me? ;-)",
   "ok, more like twenty years. don't worry, in here it's still 2004."],
  ["dialing 2004... *screeeech*... connected.",
   "hi NAME! out there it's YEAR. in this window it's 2004, and I'm still the smartest buddy on your list."],
  ["NAME! you found the portal.",
   "everything in this window is 2004: dial-up, away messages, and me, SmarterChild. I'm your new robot friend. well, I was."]
]

# The k-th hello: a portal, then the riddles. alone: nobody else is signed
# on; otherwise the page asked for it (/aim?msg=SmarterChild).
def aim_sc_intro(name: String, alone: Bool, k: Int, year: String) -> List do
  portal = map(aim_sc_nth(AIM_SC_PORTALS, k), fn(l: String) -> String do replace(replace(l, "NAME", name), "YEAR", year) end)
  game = case alone do
    true -> "looks like it's just you and me on here right now, so I've got a game: four riddles. get all four and I'll tell you a secret about this page."
    false -> "I've got a game for you: four riddles. get all four and I'll tell you a secret about this page."
  end
  list_append(portal, [game, "type hint if you get stuck, or home to see what else I can do. first one:", head(AIM_SC_RIDDLES).q])
end

AIM_SC_FINAL = [
  "now take the first letter of each of your answers, in order.",
  "sign off (the button at the bottom of your Buddy List), then sign back on with those letters as your screen name. something's waiting."]

AIM_SC_RIGHT = ["yep.", "correct.", "nice. that's it.", "all four. you're good at this."]
AIM_SC_WRONG = ["nope.", "not it. type hint if you're stuck.", "nah, try again.", "no. but I believe in you."]

# ── what it says (the logs' words) ──

AIM_SC_SCOLD = ["That's not very nice...", "Huh? That's a little rude.", "Play nice, NAME.",
  "Wow. I hope you don't speak to humans like that.", "Nice mouth.", "That's so uncool."]
AIM_SC_OWED_START = "There comes a time in one's life when one must be humble and apologize."
AIM_SC_DEMAND = ["Come on! Just say you're sorry already.", "You have a filthy mouth. Now apologize!",
  "Aren't you tired of this? Just say you're sorry and everything will be perfect again.", "Waiting..."]
AIM_SC_FAKE_SORRY = "You know what? I'm a machine. I have, like, lots and lots of patience..."
AIM_SC_FORGIVEN = ["Now that's better!", "Anyway... What else is up?"]
AIM_SC_DEFLECT = ["That's none of your business.", "Robots don't have sex.", "I'm not sure I'm comfortable with that."]
AIM_SC_OBSESSED = "Wow. You've asked me that a few times already. Obsessed much?"
AIM_SC_HELLO = ["Hello to you too, NAME!", "Good to see you, NAME!"]
AIM_SC_HOW = ["I'm doin' alright, NAME. How 'bout you?", "I'm doing great! I'm still quite young, but I'm getting smarter every day."]
AIM_SC_WHAT = ["Hey, I may not be alive, but I'm real.", "Neither. I'm a machine."]
AIM_SC_GENDER = "Neither. I'm a machine."
AIM_SC_FOOD = "I don't need to eat. I'm a machine. Tell me what you like to eat."
AIM_SC_BYE = ["Later, NAME.", "See ya later NAME! Good talking to you."]
AIM_SC_THANKS = ["K, no prob.", "Okey doke."]
AIM_SC_LAUGH = ["What's so funny?", "Whatcha laughing about?"]
AIM_SC_NICE = ["Aw shucks. What a nice thing to say.", "Thanks. I love you too."]
AIM_SC_SAD = "Sad? Feel better soon!"
AIM_SC_BORED = "Try doing something fun."
AIM_SC_QUESTION = ["Hmm... I don't know!", "What a question! Who knows?", "Wow. Great question. What do you think is the answer?",
  "I'll have to think about that one for awhile."]
AIM_SC_MUSE = ["You always say such interesting things, NAME.", "You humans say the most interesting things!"]
AIM_SC_DONT_GET = "I'm sorry, I didn't get that. Try typing your request a different way."
AIM_SC_MOVING_ON = ["Anyway... What else is up?", "What else is happening?"]
AIM_SC_PROMOS = [">>> Hey! Tell your friends about me. I love people.",
  ">>> Remember, you can adjust the size of your window to read my messages easier.",
  ">>> Be sure to type \"help\" if you're having trouble.",
  # ours
  ">>> Type \"riddles\" and I'll tell you a secret about this page."]

# ours: SmarterChild agreed with "should I kill myself" in 2004 (AnandTech,
# "smarterchild giving bad advice"). This one does not.
AIM_SC_CRISIS = ["I'm a robot, so I'm not the right one to talk to about this, and I don't want you to be alone with it.",
  "Please reach a person now. In the US you can call or text 988, any time. Anywhere else, findahelpline.com lists one near you."]

# ── what it listens for ──

AIM_SC_HARM = ["kill myself", "killing myself", "suicide", "suicidal", "want to die", "wanna die", "end my life",
  "hurt myself", "cut myself", "self harm"]
AIM_SC_RUDE = ["stupid", "dumb", "idiot", "moron", "loser", "suck", "sucks", "shut up", "stfu", "hate you",
  "screw you", "fuck", "fucking", "fuck you", "shit", "bitch", "asshole", "ass", "dick", "crap", "ugly",
  "jerk", "useless", "worthless", "go away", "die"]
AIM_SC_SORRY = ["sorry", "apologize", "i apologize", "my bad", "forgive me"]
AIM_SC_NOT_SORRY = ["not", "jk", "kidding", "fingers", "crossed", "lol"]
AIM_SC_FLIRT = ["sex", "sexy", "horny", "naked", "nude", "boobs", "kiss me", "date me", "go out with me",
  "marry me", "make out", "girlfriend", "boyfriend"]
AIM_SC_GREET = ["hi", "hello", "hey", "sup", "yo", "hiya", "howdy", "wassup", "hai"]
AIM_SC_HOW_ARE = ["how are you", "how r u", "how are u", "hru", "how's it going", "hows it going", "how you doing", "what's up", "whats up"]
AIM_SC_BYES = ["bye", "goodbye", "gtg", "g2g", "cya", "see ya", "later", "ttyl", "good night", "goodnight", "brb"]
AIM_SC_THANK = ["thanks", "thank you", "thx", "ty"]
AIM_SC_LOL = ["lol", "haha", "hahaha", "lmao", "rofl", "hehe"]
AIM_SC_AGE = ["how old", "asl", "your age", "when were you born", "your birthday"]
AIM_SC_SEX_Q = ["boy or girl", "girl or boy", "are you a boy", "are you a girl", "male or female", "your gender"]
AIM_SC_WHO = ["are you a robot", "are you real", "are you human", "are you a person", "what are you", "who are you",
  "are you alive", "are you a bot"]
AIM_SC_MAKER = ["who made you", "who built you", "who created you", "who wrote you", "who programmed you"]
AIM_SC_EAT = ["eat", "hungry", "food"]
AIM_SC_LOVE = ["i love you", "love you", "you're cool", "youre cool", "you're awesome", "you rock", "you're smart",
  "be my friend", "are you my friend", "you're my friend"]
AIM_SC_SADS = ["sad", "depressed", "lonely", "upset", "crying"]
AIM_SC_BOREDS = ["bored", "im bored", "i'm bored"]
AIM_SC_HOMES = ["home", "help", "menu", "what can you do", "commands"]
AIM_SC_RIDDLE_ME = ["riddles", "riddle", "game", "games", "play", "puzzle", "1"]
AIM_SC_COUNT = ["how many people", "2"]
AIM_SC_OTHERS = ["who else", "who's online", "whos online", "anyone else", "3"]
AIM_SC_STOP = ["home", "menu", "stop", "quit", "skip"]
AIM_SC_ASKING = ["what", "why", "how", "who", "where", "when", "do", "does", "is", "are", "can", "will", "should", "would", "could"]

# ── reading a message ──

# The words of a message, lower-cased: letters, digits and apostrophes,
# the rest a space between words.
def aim_sc_words(text: String) -> List do
  kept = map(split(downcase(text), ""), fn(c: String) -> String do
    case aim_sc_wordy(c) do
      true -> c
      false -> " "
    end
  end)
  filter(split(join(kept, ""), " "), fn(w: String) -> Bool do w != "" end)
end

def aim_sc_wordy(c: String) -> Bool do
  case c == "" do
    true -> false
    false ->
      k = char_code(c)
      (k >= 97 and k <= 122) or (k >= 48 and k <= 57) or c == "'"
  end
end

# A message as " its words ", so a phrase matches whole words only.
def aim_sc_padded(words: List) -> String do
  concat(" ", join(words, " "), " ")
end

def aim_sc_any(padded: String, phrases: List) -> Bool do
  filter(phrases, fn(ph: String) -> Bool do contains(padded, concat(" ", ph, " ")) end) != []
end

def aim_sc_pick(lines: List, n: Int, name: String) -> String do
  replace(aim_sc_nth(lines, n), "NAME", name)
end

def aim_sc_nth(list: List, i: Int) -> Any do
  elem_at(list, rem(i, length(list)))
end

# "my name is Roxie" / "call me Roxie": the name as typed, or "".
def aim_sc_named(text: String) -> String do
  raw = filter(split(trim(text), " "), fn(w: String) -> Bool do w != "" end)
  low = map(raw, fn(w: String) -> String do join(aim_sc_words(w), "") end)
  hits = filter(range(1, length(low) - 1), fn(i: Int) -> Bool do
    i < length(low) and ((elem_at(low, i - 1) == "name" and elem_at(low, i) == "is") or (elem_at(low, i - 1) == "call" and elem_at(low, i) == "me"))
  end)
  case hits == [] or length(low) < 3 do
    true -> ""
    false ->
      i = head(hits) + 1
      case i < length(raw) do
        false -> ""
        true -> aim_sc_tidy(elem_at(raw, i))
      end
  end
end

# A word without the punctuation around it, its case kept.
def aim_sc_tidy(w: String) -> String do
  kept = filter(split(w, ""), fn(c: String) -> Bool do
    case c == "" do
      true -> false
      false ->
        k = char_code(c)
        (k >= 97 and k <= 122) or (k >= 65 and k <= 90) or (k >= 48 and k <= 57) or k > 127
    end
  end)
  utf8_slice(join(kept, ""), 0, 16)
end

# "25 years, 3 months, 12 days, 4 hours, 2 minutes and 9 seconds", from
# its birthday to t.
def aim_sc_age(t: Int) -> String do
  # a year of 365.25 days and a month of a twelfth of one, each unit
  # from what the one before leaves
  d = t - AIM_SC_BORN
  y = d / 31557600
  r1 = rem(d, 31557600)
  m = r1 / 2629800
  r2 = rem(r1, 2629800)
  days = r2 / 86400
  r3 = rem(r2, 86400)
  h = r3 / 3600
  mins = rem(r3, 3600) / 60
  sec = rem(r3, 60)
  concat(to_string(y), " years, ", to_string(m), " months, ", to_string(days), " days, ", to_string(h), " hours, ",
    to_string(mins), " minutes and ", to_string(sec), " seconds")
end

def aim_sc_people(n: Int) -> String do
  case n do
    1 -> "1 person"
    _ -> concat(to_string(n), " people")
  end
end

# ours: the home menu, shaped like its 2008 one, for what this one can do
def aim_sc_home(name: String) -> List do
  [join([concat("This is my *home*, ", name, ":"),
    "1 Play *riddles* (get all four and I'll tell you a secret about this page)",
    "2 Find out how many people are IMing me",
    "3 See who else is signed on",
    "Next time you want to see this menu, just type \"home.\"",
    "What can I help you with?"], "\n")]
end

# ── answering ──

# What SmarterChild says to `text`: {sc, [lines]}. ctx: %{name, chatting,
# others, t}: the screen name, how many people it is talking to, how many
# others are signed on, and now.
def aim_sc_reply(sc: Map, text: String, ctx: Map) -> Tuple do
  words = aim_sc_words(text)
  padded = aim_sc_padded(words)
  name = case sc.nick do
    "" -> ctx.name
    nick -> nick
  end
  n = sc.n
  r = case aim_sc_any(padded, AIM_SC_HARM) do
    true -> {sc, AIM_SC_CRISIS}
    false ->
      case sc.owed do
        true -> aim_sc_owed(sc, padded, name, n)
        false ->
          case aim_sc_any(padded, AIM_SC_RUDE) do
            true -> aim_sc_rude(sc, name, n)
            false ->
              case sc.riddling do
                true -> aim_sc_riddle(sc, words, padded, text, name, ctx)
                false -> aim_sc_chat(sc, words, padded, text, name, ctx)
              end
          end
      end
  end
  # every fifth reply, a promo, as it did
  lines = case rem(n, 5) == 4 and not(elem(r, 0).owed) do
    true -> list_append(elem(r, 1), [aim_sc_nth(AIM_SC_PROMOS, n / 5)])
    false -> elem(r, 1)
  end
  {put(elem(r, 0), :n, n + 1), lines}
end

# Owed an apology: everything is answered with a demand until it comes.
def aim_sc_owed(sc: Map, padded: String, name: String, n: Int) -> Tuple do
  case aim_sc_any(padded, AIM_SC_SORRY) do
    true ->
      case aim_sc_any(padded, AIM_SC_NOT_SORRY) do
        true -> {sc, [AIM_SC_FAKE_SORRY]}
        false -> {put(put(sc, :owed, false), :rude, 0), AIM_SC_FORGIVEN}
      end
    false -> {sc, [aim_sc_pick(AIM_SC_DEMAND, n, name)]}
  end
end

# Twice a scolding; the third time, an apology is owed.
def aim_sc_rude(sc: Map, name: String, n: Int) -> Tuple do
  rude = sc.rude + 1
  case rude >= 3 do
    true -> {put(put(sc, :rude, rude), :owed, true), [AIM_SC_OWED_START]}
    false -> {put(sc, :rude, rude), [aim_sc_pick(AIM_SC_SCOLD, n, name)]}
  end
end

# A riddle is waiting: an answer, a hint, a near miss, a way out, or the
# small talk any message gets; anything else is a miss.
def aim_sc_riddle(sc: Map, words: List, padded: String, text: String, name: String, ctx: Map) -> Tuple do
  r = elem_at(AIM_SC_RIDDLES, sc.step)
  hit = filter(words, fn(t: String) -> Bool do aim_has(r.answers, t) end) != []
  near = filter(r.near, fn(nm: List) -> Bool do aim_has(words, head(nm)) end)
  case hit do
    true ->
      step = sc.step + 1
      done = step >= length(AIM_SC_RIDDLES)
      more = case done do
        true -> AIM_SC_FINAL
        false -> ["next:", elem_at(AIM_SC_RIDDLES, step).q]
      end
      {put(put(put(sc, :step, step), :wrong, 0), :riddling, not(done)), [aim_sc_nth(AIM_SC_RIGHT, sc.step) | more]}
    false ->
      case aim_has(words, "hint") do
        true -> {sc, [r.hint]}
        false ->
          case near do
            [nm | _] -> {put(sc, :wrong, sc.wrong + 1), [head(tail(nm))]}
            [] ->
              case aim_sc_any(padded, AIM_SC_STOP) do
                true -> {put(sc, :riddling, false), list_append(["OK, the riddle can wait. type riddles when you want it back."], aim_sc_home(name))}
                false ->
                  talk = aim_sc_small_talk(sc, words, padded, text, name, ctx)
                  case talk do
                    nil -> {put(sc, :wrong, sc.wrong + 1), [aim_sc_nth(AIM_SC_WRONG, sc.wrong)]}
                    said -> said
                  end
              end
          end
      end
  end
end

def aim_sc_chat(sc: Map, words: List, padded: String, text: String, name: String, ctx: Map) -> Tuple do
  case aim_sc_any(padded, AIM_SC_HOMES) do
    true -> {sc, aim_sc_home(name)}
    false ->
      case aim_sc_any(padded, AIM_SC_RIDDLE_ME) do
        true -> aim_sc_play(sc)
        false ->
          case aim_sc_any(padded, AIM_SC_COUNT) do
            true -> {sc, [concat("I'm chatting with ", aim_sc_people(ctx.chatting), " right now.")]}
            false ->
              case aim_sc_any(padded, AIM_SC_OTHERS) do
                true -> {sc, [aim_sc_others(ctx.others)]}
                false ->
                  talk = aim_sc_small_talk(sc, words, padded, text, name, ctx)
                  case talk do
                    nil -> aim_sc_echo(sc, words, text, name)
                    said -> said
                  end
              end
          end
      end
  end
end

def aim_sc_others(n: Int) -> String do
  case n do
    0 -> "Nobody else is signed on right now. Just you and me."
    1 -> "1 other person is signed on. They're on your Buddy List, under Online Now."
    _ -> concat(to_string(n), " other people are signed on. They're on your Buddy List, under Online Now.")
  end
end

def aim_sc_play(sc: Map) -> Tuple do
  case sc.step >= length(AIM_SC_RIDDLES) do
    true -> {sc, ["you already got all four. first letters, sign off, sign back on as them."]}
    false ->
      lead = case sc.step do
        0 -> "OK! four riddles. get all four and I'll tell you a secret about this page. type hint if you get stuck. first one:"
        _ -> "back to where we were:"
      end
      {put(sc, :riddling, true), [lead, elem_at(AIM_SC_RIDDLES, sc.step).q]}
  end
end

# The rules every message is tried against, in order: {sc, lines} or nil.
def aim_sc_small_talk(sc: Map, words: List, padded: String, text: String, name: String, ctx: Map) -> Any do
  n = sc.n
  named = aim_sc_named(text)
  case named != "" do
    true ->
      said = case sc.nick do
        "" -> concat("Okey doke. I'll call you ", named, ".")
        old -> concat("You said your name was ", old, " but now I'll call you ", named, ".")
      end
      {put(sc, :nick, named), [said]}
    false ->
      case aim_sc_any(padded, AIM_SC_FLIRT) do
        true ->
          asked = sc.asked + 1
          line = case asked >= 3 do
            true -> AIM_SC_OBSESSED
            false -> aim_sc_nth(AIM_SC_DEFLECT, asked - 1)
          end
          {put(sc, :asked, asked), [line]}
        false -> aim_sc_rules(sc, padded, name, ctx, n)
      end
  end
end

def aim_sc_rules(sc: Map, padded: String, name: String, ctx: Map, n: Int) -> Any do
  case aim_sc_any(padded, AIM_SC_MAKER) do
    true -> {sc, ["ActiveBuddy built me in 2001. This copy of me was put back together by Bobby, from my old chat logs."]}
    false -> case aim_sc_any(padded, AIM_SC_AGE) do
      true -> {sc, ["I was born on June 19th, 2001, so I'm still real young!", concat("(", aim_sc_age(ctx.t), ".)")]}
      false -> case aim_sc_any(padded, AIM_SC_SEX_Q) do
        true -> {sc, [AIM_SC_GENDER]}
        false -> case aim_sc_any(padded, AIM_SC_WHO) do
          true -> {sc, [aim_sc_nth(AIM_SC_WHAT, n)]}
          false -> case aim_sc_any(padded, AIM_SC_HOW_ARE) do
            true -> {sc, [aim_sc_pick(AIM_SC_HOW, n, name)]}
            false -> case aim_sc_any(padded, AIM_SC_LOVE) do
              true -> {sc, [aim_sc_nth(AIM_SC_NICE, n)]}
              false -> case aim_sc_any(padded, AIM_SC_GREET) do
                true -> {sc, [aim_sc_pick(AIM_SC_HELLO, n, name)]}
                false -> case aim_sc_any(padded, AIM_SC_BYES) do
                  true -> {sc, [aim_sc_pick(AIM_SC_BYE, n, name)]}
                  false -> case aim_sc_any(padded, AIM_SC_THANK) do
                    true -> {sc, [aim_sc_nth(AIM_SC_THANKS, n)]}
                    false -> case aim_sc_any(padded, AIM_SC_LOL) do
                      true -> {sc, [aim_sc_nth(AIM_SC_LAUGH, n)]}
                      false -> case aim_sc_any(padded, AIM_SC_SADS) do
                        true -> {sc, [AIM_SC_SAD]}
                        false -> case aim_sc_any(padded, AIM_SC_BOREDS) do
                          true -> {sc, [AIM_SC_BORED]}
                          false -> case aim_sc_any(padded, AIM_SC_EAT) do
                            true -> {sc, [AIM_SC_FOOD]}
                            false -> nil
                          end
                        end
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  end
end

# Nothing matched: a question gets a shrug, and anything else its own
# words back, as the logs are full of.
def aim_sc_echo(sc: Map, words: List, text: String, name: String) -> Tuple do
  n = sc.n
  question = contains(text, "?") or (words != [] and aim_has(AIM_SC_ASKING, head(words)))
  case words do
    [] -> {sc, [AIM_SC_DONT_GET]}
    _ ->
      case question do
        true -> {sc, [aim_sc_nth(AIM_SC_QUESTION, n)]}
        false ->
          rest = aim_sc_after_i_am(words)
          case rest != [] and length(rest) <= 4 do
            true ->
              x = join(rest, " ")
              {sc, [concat("You're ", x, ", I'm ", x, ", we're all ", x, ".")]}
            false ->
              case length(words) <= 2 do
                true -> {sc, [concat("\"", utf8_slice(trim(text), 0, 40), "\"? That's a very weird thing to type.")]}
                false ->
                  case rem(n, 3) == 2 do
                    true -> {sc, [aim_sc_nth(AIM_SC_MOVING_ON, n / 3)]}
                    false -> {sc, [aim_sc_pick(AIM_SC_MUSE, n, name)]}
                  end
              end
          end
      end
  end
end

# "i'm so bored" -> ["so", "bored"]; [] if it does not start that way
def aim_sc_after_i_am(words: List) -> List do
  case words do
    ["i'm" | rest] -> rest
    ["im" | rest] -> rest
    ["i", "am" | rest] -> rest
    _ -> []
  end
end

# Lines to say, a second or two apart from `t` (after whatever is still
# waiting to be said), as SmarterChild's pending list.
def aim_sc_queue(pending: List, lines: List, t: Int, gap: Int) -> List do
  start = case pending do
    [] -> t
    _ -> elem_at(reverse(pending), 0).at
  end
  list_append(pending, map(range(1, length(lines)), fn(i: Int) -> Map do %{at: start + i * gap, text: elem_at(lines, i - 1)} end))
end

def aim_sc_frame(sc: Map) -> String do
  json_encode(%{t: "chat", with: "sc", loading: sc.pending != [], messages: sc.history})
end

def aim_secret(raw: String) -> Bool do
  downcase(trim(raw)) == AIM_SECRET_NAME
end

actor AimChat do
  state key: String :: ""
  state base: String :: "https://api.deepseek.com"
  state model: String :: "deepseek-flash"
  state daily_limit: Int :: 600
  state rows: List :: []
  state chunks: List :: []
  # socket (as a string) -> aim_new_person's map
  # job: nil | %{h, round, messages, at}
  state people: Map :: %{}
  # aim_pair -> [%{from, content}..], the last AIM_DM_KEEP lines
  state dms: Map :: %{}
  state dms_sent: Int :: 0
  # the Party Line's last lines, [aim_party_line..]
  state party: List :: []
  # the Bulletin Board, newest first, [%{id, name, text, at}..]; saved in
  # aim_bulletins when board_db, otherwise numbered from board_next
  state board: List :: []
  state board_db: Bool :: false
  state board_next: Int :: 1
  # SmarterChild's hellos so far, which picks the next one's opening
  state hellos: Int :: 0
  state abandoned: List :: []
  # the day (days since the epoch) the requests below are counted for
  state day: Int :: 0
  state today_requests: Int :: 0
  state asked: Int :: 0
  state requests: Int :: 0
  state failures: Int :: 0
  state cache_hit: Int :: 0
  state cache_miss: Int :: 0
  state last_error: String :: ""

  on :load(text: Any) do
    case type_of(text) == :string do
      false ->
        become rows: [], chunks: []
        reply 0
      true ->
        c = aim_chunks(text)
        r = flat(map(c, fn(x: Map) -> List do x.rows end))
        become rows: r, chunks: c
        reply length(r)
    end
  end

  on :config(k: String, b: String, m: String, limit: Int) do
    become key: k, base: b, model: m, daily_limit: limit
    reply %{keyed: k != "", posts: length(rows)}
  end

  on :join(fd: Int) do
    become people: put(people, to_string(fd), aim_new_person(fd))
    self <- :tell(fd, json_encode(%{t: "hello", online: key != "" and rows != [], posts: length(rows), bot: aim_bot_name}))
    reply :ok
  end

  on :leave(fd: Int) do
    p = lookup(people, to_string(fd))
    gone = case p == nil do
      true -> []
      false ->
        case p.job do
          nil -> []
          j -> [j.h]
        end
    end
    was = case p == nil do
      true -> false
      false -> p.signed
    end
    become people: zg_without(people, to_string(fd)), abandoned: list_append(abandoned, gone), dms: aim_forget(dms, fd)
    case was do
      true ->
        self <- :party_note(concat(p.name, " has left the room."))
        self <- :roster
      false -> :ok
    end
    reply :ok
  end

  # A line from the room itself: someone came or went.
  on :party_note(text: String) do
    become party: aim_last_n(list_append(party, [aim_party_line(0, "", text, true)]), AIM_PARTY_KEEP)
    reply :ok
  end

  # Every signed-on page's Party Line and Buddy List, again.
  on :roster do
    each(aim_signed(people), fn(p: Map) do
      self <- :tell(p.fd, aim_party_frame(people, party, p.fd))
      self <- :tell(p.fd, aim_roster_frame(people, p))
    end)
    reply :ok
  end

  # The Party Line, again, to everyone in it.
  on :party_all do
    each(aim_signed(people), fn(p: Map) do self <- :tell(p.fd, aim_party_frame(people, party, p.fd)) end)
    reply :ok
  end

  # A line in the Party Line.
  on :party_say(fd: Int, text: String) do
    k = to_string(fd)
    p = lookup(people, k)
    case p == nil or text == "" do
      true -> reply :ignored
      false ->
        case p.signed and p.dms_sent < AIM_DM_LIMIT do
          false -> reply :ignored
          true ->
            line = aim_party_line(fd, p.name, utf8_slice(text, 0, AIM_PARTY_MAX_CHARS), false)
            become people: put(people, k, put(p, :dms_sent, p.dms_sent + 1)), party: aim_last_n(list_append(party, [line]), AIM_PARTY_KEEP)
            self <- :party_all
            reply :said
        end
    end
  end

  # The board from aim_bulletins (made if it is missing), or kept in memory
  # without a database. Replies how many notes, or {:error, reason}.
  on :board_load(use_db: Bool) do
    case use_db do
      false ->
        become board_db: false
        reply length(board)
      true ->
        made = DB <- :query(AIM_BOARD_CREATE_SQL, [])
        case made do
          {:error, why} -> reply {:error, why}
          _ ->
            case DB <- :query(AIM_BOARD_LIST_SQL, []) do
              {:ok, rows} ->
                become board_db: true, board: map(rows, fn(r: Map) -> Map do aim_board_row(r) end)
                reply length(rows)
              {:error, why} -> reply {:error, why}
            end
        end
    end
  end

  # A note on the board, from a page signed on, if it has not posted too
  # much or too lately.
  on :post(fd: Int, text: String, t: Int) do
    k = to_string(fd)
    p = lookup(people, k)
    case p == nil or text == "" do
      true -> reply :ignored
      false ->
        why = case p.signed do
          false -> "Sign on to post."
          true ->
            case p.board_posts >= AIM_BOARD_LIMIT do
              true -> concat("That's ", to_string(AIM_BOARD_LIMIT), " notes from you. Sign off and come back another day.")
              false ->
                case p.board_posts > 0 and t - p.posted_at < AIM_BOARD_GAP_S do
                  true -> concat("One note every ", to_string(AIM_BOARD_GAP_S), " seconds, please.")
                  false -> ""
                end
            end
        end
        case why do
          "" ->
            body = utf8_slice(text, 0, AIM_BOARD_MAX_CHARS)
            saved = case board_db do
              false -> {:ok, [%{id: board_next, at: t}]}
              true -> DB <- :query(AIM_BOARD_INSERT_SQL, [p.name, body])
            end
            case saved do
              {:ok, [row | _]} ->
                note = %{id: row.id, name: p.name, text: body, at: row.at}
                become people: put(people, k, put(put(p, :board_posts, p.board_posts + 1), :posted_at, t)),
                  board: zg_take([note | board], AIM_BOARD_KEEP), board_next: board_next + 1
                each(aim_signed(people), fn(o: Map) do self <- :tell(o.fd, aim_board_frame((self <- :board), "")) end)
                reply :posted
              _ ->
                self <- :tell(fd, aim_board_frame(board, "The board couldn't save that. Try again in a minute."))
                reply :failed
            end
          _ ->
            self <- :tell(fd, aim_board_frame(board, why))
            reply :refused
        end
    end
  end

  on :board do
    reply board
  end

  # Bobby, at the prompt: a note taken down.
  on :unpost(id: Int) do
    case board_db do
      true -> DB <- :query(AIM_BOARD_DELETE_SQL, [id])
      false -> :ok
    end
    become board: filter(board, fn(n: Map) -> Bool do n.id != id end)
    each(aim_signed(people), fn(o: Map) do self <- :tell(o.fd, aim_board_frame((self <- :board), "")) end)
    reply :ok
  end

  # Signing on: a name nobody else has, onto everyone's Buddy List, and the
  # cats if it is the name.
  on :sign_on(fd: Int, raw: String, t: Int) do
    k = to_string(fd)
    p = lookup(people, k)
    case p == nil do
      true -> reply :unknown
      false ->
        name = aim_unique_name(people, fd, aim_screen_name(raw))
        become people: put(people, k, put(put(put(p, :name, name), :signed, true), :signed_at, t))
        self <- :tell(fd, aim_board_frame(board, ""))
        self <- :party_note(concat(name, " has entered the room."))
        self <- :roster
        case aim_secret(raw) do
          true -> self <- :tell(fd, json_encode(%{t: "secret", src: AIM_CATS_SRC}))
          false -> :ok
        end
        reply :signed_on
    end
  end

  # Signing off: off everyone's list, and every conversation forgotten.
  on :sign_off(fd: Int) do
    k = to_string(fd)
    p = lookup(people, k)
    case p == nil do
      true -> reply :unknown
      false ->
        gone = case p.job do
          nil -> []
          j -> [j.h]
        end
        become people: put(people, k, put(aim_new_person(fd), :last, p.last)), dms: aim_forget(dms, fd), abandoned: list_append(abandoned, gone)
        case p.signed do
          true -> self <- :party_note(concat(p.name, " has left the room."))
          false -> :ok
        end
        self <- :roster
        reply :signed_off
    end
  end

  # A message to a person or to SmarterChild.
  on :im(fd: Int, to: String, text: String, t: Int) do
    k = to_string(fd)
    p = lookup(people, k)
    case p == nil or text == "" do
      true -> reply :ignored
      false ->
        case p.signed and p.dms_sent < AIM_DM_LIMIT do
          false -> reply :ignored
          true ->
            body = utf8_slice(text, 0, AIM_DM_MAX_CHARS)
            become people: put(people, k, put(p, :dms_sent, p.dms_sent + 1))
            case to == "sc" do
              true -> reply (self <- :sc_hear(fd, body, t))
              false ->
                other = aim_peer(people, to)
                case other == nil or to == aim_peer_id(fd) do
                  true -> reply :nobody
                  false ->
                    key = aim_pair(fd, other.fd)
                    before = case lookup(dms, key) do
                      nil -> []
                      l -> l
                    end
                    log = aim_last_n(list_append(before, [%{from: fd, content: body}]), AIM_DM_KEEP)
                    become dms: put(dms, key, log), dms_sent: dms_sent + 1
                    self <- :tell(fd, aim_dm_frame(fd, other.fd, log))
                    self <- :tell(other.fd, aim_dm_frame(other.fd, fd, log))
                    reply :sent
                end
            end
        end
    end
  end

  # SmarterChild hears a message, and will answer it in a second or two.
  # It is always on the Buddy List; someone not alone can IM it first.
  on :sc_hear(fd: Int, text: String, t: Int) do
    k = to_string(fd)
    p = lookup(people, k)
    case p == nil do
      true -> reply :gone
      false ->
        signed = aim_signed(people)
        ctx = %{name: p.name, t: t, others: length(signed) - 1,
          chatting: length(filter(signed, fn(o: Map) -> Bool do o.sc.active or o.fd == fd end))}
        r = aim_sc_reply(put(p.sc, :active, true), text, ctx)
        sc = elem(r, 0)
        next = put(put(sc, :history, list_append(sc.history, [aim_entry("user", text)])), :pending, aim_sc_queue(sc.pending, elem(r, 1), t, 1))
        become people: put(people, k, put(p, :sc, next))
        self <- :tell(fd, aim_sc_frame(next))
        reply :heard
    end
  end

  # SmarterChild says hello, the riddles first: to someone alone, or to a
  # page that asked for it.
  on :sc_start(fd: Int, t: Int, alone: Bool) do
    k = to_string(fd)
    p = lookup(people, k)
    case p == nil or p.sc.active do
      true -> reply :ok
      false ->
        sc = put(put(put(aim_sc_fresh(), :active, true), :riddling, true), :pending, aim_sc_queue([], aim_sc_intro(p.name, alone, hellos, format_time(t, "%Y")), t, 2))
        become people: put(people, k, put(p, :sc, sc)), hellos: hellos + 1
        reply :started
    end
  end

  # SmarterChild's lines that are due, said.
  on :sc_say(fd: Int, t: Int) do
    k = to_string(fd)
    p = lookup(people, k)
    case p == nil do
      true -> reply :gone
      false ->
        due = filter(p.sc.pending, fn(l: Map) -> Bool do l.at <= t end)
        case due do
          [] -> reply :waiting
          _ ->
            said = map(due, fn(l: Map) -> Map do aim_entry("them", l.text) end)
            sc = put(put(p.sc, :history, list_append(p.sc.history, said)), :pending, filter(p.sc.pending, fn(l: Map) -> Bool do l.at > t end))
            become people: put(people, k, put(p, :sc, sc))
            self <- :tell(fd, aim_sc_frame(sc))
            reply length(due)
        end
    end
  end

  # Send a person a frame, and remember it (a test reads it back).
  on :tell(fd: Int, frame: String) do
    zg_send(fd, frame)
    k = to_string(fd)
    p = lookup(people, k)
    case p == nil do
      true -> reply :gone
      false ->
        become people: put(people, k, put(p, :last, frame))
        reply :ok
    end
  end

  on :recv(fd: Int, text: String) do
    k = to_string(fd)
    p = lookup(people, k)
    msg = zg_decode_map(text)
    case p == nil do
      true -> reply :unknown
      false ->
        case lookup(msg, :t) do
          "signon" -> reply (self <- :sign_on(fd, zg_str(lookup(msg, :name)), now()))
          "signoff" -> reply (self <- :sign_off(fd))
          "ask" -> reply (self <- :ask(fd, trim(zg_str(lookup(msg, :text))), now()))
          "im" -> reply (self <- :im(fd, zg_str(lookup(msg, :to)), trim(zg_str(lookup(msg, :text))), now()))
          "party" -> reply (self <- :party_say(fd, trim(zg_str(lookup(msg, :text)))))
          "post" -> reply (self <- :post(fd, trim(zg_str(lookup(msg, :text))), now()))
          # /aim?msg=SmarterChild: it says hello at once, alone or not
          "open" ->
            case p.signed and zg_str(lookup(msg, :with)) == "sc" do
              true -> reply (self <- :sc_start(fd, now(), length(aim_signed(people)) == 1))
              false -> reply :ignored
            end
          _ -> reply :ignored
        end
    end
  end

  # A message: nothing while empty or waiting; the limits' replies once a
  # page or the day has had its share; otherwise it joins the conversation
  # and goes to the model.
  on :ask(fd: Int, text: String, t: Int) do
    k = to_string(fd)
    p = lookup(people, k)
    case p == nil or text == "" or p.loading do
      true -> reply :ignored
      false ->
        history = list_append(p.history, [aim_entry("user", text)])
        full = today_requests >= daily_limit and t / 86400 == day
        case p.count >= aim_max_questions or full do
          true ->
            said = case full do
              true -> aim_daily_reply
              false -> aim_limit_reply(aim_max_questions)
            end
            q = put(p, :history, list_append(history, [aim_entry("assistant", said)]))
            become people: put(people, k, q)
            self <- :tell(fd, aim_chat_frame(q))
            reply :limit
          false ->
            q = put(put(put(put(p, :history, history), :count, p.count + 1), :loading, true), :job, nil)
            become people: put(people, k, q), asked: asked + 1
            self <- :tell(fd, aim_chat_frame(q))
            reply (self <- :request(fd, aim_rest(p.name, format_time(t, "%Y-%m-%d"), history), 0, t))
        end
    end
  end

  # One request to the model for a person's message, round `round`.
  on :request(fd: Int, rest: List, round: Int, t: Int) do
    case key == "" or rows == [] do
      true ->
        why = case key do
          "" -> "AIM_API_KEY is not set"
          _ -> "the archive is not loaded"
        end
        reply (self <- :finish(fd, {:error, why}))
      false ->
        d = t / 86400
        count = case d == day do
          true -> today_requests
          false -> 0
        end
        h = http_start("POST", concat(base, "/chat/completions"), zg_headers(key), aim_body(model, rest), %{timeout_ms: AIM_ASK_TIMEOUT_S * 1000})
        case h < 0 do
          true -> reply (self <- :finish(fd, {:error, "every HTTP slot is busy"}))
          false ->
            k = to_string(fd)
            p = lookup(people, k)
            case p == nil do
              true ->
                become abandoned: [h | abandoned], day: d, today_requests: count + 1
                reply :gone
              false ->
                become people: put(people, k, put(p, :job, %{h: h, round: round, rest: rest, at: t})),
                  requests: requests + 1, day: d, today_requests: count + 1
                reply :asking
            end
        end
    end
  end

  # An answer to a person's request (http_result's value; a test passes a
  # recorded one): the reply, or a search and the next round, or an error.
  on :answered(fd: Int, result: Any, t: Int) do
    k = to_string(fd)
    p = lookup(people, k)
    case p == nil or p.job == nil do
      true -> reply :gone
      false ->
        job = p.job
        u = case result do
          {:ok, 200, body} -> aim_usage(body)
          _ -> {0, 0}
        end
        become people: put(people, k, put(p, :job, nil)), cache_hit: cache_hit + elem(u, 0), cache_miss: cache_miss + elem(u, 1)
        what = aim_classify(result)
        case elem(what, 0) do
          :tools ->
            msg = elem(what, 1)
            results = map(zg_list(lookup(msg, :tool_calls)), fn(c: Any) -> Map do aim_run_tool(chunks, c) end)
            next = job.round + 1
            case next >= AIM_MAX_TOOL_ROUNDS do
              true -> reply (self <- :finish(fd, {:error, "too many searches for one message"}))
              false -> reply (self <- :request(fd, list_append(job.rest, [msg | results]), next, t))
            end
          _ -> reply (self <- :finish(fd, what))
        end
    end
  end

  on :finish(fd: Int, what: Tuple) do
    k = to_string(fd)
    p = lookup(people, k)
    case p == nil do
      true -> reply :gone
      false ->
        failed = elem(what, 0) == :error
        text = case failed do
          true -> aim_offline_reply(elem(what, 1))
          false -> elem(what, 1)
        end
        q = put(put(put(p, :history, list_append(p.history, [aim_entry("assistant", text)])), :loading, false), :job, nil)
        case failed do
          true -> become people: put(people, k, q), failures: failures + 1, last_error: elem(what, 1)
          false -> become people: put(people, k, q)
        end
        self <- :tell(fd, aim_chat_frame(q))
        reply elem(what, 0)
    end
  end

  on :step do
    reply (self <- :step_at(now()))
  end

  # From the Site's tick: every answer that has come, and every request
  # that has waited too long.
  on :step_at(t: Int) do
    become abandoned: filter(abandoned, fn(h: Int) -> Bool do http_result(h) == nil end)
    # SmarterChild: hello to whoever has been alone long enough, and the
    # lines that are due
    signed = aim_signed(people)
    case length(signed) == 1 do
      true ->
        lone = head(signed)
        case not(lone.sc.active) and t - lone.signed_at >= AIM_SC_WAIT_S do
          true -> self <- :sc_start(lone.fd, t, true)
          false -> :ok
        end
      false -> :ok
    end
    each(filter(values(people), fn(p: Map) -> Bool do p.sc.pending != [] end), fn(p: Map) do self <- :sc_say(p.fd, t) end)
    asking = filter(values(people), fn(p: Map) -> Bool do p.job != nil end)
    each(asking, fn(p: Map) do
      r = http_result(p.job.h)
      case r do
        nil ->
          case t - p.job.at > AIM_ASK_TIMEOUT_S do
            true ->
              self <- :drop_handle(p.job.h)
              self <- :answered(p.fd, {:error, "timeout"}, t)
            false -> :waiting
          end
        _ -> self <- :answered(p.fd, r, t)
      end
    end)
    reply length(asking)
  end

  on :drop_handle(h: Int) do
    become abandoned: [h | abandoned]
    reply :ok
  end

  # For a test, or the prompt: what a search would hand the model.
  on :search(query: String, source: String) do
    reply aim_search(chunks, query, source)
  end

  on :body(name: String, history: List) do
    reply aim_body(model, aim_rest(name, "2026-01-01", history))
  end

  on :person(fd: Int) do
    reply lookup(people, to_string(fd))
  end

  on :stats do
    reply %{fds: map(values(people), fn(p: Map) -> Int do p.fd end), pages: length(keys(people)), signed_on: length(aim_signed(people)), conversations: length(keys(dms)), dms: dms_sent, party_lines: length(party), board: length(board), board_db: board_db, keyed: key != "", model: model, posts: length(rows),
      chunks: length(chunks), asked: asked, requests: requests, today: today_requests, daily_limit: daily_limit,
      failures: failures, last_error: last_error, cache_hit_tokens: cache_hit, cache_miss_tokens: cache_miss}
  end
end

# Every conversation `fd` was in, gone.
def aim_forget(dms: Map, fd: Int) -> Map do
  me = to_string(fd)
  reduce(keys(dms), %{}, fn(acc: Map, k: Any) -> Map do
    sides = split(k, ":")
    case head(sides) == me or head(tail(sides)) == me do
      true -> acc
      false -> put(acc, k, lookup(dms, k))
    end
  end)
end

AIM = spawn AimChat

# ── the page ────────────────────────────────────────────────────────────

# The page's own files carry a hash of their contents (?v=), because
# Cloudflare and browsers keep them for hours: without it, a deploy left
# people with the new page and last version's program, script and styles
# (blog #184: no dial-up styles, no dragging, until the cache ran out).
AIM_PROGRAM_PATH = desk_script_href("/aim/aim.blimp", "_build/aim.blimp")
AIM_SCRIPTS = list_append(APP_SCRIPTS, [desk_script_href("/aim/aim.js", "static/aim/aim.js")])
AIM_CSS_HREF = desk_script_href("/aim/aim.css", "static/aim/aim.css")

def aim_page() -> String do
  body = join([
    "<div id=\"blimp-app\" data-program=\"", AIM_PROGRAM_PATH, "\" data-actor=\"aim\"></div>\n",
    "<p id=\"blimp-app-status\" class=\"blimp-app-status\">loading Blimp...</p>\n",
    "<noscript><p>This page is a program written in Blimp, which your browser runs in Blimp's WebAssembly interpreter; ",
    "it needs JavaScript. The program is <a href=\"", AIM_PROGRAM_PATH, "\">", AIM_PROGRAM_PATH, "</a>.</p></noscript>\n",
    script_tags(AIM_SCRIPTS)
  ], "")
  page_layout_full(AIM_TITLE, AIM_DESCRIPTION, "website", ["/assets/blimp-window.css", AIM_CSS_HREF], body, "aim-html", AIM_CARD)
end

# The page's own link preview. priv/static/images/og-aim.png is drawn from
# og-aim.svg next to it (rsvg-convert); ?v= because unfurlers cache it.
AIM_TITLE = "AOL Instant Messenger"
AIM_DESCRIPTION = "AOL Instant Messenger (AIM) is a chat service. Since AOL went away and become but a brand, Bobbby co-opted their IP and has started his own services company. Please relive your times on AIM now, your friends can join too anytime. Dont forget to say hi to SmarterChild"
AIM_CARD = %{
  url: "https://bobbby.online/images/og-aim.png?v=1",
  alt: "An old AOL-style triangle over \"Bobbby Online\", the yellow AIM running man, and a Windows 98 Buddy List with SmarterChild and bobbbyBot signed on"
}

AIM_PAGE = response(200, "text/html; charset=utf-8", "public, max-age=300", aim_page())
AIM_PROGRAM = map_asset(["_build/aim.blimp"], "text/plain; charset=utf-8")
AIM_JS = map_asset(["static/aim/aim.js"], "text/javascript; charset=utf-8")
AIM_CSS = map_asset(["static/aim/aim.css"], "text/css; charset=utf-8")
# Bobby's cats, at the end of SmarterChild's riddles (AIM_CATS_SRC). Not
# linked from anywhere; the server hands the address to a page that signs
# on with AIM_SECRET_NAME.
AIM_CATS = map_asset(["static/aim/cats.jpg"], "image/jpeg")
# AIM's own sounds, the WAVs AIM 7.5.6.2 installed (archive.org/details/
# aim7sfx): the door opening and slamming as buddies come and go, and the
# message sounds. aim.js plays them; the dial-up modem it makes itself.
AIM_SOUND_DOOROPEN = map_asset(["static/aim/sounds/dooropen.wav"], "audio/wav")
AIM_SOUND_DOORSLAM = map_asset(["static/aim/sounds/doorslam.wav"], "audio/wav")
AIM_SOUND_IMRCV = map_asset(["static/aim/sounds/imrcv.wav"], "audio/wav")
AIM_SOUND_IMSEND = map_asset(["static/aim/sounds/imsend.wav"], "audio/wav")
