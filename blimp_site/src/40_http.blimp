# HTTP/1.1, as much of it as a blog behind Caddy needs.
#
# One request per connection: every response says Connection: close and the
# worker closes the socket after writing it. Caddy keeps the connection to
# the browser alive; this side does not have to.

# "GET /post/chess?x=1 HTTP/1.1\r\nHost: ..." -> %{method, path, query}
def parse_request(raw: String) -> Map do
  line = head(split(raw, "\r\n"))
  parts = split(line, " ")
  case length(parts) >= 3 do
    false -> %{method: "", path: "", query: ""}
    true ->
      target = elem_at(parts, 1)
      q = index_of(target, "?")
      case q >= 0 do
        true -> %{method: head(parts), path: take(target, q), query: drop(target, q + 1)}
        false -> %{method: head(parts), path: target, query: ""}
      end
  end
end

def hex_value(c: String) -> Int do
  code = char_code(c)
  case code >= 48 and code <= 57 do
    true -> code - 48
    false ->
      case code >= 97 and code <= 102 do
        true -> code - 87
        false ->
          case code >= 65 and code <= 70 do
            true -> code - 55
            false -> -1
          end
      end
  end
end

# %XX and + in a query value. A malformed escape is kept as written.
def url_decode_from(s: String, i: Int, acc: List) -> String do
  case i >= length(s) do
    true -> join(reverse(acc), "")
    false ->
      c = char_at(s, i)
      case c do
        "+" -> url_decode_from(s, i + 1, [" " | acc])
        "%" ->
          hi = case i + 2 < length(s) do
            true -> hex_value(char_at(s, i + 1))
            false -> -1
          end
          lo = case i + 2 < length(s) do
            true -> hex_value(char_at(s, i + 2))
            false -> -1
          end
          case hi >= 0 and lo >= 0 do
            true -> url_decode_from(s, i + 3, [from_char_code(hi * 16 + lo) | acc])
            false -> url_decode_from(s, i + 1, ["%" | acc])
          end
        _ -> url_decode_from(s, i + 1, [c | acc])
      end
  end
end

def url_decode(s: String) -> String do
  url_decode_from(s, 0, [])
end

# The value of `key` in "a=1&b=2", decoded, or "" when it is absent.
#
# A loop rather than filter(..., fn ...): each lambda this interpreter
# creates copies every binding in scope, top-level definitions included,
# which in the full site is about 18KB a call. This runs on every request.
def query_param(query: String, key: String) -> String do
  query_param_in(split(query, "&"), concat(key, "="))
end

def query_param_in(pairs: List, prefix: String) -> String do
  case pairs do
    [] -> ""
    [p | rest] ->
      case starts_with(p, prefix) do
        true -> url_decode(drop(p, length(prefix)))
        false -> query_param_in(rest, prefix)
      end
  end
end

def status_text(status: Int) -> String do
  case status do
    200 -> "OK"
    201 -> "Created"
    204 -> "No Content"
    301 -> "Moved Permanently"
    302 -> "Found"
    303 -> "See Other"
    304 -> "Not Modified"
    400 -> "Bad Request"
    401 -> "Unauthorized"
    403 -> "Forbidden"
    404 -> "Not Found"
    405 -> "Method Not Allowed"
    406 -> "Not Acceptable"
    408 -> "Request Timeout"
    411 -> "Length Required"
    413 -> "Content Too Large"
    415 -> "Unsupported Media Type"
    421 -> "Misdirected Request"
    422 -> "Unprocessable Content"
    429 -> "Too Many Requests"
    431 -> "Request Header Fields Too Large"
    502 -> "Bad Gateway"
    503 -> "Service Unavailable"
    _ -> "Internal Server Error"
  end
end

def response(status: Int, content_type: String, cache: String, body: String) -> Map do
  %{status: status, content_type: content_type, cache: cache, body: body, location: ""}
end

def html_response(status: Int, body: String) -> Map do
  response(status, "text/html; charset=utf-8", "no-cache", body)
end

def redirect(location: String) -> Map do
  %{status: 301, content_type: "text/plain", cache: "public, max-age=3600", body: "", location: location}
end

# The bytes that go on the wire. A HEAD gets the headers a GET would, with
# the GET's Content-Length, and no body.
def serialize(resp: Map, method: String) -> String do
  location = case length(resp.location) > 0 do
    true -> concat("Location: ", resp.location, "\r\n")
    false -> ""
  end
  body = case method == "HEAD" do
    true -> ""
    false -> resp.body
  end
  # any more headers a response carries, as [[name, value], ...]
  extra = case lookup(resp, :headers) do
    nil -> ""
    hs -> join(map(hs, fn(h: List) -> String do concat(head(h), ": ", head(tail(h)), "\r\n") end), "")
  end
  # a response built once at boot carries its validator (prebuilt, below)
  etag = case lookup(resp, :etag) do
    nil -> ""
    tag -> concat("ETag: ", tag, "\r\n")
  end
  join([
    "HTTP/1.1 ", to_string(resp.status), " ", status_text(resp.status), "\r\n",
    "Content-Type: ", resp.content_type, "\r\n",
    "Content-Length: ", to_string(length(resp.body)), "\r\n",
    "Cache-Control: ", resp.cache, "\r\n",
    location,
    etag,
    extra,
    "X-Served-By: blimp\r\n",
    "Connection: close\r\n\r\n",
    body
  ], "")
end

def content_type_for(path: String) -> String do
  ext = last(split(path, "."))
  case downcase(ext) do
    "css" -> "text/css; charset=utf-8"
    "ico" -> "image/x-icon"
    "png" -> "image/png"
    "jpg" -> "image/jpeg"
    "jpeg" -> "image/jpeg"
    "gif" -> "image/gif"
    "svg" -> "image/svg+xml"
    "webp" -> "image/webp"
    "txt" -> "text/plain; charset=utf-8"
    "html" -> "text/html; charset=utf-8"
    "json" -> "application/json"
    "js" -> "text/javascript; charset=utf-8"
    "wasm" -> "application/wasm"
    "json" -> "application/json"
    "blimp" -> "text/plain; charset=utf-8"
    "md" -> "text/markdown; charset=utf-8"
    "woff2" -> "font/woff2"
    _ -> "application/octet-stream"
  end
end

# A static path is served only if every segment is plain: no "..", no empty
# segment, nothing starting with a dot.
def safe_static_path(path: String) -> Bool do
  segments = drop_list(split(path, "/"), 1)
  length(segments) > 0 and plain_segments(segments)
end

def plain_segments(segments: List) -> Bool do
  case segments do
    [] -> true
    [s | rest] -> length(s) > 0 and not(starts_with(s, ".")) and plain_segments(rest)
  end
end

# ── The edge cache ──────────────────────────────────────────────────────
#
# Cloudflare sits in front of the site, and it held nothing: every page said
# no-cache or max-age=300, no response had an ETag, and a revalidation was a
# full download. Answering takes this process under a millisecond; the trip
# through Cloudflare to the box added 20-100 ms. So a response that is the
# same for everyone says how long it stays the same, by kind:
#
#   CACHE_IMMUTABLE    a URL that names its content (?v=<the first 10 hex of
#                      its sha256>, what asset_href and desk_script_href
#                      write): it can never change, so a year.
#   CACHE_FILES_HTML   a page that is a function of the deploy's files (a
#                      post, /blog, a tag, a snapshot page, the journal): a
#                      browser asks again after a minute, Cloudflare keeps it
#                      a day, and deploy.sh purges Cloudflare after a ship.
#   CACHE_FILES        the same for everything else built at boot (a
#                      stylesheet or script asked for without ?v=, a program
#                      fetched with the runtime's build as its ?v=, which
#                      names the runtime, not the program): five minutes in
#                      a browser, as before, a day at the edge.
#   CACHE_HOME         the bare homepage: one page for everyone, but /curate
#                      and the museum refresh can change it at any minute, so
#                      the edge asks again every minute too. It asks with
#                      If-None-Match, so asking is a 304 while it has not.
#
# Pages that differ per visitor or per request keep no-cache.
CACHE_IMMUTABLE = "public, max-age=31536000, immutable"
CACHE_FILES_HTML = "public, max-age=60, s-maxage=86400"
CACHE_FILES = "public, max-age=300, s-maxage=86400"
CACHE_HOME = "public, max-age=60, s-maxage=60, stale-while-revalidate=300"

def edge_cache_for(content_type: String) -> String do
  case starts_with(content_type, "text/html") do
    true -> CACHE_FILES_HTML
    false -> CACHE_FILES
  end
end

# The validator and the version of a body, from one sha256: the ETag is its
# first 16 hex in quotes, the version the first 10 (what ?v= carries).
def edge_sums(body: String) -> Map do
  sha = sha256(body)
  %{etag: concat("\"", take(sha, 16), "\""), ver: take(sha, 10)}
end

# A prebuilt wire (serialize's bytes, built at boot) as an entry the edge
# cache serves: the same bytes with an ETag and the Cache-Control `cache`,
# plus where that Cache-Control line sits, so a request that names the
# content (?v=) can be given CACHE_IMMUTABLE instead without parsing.
# %{wire, etag, ver, cut, cut_end}; a wire that is not a 200 is kept as it
# is, with no ETag.
def edge_entry(wire: String, cache: String) -> Map do
  hend = index_of(wire, "\r\n\r\n")
  head_text = take(wire, hend)
  case starts_with(head_text, "HTTP/1.1 200 ") do
    false -> %{wire: wire, etag: "", ver: "", cut: -1, cut_end: -1}
    true ->
      body = drop(wire, hend + 4)
      sums = edge_sums(body)
      lines = map(split(head_text, "\r\n"), fn(l: String) -> String do
        case starts_with(l, "Cache-Control: ") do
          true -> concat("Cache-Control: ", cache, "\r\nETag: ", sums.etag)
          false -> l
        end
      end)
      out = concat(join(lines, "\r\n"), "\r\n\r\n", body)
      cut = index_of(out, "\r\nCache-Control: ") + 2
      cut_end = index_of_from(out, "\r\n", cut) + 2
      %{wire: out, etag: sums.etag, ver: sums.ver, cut: cut, cut_end: cut_end}
  end
end

# The route's Cache-Control for a prebuilt wire: by its Content-Type.
def edge_route(wire: String) -> Map do
  html = contains(take(wire, index_of(wire, "\r\n\r\n")), "\r\nContent-Type: text/html")
  case html do
    true -> edge_entry(wire, CACHE_FILES_HTML)
    false -> edge_entry(wire, CACHE_FILES)
  end
end

# Every fixed route, path -> wire, as path -> entry.
def edge_routes(routes: Map) -> Map do
  reduce(keys(routes), %{}, fn(acc: Map, path: String) -> Map do
    put(acc, path, edge_route(lookup(routes, path)))
  end)
end

# The entry's bytes for this query: CACHE_IMMUTABLE when ?v= is its own
# version, else as built. A ?v= that is some other version (a page from
# before the deploy, or a program fetched by the runtime's build) is not a
# promise about these bytes, so it gets the ordinary answer.
def edge_versioned(query: String, ver: String) -> Bool do
  length(ver) > 0 and length(query) > 0 and query_param(query, "v") == ver
end

def edge_wire(entry: Map, query: String) -> String do
  case edge_versioned(query, entry.ver) and entry.cut > 0 do
    false -> entry.wire
    true -> concat(take(entry.wire, entry.cut), "Cache-Control: ", CACHE_IMMUTABLE, "\r\n", drop(entry.wire, entry.cut_end))
  end
end

# If-None-Match against an ETag: "*", or any tag in the list, compared
# weakly (Cloudflare turns a strong ETag weak when it compresses). Caddy's
# encode sends the browser "<tag>-gzip" and takes the suffix off again on
# the way in, so the tag reaching here is this one (checked with caddy:2,
# v2.11.7, in front of this server).
def etag_matches(header: String, etag: String) -> Bool do
  length(etag) > 0 and length(header) > 0 and (trim(header) == "*" or etag_in(split(header, ","), etag))
end

def etag_in(tags: List, etag: String) -> Bool do
  case tags do
    [] -> false
    [t | rest] ->
      bare = trim(t)
      plain = case starts_with(bare, "W/") do
        true -> drop(bare, 2)
        false -> bare
      end
      plain == etag or etag_in(rest, etag)
  end
end

# 304: the validator and the freshness the 200 would have had, and no body
# (RFC 9110 15.4.5).
def not_modified(etag: String, cache: String) -> String do
  join([
    "HTTP/1.1 304 Not Modified\r\n",
    "Cache-Control: ", cache, "\r\n",
    "ETag: ", etag, "\r\n",
    "X-Served-By: blimp\r\n",
    "Connection: close\r\n\r\n"
  ], "")
end

# The Cache-Control a wire was built with.
def wire_cache(wire: String, cut: Int, cut_end: Int) -> String do
  slice(wire, cut + 15, cut_end - cut - 17)
end

# A response Map built once at boot (a page or file a src/ module holds as a
# constant and dynamic() returns): with its ETag and version, and the
# edge's Cache-Control for its kind unless it said no-cache or no-store.
def prebuilt(resp: Map) -> Map do
  sums = edge_sums(resp.body)
  cache = case starts_with(resp.cache, "public") do
    true -> edge_cache_for(resp.content_type)
    false -> resp.cache
  end
  merge(resp, %{etag: sums.etag, ver: sums.ver, cache: cache})
end
