# phangraphs (/phish): Phish 3.0 jam analytics, from the phish_tracks
# table. This file is the song list's sorting and filtering from
# PhishLive, as Blimp; the page's program (static/phish/phish.blimp) is
# built on it. Blog.Phish, the queries, is src/97_phish_api.blimp, which
# only the server loads.

# PhishLive.assign_sorted_songs/1: played at least `min` times (or the
# selected song), name containing `filter` (or the selected song), sorted
# as its sort_by tuples sort. sort_by_keys is stable, as Enum.sort_by is.
def phish_sorted(songs: List, sort_by: String, min: Int, filter: String, selected: String) -> List do
  needle = downcase(filter)
  kept = filter(songs, fn(s: Map) -> Bool do
    (s.times_played >= min or s.song_name == selected) and (needle == "" or contains(downcase(s.song_name), needle) or s.song_name == selected)
  end)
  keys = map(kept, fn(s: Map) -> Int do phish_sort_key(sort_by, s.jamchart_count, s.times_played) end)
  sort_by_keys(kept, keys)
end
