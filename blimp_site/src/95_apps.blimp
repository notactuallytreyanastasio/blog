# Pages that are one Blimp program, run in the browser: the server sends a
# page with an empty #blimp-app naming the program and the actor it ends
# with, and static/blimp/app.js mounts it. The program is the page; the
# server only says where it is.

APP_SCRIPTS = ["/blimp/blimp.js", "/blimp/blimp-view.js", "/blimp/canvas.js", "/blimp/page-canvas.js", "/blimp/app.js"]

def app_page(title: String, description: String, stylesheets: List, html_class: String, program: String, actor_var: String) -> String do
  app_page_with(title, description, stylesheets, html_class, program, actor_var, false)
end

# located: the program keeps its state in the URL, and app.js tells it what
# the URL says when it starts (actor <- :location("year=2023&...")).
def app_page_with(title: String, description: String, stylesheets: List, html_class: String, program: String, actor_var: String, located: Bool) -> String do
  flag = case located do
    true -> " data-location=\"1\""
    false -> ""
  end
  body = join([
    "<div id=\"blimp-app\" data-program=\"", escape_html(program), "\" data-actor=\"", escape_html(actor_var), "\"", flag, "></div>\n",
    "<p id=\"blimp-app-status\" class=\"blimp-app-status\">loading Blimp...</p>\n",
    "<noscript><p>This page is a program written in Blimp, which your browser runs in Blimp's WebAssembly interpreter; ",
    "that needs JavaScript to start. The program is <a href=\"", escape_html(program), "\">", escape_html(program), "</a>.</p></noscript>\n",
    script_tags(APP_SCRIPTS)
  ], "")
  page_layout_html(title, description, "website", list_append(stylesheets, ["/assets/apps.css", "/assets/blimp-window.css"]), body, html_class)
end

APP_CSS = "/assets/app-3cfac71d5552d1426de906087a8be2fe.css"

# What BlinksLive's root layout (blinks_root.html.heex) puts in every
# /blinks page's head beyond the site's own: the home-screen app (the
# manifest, the icons, standalone on iOS, where Web Push only works from an
# installed app) and the link preview. Without the manifest "Add to Home
# Screen" makes a bookmark, not the app the bell's pushes go to. It is here, not
# with the blinks files, because three of them build pages at load time and
# the shell's glob order among 99_blinks.blimp, 99_blinks_pages.blimp and
# 99_blinkslive.blimp depends on the locale.
def blk_pwa_head_tags() -> String do
  join([
  "<link rel=\"manifest\" href=\"/static/blinks-pwa/manifest.json\">\n",
  "<link rel=\"apple-touch-icon\" href=\"/static/blinks-pwa/icon-180.png\">\n",
  "<link rel=\"icon\" type=\"image/png\" sizes=\"192x192\" href=\"/static/blinks-pwa/icon-192.png\">\n",
  "<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n",
  "<meta name=\"mobile-web-app-capable\" content=\"yes\">\n",
  "<meta name=\"apple-mobile-web-app-title\" content=\"Blinks\">\n",
  "<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"default\">\n",
  "<meta name=\"theme-color\" content=\"#f5f2ea\">\n",
  "<meta property=\"og:url\" content=\"https://bobbby.online/blinks\">\n",
  "<meta property=\"og:image\" content=\"https://bobbby.online/static/blinks-og.png\">\n",
  "<meta property=\"og:image:width\" content=\"1200\">\n",
  "<meta property=\"og:image:height\" content=\"630\">\n"
  ], "")
end

def blk_pwa_head(html: String) -> String do
  i = index_of(html, "</head>")
  case i >= 0 do
    true -> concat(take(html, i), blk_pwa_head_tags(), drop(html, i))
    # every page_layout_html has one; a page without it is a bug to see
    false ->
      puts("blk_pwa_head: a /blinks page has no </head>: refusing to start")
      exit(1)
  end
end

def list_append(a: List, b: List) -> List do
  reduce(reverse(a), b, fn(acc: List, x: Any) -> List do [x | acc] end)
end

# /temper-snake: Snake written in Temper, compiled to Blimp, running in the
# browser -- TemperSnakeLive's page, as the Blimp server's. The game and its
# runner (/static/temper-snake/*) are the files Phoenix served, unchanged;
# they run on the site's Blimp (static/snake/play.js), which draws the game
# in the Blimp window.
TEMPER_SNAKE_FILES = ["blimp.js", "blimp-view.js", "blimp.wasm", "embed.css", "embed.js", "harness.blimp", "snake.blimp", "index.html", "selftest.html"]

def temper_snake_page() -> String do
  base = "/static/temper-snake/"
  body = join([
    "<div class=\"max-w-2xl mx-auto px-4 py-10 space-y-6\">",
    "<div><h1 class=\"text-2xl font-semibold tracking-tight\">Snake, by way of Temper and Blimp</h1></div>",
    "<link rel=\"stylesheet\" href=\"", base, "embed.css\">",
    "<div id=\"snake-host\"><div id=\"snake-app\" class=\"blimp-host\"><span class=\"text-sm text-gray-500\">loading…</span></div>",
    "<div id=\"snake-status\" class=\"mt-3 text-xs text-gray-400\"></div></div>",
    "<link rel=\"stylesheet\" href=\"/assets/blimp-window.css\">",
    script_tags(["/blimp/blimp.js", "/blimp/blimp-view.js", "/blimp/canvas.js", "/blimp/page-canvas.js", "/snake/play.js"]),
    "<div class=\"prose prose-sm dark:prose-invert max-w-none\">",
    "<p>The game is about 300 lines of <a href=\"https://github.com/temperlang/temper\">Temper</a>, a language that compiles to several others. ",
    "<a href=\"https://github.com/notactuallytreyanastasio/temper_snake\">Someone wrote it</a> to run on six backends. This is a seventh: Blimp, an actor language with a tree-walking interpreter written in Zig.</p>",
    "<p>Nothing on this page simulates snake. The board you are looking at is drawn by the game's own <code>render</code> function, compiled from Temper to Blimp, executed by the Blimp interpreter compiled to WebAssembly and running in your browser. The score, the food placement and the collision that ends it are all the original Temper.</p>",
    "<p>The game's own runner reads <code>w/a/s/d</code> from standard input and sleeps 200ms between frames, which a browser gives you neither of. So there is a second runner, written in Blimp, that describes its input and its clock instead of performing them:</p>",
    "<pre><code>timer(200, :tick)\n    key(\"w\", :up), key(\"a\", :left), key(\"s\", :down), key(\"d\", :right)</code></pre>",
    "<p>Those draw nothing. The host turns the first into an interval and the rest into a keydown table, and the game receives <code>:tick</code> and <code>:up</code> as ordinary actor messages.</p>",
    "<p>And now the page around it is served by Blimp too.</p>",
    "</div></div>"
  ], "")
  page_layout("Snake, by way of Temper and Blimp", "Snake written in Temper, compiled to Blimp, running in your browser.", "website", [APP_CSS], body)
end
