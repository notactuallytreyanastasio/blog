# /cursor-tracker: everyone's cursor over one shared drawing area, and the
# dots they click into it.
#
# CursorTrackerLive tracked each visitor with Presence, broadcast every
# mousemove over PubSub (its hook pushed one per browser event, unthrottled)
# and kept the dots in an ETS table owned by Blog.CursorPoints. Here the room
# is one actor, CURSORS, in the one server process. A browser opens
# /live/cursors; the Site actor hands CURSORS the socket (:join), every frame
# on it (:recv) and its end (:leave), and every tick asks it to :push.
# Who is in the room and writing to them is not CURSORS' own any more: the
# visitors are members of the site's Rooms hub (src/89_rooms.blimp), which
# rate-limits their frames and sends each one this tick's frames in one
# write when main.blimp flushes it. CURSORS keeps the points and the clock.
#
# What crosses, as JSON text frames:
#   up    {"t":"move","rx":12,"ry":40,"inside":true}   at most 20 a second,
#         and only when it changed (static/cursors/cursors.js)
#         {"t":"point","x":12,"y":40}                   a click in the area
#         {"t":"clear"}
#   down  {"t":"hello","id":..,"color":..,"points":[..],"users":[..]}  once
#         {"t":"users","users":[{"id","color","rx","ry","inside"}]}
#         {"t":"point","point":{"id","color","x","y"}}
#         {"t":"clear"}
#
# Moves are not forwarded as they come: each one overwrites that visitor's
# cursor, and :push sends everyone the whole room at most every
# CT_PUSH_MS. A room of n visitors each moving 20 times a second costs n
# frames out per push, not n*n per move. Only the position inside the area
# is sent; where the cursor is on the rest of the page is the page's own
# business (the LiveView sent it, and nobody else displayed it).
#
# The arithmetic (colour, the hourly clear, clamping) is Temper,
# temper/src/cursor_tracker.

CT_PUSH_MS = 50
CT_POINT_MS = 100
CT_MAX_POINTS = 1000
CT_MAX_COORD = 4000

# The room's sockets, who is in it and what they are sent are a Rooms
# hub's (src/89_rooms.blimp): each visitor is a member of CT_TOPIC, their id
# is who and their colour and cursor are what they say about themselves.
# The topic sends no presence frames of its own: the page already had the
# room in its "users" frame, and that stays the wire.
CT_TOPIC = "cursors"

# The hub a room uses: its own when given one (a test), else the site's.
def ct_hub(h: Any) -> Any do
  case h == nil do
    true -> ROOMS
    false -> h
  end
end

# A number a browser sent, as a whole number from 0 to CT_MAX_COORD.
def ct_coord(v: Any) -> Int do
  case type_of(v) do
    :integer -> ct_clamp(v, 0, CT_MAX_COORD)
    :float -> ct_clamp(round(v), 0, CT_MAX_COORD)
    _ -> 0
  end
end

# The room as it is sent: everyone, in the order they came.
def ct_users(members: List) -> List do
  map(members, fn(m: Map) -> Map do
    %{id: m.who, color: m.meta.color, rx: m.meta.rx, ry: m.meta.ry, inside: m.meta.inside}
  end)
end

def ct_users_json(members: List) -> String do
  json_encode(%{t: "users", users: ct_users(members)})
end

# The first n of a list (newest first, so the newest n points).
def ct_first(list: List, n: Int) -> List do
  reverse(ct_first_into(list, n, []))
end

def ct_first_into(list: List, n: Int, acc: List) -> List do
  case n <= 0 do
    true -> acc
    false ->
      case list do
        [] -> acc
        [h | rest] -> ct_first_into(rest, n - 1, [h | acc])
      end
  end
end

def ct_decode(text: String) -> Map do
  case json_decode(text) do
    {:ok, m} ->
      case type_of(m) == :map do
        true -> m
        false -> %{}
      end
    _ -> %{}
  end
end

actor CursorRoom do
  state hub: Any :: nil
  # socket (as a string) -> when it last drew a point
  state point_at: Map :: %{}
  state points: List :: []
  state dirty: Bool :: false
  state pushed_at: Int :: 0
  state hour: Int :: 0

  # A test's room keeps its own hub.
  on :hub(h: Any) do
    h <- :open(CT_TOPIC, %{diffs: false})
    become hub: h
    reply :ok
  end

  # A new socket: a visitor with a fresh id and the colour it gives them,
  # sent who they are, the points so far and who else is here.
  on :join(fd: Int) do
    rooms = ct_hub(hub)
    id = hex_encode(random_bytes(8))
    color = ct_color(id)
    rooms <- :open(CT_TOPIC, %{diffs: false})
    rooms <- :join(CT_TOPIC, fd, id, %{color: color, rx: 0, ry: 0, inside: false})
    members = rooms <- :list(CT_TOPIC)
    rooms <- :send(fd, json_encode(%{t: "hello", id: id, color: color, points: points, users: ct_users(members)}))
    become point_at: put(point_at, to_string(fd), 0), dirty: true
    reply id
  end

  on :leave(fd: Int) do
    rooms = ct_hub(hub)
    rooms <- :leave(CT_TOPIC, fd)
    become point_at: rooms_drop_key(point_at, to_string(fd)), dirty: true
    reply :ok
  end

  # A frame from a page. Anything that is not one of the three is ignored
  # and answered :bad, and a frame over the hub's rate :limited; the Site
  # keeps the socket either way.
  on :recv(fd: Int, text: String) do
    rooms = ct_hub(hub)
    msg = ct_decode(text)
    what = lookup(msg, :t)
    case rooms <- :inbound(fd) do
      :limited -> reply :limited
      :ok ->
        case what do
          # the commonest frame by far: one call, which is also the check
          # that fd is in the room
          "move" ->
            moved = rooms <- :patch(CT_TOPIC, fd, %{rx: ct_coord(lookup(msg, :rx)), ry: ct_coord(lookup(msg, :ry)), inside: lookup(msg, :inside) == true})
            case moved == nil do
              true -> reply :bad
              false ->
                become dirty: true
                reply :move
            end
          # a point goes to everyone at once, the clicker too: the page shows
          # what the room has, not what it hoped to add
          "point" ->
            me = rooms <- :member(CT_TOPIC, fd)
            t = now_ms()
            case me == nil do
              true -> reply :bad
              false ->
                case t - lookup(point_at, to_string(fd)) < CT_POINT_MS do
                  true -> reply :too_soon
                  false ->
                    pt = %{id: me.who, color: me.meta.color, x: ct_coord(lookup(msg, :x)), y: ct_coord(lookup(msg, :y))}
                    rooms <- :broadcast(CT_TOPIC, json_encode(%{t: "point", point: pt}))
                    become point_at: put(point_at, to_string(fd), t), points: ct_first([pt | points], CT_MAX_POINTS)
                    reply :point
                end
            end
          "clear" ->
            me = rooms <- :member(CT_TOPIC, fd)
            case me == nil do
              true -> reply :bad
              false ->
                rooms <- :broadcast(CT_TOPIC, json_encode(%{t: "clear"}))
                become points: []
                reply :clear
            end
          _ -> reply :bad
        end
    end
  end

  # Every Site tick: the hourly clear when an hour has turned, and the room
  # to everyone if it changed and CT_PUSH_MS has passed since the last time.
  # t_ms and now_s are the clock, passed in so a test can be the clock.
  # What is said here goes out at the hub's next flush, in this same tick.
  on :push(t_ms: Int, now_s: Int) do
    rooms = ct_hub(hub)
    h = ct_hour(now_s)
    turned = hour != 0 and h != hour and points != []
    case turned do
      true -> rooms <- :broadcast(CT_TOPIC, json_encode(%{t: "clear"}))
      false -> :ok
    end
    kept = case turned do
      true -> []
      false -> points
    end
    case dirty and t_ms - pushed_at >= CT_PUSH_MS do
      false ->
        become hour: h, points: kept
        reply 0
      true ->
        members = rooms <- :list(CT_TOPIC)
        rooms <- :broadcast(CT_TOPIC, ct_users_json(members))
        become hour: h, points: kept, dirty: false, pushed_at: t_ms
        reply length(members)
    end
  end

  # From the prompt, or a test.
  on :room do
    rooms = ct_hub(hub)
    members = rooms <- :list(CT_TOPIC)
    reply %{users: ct_users(members), points: points, dirty: dirty}
  end
end

CURSORS = spawn CursorRoom

# ── the page ────────────────────────────────────────────────────────────

CT_SCRIPTS = ["/blimp/blimp.js", "/blimp/blimp-view.js", "/blimp/canvas.js", "/blimp/page-canvas.js", "/blimp/app.js", "/cursor-tracker/cursors.js"]

def cursor_tracker_page() -> String do
  program = "/cursor-tracker/cursors.blimp"
  body = join([
    "<div id=\"blimp-app\" data-program=\"", program, "\" data-actor=\"cur\"></div>\n",
    "<p id=\"blimp-app-status\" class=\"blimp-app-status\">loading Blimp...</p>\n",
    "<noscript><p>This page is a program written in Blimp, which your browser runs in Blimp's WebAssembly interpreter; ",
    "that needs JavaScript to start. The program is <a href=\"", program, "\">", program, "</a>.</p></noscript>\n",
    script_tags(CT_SCRIPTS)
  ], "")
  page_layout("Cursor Tracker", "Track cursor positions, draw points on a canvas", "website", ["/assets/app-3cfac71d5552d1426de906087a8be2fe.css", "/assets/apps.css", "/assets/blimp-window.css"], body)
end

def ct_asset(file: String, content_type: String) -> Map do
  body = read_file(file)
  case body do
    nil ->
      print(concat("cannot read ", file))
      exit(1)
    _ -> response(200, content_type, "public, max-age=300", body)
  end
end

CT_PAGE = response(200, "text/html; charset=utf-8", "public, max-age=300", cursor_tracker_page())
CT_PROGRAM = ct_asset("_build/cursors.blimp", "text/plain; charset=utf-8")
CT_JS = ct_asset("static/cursors/cursors.js", "text/javascript; charset=utf-8")
