# mirror: begin
# /mirror: "I am looking at myself". MirrorLive fetched its own Elixir
# source and set every character spinning. This is the Blimp that renders
# the page, and what it shows is this file: cut, at boot, out of
# _build/site.blimp, the program the server is running, between this
# file's first line and its last.
#
# The characters used to spin as MirrorLive's did; now the code holds still
# so it can be read. There is no script on the page.

MIRROR_BEGIN = "# mirror: begin"
MIRROR_END = "# mirror: end"

# The text between the markers in the running program, markers included.
def mirror_source(program: String) -> String do
  from = index_of(program, MIRROR_BEGIN)
  upto = index_of_from(program, concat("\n", MIRROR_END), from + 1)
  case from >= 0 and upto > from do
    true -> slice(program, from, upto - from + length(MIRROR_END) + 1)
    false -> desk_die("mirror: cannot find this file in the running program")
  end
end

def mirror_page(program: String) -> String do
  source = mirror_source(program)
  body = join([
    "<div class=\"os-desktop-osx\">",
    "<div class=\"os-window os-window-osx mirror-window\">",
    "<div class=\"os-titlebar\"><div class=\"os-titlebar-buttons\"><a href=\"/\" class=\"os-btn-close\"></a>",
    "<span class=\"os-btn-min\"></span><span class=\"os-btn-max\"></span></div>",
    "<span class=\"os-titlebar-title\">Mirror.app - Self-Reflecting Code</span><div class=\"os-titlebar-spacer\"></div></div>",
    "<div class=\"os-content mirror-content\"><div class=\"p-6\">",
    "<h1 class=\"text-2xl font-bold mb-6 text-white\">Mirror Mirror on the wall, who's the most meta of them all?</h1>",
    "<div class=\"bg-gray-800 rounded-lg p-6 shadow-lg\">",
    "<pre class=\"text-sm font-mono text-white mirror-code\"><code class=\"language-blimp\">",
    escape_html(source),
    "</code></pre></div></div></div>",
    "<div class=\"os-statusbar\"><span>Viewing: 96_mirror.blimp, ", to_string(length(split(source, "\n"))), " lines of the running program</span>\n",
    "<span>Mode: Self-Reflection</span></div>",
    "</div></div>"
  ], "")
  page_layout("I am looking at myself", "A page that shows its own source code", "website", [APP_CSS], body)
end
# mirror: end
