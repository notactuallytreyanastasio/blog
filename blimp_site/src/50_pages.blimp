# Pages. Each is a function from data to one HTML string.
#
# The markup is PostLive's and PostLive.Index's, element for element, minus
# what needed a socket: the reader count, the comment form and the LIVE
# badge. Nothing here emits a <script>, an on* attribute, or a javascript:
# URL, and test/pages_test.blimp holds every page to that.

def site_description() -> String do
  "This page was built in a language the programmer who it is about invented. It is a space to experiment with software and share it socially. Please participate in the more social aspects of the site politely. There is a mixture of writing, games, and technical demonstrations. Please enjoy your day. I love you"
end

SITE_NAME = "Bobbby's Online Museum"

def meta_tag(attr: String, name: String, content: String) -> String do
  concat("<meta ", attr, "=\"", name, "\" content=\"", escape_html(content), "\">\n")
end

# The names list_dir gives that are files to hash (it may answer nil, or
# give "." and "..").
def asset_files(names: Any) -> List do
  case type_of(names) == :list do
    false -> []
    true -> filter(names, fn(n: String) -> Bool do not(starts_with(n, ".")) end)
  end
end

# A stylesheet under /assets/ is linked with ?v= and the start of its
# content's sha256, so a changed file is a new URL. Cloudflare caches
# /assets/* for four hours (max-age=14400) and kept serving the old
# desktop.css after the homepage redesign shipped: the new markup arrived
# with the old styles. The server routes by path, so the query changes
# nothing but the cache key. A link it cannot read (Phoenix's digested
# app-*.css, served from priv) is left as it is; its name is already its
# version.
#
# The hashes are taken once, when the program starts: every file in
# assets/, read and hashed when this file is evaluated, not on every page
# built (every post page, the blog index, the 404s and the rest each read
# and hashed their stylesheets again). A stylesheet changed under a running
# site keeps its old ?v= until the next start, as its route keeps its old
# body (main.blimp's load_asset reads it once too).
ASSET_VERSIONS = reduce(asset_files(list_dir("assets")), %{}, fn(acc: Map, name: String) -> Map do
  body = read_file(concat("assets/", name))
  case body do
    nil -> acc
    _ -> put(acc, concat("/assets/", name), take(sha256(body), 10))
  end
end)

def asset_href(href: String) -> String do
  v = lookup(ASSET_VERSIONS, href)
  case v do
    nil -> href
    _ -> concat(href, "?v=", v)
  end
end

def page_layout(title: String, description: String, og_type: String, stylesheets: List, body: String) -> String do
  page_layout_html(title, description, og_type, stylesheets, body, "")
end

# The same, with a class on <html> (2048 locks the page's scrolling that way).
def page_layout_html(title: String, description: String, og_type: String, stylesheets: List, body: String, html_class: String) -> String do
  page_layout_full(title, description, og_type, stylesheets, body, html_class, nil)
end

# A page with a share card: image is %{url, alt}, a 1200x630 picture, or
# nil for none. Link previews then show it large (summary_large_image).
def page_layout_full(title: String, description: String, og_type: String, stylesheets: List, body: String, html_class: String, image: Any) -> String do
  card = case image do
    nil -> meta_tag("name", "twitter:card", "summary")
    _ -> join([
      meta_tag("property", "og:image", image.url),
      meta_tag("property", "og:image:width", "1200"),
      meta_tag("property", "og:image:height", "630"),
      meta_tag("property", "og:image:alt", image.alt),
      meta_tag("name", "twitter:card", "summary_large_image"),
      meta_tag("name", "twitter:image", image.url),
      meta_tag("name", "twitter:image:alt", image.alt)
    ], "")
  end
  open_html = case html_class do
    "" -> "<html lang=\"en\">"
    _ -> concat("<html lang=\"en\" class=\"", escape_html(html_class), "\">")
  end
  links = join(map(stylesheets, fn(href: String) -> String do
    concat("<link rel=\"stylesheet\" href=\"", asset_href(href), "\">\n")
  end), "")
  join([
    "<!DOCTYPE html>\n", open_html, "\n<head>\n",
    "<meta charset=\"utf-8\">\n",
    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n",
    "<title>", escape_html(title), "</title>\n",
    meta_tag("name", "description", description),
    meta_tag("property", "og:title", title),
    meta_tag("property", "og:description", description),
    meta_tag("property", "og:type", og_type),
    meta_tag("property", "og:site_name", SITE_NAME),
    card,
    meta_tag("name", "twitter:title", title),
    meta_tag("name", "twitter:description", description),
    "<link rel=\"icon\" href=\"/favicon.ico\">\n",
    links,
    blimp_preloads(body),
    "</head>\n<body>\n",
    with_runtime(body),
    "\n</body>\n</html>\n"
  ], "")
end

# What a Blimp page fetches only after its scripts have run, asked for from
# the <head> instead. A page loaded in series: the HTML, then blimp.js and
# the page's host script (app.js, play.js), and only when they ran did the
# host ask for blimp.wasm (617KB), and only when that was instantiated, the
# program. On /who the wasm started 213ms into the load with 40ms of
# emulated round trip, after every stylesheet and script. A preload starts
# both with the stylesheets. The URLs are read off the page itself, from
# the attributes its host reads them from, so they are the same strings
# and the preload is the one the host's fetch() is given:
#   data-wasm, else data-blimp-wasm      the interpreter (app.js's order)
#   data-program, ?v=data-blimp-build    app.js's program, versioned as it
#                                        versions it (not when it has a ?)
#   data-programs                        a host that fetches several
#                                        (static/snake/play.js), as written
#   data-renderer                        the post window's worker's program
# crossorigin because fetch() is a CORS-mode request, which a preload
# without it does not match. A post's worker fetches in its own context,
# which no preload serves; it finds them in the HTTP cache (they are named
# by content, so kept a year), and the article comes first, so a post's
# are fetchpriority="low".
def blimp_preloads(body: String) -> String do
  wasm = page_attr(body, "data-wasm")
  interp = case wasm do
    "" -> page_attr(body, "data-blimp-wasm")
    _ -> wasm
  end
  program = page_attr(body, "data-program")
  build = page_attr(body, "data-blimp-build")
  versioned = case program == "" or build == "" or contains(program, "?") do
    true -> program
    false -> concat(program, "?v=", build)
  end
  renderer = page_attr(body, "data-renderer")
  several = filter(split(page_attr(body, "data-programs"), " "), fn(u: String) -> Bool do u != "" end)
  urls = filter(flat([[interp, versioned, renderer], several]), fn(u: String) -> Bool do u != "" end)
  prio = case renderer == "" do
    true -> ""
    false -> " fetchpriority=\"low\""
  end
  join(map(urls, fn(u: String) -> String do
    concat("<link rel=\"preload\" href=\"", u, "\" as=\"fetch\" crossorigin", prio, ">\n")
  end), "")
end

# The value of the first `name="..."` in html, as written (still escaped),
# or "".
def page_attr(html: String, name: String) -> String do
  key = concat(" ", name, "=\"")
  at = index_of(html, key)
  case at < 0 do
    true -> ""
    false ->
      from = at + length(key)
      stop = index_of_from(html, "\"", from)
      case stop < 0 do
        true -> ""
        false -> slice(html, from, stop - from)
      end
  end
end

# Blimp's canvas, drawing the one Blimp process serving this site, as it
# runs: a small window in the corner of every page, fed by /live/runtime
# (static/blimp/runtime.js). A page that already loads the canvas to draw
# a program of its own (a post, /tetris) keeps just that one.
RUNTIME_TAGS = "<link rel=\"stylesheet\" href=\"/assets/blimp-window.css\">\n<script src=\"/blimp/canvas.js\"></script>\n<script src=\"/blimp/runtime.js\"></script>\n"

def with_runtime(body: String) -> String do
  case contains(body, "/blimp/canvas.js") do
    true -> body
    false -> concat(body, "\n", RUNTIME_TAGS)
  end
end

# The same, put into a whole page someone else wrote (the snapshots in
# content/pages), before its last </body>.
def page_with_runtime(html: String) -> String do
  at = pg_last_index(html, "</body>", 0, -1)
  case at < 0 do
    true -> concat(html, RUNTIME_TAGS)
    false -> concat(take(html, at), RUNTIME_TAGS, drop(html, at))
  end
end

def tag_spans(tags: List, class: String) -> String do
  join(map(tags, fn(t: String) -> String do
    concat("<span class=\"", class, "\">", escape_html(t), "</span>")
  end), "")
end

def plural(n: Int, one: String, many: String) -> String do
  case n == 1 do
    true -> concat(to_string(n), " ", one)
    false -> concat(to_string(n), " ", many)
  end
end

def menu_bar(extra_links: String, right: String) -> String do
  join([
    "<div class=\"mac-menu-bar\">",
    "<div class=\"menu-left\">",
    "<span class=\"apple-menu\">&#63743;</span>",
    "<span class=\"menu-item\">File</span>",
    "<span class=\"menu-item\">Edit</span>",
    "<span class=\"menu-item\">View</span>",
    "<a href=\"/\" class=\"menu-item\" style=\"text-decoration: none; color: inherit;\">Home</a>",
    extra_links,
    "</div>",
    "<div class=\"menu-right\"><span>", right, "</span></div>",
    "</div>"
  ], "")
end

def blog_post_row(post: Map) -> String do
  tags = case length(post.tags) > 0 do
    true -> concat("<span class=\"blog-post-tags\">", tag_spans(post.tags, "blog-tag"), "</span>")
    false -> ""
  end
  join([
    "<a href=\"/post/", post.slug, "\" class=\"blog-post-row\">",
    "<div class=\"blog-post-icon\">📝</div>",
    "<div class=\"blog-post-info\">",
    "<div class=\"blog-post-title\">", escape_html(post.title), "</div>",
    "<div class=\"blog-post-meta\">", post.date, " ", tags, "</div>",
    "</div></a>"
  ], "")
end

def blog_index_page(posts: List) -> String do
  body = join([
    "<div class=\"mac-blog\">",
    menu_bar("", "served by Blimp"),
    "<div class=\"mac-desktop\"><div class=\"mac-window\">",
    "<div class=\"mac-title-bar\"><a href=\"/\" class=\"mac-close-box\"></a>",
    "<div class=\"mac-title\">Thoughts &amp; Tidbits - Blog</div>",
    "<div class=\"mac-resize-box\"></div></div>",
    "<div class=\"mac-window-content\"><div class=\"blog-posts-list\">",
    journal_blog_row(),
    join(map(posts, fn(p: Map) -> String do blog_post_row(p) end), ""),
    "</div></div>",
    "<div class=\"mac-status-bar\"><span>", plural(length(posts), "post", "posts"), "</span>",
    "<span>0 scripts</span></div>",
    "</div></div></div>"
  ], "")
  page_layout("Thoughts and Tidbits", site_description(), "website", ["/assets/base.css", "/assets/blog.css"], body)
end

def post_page(post: Map) -> String do
  body = join([
    "<div class=\"mac-post\">",
    menu_bar("<a href=\"/blog\" class=\"menu-item\" style=\"text-decoration: none; color: inherit;\">Blog</a>", "served by Blimp"),
    "<div class=\"mac-desktop\"><div class=\"mac-window\">",
    "<div class=\"mac-title-bar\"><a href=\"/blog\" class=\"mac-close-box\"></a>",
    "<div class=\"mac-title\">", escape_html(post.title), "</div>",
    "<div class=\"mac-resize-box\"></div></div>",
    "<div class=\"mac-window-content\">",
    "<div class=\"post-meta-bar\">",
    "<span class=\"post-date\">", post.date, "</span>",
    "<span class=\"post-stats\">", to_string(post.words), " words · ", post.read_time, "</span>",
    "<div class=\"post-tags-inline\">", tag_spans(post.tags, "mac-tag"), "</div>",
    "</div>",
    "<div id=\"post-content\" class=\"article-content\">", post.html, "</div>",
    "<div class=\"post-footer\"><a href=\"/blog\" class=\"back-link\">← Back to all posts</a></div>",
    "</div>",
    "<div class=\"mac-status-bar\"><span>", to_string(post.words), " words</span><span>", post.read_time, "</span></div>",
    "</div></div></div>",
    blimp_window(post.slug)
  ], "")
  page_layout(post.title, post.description, "article", ["/assets/base.css", "/assets/post.css", "/assets/highlight.css", "/assets/blimp-window.css"], body)
end

# The small window pinned to a post page's corner. static/post/post.js runs
# the site's own renderer on this post in the browser, in a worker, and
# Blimp's canvas draws it doing so; the status line says whether the bytes
# match what the server sent. The two scripts are Blimp's canvas and that
# starter; neither is needed to read the post, which is all above.
# Every URL in it is named by content (POST_WINDOW_URLS, beside
# script_href in src/90_live.blimp): the worker, the blimp.js it imports
# and the blimp.wasm that runs, so a cached copy from before a deploy is
# never mixed with this one.

def blimp_window(slug: String) -> String do
  join([
    "<span id=\"blimp-closed\"></span>",
    "<div id=\"blimp-window\" class=\"blimp-window\" data-slug=\"", escape_html(slug), "\"", POST_WINDOW_URLS.attrs, ">",
    "<div class=\"mac-title-bar\"><a href=\"#blimp-closed\" class=\"mac-close-box\" title=\"close\"></a>",
    "<div class=\"mac-title\">Blimp: this post, rendered again</div></div>",
    "<div id=\"blimp-viz-wrap\"><canvas id=\"blimp-viz\"></canvas></div>",
    "<div id=\"blimp-status\" class=\"blimp-status\">This post was rendered by a server written in Blimp. ",
    "With scripts on, your browser renders it again here, with the same Blimp code.</div>",
    "</div>",
    POST_WINDOW_URLS.scripts
  ], "")
end

def not_found_page(path: String) -> String do
  not_found_page_for(concat("<code>", escape_html(path), "</code>"))
end

# `where` is HTML: the path in <code>, or words.
def not_found_page_for(where: String) -> String do
  body = join([
    "<div class=\"mac-blog\">",
    menu_bar("", "served by Blimp"),
    "<div class=\"mac-desktop\"><div class=\"mac-window\">",
    "<div class=\"mac-title-bar\"><a href=\"/\" class=\"mac-close-box\"></a>",
    "<div class=\"mac-title\">Not Found</div><div class=\"mac-resize-box\"></div></div>",
    "<div class=\"mac-window-content\" style=\"padding: 24px;\">",
    "<p>There is nothing at ", where, ".</p>",
    "<p style=\"margin-top: 12px;\"><a href=\"/blog\">All posts</a></p>",
    "</div></div></div></div>"
  ], "")
  page_layout("Not Found", site_description(), "website", ["/assets/base.css", "/assets/blog.css"], body)
end

# The answer to every GET no route has (static_or_404, main.blimp), made
# once: the response dynamic() hands back, with its wire, which answer_resp
# sends as it is. It was a page rendered per request, naming the path, after
# the whole fallback chain; in production Caddy answers any Blimp 404 with a
# 308 to old.bobbby.online and drops the body unread, so nobody saw the path
# and every scanner's probe paid for it. The page says "this address".
def not_found_prebuilt() -> Map do
  resp = html_response(404, not_found_page_for("this address"))
  put(resp, :wire, serialize(resp, "GET"))
end
NOT_FOUND = not_found_prebuilt()
