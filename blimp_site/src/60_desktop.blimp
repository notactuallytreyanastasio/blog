# The homepage: the server drawn live, the pages it serves, the newest
# posts, and the museum. It works without JavaScript; with it, the canvas
# at the top draws this very process (static/blimp/home.js).
#
# The state that changes what is on screen lives in the query string:
#
#   cat=<category>   museum filter (absent: All)
#   project=<slug>   the museum exhibit shown open
#   leica=1          the Leica large-file warning
#
# Every link carries the rest of the state along. A value is echoed back
# into a link only after it has been checked against the data, so nothing a
# visitor types into the URL reaches the page.
#
# The boot splash shows only for a bare "/". Any query string at all, even
# the /?booted=1 that clicking the splash leads to, means the visitor has
# seen it.
#
# What is a function of strings and numbers alone (the clock, the links,
# fixed HTML) is Temper, in temper/src/desktop. What reads or builds a
# record stays here.

APPS_ORIGIN = "https://bobbby.online"

# ── Loading the snapshots in data/ ──────────────────────────────────────

def desk_lines(text: String) -> List do
  filter(split(text, "\n"), fn(l: String) -> Bool do length(l) > 0 end)
end

def desk_field(fields: List, i: Int) -> String do
  elem_at(fields, i)
end

def desk_die(message: String) -> Any do
  print(message)
  exit(1)
end

def desk_read(path: String) -> String do
  text = read_file(path)
  case text do
    nil -> desk_die(concat("cannot read ", path))
    _ -> text
  end
end

def desk_repos_for(repo_rows: List, slug: String) -> List do
  map(filter(repo_rows, fn(r: List) -> Bool do head(r) == slug end), fn(r: List) -> Map do
    %{name: desk_field(r, 1), full_name: desk_field(r, 2)}
  end)
end

def desk_load_museum(tsv: String, repos_tsv: String) -> List do
  repo_rows = map(desk_lines(repos_tsv), fn(l: String) -> List do split(l, "\t") end)
  map(desk_lines(tsv), fn(l: String) -> Map do
    f = split(l, "\t")
    case length(f) == 12 and desk_url_safe(desk_field(f, 0)) and desk_url_safe(desk_field(f, 4)) do
      false -> desk_die(concat("data/museum.tsv: expected 12 fields, and a slug and category that need no URL escaping, in ", l))
      true ->
        %{
          slug: desk_field(f, 0),
          title: desk_field(f, 1),
          tagline: desk_field(f, 2),
          description: desk_unescape(desk_field(f, 3)),
          category: desk_field(f, 4),
          tech: desk_split_tech(desk_field(f, 5)),
          internal_path: desk_field(f, 6),
          external_url: desk_field(f, 7),
          repos: desk_repos_for(repo_rows, desk_field(f, 0))
        }
    end
  end)
end

def desk_member(list: List, x: String) -> Bool do
  case list do
    [] -> false
    [h | rest] ->
      case h == x do
        true -> true
        false -> desk_member(rest, x)
      end
  end
end

def desk_uniq(list: List, acc: List) -> List do
  case list do
    [] -> reverse(acc)
    [h | rest] ->
      case desk_member(acc, h) do
        true -> desk_uniq(rest, acc)
        false -> desk_uniq(rest, [h | acc])
      end
  end
end

# Blog.Museum.Projects.categories/0: distinct, ascending.
def desk_categories(projects: List) -> List do
  sort(desk_uniq(map(projects, fn(p: Map) -> String do p.category end), []))
end

# The only finder action the page can honour without a socket is the Phish
# window, and it does that by linking to the Phish app. Any other action is
# a boot failure, not an icon that silently does nothing.
def desk_check_action(action: String, name: String) -> String do
  case action do
    "" -> action
    "toggle_phish" -> action
    _ -> desk_die(concat("data/finder_items.tsv: no script-free way to do action ", action, " for ", name))
  end
end

def desk_load_finder(sections_tsv: String, items_tsv: String) -> List do
  items = map(desk_lines(items_tsv), fn(l: String) -> Map do
    f = split(l, "\t")
    case length(f) == 6 do
      false -> desk_die(concat("data/finder_items.tsv: expected 6 fields in ", l))
      true ->
        %{
          section: desk_field(f, 0),
          name: desk_field(f, 1),
          icon: desk_field(f, 2),
          path: desk_field(f, 3),
          action: desk_check_action(desk_field(f, 4), desk_field(f, 1)),
          description: desk_field(f, 5)
        }
    end
  end)
  map(desk_lines(sections_tsv), fn(l: String) -> Map do
    f = split(l, "\t")
    name = desk_field(f, 0)
    %{
      name: name,
      label: desk_field(f, 1),
      items: filter(items, fn(i: Map) -> Bool do i.section == name end)
    }
  end)
end

# ── Pixel icons: Blog.Museum.Icons.pixels/1 ─────────────────────────────

# The pixel icons stay Blimp. In Temper they were the same loop, but a
# character step there is u8_decode_at, temper_string_next and temper_int32,
# three calls into temper-core where this makes one builtin char_at: loading
# the 33 icons went from 138 ms to 638 ms.
def desk_row_rects(row: String, x: Int, y: String, acc: List) -> List do
  case x >= length(row) do
    true -> acc
    false ->
      case char_at(row, x) == "#" do
        true -> desk_row_rects(row, x + 1, y, [concat("<rect x=\"", to_string(x), "\" y=\"", y, "\" width=\"1\" height=\"1\"/>") | acc])
        false -> desk_row_rects(row, x + 1, y, acc)
      end
  end
end

def desk_grid_rects(rows: List, y: Int, acc: List) -> List do
  case rows do
    [] -> reverse(acc)
    [row | rest] -> desk_grid_rects(rest, y + 1, desk_row_rects(row, 0, to_string(y), acc))
  end
end

# The same bytes pixels/1 produces, heredoc newlines included.
def desk_pixels(rows: List) -> String do
  join([
    "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 20\" shape-rendering=\"crispEdges\">\n",
    "<g fill=\"#000\">\n",
    join(desk_grid_rects(rows, 0, []), "\n"),
    "\n</g>\n</svg>\n"
  ], "")
end

def desk_icon_entries(lines: List, slug: String, rows: List, acc: Map) -> Map do
  case lines do
    [] ->
      case slug do
        "" -> acc
        _ -> put(acc, slug, desk_pixels(reverse(rows)))
      end
    [l | rest] ->
      case starts_with(l, "== ") do
        true ->
          done = case slug do
            "" -> acc
            _ -> put(acc, slug, desk_pixels(reverse(rows)))
          end
          desk_icon_entries(rest, drop(l, 3), [], done)
        false -> desk_icon_entries(rest, slug, [l | rows], acc)
      end
  end
end

def desk_load_icons(text: String) -> Map do
  icons = desk_icon_entries(desk_lines(text), "", [], %{})
  case lookup(icons, "default") do
    nil -> desk_die("data/icons.txt has no default icon")
    _ -> icons
  end
end

# Blog.Museum.Icons.get/1
def desk_icon(icons: Map, slug: String) -> String do
  icon = lookup(icons, slug)
  case icon do
    nil -> lookup(icons, "default")
    _ -> icon
  end
end

# Everything the page needs that does not change per request, including
# the HTML of every part that does not depend on the query string. A render
# measured 2.5MB of garbage before this, most of it escape_html and the
# nested joins around 32 pixel icons; a worker frees nothing until it exits.
#
# The museum and the Finder come from Postgres in production
# (load_desktop_db) and from the data/*.tsv snapshot in tests and offline
# (load_desktop); the pixel icons are always icons.txt, which is taken from
# the Phoenix source, not the database.
def load_desktop(dir: String, posts: List) -> Map do
  loaded = desk_load_museum(desk_read(concat(dir, "/museum.tsv")), desk_read(concat(dir, "/museum_repos.tsv")))
  finder = desk_load_finder(desk_read(concat(dir, "/finder_sections.tsv")), desk_read(concat(dir, "/finder_items.tsv")))
  build_desktop(loaded, finder, desk_load_icons(desk_read(concat(dir, "/icons.txt"))), posts)
end

def build_desktop(loaded: List, finder: List, icons: Map, posts: List) -> Map do
  icon_text = concat(desk_read("data/hangar_icons.txt"), "\n", desk_read("data/icons.txt"))
  own = desk_path_entries(desk_lines(icon_text), "", [], %{})
  hangar = desk_load_hangar(desk_read("data/hangar.tsv"), own, %{})
  museum = map(loaded, fn(p: Map) -> Map do
    put(put(p, "row_html", desk_ex_row(p, own)), "detail_html", desk_detail_inner(p, icons))
  end)
  groups = desk_hangar_groups(hangar)
  desk_check_notes(groups)
  %{
    museum: museum,
    categories: desk_categories(museum),
    finder_html: desk_finder_sections(finder),
    item_count: reduce(finder, 0, fn(n: Int, s: Map) -> Int do n + length(s.items) end),
    icons: icons,
    blog_html: desk_blog_lines(posts),
    post_count: length(posts),
    hangar_groups: groups,
    hangar_count: length(hangar),
    art_html: desk_art(desk_art_seed(now()))
  }
end

# ── The background: a Temper Art picture ────────────────────────────────
#
# temper/src/art's Bauhaus generator, the one /art draws, as the page's
# wallpaper. Bauhaus is a grid of a few dozen shapes, about 5KB; Flow is
# thousands of line segments and several hundred KB, too much to put behind
# every page view. The engine's palette is dropped by desktop.css, which
# paints the shapes in the page's own ink and signal colour at a few
# percent, so the picture follows light and dark. The seed is the day the
# desktop was built (days since 1970): it changes when the server restarts
# or the museum reloads on a new day.
DESK_ART_W = 1600
DESK_ART_H = 1000

def desk_art_seed(epoch_s: Int) -> Int do
  epoch_s / 86400
end

def desk_art(seed: Int) -> String do
  concat(
    "<div class=\"bg-art\" aria-hidden=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 ",
    to_string(DESK_ART_W * 10), " ", to_string(DESK_ART_H * 10),
    "\" preserveAspectRatio=\"xMidYMid slice\" stroke-linecap=\"round\" data-seed=\"", to_string(seed), "\">",
    art_shapes(seed, "bauhaus", DESK_ART_W, DESK_ART_H),
    "</svg></div>")
end

# ── Margin notes: data/explainers.tsv ──────────────────────────────────
#
# Short notes in the owner's hand, pinned to words in the intro and to each
# section's heading, in the manner of a reader's marginalia. The words and
# links are data/explainers.tsv, so they change without touching this file.
#
# A note is a <details> (its <summary> is the word, or a small "note" tab
# beside a heading) followed by the note itself. desktop.css shows the note
# while the word is hovered or focused, and while the <details> is open, so
# a tap on a phone opens and closes it with no script; home.js only closes
# the others and keeps one on screen. The note is outside the <details>, so
# it can be shown on hover without opening it, and the word points at it
# with aria-describedby.
#
# Every key the page asks for must be in the file, and every key in the file
# must be asked for: a note that never shows, or a word whose note went
# missing, stops the boot rather than rendering as nothing.

DESK_NOTE_WORDS = ["programmer", "photographer", "artist", "nyc", "games-and-toys", "writing", "photographs", "older-projects", "blimp"]
DESK_NOTE_SECTIONS = ["sec-machine", "sec-writing", "sec-museum", "sec-photos", "sec-more"]

# "Label=/path | Label=" -> [[label, href], ...]; an empty href is kept (the
# link is not shown until it is filled in).
def desk_note_links(field: String, line: String) -> List do
  pieces = filter(map(split(field, "|"), fn(x: String) -> String do trim(x) end), fn(x: String) -> Bool do length(x) > 0 end)
  map(pieces, fn(x: String) -> List do
    at = index_of(x, "=")
    case at < 1 do
      true -> desk_die(concat("data/explainers.tsv: a link is Label=/path, not ", x, ", in ", line))
      false ->
        href = trim(drop(x, at + 1))
        ok = href == "" or starts_with(href, "/") or starts_with(href, "#") or starts_with(href, "https://")
        case ok do
          false -> desk_die(concat("data/explainers.tsv: a link goes to /path, #anchor or https://, not ", href, ", in ", line))
          true -> [trim(take(x, at)), href]
        end
    end
  end)
end

def desk_load_notes(text: String) -> Map do
  rows = filter(desk_lines(text), fn(l: String) -> Bool do not(starts_with(l, "#")) end)
  reduce(rows, %{}, fn(acc: Map, l: String) -> Map do
    f = split(l, "\t")
    key = trim(head(f))
    ok = length(f) >= 2 and length(f) <= 3 and length(key) > 0 and length(trim(elem_at(f, 1))) > 0
    case ok do
      false -> desk_die(concat("data/explainers.tsv: expected key, TAB, note[, TAB, links] in ", l))
      true ->
        case lookup(acc, key) do
          nil ->
            links = case length(f) == 3 do
              true -> desk_note_links(elem_at(f, 2), l)
              false -> []
            end
            put(acc, key, desk_note_span(key, trim(elem_at(f, 1)), links))
          _ -> desk_die(concat("data/explainers.tsv: ", key, " twice"))
        end
    end
  end)
end

# The note's HTML: a small "note" label, the words, and the links that have
# somewhere to go. Built once.
def desk_note_span(key: String, text: String, links: List) -> String do
  shown = filter(links, fn(k: List) -> Bool do elem_at(k, 1) != "" end)
  anchors = case shown do
    [] -> ""
    _ -> concat("<span class=\"note-links\">", join(map(shown, fn(k: List) -> String do
      concat("<a href=\"", escape_html(elem_at(k, 1)), "\">", escape_html(head(k)), "</a>")
    end), ""), "</span>")
  end
  concat("<span class=\"note\" role=\"note\" id=\"gl-", key, "\"><span class=\"who\">note</span><span class=\"said\">", escape_html(text), "</span>", anchors, "</span>")
end

DESK_NOTES = desk_load_notes(desk_read("data/explainers.tsv"))

def desk_note_html(key: String) -> String do
  n = lookup(DESK_NOTES, key)
  case n do
    nil -> desk_die(concat("data/explainers.tsv has no note ", key))
    _ -> n
  end
end

# Every note in the file is shown somewhere: the words, the fixed sections,
# and one sec-<group> for each group in data/hangar.tsv.
def desk_check_notes(groups: List) -> Bool do
  wanted = list_append(list_append(DESK_NOTE_WORDS, DESK_NOTE_SECTIONS), map(groups, fn(g: Map) -> String do concat("sec-", g.group) end))
  each(wanted, fn(k: String) do desk_note_html(k) end)
  each(keys(DESK_NOTES), fn(k: String) do
    case desk_member(wanted, k) or starts_with(k, "post-") do
      true -> :ok
      false -> desk_die(concat("data/explainers.tsv: the page shows no note ", k))
    end
  end)
  true
end

# A word in running text with a note on it.
def desk_gloss_term(key: String, word: String) -> String do
  concat("<span class=\"gloss\"><details class=\"gloss-t\"><summary aria-describedby=\"gl-", key, "\">", word, "</summary></details>", desk_note_html(key), "</span>")
end

# A link with a note on it: the link still goes where it went, and a small
# mark after it opens the note on a tap.
def desk_gloss_link(key: String, href: String, text: String) -> String do
  concat("<span class=\"gloss\"><a href=\"", href, "\" aria-describedby=\"gl-", key, "\">", text, "</a><details class=\"gloss-t gloss-mark\"><summary aria-label=\"A note on ", text, "\"></summary></details>", desk_note_html(key), "</span>")
end

# A section's heading with a "note" tab beside it.
def desk_gloss_sec(key: String, h2: String) -> String do
  concat("<div class=\"gloss gloss-sec\">", h2, "<details class=\"gloss-t gloss-tab\"><summary aria-describedby=\"gl-", key, "\">note</summary></details>", desk_note_html(key), "</div>")
end

# ── The manifest: the pages that run on Blimp ───────────────────────────
#
# data/hangar.tsv: group, path, name, icon, pitch. The icon is one of
# data/hangar_icons.txt's (drawn for this window) or of icons.txt's (the
# museum's). A path that is not a plain site path, or an icon neither file
# has, stops the boot: a tile with the default icon, or a link that goes
# nowhere, would look fine and be wrong.

# The Hangar's icons as one path each, a run of pixels to a subpath: the
# museum's rect-a-pixel SVG (pixels/1's bytes, kept for the museum) made
# thirty icons 200KB of the page; this makes them about 30KB.
def desk_runs(row: String, x: Int, y: String, acc: List) -> List do
  case x >= length(row) do
    true -> acc
    false ->
      case char_at(row, x) == "#" do
        false -> desk_runs(row, x + 1, y, acc)
        true ->
          n = desk_run_len(row, x, 0)
          w = to_string(n)
          desk_runs(row, x + n, y, [concat("M", to_string(x), " ", y, "h", w, "v1h-", w, "z") | acc])
      end
  end
end

def desk_run_len(row: String, x: Int, n: Int) -> Int do
  case x + n < length(row) and char_at(row, x + n) == "#" do
    true -> desk_run_len(row, x, n + 1)
    false -> n
  end
end

def desk_path_rows(rows: List, y: Int, acc: List) -> List do
  case rows do
    [] -> reverse(acc)
    [row | rest] -> desk_path_rows(rest, y + 1, desk_runs(row, 0, to_string(y), acc))
  end
end

def desk_path_icon(rows: List) -> String do
  concat("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 20\" shape-rendering=\"crispEdges\"><path d=\"", join(desk_path_rows(rows, 0, []), ""), "\"/></svg>")
end

def desk_path_done(slug: String, rows: List, acc: Map) -> Map do
  case slug do
    "" -> acc
    _ -> put(acc, slug, desk_path_icon(reverse(rows)))
  end
end

def desk_path_entries(lines: List, slug: String, rows: List, acc: Map) -> Map do
  case lines do
    [] -> desk_path_done(slug, rows, acc)
    [l | rest] ->
      case starts_with(l, "== ") do
        true -> desk_path_entries(rest, drop(l, 3), [], desk_path_done(slug, rows, acc))
        false -> desk_path_entries(rest, slug, [l | rows], acc)
      end
  end
end

def desk_load_hangar(tsv: String, own: Map, museum_icons: Map) -> List do
  map(desk_lines(tsv), fn(l: String) -> Map do
    f = split(l, "\t")
    case length(f) == 5 and starts_with(desk_field(f, 1), "/") and desk_url_safe(drop(desk_field(f, 1), 1)) do
      false -> desk_die(concat("data/hangar.tsv: expected 5 fields and a plain /path in ", l))
      true ->
        slug = desk_field(f, 3)
        mine = lookup(own, slug)
        icon = case mine do
          nil -> lookup(museum_icons, slug)
          _ -> mine
        end
        case icon do
          nil -> desk_die(concat("data/hangar.tsv: no icon ", slug, " in data/hangar_icons.txt or data/icons.txt"))
          _ -> %{group: desk_field(f, 0), path: desk_field(f, 1), name: desk_field(f, 2), icon: icon, pitch: desk_field(f, 4)}
        end
    end
  end)
end

# One card a group, in data/hangar.tsv's order: its slug, label, count and
# the tiles' HTML.
def desk_hangar_groups(pages: List) -> List do
  groups = desk_uniq(map(pages, fn(p: Map) -> String do p.group end), [])
  map(groups, fn(g: String) -> Map do
    mine = filter(pages, fn(p: Map) -> Bool do p.group == g end)
    tiles = join(map(mine, fn(p: Map) -> String do desk_hangar_tile(p.path, p.icon, p.name, p.pitch) end), "")
    %{group: g, label: desk_hangar_label(g), count: length(mine), tiles: tiles}
  end)
end

# The Blimp commit the server binary was built from: deploy.sh writes it to
# bin/BLIMP_COMMIT, which the image puts at /app/BLIMP_COMMIT, one up from
# the site. A laptop has none, and says "local build".
def desk_hex(s: String, i: Int) -> Bool do
  case i >= length(s) do
    true -> true
    false ->
      case contains("0123456789abcdef", char_at(s, i)) do
        true -> desk_hex(s, i + 1)
        false -> false
      end
  end
end

def desk_commit_of(text: Any) -> String do
  case text do
    nil -> ""
    _ ->
      sha = trim(text)
      case length(sha) == 40 and desk_hex(sha, 0) do
        true -> sha
        false -> ""
      end
  end
end

DESK_BLIMP_COMMIT = desk_commit_of(read_file("../BLIMP_COMMIT"))

# What the server is doing now, from the runtime's own snapshot: how many
# actors, and the Site actor's served count and boot time. A snapshot keeps
# numbers and summarises everything else, so this reads no page data.
def desk_site_state(actors: List) -> Map do
  case actors do
    [] -> %{}
    [a | rest] ->
      case a.type == "Site" do
        true -> lookup(a, "state")
        false -> desk_site_state(rest)
      end
  end
end

def desk_int(v: Any) -> Int do
  case type_of(v) do
    :integer -> v
    _ -> 0
  end
end

def desk_live_now(epoch_s: Int) -> String do
  snap = runtime_snapshot()
  site = desk_site_state(snap.actors)
  booted = desk_int(lookup(site, "booted_at"))
  up = case booted > 0 and epoch_s >= booted do
    true -> epoch_s - booted
    false -> 0
  end
  desk_live_counts(length(snap.actors), desk_int(lookup(site, "served")), up)
end

# The counters the prebuilt homepage is cut at, like the clock.
DESK_LIVE_MARK = desk_live_counts(0, 0, 0)

def desk_live_html(counts: String, render: String) -> String do
  short = case DESK_BLIMP_COMMIT do
    "" -> ""
    _ -> take(DESK_BLIMP_COMMIT, 7)
  end
  desk_live_strip(counts, DESK_BLIMP_COMMIT, short, render)
end

# ── Loading the museum and the Finder from Postgres ─────────────────────
#
# The same rows data/export.sh snapshots, as the same maps the snapshot
# loader makes, so build_desktop cannot tell them apart.
# {:ok, museum, finder, db} or {:error, reason, db}. A row the page could
# not show honestly (a slug that needs URL escaping, a Finder action with
# no script-free equivalent) is an error for the whole load, never a
# skipped row: the caller keeps the desktop it has and says why.

# The four queries are Alloy's (temper/src/db/desktop.temper.md), built
# once, here: [sql, params...] each, and none of them takes a parameter.
DESK_QUERIES = [desk_museum_q(), desk_repos_q(), desk_sections_q(), desk_items_q()]

def desk_db_rows(db: Map, queries: List, acc: List) -> Tuple do
  case queries do
    [] -> {:ok, reverse(acc), db}
    [q | rest] ->
      case pg_query(db, head(q), tail(q)) do
        {:ok, rows, next} -> desk_db_rows(next, rest, [rows | acc])
        {:error, reason, next} -> {:error, reason, next}
      end
  end
end

def load_desk_db(db: Map) -> Tuple do
  case desk_db_rows(db, DESK_QUERIES, []) do
    {:error, reason, next} -> {:error, reason, next}
    {:ok, sets, next} ->
      projects = elem_at(sets, 0)
      repos = elem_at(sets, 1)
      items = elem_at(sets, 3)
      bad_project = filter(projects, fn(p: Map) -> Bool do not(desk_url_safe(p.slug) and desk_url_safe(p.category)) end)
      bad_item = filter(items, fn(i: Map) -> Bool do not(i.action == "" or i.action == "toggle_phish") end)
      case {bad_project, bad_item} do
        {[], []} ->
          museum = map(projects, fn(p: Map) -> Map do
            %{
              slug: p.slug,
              title: p.title,
              tagline: p.tagline,
              description: p.description,
              category: p.category,
              tech: desk_split_tech(p.tech),
              internal_path: p.internal_path,
              external_url: p.external_url,
              repos: map(filter(repos, fn(r: Map) -> Bool do r.slug == p.slug end), fn(r: Map) -> Map do
                %{name: r.name, full_name: r.full_name}
              end)
            }
          end)
          finder = map(elem_at(sets, 2), fn(s: Map) -> Map do
            %{name: s.name, label: s.label, items: filter(items, fn(i: Map) -> Bool do i.section == s.name end)}
          end)
          {:ok, museum, finder, next}
        {[p | _], _} -> {:error, concat("museum project ", p.slug, " has a slug or category (", p.category, ") that would need URL escaping"), next}
        {_, [i | _]} -> {:error, concat("finder item ", i.name, " has action ", i.action, ", which has no script-free equivalent"), next}
      end
  end
end

# ── State ───────────────────────────────────────────────────────────────

def desk_find_project(projects: List, slug: String) -> Any do
  case projects do
    [] -> nil
    [p | rest] ->
      case p.slug == slug do
        true -> p
        false -> desk_find_project(rest, slug)
      end
  end
end

# query_param/2 from 40_http, once over pre-split pairs and without a lambda.
def desk_qp(pairs: List, prefix: String) -> String do
  case pairs do
    [] -> ""
    [p | rest] ->
      case starts_with(p, prefix) do
        true -> url_decode(drop(p, length(prefix)))
        false -> desk_qp(rest, prefix)
      end
  end
end

def desk_flag(pairs: List, key: String, want: String) -> String do
  case desk_qp(pairs, concat(key, "=")) == want do
    true -> want
    false -> ""
  end
end

# The query string, reduced to values the data vouches for. The old
# desktop's finder=, museum= and m= opened and closed windows that are not
# windows any more; a link that still carries them gets the page without
# them, and they are not echoed back.
def desk_state(query: String, desk: Map) -> Map do
  pairs = split(query, "&")
  cat = desk_qp(pairs, "cat=")
  slug = desk_qp(pairs, "project=")
  known_cat = case desk_member(desk.categories, cat) do
    true -> cat
    false -> ""
  end
  known_slug = case desk_find_project(desk.museum, slug) do
    nil -> ""
    _ -> slug
  end
  %{cat: known_cat, project: known_slug, leica: desk_flag(pairs, "leica", "1")}
end

# The link to a state, already escaped for an href: every value in the
# state is a known slug, category or flag.
def desk_href(st: Map) -> String do
  desk_href_of(st.cat, st.project, st.leica)
end

# A link that changes the museum lands back on the museum, not the top.
def desk_museum_href(st: Map) -> String do
  concat(desk_href(st), "#museum")
end

def desk_category_label(cat: String) -> String do
  case cat do
    "hardware" -> "Hardware"
    "maps" -> "Maps"
    "ml" -> "ML &amp; AI"
    "music" -> "Music"
    "social" -> "Social"
    "tools" -> "Tools"
    "writing" -> "Writing"
    _ -> escape_html(capitalize(downcase(cat)))
  end
end

# ── Built once: the log, the other pages ────────────────────────────────

# The newest three posts: title, date, and under them a margin note from
# data/explainers.tsv keyed post-<slug>. The opening of each post used to
# be here, four lines of it; a note says more in one. A post with no note
# is a title and a date. The rest are on /blog.
HOME_POSTS = 3

def desk_post_note(slug: String) -> String do
  n = lookup(DESK_NOTES, concat("post-", slug))
  case n do
    nil -> ""
    _ -> replace_all(replace_all(n, "<span class=\"note\" role=\"note\"", "<span class=\"note log-note\" role=\"note\""), "<span class=\"who\">note</span>", "")
  end
end

def desk_blog_lines(posts: List) -> String do
  join(map(desk_take_list(posts, HOME_POSTS, []), fn(p: Map) -> String do
    concat("<li class=\"log-row\"><a class=\"log-link\" href=\"/post/", p.slug, "\"><span class=\"log-title\">", escape_html(p.title), "</span><span class=\"log-date\">", p.date, "</span></a>", desk_post_note(p.slug), "</li>")
  end), "")
end

# The Finder's sections, as one line of links each. An item with nowhere
# to go is its name, not a link that goes nowhere.
def desk_finder_item(item: Map) -> String do
  title = case length(item.description) > 0 do
    true -> concat(" title=\"", escape_html(item.description), "\"")
    false -> ""
  end
  name = escape_html(item.name)
  case item.action do
    "toggle_phish" -> concat("<a href=\"", APPS_ORIGIN, "/phish\"", title, ">", name, "</a>")
    _ ->
      case length(item.path) > 0 do
        true -> concat("<a href=\"", escape_html(desk_app_href(item.path)), "\"", title, ">", name, "</a>")
        false -> concat("<span", title, ">", name, "</span>")
      end
  end
end

def desk_finder_sections(finder: List) -> String do
  join(map(finder, fn(s: Map) -> String do
    label = case length(s.label) > 0 do
      true -> s.label
      false -> s.name
    end
    join([
      "<div class=\"more-row\"><h3 class=\"plate-label\">", escape_html(label), "</h3><p>",
      join(map(s.items, fn(i: Map) -> String do desk_finder_item(i) end), "<span class=\"sep\"> / </span>"),
      "</p></div>"
    ], "")
  end), "")
end

def desk_tech_tags(tech: List) -> String do
  join(map(tech, fn(t: String) -> String do desk_tech_tag(t) end), "")
end

def desk_take_list(list: List, n: Int, acc: List) -> List do
  case n <= 0 do
    true -> reverse(acc)
    false ->
      case list do
        [] -> reverse(acc)
        [h | rest] -> desk_take_list(rest, n - 1, [h | acc])
      end
  end
end

# ── The museum ──────────────────────────────────────────────────────────

# An exhibit's page below its heading, built once per exhibit.
def desk_detail_inner(p: Map, icons: Map) -> String do
  repos = case p.repos do
    [] -> ""
    _ -> join([
      "<p class=\"ex-repos\"><span class=\"plate-label\">Source</span> ",
      join(map(p.repos, fn(r: Map) -> String do
        concat("<a href=\"https://github.com/", escape_html(r.full_name), "\" target=\"_blank\" class=\"ex-repo\">", escape_html(r.name), "</a>")
      end), " "),
      "</p>"
    ], "")
  end
  launch = case length(p.internal_path) > 0 do
    true -> concat("<a href=\"", escape_html(desk_app_href(p.internal_path)), "\" class=\"btn primary\">Launch &#x25B6;</a>")
    false -> ""
  end
  visit = case length(p.external_url) > 0 do
    true -> concat("<a href=\"", escape_html(p.external_url), "\" target=\"_blank\" class=\"btn\">Visit &#x2197;</a>")
    false -> ""
  end
  join([
    "<div class=\"ex-icon\">", desk_icon(icons, p.slug), "</div>",
    "<div class=\"ex-body\">",
    "<h3 class=\"ex-title\">", escape_html(p.title), "</h3>",
    "<p class=\"ex-tagline\">", escape_html(p.tagline), "</p>",
    "<p class=\"ex-desc\">", escape_html(trim(p.description)), "</p>",
    "<p class=\"ex-techs\">", desk_tech_tags(p.tech), "</p>",
    repos,
    "<p class=\"ex-actions\">", launch, visit, "</p>",
    "<p class=\"ex-meta\">", escape_html(p.category), " &middot; ", plural(length(p.tech), "technology", "technologies"), "</p>",
    "</div>"
  ], "")
end

# An exhibit in the list: its pixel icon (the one-path kind the manifest
# uses, not the detail's rect-a-pixel one), title and tagline. Built once.
def desk_ex_row(p: Map, own: Map) -> String do
  icon = lookup(own, p.slug)
  shown = case icon do
    nil -> lookup(own, "default")
    _ -> icon
  end
  concat("<span class=\"ex-ico\">", shown, "</span><span class=\"ex-name\">", escape_html(p.title), "</span><span class=\"ex-line\">", escape_html(p.tagline), "</span>")
end

# Per-request code loops by recursion, not map or filter: calling a lambda
# measured about 3KB of garbage a call, and a render makes a few hundred.
def desk_museum_rows(projects: List, st: Map, acc: List) -> List do
  case projects do
    [] -> reverse(acc)
    [p | rest] ->
      case st.cat == "" or st.cat == p.category do
        true ->
          class = case st.project == p.slug do
            true -> "ex on"
            false -> "ex"
          end
          row = concat("<li><a class=\"", class, "\" href=\"", desk_museum_href(put(st, "project", p.slug)), "\">", p.row_html, "</a></li>")
          desk_museum_rows(rest, st, [row | acc])
        false -> desk_museum_rows(rest, st, acc)
      end
  end
end

def desk_tabs(cats: List, st: Map, acc: List) -> List do
  case cats do
    [] -> reverse(acc)
    [c | rest] ->
      tab = concat("<a class=\"", desk_active(st.cat == c, "tab"), "\" href=\"", desk_museum_href(put(st, "cat", c)), "\">", desk_category_label(c), "</a>")
      desk_tabs(rest, st, [tab | acc])
  end
end

def desk_detail(st: Map, desk: Map) -> String do
  p = desk_find_project(desk.museum, st.project)
  case p do
    nil -> ""
    _ ->
      join([
        "<article class=\"ex-detail\" id=\"museum-detail\">",
        "<a class=\"ex-close\" href=\"", desk_museum_href(put(st, "project", "")), "\" aria-label=\"Close\">&#x2715;</a>",
        p.detail_html,
        "</article>"
      ], "")
  end
end

def desk_museum(st: Map, desk: Map) -> String do
  rows = desk_museum_rows(desk.museum, st, [])
  join([
    "<section class=\"card archive\" id=\"museum\" aria-labelledby=\"museum-h\">",
    desk_card_kicker("Older projects", 2, desk_card_total(desk)),
    "<header class=\"sec-head\">", desk_gloss_sec("sec-museum", "<h2 id=\"museum-h\">The museum</h2>"), "<span class=\"sec-count\">", plural(length(rows), "exhibit", "exhibits"), "</span></header>",
    "<p class=\"sec-note\">Older projects: hardware, maps, music, machine learning, social experiments. Pick one to read about it.</p>",
    "<nav class=\"tabs\" aria-label=\"Museum categories\">",
    "<a class=\"", desk_active(st.cat == "", "tab"), "\" href=\"", desk_museum_href(put(st, "cat", "")), "\">All</a>",
    join(desk_tabs(desk.categories, st, []), ""),
    "</nav>",
    desk_detail(st, desk),
    "<ul class=\"ex-list\">", join(rows, ""), "</ul>",
    "</section>"
  ], "")
end

# ── The page ────────────────────────────────────────────────────────────

# Blimp's canvas and the script that feeds it the server. With these in the
# body, page_layout adds no corner runtime window: the page is the window.
# home.js is linked by its content hash, like the stylesheets, because
# Cloudflare keeps /blimp/* too.
def desk_script_href(url: String, path: String) -> String do
  body = read_file(path)
  case body do
    nil -> desk_die(concat("cannot read ", path))
    _ -> concat(url, "?v=", take(sha256(body), 10))
  end
end

HOME_TAGS = concat("<script src=\"/blimp/canvas.js\"></script><script src=\"", desk_script_href("/blimp/home.js", "static/blimp/home.js"), "\"></script>")

# The share card: the scope, as a link preview. priv/static/images, served
# at /images/; ?v= because Cloudflare and every link unfurler cache it.
HOME_CARD = %{
  url: "https://bobbby.online/images/og-museum.png?v=1",
  alt: "Bobbby's Online Museum: the site's one Blimp process drawn live, its actors as hexagons and its messages as rays"
}

HOME_FONTS = "https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400..700&amp;display=swap"

def desk_rail(epoch_s: Int, st: Map) -> String do
  join([
    "<header class=\"rail\">",
    "<a class=\"mark\" href=\"/?booted=1\">", desk_blimp_svg(46), "<span class=\"mark-name\">bobbby<span>.online</span></span></a>",
    "<nav class=\"rail-nav\" aria-label=\"Site\">",
    "<a href=\"#work\">Things I made</a><a href=\"/blog\">Writing</a><a href=\"", desk_href(put(st, "leica", "1")), "\">Photographs</a><a href=\"#museum\">Museum</a><a href=\"/directory\">Directory</a>",
    "</nav>",
    "<p class=\"rail-clock\"><span>UTC</span> ", desk_clock(epoch_s), "</p>",
    "</header>"
  ], "")
end

# Who this is: the boot splash's own words, then what is on the page.
def desk_intro(st: Map) -> String do
  join([
    "<section class=\"intro\" aria-labelledby=\"intro-h\">",
    "<p class=\"plate-label\">Programmer &middot; photographer &middot; artist &middot; New York City</p>",
    "<h1 id=\"intro-h\" class=\"headline\">Hi, I&#8217;m Bobby. <em>I use things in ways they were not intended.</em></h1>",
    # divs, not paragraphs: a note is a <details>, and a parser closes an
    # open <p> at the first one
    "<div class=\"intro-text\">I am a ", desk_gloss_term("programmer", "programmer"), ", ", desk_gloss_term("photographer", "photographer"), ", and ", desk_gloss_term("artist", "artist"), " living in ", desk_gloss_term("nyc", "NYC"), ". I like to evoke new directions of vision by playing with the social fabric that wraps us around a computer.</div>",
    "<div class=\"intro-text\">This is where that work lives: ", desk_gloss_link("games-and-toys", "#work", "games and toys"), " you can play, live views of the internet, data and maps, ", desk_gloss_link("writing", "/blog", "writing"), ", ", desk_gloss_link("photographs", desk_href(put(st, "leica", "1")), "photographs"), ", and ", desk_gloss_link("older-projects", "#museum", "older projects"), ". Most of it wants you to join in; please be kind to whoever else is there.</div>",
    "<div class=\"intro-text\">All of it is written in ", desk_gloss_link("blimp", "https://blimp.bobbby.online/", "Blimp"), ", a language I made for it.</div>",
    "</section>"
  ], "")
end

# The site is a piece too: the language it runs in is one I wrote. The
# canvas draws that process; it is below the work now, not above it.
def desk_scope(live: String) -> String do
  join([
    "<section class=\"scope-col\" id=\"machine\" aria-labelledby=\"scope-h\">",
    "<header class=\"sec-head\">", desk_gloss_sec("sec-machine", "<h2 id=\"scope-h\">The machine under this page</h2>"), "<a class=\"sec-count\" href=\"/stack\">how it is built &#x2192;</a></header>",
    "<p class=\"sec-note\">I also wrote the language this site runs in, <a href=\"https://github.com/notactuallytreyanastasio/blimp\">Blimp</a>. The whole site is one Blimp process, and this is it, live. Your visit was one of the messages. <a href=\"/mirror\">Read its source</a>.</p>",
    "<figure class=\"scope\">",
    "<div class=\"scope-screen\" id=\"scope-wrap\"><canvas id=\"scope-canvas\" aria-label=\"The server's actors and the messages between them, live\"></canvas>",
    "<p class=\"scope-status\" id=\"scope-status\">Scripts are off, so the drawing is too. The gauges below are the server's own numbers, as of this request.</p></div>",
    "<figcaption>",
    "<span class=\"key\"><svg viewBox=\"0 0 20 20\" width=\"16\" height=\"16\" aria-hidden=\"true\"><path d=\"M10 1l8 4.5v9L10 19l-8-4.5v-9z\"/></svg> an actor inside the server</span>",
    "<span class=\"key\"><svg viewBox=\"0 0 24 8\" width=\"24\" height=\"8\" aria-hidden=\"true\"><path d=\"M1 4h20M17 1l4 3-4 3\"/></svg> a message between two</span>",
    "</figcaption>",
    "</figure>",
    live,
    desk_meter(),
    "</section>"
  ], "")
end

# The server's CPU and memory over the last two minutes, drawn by home.js
# from the samples /live/runtime carries (src/88_meter.blimp). One time
# axis, both lines on it: CPU against its percent scale, memory as the
# shape it has made over the window, with its value in the legend.
def desk_meter() -> String do
  join([
    "<figure class=\"meter\" id=\"meter\">",
    "<figcaption class=\"meter-head\"><span class=\"plate-label\">CPU and memory, the last two minutes</span>",
    "<span class=\"meter-legend\">",
    "<span class=\"mk mk-cpu\"><i></i>CPU <b id=\"meter-cpu\">&#8212;</b></span>",
    "<span class=\"mk mk-mem\"><i></i>memory <b id=\"meter-mem\">&#8212;</b></span>",
    "</span></figcaption>",
    "<div class=\"meter-plot\" id=\"meter-wrap\"><canvas id=\"meter-canvas\" role=\"img\" aria-label=\"The server's CPU use and memory over the last two minutes\"></canvas>",
    "<p class=\"meter-tip\" id=\"meter-tip\" hidden></p>",
    "<p class=\"meter-off\" id=\"meter-off\">Scripts are off, so there is no graph. The server samples itself once a second and sends it to this page over the same socket as the drawing above.</p></div>",
    "<p class=\"meter-note\">CPU is a share of one core: the server is a single thread, so 100% is all it can use. Memory is resident memory; its line shows how it rose and fell against the most it reached in the window, and the jumps down are the heap being compacted.</p>",
    "</figure>"
  ], "")
end

# ── The cards: the right-hand column ────────────────────────────────────
#
# Writing, the museum, the four groups of things to use, photographs and
# everything else, in that order, one card each. On a wide screen the page
# scrolls through them with scroll-snap (desktop.css) while the intro and
# the scope stay put on the left; on a phone they follow the scope. Each
# says where it is in the run, so the position needs no script.

def desk_card_total(desk: Map) -> Int do
  length(desk.hangar_groups) + 4
end

def desk_card_kicker(label: String, n: Int, total: Int) -> String do
  concat("<p class=\"plate-label card-kicker\">", label, " <span>", desk_pad(n, 2), " / ", desk_pad(total, 2), "</span></p>")
end

def desk_log(desk: Map) -> String do
  join([
    "<section class=\"card log\" id=\"writing\" aria-labelledby=\"log-h\">",
    desk_card_kicker("The newest posts", 1, desk_card_total(desk)),
    "<header class=\"sec-head\">", desk_gloss_sec("sec-writing", "<h2 id=\"log-h\">Writing</h2>"), "<a class=\"sec-count\" href=\"/blog\">all ", to_string(desk.post_count), " posts &#x2192;</a></header>",
    "<ol class=\"log-list\">", desk.blog_html, "</ol>",
    journal_desk_line(),
    "</section>"
  ], "")
end

# The first group's card is #work, the anchor "Things I made" has always
# gone to.
def desk_hangar_cards(groups: List, n: Int, total: Int, acc: List) -> List do
  case groups do
    [] -> reverse(acc)
    [g | rest] ->
      id = case n == 3 do
        true -> "work"
        false -> concat("work-", g.group)
      end
      card = join([
        "<section class=\"card manifest\" id=\"", id, "\" aria-labelledby=\"", id, "-h\">",
        desk_card_kicker("Things I made that you can use", n, total),
        "<header class=\"sec-head\">", desk_gloss_sec(concat("sec-", g.group), concat("<h2 id=\"", id, "-h\">", escape_html(g.label), "</h2>")), "<span class=\"sec-count\">", desk_pad(g.count, 2), "</span></header>",
        "<ul class=\"mf-list\">", g.tiles, "</ul>",
        "</section>"
      ], "")
      desk_hangar_cards(rest, n + 1, total, [card | acc])
  end
end

def desk_photos(st: Map, desk: Map) -> String do
  total = desk_card_total(desk)
  join([
    "<section class=\"card photos\" id=\"photographs\" aria-labelledby=\"photos-h\">",
    desk_card_kicker("From the Leica", total - 1, total),
    "<header class=\"sec-head\">", desk_gloss_sec("sec-photos", "<h2 id=\"photos-h\">Photographs</h2>"), "<span class=\"sec-count\">110 MB</span></header>",
    "<p class=\"sec-note\">My favourite shots from the Leica, in one very large image. It is 110 megabytes, so the link asks before it loads.</p>",
    "<p class=\"ex-actions\"><a class=\"btn primary\" href=\"", desk_href(put(st, "leica", "1")), "\">See the photographs &#x25B6;</a><a class=\"btn\" href=\"/gallery\">The gallery</a></p>",
    "</section>"
  ], "")
end

def desk_more(st: Map, desk: Map) -> String do
  total = desk_card_total(desk)
  join([
    "<section class=\"card more\" id=\"more\" aria-labelledby=\"more-h\">",
    desk_card_kicker("The old desktop&#8217;s Finder", total, total),
    "<header class=\"sec-head\">", desk_gloss_sec("sec-more", "<h2 id=\"more-h\">Everything else</h2>"), "<span class=\"sec-count\">", to_string(desk.item_count), " items</span></header>",
    "<div class=\"more-rows\">", desk.finder_html, "</div>",
    desk_foot(st),
    "</section>"
  ], "")
end

def desk_foot(st: Map) -> String do
  join([
    "<footer class=\"foot\">",
    "<p><strong>Phoenix</strong> served this site until September 2026. It has been retired, not scrapped: it still takes visitors at <a href=\"https://old.bobbby.online\">old.bobbby.online</a>.</p>",
    "<p class=\"foot-links\"><a href=\"/very_direct_message\">Print on my desk</a><a href=\"", desk_href(put(st, "leica", "1")), "\">My favourite Leica shots (110 MB)</a><a href=\"https://github.com/notactuallytreyanastasio/blimp\">Blimp on GitHub</a><a href=\"/\">Replay the boot screen</a></p>",
    "</footer>"
  ], "")
end

def desktop_page(query: String, desk: Map, epoch_s: Int) -> String do
  counts = case query do
    "" -> DESK_LIVE_MARK
    _ -> desk_live_now(epoch_s)
  end
  desktop_page_with(query, desk, epoch_s, counts, query == "")
end

# The page with these counters. prebuilt: it is the bare homepage built at
# boot, whose counters are put back per request (main.blimp's bare_home).
def desktop_page_with(query: String, desk: Map, epoch_s: Int, counts: String, prebuilt: Bool) -> String do
  t0 = now_ms()
  st = desk_state(query, desk)
  splash = case query do
    "" -> desk_boot_splash()
    _ -> ""
  end
  warning = case st.leica do
    "" -> ""
    _ -> desk_leica_dialog(desk_href(put(st, "leica", "")))
  end
  museum = desk_museum(st, desk)
  more = desk_more(st, desk)
  render = case prebuilt do
    true -> "prebuilt at boot"
    false -> concat(to_string(now_ms() - t0), " ms")
  end
  total = desk_card_total(desk)
  body = join([
    desk.art_html,
    "<div class=\"home\">",
    "<div class=\"pane\">",
    desk_rail(epoch_s, st),
    desk_intro(st),
    desk_scope(desk_live_html(counts, render)),
    "</div>",
    "<main class=\"cards\">",
    desk_log(desk),
    museum,
    join(desk_hangar_cards(desk.hangar_groups, 3, total, []), ""),
    desk_photos(st, desk),
    more,
    "</main>",
    "</div>",
    warning,
    splash,
    HOME_TAGS
  ], "")
  page_layout_full(SITE_NAME, site_description(), "website", [HOME_FONTS, "/assets/desktop.css"], body, "", HOME_CARD)
end
