# The homepage: TerminalLive's classic Mac OS desktop, with no JavaScript.
#
# Every phx-click that changed what was on screen is a link now, and the
# state it changed lives in the query string:
#
#   cat=<category>   museum filter tab (absent: All)
#   project=<slug>   the museum detail window
#   finder=1         the Finder window ("Apps & Games")
#   museum=0         the museum list closed
#   leica=1          the Leica large-file warning
#   m=<window>       the window the mobile taskbar brought forward
#
# Every link carries the rest of the state along. A value is echoed back
# into a link only after it has been checked against the data, so nothing a
# visitor types into the URL reaches the page.
#
# The boot splash shows only for a bare "/". Any query string at all, even
# the /?booted=1 that clicking the splash leads to, means the visitor is
# already on the desktop.
#
# What needed a socket or a script is not here: the AIM chat and its name
# dialog, presence counts, the Phish window, the work log, the photo
# window, the Leica zoom viewer, the Joyride tour, tooltips and dragging.
#
# What is a function of strings and numbers alone (the clock, the links,
# the fixed HTML of the chrome) is Temper, in
# temper/src/desktop. What reads or builds a record stays here.

APPS_ORIGIN = "https://bobbby.online"

# ── Loading the snapshots in data/ ──────────────────────────────────────

def desk_lines(text: String) -> List do
  filter(split(text, "\n"), fn(l: String) -> Bool do length(l) > 0 end)
end

def desk_field(fields: List, i: Int) -> String do
  elem_at(fields, i)
end

def desk_die(message: String) -> Any do
  print(message)
  exit(1)
end

def desk_read(path: String) -> String do
  text = read_file(path)
  case text do
    nil -> desk_die(concat("cannot read ", path))
    _ -> text
  end
end

def desk_repos_for(repo_rows: List, slug: String) -> List do
  map(filter(repo_rows, fn(r: List) -> Bool do head(r) == slug end), fn(r: List) -> Map do
    %{name: desk_field(r, 1), full_name: desk_field(r, 2)}
  end)
end

def desk_load_museum(tsv: String, repos_tsv: String) -> List do
  repo_rows = map(desk_lines(repos_tsv), fn(l: String) -> List do split(l, "\t") end)
  map(desk_lines(tsv), fn(l: String) -> Map do
    f = split(l, "\t")
    case length(f) == 12 and desk_url_safe(desk_field(f, 0)) and desk_url_safe(desk_field(f, 4)) do
      false -> desk_die(concat("data/museum.tsv: expected 12 fields, and a slug and category that need no URL escaping, in ", l))
      true ->
        %{
          slug: desk_field(f, 0),
          title: desk_field(f, 1),
          tagline: desk_field(f, 2),
          description: desk_unescape(desk_field(f, 3)),
          category: desk_field(f, 4),
          tech: desk_split_tech(desk_field(f, 5)),
          internal_path: desk_field(f, 6),
          external_url: desk_field(f, 7),
          repos: desk_repos_for(repo_rows, desk_field(f, 0))
        }
    end
  end)
end

def desk_member(list: List, x: String) -> Bool do
  case list do
    [] -> false
    [h | rest] ->
      case h == x do
        true -> true
        false -> desk_member(rest, x)
      end
  end
end

def desk_uniq(list: List, acc: List) -> List do
  case list do
    [] -> reverse(acc)
    [h | rest] ->
      case desk_member(acc, h) do
        true -> desk_uniq(rest, acc)
        false -> desk_uniq(rest, [h | acc])
      end
  end
end

# Blog.Museum.Projects.categories/0: distinct, ascending.
def desk_categories(projects: List) -> List do
  sort(desk_uniq(map(projects, fn(p: Map) -> String do p.category end), []))
end

# The only finder action the page can honour without a socket is the Phish
# window, and it does that by linking to the Phish app. Any other action is
# a boot failure, not an icon that silently does nothing.
def desk_check_action(action: String, name: String) -> String do
  case action do
    "" -> action
    "toggle_phish" -> action
    _ -> desk_die(concat("data/finder_items.tsv: no script-free way to do action ", action, " for ", name))
  end
end

def desk_load_finder(sections_tsv: String, items_tsv: String) -> List do
  items = map(desk_lines(items_tsv), fn(l: String) -> Map do
    f = split(l, "\t")
    case length(f) == 6 do
      false -> desk_die(concat("data/finder_items.tsv: expected 6 fields in ", l))
      true ->
        %{
          section: desk_field(f, 0),
          name: desk_field(f, 1),
          icon: desk_field(f, 2),
          path: desk_field(f, 3),
          action: desk_check_action(desk_field(f, 4), desk_field(f, 1)),
          description: desk_field(f, 5)
        }
    end
  end)
  map(desk_lines(sections_tsv), fn(l: String) -> Map do
    f = split(l, "\t")
    name = desk_field(f, 0)
    %{
      name: name,
      label: desk_field(f, 1),
      items: filter(items, fn(i: Map) -> Bool do i.section == name end)
    }
  end)
end

# ── Pixel icons: Blog.Museum.Icons.pixels/1 ─────────────────────────────

# The pixel icons stay Blimp. In Temper they were the same loop, but a
# character step there is u8_decode_at, temper_string_next and temper_int32,
# three calls into temper-core where this makes one builtin char_at: loading
# the 33 icons went from 138 ms to 638 ms.
def desk_row_rects(row: String, x: Int, y: String, acc: List) -> List do
  case x >= length(row) do
    true -> acc
    false ->
      case char_at(row, x) == "#" do
        true -> desk_row_rects(row, x + 1, y, [concat("<rect x=\"", to_string(x), "\" y=\"", y, "\" width=\"1\" height=\"1\"/>") | acc])
        false -> desk_row_rects(row, x + 1, y, acc)
      end
  end
end

def desk_grid_rects(rows: List, y: Int, acc: List) -> List do
  case rows do
    [] -> reverse(acc)
    [row | rest] -> desk_grid_rects(rest, y + 1, desk_row_rects(row, 0, to_string(y), acc))
  end
end

# The same bytes pixels/1 produces, heredoc newlines included.
def desk_pixels(rows: List) -> String do
  join([
    "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 20\" shape-rendering=\"crispEdges\">\n",
    "<g fill=\"#000\">\n",
    join(desk_grid_rects(rows, 0, []), "\n"),
    "\n</g>\n</svg>\n"
  ], "")
end

def desk_icon_entries(lines: List, slug: String, rows: List, acc: Map) -> Map do
  case lines do
    [] ->
      case slug do
        "" -> acc
        _ -> put(acc, slug, desk_pixels(reverse(rows)))
      end
    [l | rest] ->
      case starts_with(l, "== ") do
        true ->
          done = case slug do
            "" -> acc
            _ -> put(acc, slug, desk_pixels(reverse(rows)))
          end
          desk_icon_entries(rest, drop(l, 3), [], done)
        false -> desk_icon_entries(rest, slug, [l | rows], acc)
      end
  end
end

def desk_load_icons(text: String) -> Map do
  icons = desk_icon_entries(desk_lines(text), "", [], %{})
  case lookup(icons, "default") do
    nil -> desk_die("data/icons.txt has no default icon")
    _ -> icons
  end
end

# Blog.Museum.Icons.get/1
def desk_icon(icons: Map, slug: String) -> String do
  icon = lookup(icons, slug)
  case icon do
    nil -> lookup(icons, "default")
    _ -> icon
  end
end

# Everything the page needs that does not change per request, including
# the HTML of every part that does not depend on the query string. A render
# measured 2.5MB of garbage before this, most of it escape_html and the
# nested joins around 32 pixel icons; a worker frees nothing until it exits.
#
# The museum and the Finder come from Postgres in production
# (load_desktop_db) and from the data/*.tsv snapshot in tests and offline
# (load_desktop); the pixel icons are always icons.txt, which is taken from
# the Phoenix source, not the database.
def load_desktop(dir: String, posts: List) -> Map do
  loaded = desk_load_museum(desk_read(concat(dir, "/museum.tsv")), desk_read(concat(dir, "/museum_repos.tsv")))
  finder = desk_load_finder(desk_read(concat(dir, "/finder_sections.tsv")), desk_read(concat(dir, "/finder_items.tsv")))
  build_desktop(loaded, finder, desk_load_icons(desk_read(concat(dir, "/icons.txt"))), posts)
end

def build_desktop(loaded: List, finder: List, icons: Map, posts: List) -> Map do
  icon_text = concat(desk_read("data/hangar_icons.txt"), "\n", desk_read("data/icons.txt"))
  own = desk_path_entries(desk_lines(icon_text), "", [], %{})
  hangar = desk_load_hangar(desk_read("data/hangar.tsv"), own, %{})
  museum = map(loaded, fn(p: Map) -> Map do
    put(put(p, "item_html", desk_item_inner(p, icons)), "detail_html", desk_detail_inner(p, icons))
  end)
  %{
    museum: museum,
    categories: desk_categories(museum),
    finder_html: desk_finder_sections(finder),
    item_count: reduce(finder, 0, fn(n: Int, s: Map) -> Int do n + length(s.items) end),
    icons: icons,
    blog_rows: join(map(posts, fn(p: Map) -> String do blog_post_row(p) end), ""),
    post_count: length(posts),
    hangar_html: desk_hangar_html(hangar),
    hangar_count: length(hangar),
    stack_icon: lookup(own, "hg-stack"),
    mirror_icon: lookup(own, "code-mirror")
  }
end

# ── The Hangar: the pages that run on Blimp ─────────────────────────────
#
# data/hangar.tsv: group, path, name, icon, pitch. The icon is one of
# data/hangar_icons.txt's (drawn for this window) or of icons.txt's (the
# museum's). A path that is not a plain site path, or an icon neither file
# has, stops the boot: a tile with the default icon, or a link that goes
# nowhere, would look fine and be wrong.

# The Hangar's icons as one path each, a run of pixels to a subpath: the
# museum's rect-a-pixel SVG (pixels/1's bytes, kept for the museum) made
# thirty icons 200KB of the page; this makes them about 30KB.
def desk_runs(row: String, x: Int, y: String, acc: List) -> List do
  case x >= length(row) do
    true -> acc
    false ->
      case char_at(row, x) == "#" do
        false -> desk_runs(row, x + 1, y, acc)
        true ->
          n = desk_run_len(row, x, 0)
          w = to_string(n)
          desk_runs(row, x + n, y, [concat("M", to_string(x), " ", y, "h", w, "v1h-", w, "z") | acc])
      end
  end
end

def desk_run_len(row: String, x: Int, n: Int) -> Int do
  case x + n < length(row) and char_at(row, x + n) == "#" do
    true -> desk_run_len(row, x, n + 1)
    false -> n
  end
end

def desk_path_rows(rows: List, y: Int, acc: List) -> List do
  case rows do
    [] -> reverse(acc)
    [row | rest] -> desk_path_rows(rest, y + 1, desk_runs(row, 0, to_string(y), acc))
  end
end

def desk_path_icon(rows: List) -> String do
  concat("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 20\" shape-rendering=\"crispEdges\"><path d=\"", join(desk_path_rows(rows, 0, []), ""), "\"/></svg>")
end

def desk_path_done(slug: String, rows: List, acc: Map) -> Map do
  case slug do
    "" -> acc
    _ -> put(acc, slug, desk_path_icon(reverse(rows)))
  end
end

def desk_path_entries(lines: List, slug: String, rows: List, acc: Map) -> Map do
  case lines do
    [] -> desk_path_done(slug, rows, acc)
    [l | rest] ->
      case starts_with(l, "== ") do
        true -> desk_path_entries(rest, drop(l, 3), [], desk_path_done(slug, rows, acc))
        false -> desk_path_entries(rest, slug, [l | rows], acc)
      end
  end
end

def desk_load_hangar(tsv: String, own: Map, museum_icons: Map) -> List do
  map(desk_lines(tsv), fn(l: String) -> Map do
    f = split(l, "\t")
    case length(f) == 5 and starts_with(desk_field(f, 1), "/") and desk_url_safe(drop(desk_field(f, 1), 1)) do
      false -> desk_die(concat("data/hangar.tsv: expected 5 fields and a plain /path in ", l))
      true ->
        slug = desk_field(f, 3)
        mine = lookup(own, slug)
        icon = case mine do
          nil -> lookup(museum_icons, slug)
          _ -> mine
        end
        case icon do
          nil -> desk_die(concat("data/hangar.tsv: no icon ", slug, " in data/hangar_icons.txt or data/icons.txt"))
          _ -> %{group: desk_field(f, 0), path: desk_field(f, 1), name: desk_field(f, 2), icon: icon, pitch: desk_field(f, 4)}
        end
    end
  end)
end

def desk_hangar_html(pages: List) -> String do
  groups = desk_uniq(map(pages, fn(p: Map) -> String do p.group end), [])
  join(map(groups, fn(g: String) -> String do
    mine = filter(pages, fn(p: Map) -> Bool do p.group == g end)
    tiles = join(map(mine, fn(p: Map) -> String do desk_hangar_tile(p.path, p.icon, p.name, p.pitch) end), "")
    desk_hangar_group(desk_hangar_label(g), length(mine), tiles)
  end), "")
end

# The Blimp commit the server binary was built from: deploy.sh writes it to
# bin/BLIMP_COMMIT, which the image puts at /app/BLIMP_COMMIT, one up from
# the site. A laptop has none, and says "local build".
def desk_hex(s: String, i: Int) -> Bool do
  case i >= length(s) do
    true -> true
    false ->
      case contains("0123456789abcdef", char_at(s, i)) do
        true -> desk_hex(s, i + 1)
        false -> false
      end
  end
end

def desk_commit_of(text: Any) -> String do
  case text do
    nil -> ""
    _ ->
      sha = trim(text)
      case length(sha) == 40 and desk_hex(sha, 0) do
        true -> sha
        false -> ""
      end
  end
end

DESK_BLIMP_COMMIT = desk_commit_of(read_file("../BLIMP_COMMIT"))

# What the server is doing now, from the runtime's own snapshot: how many
# actors, and the Site actor's served count and boot time. A snapshot keeps
# numbers and summarises everything else, so this reads no page data.
def desk_site_state(actors: List) -> Map do
  case actors do
    [] -> %{}
    [a | rest] ->
      case a.type == "Site" do
        true -> lookup(a, "state")
        false -> desk_site_state(rest)
      end
  end
end

def desk_int(v: Any) -> Int do
  case type_of(v) do
    :integer -> v
    _ -> 0
  end
end

def desk_live_now(epoch_s: Int) -> String do
  snap = runtime_snapshot()
  site = desk_site_state(snap.actors)
  booted = desk_int(lookup(site, "booted_at"))
  up = case booted > 0 and epoch_s >= booted do
    true -> epoch_s - booted
    false -> 0
  end
  desk_live_counts(length(snap.actors), desk_int(lookup(site, "served")), up)
end

# The counters the prebuilt homepage is cut at, like the clock.
DESK_LIVE_MARK = desk_live_counts(0, 0, 0)

def desk_live_html(counts: String, render: String) -> String do
  short = case DESK_BLIMP_COMMIT do
    "" -> ""
    _ -> take(DESK_BLIMP_COMMIT, 7)
  end
  desk_live_strip(counts, DESK_BLIMP_COMMIT, short, render)
end

# ── Loading the museum and the Finder from Postgres ─────────────────────
#
# The same rows data/export.sh snapshots, as the same maps the snapshot
# loader makes, so build_desktop cannot tell them apart.
# {:ok, museum, finder, db} or {:error, reason, db}. A row the page could
# not show honestly (a slug that needs URL escaping, a Finder action with
# no script-free equivalent) is an error for the whole load, never a
# skipped row: the caller keeps the desktop it has and says why.

DESK_MUSEUM_SQL = "select slug, title, coalesce(tagline, '') as tagline, coalesce(description, '') as description, category, coalesce(array_to_string(tech_stack, ','), '') as tech, coalesce(internal_path, '') as internal_path, coalesce(external_url, '') as external_url from museum_projects where visible order by sort_order, id"
DESK_REPOS_SQL = "select p.slug, coalesce(r.repo->>'name', '') as name, coalesce(r.repo->>'full_name', '') as full_name from museum_projects p, unnest(p.github_repos) with ordinality as r(repo, n) where p.visible order by p.sort_order, p.id, r.n"
DESK_SECTIONS_SQL = "select name, coalesce(label, '') as label from finder_sections where visible order by sort_order, id"
DESK_ITEMS_SQL = "select s.name as section, i.name, coalesce(i.icon, '') as icon, coalesce(i.path, '') as path, coalesce(i.action, '') as action, coalesce(i.description, '') as description from finder_items i join finder_sections s on s.id = i.section_id where s.visible and i.visible order by s.sort_order, s.id, i.sort_order, i.id"

def desk_db_rows(db: Map, sqls: List, acc: List) -> Tuple do
  case sqls do
    [] -> {:ok, reverse(acc), db}
    [sql | rest] ->
      case pg_query(db, sql, []) do
        {:ok, rows, next} -> desk_db_rows(next, rest, [rows | acc])
        {:error, reason, next} -> {:error, reason, next}
      end
  end
end

def load_desk_db(db: Map) -> Tuple do
  case desk_db_rows(db, [DESK_MUSEUM_SQL, DESK_REPOS_SQL, DESK_SECTIONS_SQL, DESK_ITEMS_SQL], []) do
    {:error, reason, next} -> {:error, reason, next}
    {:ok, sets, next} ->
      projects = elem_at(sets, 0)
      repos = elem_at(sets, 1)
      items = elem_at(sets, 3)
      bad_project = filter(projects, fn(p: Map) -> Bool do not(desk_url_safe(p.slug) and desk_url_safe(p.category)) end)
      bad_item = filter(items, fn(i: Map) -> Bool do not(i.action == "" or i.action == "toggle_phish") end)
      case {bad_project, bad_item} do
        {[], []} ->
          museum = map(projects, fn(p: Map) -> Map do
            %{
              slug: p.slug,
              title: p.title,
              tagline: p.tagline,
              description: p.description,
              category: p.category,
              tech: desk_split_tech(p.tech),
              internal_path: p.internal_path,
              external_url: p.external_url,
              repos: map(filter(repos, fn(r: Map) -> Bool do r.slug == p.slug end), fn(r: Map) -> Map do
                %{name: r.name, full_name: r.full_name}
              end)
            }
          end)
          finder = map(elem_at(sets, 2), fn(s: Map) -> Map do
            %{name: s.name, label: s.label, items: filter(items, fn(i: Map) -> Bool do i.section == s.name end)}
          end)
          {:ok, museum, finder, next}
        {[p | _], _} -> {:error, concat("museum project ", p.slug, " has a slug or category (", p.category, ") that would need URL escaping"), next}
        {_, [i | _]} -> {:error, concat("finder item ", i.name, " has action ", i.action, ", which has no script-free equivalent"), next}
      end
  end
end

# ── State ───────────────────────────────────────────────────────────────

def desk_find_project(projects: List, slug: String) -> Any do
  case projects do
    [] -> nil
    [p | rest] ->
      case p.slug == slug do
        true -> p
        false -> desk_find_project(rest, slug)
      end
  end
end

# query_param/2 from 40_http, once over pre-split pairs and without a lambda.
def desk_qp(pairs: List, prefix: String) -> String do
  case pairs do
    [] -> ""
    [p | rest] ->
      case starts_with(p, prefix) do
        true -> url_decode(drop(p, length(prefix)))
        false -> desk_qp(rest, prefix)
      end
  end
end

def desk_flag(pairs: List, key: String, want: String) -> String do
  case desk_qp(pairs, concat(key, "=")) == want do
    true -> want
    false -> ""
  end
end

# The query string, reduced to values the data vouches for.
def desk_state(query: String, desk: Map) -> Map do
  pairs = split(query, "&")
  cat = desk_qp(pairs, "cat=")
  slug = desk_qp(pairs, "project=")
  m = desk_qp(pairs, "m=")
  known_cat = case desk_member(desk.categories, cat) do
    true -> cat
    false -> ""
  end
  known_slug = case desk_find_project(desk.museum, slug) do
    nil -> ""
    _ -> slug
  end
  known_m = case m == "finder" or m == "museum" or m == "blog" or m == "hangar" do
    true -> m
    false -> ""
  end
  %{
    cat: known_cat,
    project: known_slug,
    finder: desk_flag(pairs, "finder", "1"),
    museum: desk_flag(pairs, "museum", "0"),
    leica: desk_flag(pairs, "leica", "1"),
    m: known_m
  }
end

def desk_show_finder(st: Map) -> Bool do
  st.finder == "1" or st.m == "finder"
end

def desk_show_museum(st: Map) -> Bool do
  st.museum != "0" or st.m == "museum"
end

# On a phone the windows stack, and the one the taskbar chose goes first;
# with none chosen, the Hangar leads.
def desk_mobile(st: Map) -> String do
  case st.m do
    "" -> "hangar"
    m -> m
  end
end

# The link to a state, already escaped for an href: every value in the
# state is a known slug, category or flag. A link to the empty state says
# booted=1, so that closing the last window does not replay the splash.
def desk_href(st: Map) -> String do
  desk_href_of(st.cat, st.project, st.finder, st.museum, st.leica, st.m)
end

def desk_close_finder(st: Map) -> Map do
  m = case st.m == "finder" do
    true -> ""
    false -> st.m
  end
  put(put(st, "finder", ""), "m", m)
end

def desk_toggle_finder(st: Map) -> Map do
  case desk_show_finder(st) do
    true -> desk_close_finder(st)
    false -> put(st, "finder", "1")
  end
end

def desk_toggle_museum(st: Map) -> Map do
  case desk_show_museum(st) do
    true ->
      m = case st.m == "museum" do
        true -> ""
        false -> st.m
      end
      put(put(st, "museum", "0"), "m", m)
    false -> put(st, "museum", "")
  end
end

def desk_category_label(cat: String) -> String do
  case cat do
    "hardware" -> "Hardware"
    "maps" -> "Maps"
    "ml" -> "ML &amp; AI"
    "music" -> "Music"
    "social" -> "Social"
    "tools" -> "Tools"
    "writing" -> "Writing"
    _ -> escape_html(capitalize(downcase(cat)))
  end
end

# ── Windows ─────────────────────────────────────────────────────────────

def desk_finder_item(item: Map) -> String do
  title = case length(item.description) > 0 do
    true -> concat(" title=\"", escape_html(item.description), "\"")
    false -> ""
  end
  inner = concat(
    "<div class=\"icon-image\">", escape_html(item.icon), "</div>",
    "<div class=\"icon-label\">", escape_html(item.name), "</div>"
  )
  case item.action do
    "toggle_phish" -> concat("<a class=\"icon\" href=\"", APPS_ORIGIN, "/phish\"", title, ">", inner, "</a>")
    _ ->
      case length(item.path) > 0 do
        true -> concat("<a class=\"icon\" href=\"", escape_html(desk_app_href(item.path)), "\"", title, ">", inner, "</a>")
        false -> concat("<div class=\"icon\" tabindex=\"0\"", title, ">", inner, "</div>")
      end
  end
end

def desk_finder_sections(finder: List) -> String do
  join(map(finder, fn(s: Map) -> String do
    label = case length(s.label) > 0 do
      true -> s.label
      false -> s.name
    end
    join([
      "<div class=\"icon-section\">",
      "<div class=\"section-label\">", escape_html(label), "</div>",
      "<div class=\"section-items\">",
      join(map(s.items, fn(i: Map) -> String do desk_finder_item(i) end), ""),
      "</div></div>"
    ], "")
  end), "")
end

def desk_finder_window(st: Map, desk: Map) -> String do
  mobile = case desk_mobile(st) == "finder" do
    true -> " mobile-active"
    false -> ""
  end
  museum_label = case desk_show_museum(st) do
    true -> "icon-label selected-label"
    false -> "icon-label"
  end
  join([
    "<div class=\"window mobile-window-finder", mobile, "\" id=\"finder-window\">",
    desk_title_bar(desk_href(desk_close_finder(st)), "bobbby.online"),
    "<div class=\"window-content\"><div class=\"icon-grid\">",
    desk.finder_html,
    "<div class=\"icon-section\">",
    "<div class=\"section-label\">Other Work &amp; Frivolity</div>",
    "<div class=\"section-items\">",
    "<a class=\"icon\" href=\"", desk_href(desk_toggle_museum(st)), "\" id=\"icon-museum-toggle\">",
    "<div class=\"icon-image\">", desk_projects_icon(), "</div>",
    "<div class=\"", museum_label, "\">Projects</div>",
    "</a></div></div>",
    "</div></div>",
    "<div class=\"status-bar\"><span>", to_string(desk.item_count), " items</span></div>",
    "</div>"
  ], "")
end

def desk_tech_tags(tech: List) -> String do
  join(map(tech, fn(t: String) -> String do desk_tech_tag(t) end), "")
end

def desk_take_list(list: List, n: Int, acc: List) -> List do
  case n <= 0 do
    true -> reverse(acc)
    false ->
      case list do
        [] -> reverse(acc)
        [h | rest] -> desk_take_list(rest, n - 1, [h | acc])
      end
  end
end

# Everything inside a museum list row but the row's own <a>.
def desk_item_inner(p: Map, icons: Map) -> String do
  join([
    "<div class=\"museum-list-icon\">", desk_icon(icons, p.slug), "</div>",
    "<div class=\"museum-list-info\">",
    "<div class=\"museum-list-name\">", escape_html(p.title), "</div>",
    "<div class=\"museum-list-tagline\">", escape_html(p.tagline), "</div>",
    "<div class=\"museum-list-tags\">", desk_tech_tags(desk_take_list(p.tech, 3, [])), "</div>",
    "</div></a>"
  ], "")
end

# A row's opening tag; the prebuilt item_html follows it as its own piece.
def desk_museum_item(p: Map, st: Map) -> String do
  class = case st.project == p.slug do
    true -> "museum-list-item selected"
    false -> "museum-list-item"
  end
  concat("<a class=\"", class, "\" href=\"", desk_href(put(st, "project", p.slug)), "\">")
end

# Per-request code loops by recursion, not map or filter: calling a lambda
# measured about 3KB of garbage a call, and a render makes a few hundred.
#
# Blog.Museum.Projects.by_category/1 when a tab is chosen, all/0 when not.
def desk_museum_rows(projects: List, st: Map, acc: List) -> List do
  case projects do
    [] -> reverse(acc)
    [p | rest] ->
      case st.cat == "" or st.cat == p.category do
        true -> desk_museum_rows(rest, st, [p.item_html, desk_museum_item(p, st) | acc])
        false -> desk_museum_rows(rest, st, acc)
      end
  end
end

def desk_tabs(cats: List, st: Map, acc: List) -> List do
  case cats do
    [] -> reverse(acc)
    [c | rest] ->
      tab = concat("<a class=\"", desk_active(st.cat == c, "museum-filter-tag"), "\" href=\"", desk_href(put(st, "cat", c)), "\">", desk_category_label(c), "</a>")
      desk_tabs(rest, st, [tab | acc])
  end
end

# A list of pieces, not a string: the rows hold 32 pixel icons, about
# 190KB, and joining them here would copy them once more per request.
def desk_museum_window(st: Map, desk: Map) -> List do
  mobile = case desk_mobile(st) == "museum" do
    true -> " mobile-active"
    false -> ""
  end
  rows = desk_museum_rows(desk.museum, st, [])
  tabs = join(desk_tabs(desk.categories, st, []), "")
  finder_on = desk_show_finder(st)
  finder_href = desk_href(desk_toggle_finder(st))
  status_style = case finder_on do
    true -> "cursor: pointer; background: #000; color: #fff; padding: 0 6px;"
    false -> "cursor: pointer; text-decoration: underline; padding: 0 6px;"
  end
  flat([
    "<div class=\"museum-list-window mobile-window-museum", mobile, "\" id=\"museum-list-window\">",
    desk_title_bar(desk_href(desk_toggle_museum(st)), "Technical Museum"),
    "<div class=\"museum-filter-row\">",
    "<a class=\"", desk_active(st.cat == "", "museum-filter-tag"), "\" href=\"", desk_href(put(st, "cat", "")), "\">All</a>",
    tabs,
    "<span style=\"flex: 1;\"></span>",
    "<a class=\"", desk_active(finder_on, "museum-filter-tag"), "\" href=\"", finder_href, "\" style=\"border: 1px solid #999;\">Apps &amp; Games</a>",
    "</div>",
    "<div class=\"museum-list-content\">",
    rows,
    "</div>",
    "<div class=\"status-bar\">",
    "<span>", to_string(length(rows) / 2), " exhibits</span>",
    "<a href=\"", finder_href, "\" style=\"", status_style, "\">Apps &amp; Games</a>",
    "</div>",
    "</div>"
  ])
end

# The detail window below its title bar.
def desk_detail_inner(p: Map, icons: Map) -> String do
  repos = case p.repos do
    [] -> ""
    _ -> join([
      "<div class=\"museum-detail-repos\"><strong>Source:</strong>",
      join(map(p.repos, fn(r: Map) -> String do
        concat("<a href=\"https://github.com/", escape_html(r.full_name), "\" target=\"_blank\" class=\"museum-repo-link\">", escape_html(r.name), "</a>")
      end), ""),
      "</div>"
    ], "")
  end
  launch = case length(p.internal_path) > 0 do
    true -> concat("<a href=\"", escape_html(desk_app_href(p.internal_path)), "\" class=\"museum-launch-btn\">Launch &#x25B6;</a>")
    false -> ""
  end
  visit = case length(p.external_url) > 0 do
    true -> concat("<a href=\"", escape_html(p.external_url), "\" target=\"_blank\" class=\"museum-launch-btn\" style=\"margin-top: 8px;\">Visit &#x2197;</a>")
    false -> ""
  end
  join([
    "<div class=\"museum-detail-content\">",
    "<div class=\"museum-detail-icon\">", desk_icon(icons, p.slug), "</div>",
    "<div class=\"museum-detail-title\">", escape_html(p.title), "</div>",
    "<div class=\"museum-detail-tagline\">", escape_html(p.tagline), "</div>",
    "<div class=\"museum-detail-description\">", escape_html(trim(p.description)), "</div>",
    "<div class=\"museum-detail-tech\">", desk_tech_tags(p.tech), "</div>",
    repos, launch, visit,
    "</div>",
    "<div class=\"status-bar\"><span>", escape_html(p.category), "</span>",
    "<span>", to_string(length(p.tech)), " technologies</span></div>"
  ], "")
end

def desk_detail_window(st: Map, desk: Map) -> String do
  p = desk_find_project(desk.museum, st.project)
  case p do
    nil -> ""
    _ ->
      join([
        "<div class=\"museum-detail-window\" id=\"museum-detail-window\">",
        desk_title_bar(desk_href(put(st, "project", "")), escape_html(p.title)),
        p.detail_html,
        "</div>"
      ], "")
  end
end

def desk_leica_icon(st: Map) -> String do
  desk_leica_icon_html(desk_href(put(st, "leica", "1")))
end

# The warning dialog is plain HTML, so it stays. Its "Load" button used to
# start the zoom-and-pan viewer; now it opens the image itself.
def desk_leica_warning(st: Map) -> String do
  case st.leica do
    "" -> ""
    _ -> desk_leica_dialog(desk_href(put(st, "leica", "")))
  end
end

def desk_blog_window(st: Map, desk: Map) -> String do
  mobile = case desk_mobile(st) == "blog" do
    true -> " mobile-active"
    false -> ""
  end
  join([
    "<div class=\"blog-window mobile-window-blog", mobile, "\" id=\"blog-window\">",
    "<div class=\"title-bar\"><div class=\"close-box\"></div>",
    "<div class=\"title\">Thoughts &amp; Tidbits - Blog</div>",
    "<div class=\"resize-box\"></div></div>",
    "<div class=\"blog-window-content\"><div class=\"blog-posts-list\">",
    desk.blog_rows,
    "</div></div>",
    "<div class=\"status-bar\"><span>", to_string(desk.post_count), " posts</span></div>",
    "</div>"
  ], "")
end

def desk_taskbar(st: Map) -> String do
  mob = desk_mobile(st)
  apps = put(put(st, "finder", "1"), "m", "finder")
  museum = put(put(st, "museum", ""), "m", "museum")
  hangar = case st.m do
    "" -> st
    _ -> put(st, "m", "hangar")
  end
  desk_taskbar_links(mob == "hangar", mob == "museum", mob == "blog", mob == "finder", desk_href(hangar), desk_href(museum), desk_href(put(st, "m", "blog")), desk_href(apps))
end

def desk_hangar_window(st: Map, desk: Map, live: String) -> String do
  mobile = case desk_mobile(st) == "hangar" do
    true -> " mobile-active"
    false -> ""
  end
  join([
    "<div class=\"hangar-window mobile-window-hangar", mobile, "\" id=\"hangar-window\">",
    "<div class=\"title-bar\"><div class=\"close-box\"></div><div class=\"title\">The Hangar</div><div class=\"resize-box\"></div></div>",
    "<div class=\"hangar-head\">", desk_blimp_svg(88),
    "<div><div class=\"hangar-headline\">Every page on this site is served by one Blimp process.</div>",
    "<p>Blimp is the actor language I have been writing. The server is its interpreter, in Zig; the games run that same interpreter in your browser, as WebAssembly. Phoenix, which ran all this until September, is in the Trash.</p></div></div>",
    live,
    "<div class=\"hangar-body\">", desk.hangar_html, "</div>",
    "<div class=\"status-bar\"><span>", to_string(desk.hangar_count), " pages, one process</span><a href=\"/stack\">how it is built &#x2192;</a></div>",
    "</div>"
  ], "")
end

def desk_side_icons(st: Map, desk: Map) -> String do
  join([
    "<div class=\"side-icons\">",
    desk_side_icon("/stack", desk.stack_icon, "The Stack"),
    desk_side_icon("/mirror", desk.mirror_icon, "View Source"),
    desk_side_icon("/directory", desk_projects_icon(), "Directory"),
    desk_leica_icon(st),
    desk_side_icon("https://old.bobbby.online", desk_trash_svg(), "Trash<br>(Phoenix)"),
    "</div>"
  ], "")
end

def desktop_page(query: String, desk: Map, epoch_s: Int) -> String do
  counts = case query do
    "" -> DESK_LIVE_MARK
    _ -> desk_live_now(epoch_s)
  end
  desktop_page_with(query, desk, epoch_s, counts, query == "")
end

# The page with these counters. prebuilt: it is the bare homepage built at
# boot, whose counters are put back per request (main.blimp's bare_home).
def desktop_page_with(query: String, desk: Map, epoch_s: Int, counts: String, prebuilt: Bool) -> String do
  t0 = now_ms()
  st = desk_state(query, desk)
  finder = case desk_show_finder(st) do
    true -> desk_finder_window(st, desk)
    false -> ""
  end
  museum = case desk_show_museum(st) do
    true -> desk_museum_window(st, desk)
    false -> []
  end
  splash = case query do
    "" -> desk_boot_splash()
    _ -> ""
  end
  menu = desk_menu_bar_links(epoch_s, desk_href(desk_toggle_museum(st)), desk_href(desk_toggle_finder(st)))
  blog = desk_blog_window(st, desk)
  detail = desk_detail_window(st, desk)
  icons = desk_side_icons(st, desk)
  warning = desk_leica_warning(st)
  taskbar = desk_taskbar(st)
  render = case prebuilt do
    true -> "prebuilt at boot"
    false -> concat(to_string(now_ms() - t0), " ms")
  end
  body = join(flat([
    "<div class=\"desk-frame\"><main class=\"desk-main\"><div class=\"desk-screen\">",
    "<div class=\"mac\">",
    menu,
    "<div class=\"desktop\">",
    "<a class=\"blimp-flyer\" href=\"https://github.com/notactuallytreyanastasio/blimp\" title=\"Blimp, the language this site runs on\">", desk_blimp_svg(56), "</a>",
    desk_hangar_window(st, desk, desk_live_html(counts, render)),
    museum,
    blog,
    finder,
    "<div class=\"right-column\">", detail, "</div>",
    icons,
    warning,
    taskbar,
    "</div></div>",
    splash,
    "</div></main></div>"
  ]), "")
  page_layout("Thoughts and Tidbits", site_description(), "website", ["/assets/base.css", "/assets/desktop.css"], body)
end
