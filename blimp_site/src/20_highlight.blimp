# Server-side syntax highlighting, emitting highlight.js class names so a
# stock highlight.js theme (or highlight_css below) styles the result.
#
# highlight(lang, code) takes the raw text of a fenced block and returns the
# HTML that goes inside <code>. Only Elixir is highlighted. Every other
# language comes back HTML-escaped and nothing more: no auto-detection.
#
# The Elixir scanner follows highlight.js 11's grammar (src/languages/
# elixir.js) mode by mode rather than inventing its own idea of Elixir. That
# grammar is a list of modes tried at each position in order; the first mode
# whose begin matches at the leftmost position wins, and text between modes
# is scanned for keywords. hl_default does exactly that, one byte position at
# a time, and each mode is a function that scans to its own end. Nesting
# (an interpolation inside a string inside an interpolation) recurses, one
# native frame per level; every loop over characters is a tail call.
#
# Output goes into a sink rather than a growing string: see hl_put.
#
# Classes emitted, all from the hljs grammar:
#   hljs-keyword        after alias and case ... with, plus def/defmodule
#   hljs-literal        true false nil
#   hljs-string         "..." '...' """...""" '''...''' ~S"..." ~s(...) etc
#   hljs-subst          #{...} inside strings and lowercase sigils
#   hljs-char escape_   backslash escapes inside sigils (not plain strings)
#   hljs-regex          ~r/.../ and ~R/.../ (hljs says "regex", not "regexp")
#   hljs-comment        # to end of line
#   hljs-doctag         TODO: FIXME: NOTE: BUG: OPTIMIZE: HACK: XXX: in comments
#   hljs-function       def/defp/defmacro/defmacrop through the name
#   hljs-class          defmodule/defimpl/defprotocol/defrecord through the name
#   hljs-title          the name after those
#   hljs-title class_   any other Capitalised name (module references)
#   hljs-symbol         :atom, :"atom", key:
#   hljs-number         42, -1, 1_000, 3.14, 1.0e10, 0x1F, 0b101, 0o17
#   hljs-variable       @attr, @@x, $x
#
# Known departures from hljs, all in edge cases the posts do not hit:
#   - \s after ":" means ASCII whitespace only; hljs also counts Unicode
#     spaces, so ":<nbsp>" is a symbol here and not there.
#   - A backslash escape swallows one whole UTF-8 character; hljs takes one
#     UTF-16 unit, which splits a character outside the BMP.
#   - hljs's "phrasal words" comment mode exists only for relevance scoring and
#     emits nothing, so it is not modelled.

def highlight(lang: String, code: String) -> String do
  case lang == "elixir" or lang == "ex" or lang == "exs" do
    true -> hl_elixir(code)
    false -> escape_html(code)
  end
end

def hl_elixir(code: String) -> String do
  r = hl_default(code, length(code), 0, 0, hl_sink(), false)
  case r do
    {o, _} -> hl_finish(o)
  end
end

# ---------------------------------------------------------------------------
# Output sink.
#
# Nothing is freed during a run. concat copies the string built so far and
# consing copies the list (measured: 10,000 conses onto one list cost
# 400 MB), so neither can grow one piece at a time. The sink is
# {pieces, count, chunks}: up to 32 pieces in a short list, then joined into
# one chunk. The chunk list grows once per 32 pieces, so it is only
# quadratic past a few thousand chunks, far beyond any code block here.
# (A binary-counter chain of nested tuples was tried too; at post sizes it
# used slightly more memory, because every tuple match allocates.)

def hl_sink() -> Any do
  {[], 0, []}
end

def hl_put(o: Any, s: String) -> Any do
  case o do
    {ps, n, cs} ->
      case n >= 31 do
        true -> {[], 0, [join(reverse([s | ps]), "") | cs]}
        false -> {[s | ps], n + 1, cs}
      end
  end
end

def hl_finish(o: Any) -> String do
  case o do
    {ps, _, cs} -> join(reverse([join(reverse(ps), "") | cs]), "")
  end
end

# escape_html is five split/join passes; most tokens need none of them.
def hl_escape(s: String) -> String do
  case contains(s, "&") or contains(s, "<") or contains(s, ">") or contains(s, "\"") or contains(s, "'") do
    true -> escape_html(s)
    false -> s
  end
end

# Source bytes [a, b) as escaped text.
def hl_text(o: Any, code: String, a: Int, b: Int) -> Any do
  case a < b do
    true -> hl_put(o, hl_escape(slice(code, a, b - a)))
    false -> o
  end
end

def hl_open(o: Any, cls: String) -> Any do
  hl_put(o, concat("<span class=\"hljs-", cls, "\">"))
end

def hl_close(o: Any) -> Any do
  hl_put(o, "</span>")
end

# Source bytes [a, b) wrapped in one span, as one piece.
def hl_span(o: Any, cls: String, code: String, a: Int, b: Int) -> Any do
  hl_put(o, concat("<span class=\"hljs-", cls, "\">", hl_escape(slice(code, a, b - a)), "</span>"))
end

# ---------------------------------------------------------------------------
# Character classes, on byte codes. -1 past either end.

def hl_c(code: String, i: Int) -> Int do
  case i >= 0 and i < length(code) do
    true -> char_code(char_at(code, i))
    false -> -1
  end
end

def hl_is_digit(c: Int) -> Bool do
  c >= 48 and c <= 57
end

def hl_is_upper(c: Int) -> Bool do
  c >= 65 and c <= 90
end

def hl_is_lower(c: Int) -> Bool do
  c >= 97 and c <= 122
end

# [a-zA-Z_]
def hl_is_ident_start(c: Int) -> Bool do
  hl_is_upper(c) or hl_is_lower(c) or c == 95
end

# \w
def hl_is_word(c: Int) -> Bool do
  hl_is_ident_start(c) or hl_is_digit(c)
end

# \s, ASCII only
def hl_is_space(c: Int) -> Bool do
  c == 32 or (c >= 9 and c <= 13)
end

# \b before position i: the characters either side differ in wordness.
def hl_boundary(code: String, i: Int) -> Bool do
  hl_is_word(hl_c(code, i - 1)) != hl_is_word(hl_c(code, i))
end

# Bytes in the UTF-8 character that starts with byte c.
def hl_utf8_len(c: Int) -> Int do
  case c >= 240 do
    true -> 4
    false ->
      case c >= 224 do
        true -> 3
        false ->
          case c >= 192 do
            true -> 2
            false -> 1
          end
      end
  end
end

# Index just past one whole character at i, never past n.
def hl_next_char(code: String, n: Int, i: Int) -> Int do
  min(n, i + hl_utf8_len(hl_c(code, i)))
end

def hl_at(code: String, i: Int, s: String) -> Bool do
  slice(code, i, length(s)) == s
end

# Advance while the byte is a word character: \w*
def hl_word_run(code: String, n: Int, i: Int) -> Int do
  case i < n and hl_is_word(hl_c(code, i)) do
    true -> hl_word_run(code, n, i + 1)
    false -> i
  end
end

# [a-zA-Z0-9_.]*
def hl_ident_run(code: String, n: Int, i: Int) -> Int do
  c = hl_c(code, i)
  case i < n and (hl_is_word(c) or c == 46) do
    true -> hl_ident_run(code, n, i + 1)
    false -> i
  end
end

# End of ELIXIR_IDENT_RE, [a-zA-Z_][a-zA-Z0-9_.]*(!|\?)?, starting at an
# identifier start i and not reading past n.
def hl_ident_end(code: String, n: Int, i: Int) -> Int do
  e = hl_ident_run(code, n, i + 1)
  c = hl_c(code, e)
  case e < n and (c == 33 or c == 63) do
    true -> e + 1
    false -> e
  end
end

# ---------------------------------------------------------------------------
# Keywords, applied to the text between modes.

def hl_kw_kind(w: String) -> String do
  case w do
    "after" -> "keyword"
    "alias" -> "keyword"
    "and" -> "keyword"
    "case" -> "keyword"
    "catch" -> "keyword"
    "cond" -> "keyword"
    "defstruct" -> "keyword"
    "defguard" -> "keyword"
    "do" -> "keyword"
    "else" -> "keyword"
    "end" -> "keyword"
    "fn" -> "keyword"
    "for" -> "keyword"
    "if" -> "keyword"
    "import" -> "keyword"
    "in" -> "keyword"
    "not" -> "keyword"
    "or" -> "keyword"
    "quote" -> "keyword"
    "raise" -> "keyword"
    "receive" -> "keyword"
    "require" -> "keyword"
    "reraise" -> "keyword"
    "rescue" -> "keyword"
    "try" -> "keyword"
    "unless" -> "keyword"
    "unquote" -> "keyword"
    "unquote_splicing" -> "keyword"
    "use" -> "keyword"
    "when" -> "keyword"
    "with" -> "keyword"
    "false" -> "literal"
    "nil" -> "literal"
    "true" -> "literal"
    _ -> ""
  end
end

# hljs scans the buffer with ELIXIR_IDENT_RE, unanchored, so "Enum.map" is
# one word (and not a keyword) and "x.end" is not the keyword end. The
# identifier cannot run past the buffer's end b.
def hl_kw(code: String, a: Int, b: Int, o: Any) -> Any do
  hl_kw_scan(code, a, b, a, o)
end

def hl_kw_scan(code: String, j: Int, b: Int, run: Int, o: Any) -> Any do
  case j >= b do
    true -> hl_text(o, code, run, b)
    false ->
      case hl_is_ident_start(hl_c(code, j)) do
        false -> hl_kw_scan(code, j + 1, b, run, o)
        true ->
          e = hl_ident_end(code, b, j)
          k = hl_kw_kind(slice(code, j, e - j))
          case k == "" do
            true -> hl_kw_scan(code, e, b, run, o)
            false -> hl_kw_scan(code, e, b, e, hl_span(hl_text(o, code, run, j), k, code, j, e))
          end
      end
  end
end

# ---------------------------------------------------------------------------
# The default mode: top level, and the inside of #{...}.
#
# Walks positions from i; bytes from `start` to i are the pending keyword
# buffer. Returns {sink, index}. With subst true, an unclaimed "}" ends it
# (the "}" is emitted, the caller closes the span).

def hl_default(code: String, n: Int, i: Int, start: Int, o: Any, subst: Bool) -> Any do
  case i >= n do
    true -> {hl_kw(code, start, i, o), i}
    false ->
      c = hl_c(code, i)
      case hl_may_begin(c) do
        false ->
          case subst and c == 125 do
            true -> {hl_put(hl_kw(code, start, i, o), "}"), i + 1}
            false -> hl_default(code, n, i + 1, start, o, subst)
          end
        true ->
          r = hl_try(code, n, i, o, start, c)
          case r do
            {o2, j} ->
              case j >= 0 do
                true -> hl_default(code, n, j, j, o2, subst)
                false ->
                  case hl_is_word(c) and hl_boundary(code, i) do
                    # Nothing began at this word's start, so nothing begins
                    # inside it: every mode but key: needs a \b, and key:
                    # fails the same way from any later start in the word.
                    true -> hl_default(code, n, hl_word_run(code, n, i), start, o, subst)
                    false -> hl_default(code, n, i + 1, start, o, subst)
                  end
              end
          end
      end
  end
end

# Could any mode begin with this byte? " ' ~ # : - $ @ or a word character.
def hl_may_begin(c: Int) -> Bool do
  hl_is_word(c) or c == 34 or c == 39 or c == 126 or c == 35 or c == 58 or c == 45 or c == 36 or c == 64
end

# Try every mode at i, in the grammar's order. {sink, end} on a match, with
# the buffer before i flushed first; {sink, -1} when nothing begins here.
def hl_try(code: String, n: Int, i: Int, o: Any, start: Int, c: Int) -> Any do
  s = hl_string_begin(code, i)
  case s do
    {open, close} -> hl_string(code, n, i, open, close, hl_kw(code, start, i, o))
    _ ->
      case c == 126 do
        true -> hl_try_sigil(code, n, i, o, start)
        false -> hl_try_rest(code, n, i, o, start, c)
      end
  end
end

def hl_try_sigil(code: String, n: Int, i: Int, o: Any, start: Int) -> Any do
  k = hl_c(code, i + 1)
  close = hl_sigil_close(hl_c(code, i + 2))
  case close == "" do
    true -> {o, -1}
    false ->
      o2 = hl_kw(code, start, i, o)
      case k == 114 or k == 82 do
        # ~r ~R
        true -> hl_sigil(code, n, i, k == 114, true, "regex", o2)
        false ->
          case hl_is_upper(k) do
            true -> hl_sigil(code, n, i, false, false, "string", o2)
            false ->
              case hl_is_lower(k) do
                true -> hl_sigil(code, n, i, true, false, "string", o2)
                false -> {o, -1}
              end
          end
      end
  end
end

def hl_try_rest(code: String, n: Int, i: Int, o: Any, start: Int, c: Int) -> Any do
  case c == 35 do
    # #
    true -> hl_comment(code, n, i, hl_kw(code, start, i, o))
    false ->
      d = hl_def_word(code, n, i)
      case d do
        {w, cls} -> hl_def(code, n, i, i + length(w), cls, hl_kw(code, start, i, o))
        _ -> hl_try_simple(code, n, i, o, start, c)
      end
  end
end

# The modes that are one token: flush, wrap [i, e) in a span.
def hl_try_simple(code: String, n: Int, i: Int, o: Any, start: Int, c: Int) -> Any do
  case c == 58 and hl_c(code, i + 1) == 58 do
    # "::" is its own mode with no class, so it is plain and never a symbol.
    true -> {hl_text(hl_kw(code, start, i, o), code, i, i + 2), i + 2}
    false ->
      case c == 58 and not(hl_is_space(hl_c(code, i + 1))) do
        true -> hl_symbol(code, n, i, hl_kw(code, start, i, o))
        false ->
          t = hl_token(code, n, i, c)
          case t do
            {cls, e} -> {hl_span(hl_kw(code, start, i, o), cls, code, i, e), e}
            _ -> {o, -1}
          end
      end
  end
end

# key:, Module, number, @attr, in that order. {class, end} or nil.
def hl_token(code: String, n: Int, i: Int, c: Int) -> Any do
  k = hl_key_symbol_end(code, n, i, c)
  case k > 0 do
    true -> {"symbol", k}
    false ->
      case hl_is_upper(c) and hl_boundary(code, i) and hl_is_word(hl_c(code, i + 1)) do
        true -> {"title class_", hl_word_run(code, n, i + 1)}
        false ->
          m = hl_number_end(code, n, i, c)
          case m > 0 do
            true -> {"number", m}
            false ->
              v = hl_variable_end(code, n, i, c)
              case v > 0 do
                true -> {"variable", v}
                false -> nil
              end
          end
      end
  end
end

# ELIXIR_IDENT_RE + ':(?!:)'. Not anchored to a word start, like hljs.
def hl_key_symbol_end(code: String, n: Int, i: Int, c: Int) -> Int do
  case hl_is_ident_start(c) do
    false -> -1
    true ->
      e = hl_ident_end(code, n, i)
      case hl_c(code, e) == 58 and hl_c(code, e + 1) != 58 do
        true -> e + 1
        false -> -1
      end
  end
end

# (\b0o[0-7_]+)|(\b0b[01_]+)|(\b0x[0-9a-fA-F_]+)|(-?\b[0-9][0-9_]*(\.[0-9_]+([eE][-+]?[0-9]+)?)?)
def hl_number_end(code: String, n: Int, i: Int, c: Int) -> Int do
  case c == 45 and hl_is_digit(hl_c(code, i + 1)) do
    true -> hl_decimal_end(code, n, i + 1)
    false ->
      case hl_is_digit(c) and hl_boundary(code, i) do
        false -> -1
        true ->
          p = hl_radix_end(code, n, i)
          case p > 0 do
            true -> p
            false -> hl_decimal_end(code, n, i)
          end
      end
  end
end

def hl_radix_end(code: String, n: Int, i: Int) -> Int do
  case hl_c(code, i) == 48 do
    false -> -1
    true ->
      x = hl_c(code, i + 1)
      e = hl_radix_run(code, n, i + 2, x)
      case e > i + 2 do
        true -> e
        false -> -1
      end
  end
end

# Digits allowed after 0o, 0b, 0x (x is the letter's code), plus "_".
def hl_radix_run(code: String, n: Int, i: Int, x: Int) -> Int do
  c = hl_c(code, i)
  ok = c == 95 or (x == 111 and c >= 48 and c <= 55) or (x == 98 and (c == 48 or c == 49)) or (x == 120 and (hl_is_digit(c) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70)))
  case i < n and ok do
    true -> hl_radix_run(code, n, i + 1, x)
    false -> i
  end
end

def hl_digits_(code: String, n: Int, i: Int) -> Int do
  c = hl_c(code, i)
  case i < n and (hl_is_digit(c) or c == 95) do
    true -> hl_digits_(code, n, i + 1)
    false -> i
  end
end

def hl_digits(code: String, n: Int, i: Int) -> Int do
  case i < n and hl_is_digit(hl_c(code, i)) do
    true -> hl_digits(code, n, i + 1)
    false -> i
  end
end

# [0-9][0-9_]*(\.[0-9_]+([eE][-+]?[0-9]+)?)? from a digit at i.
def hl_decimal_end(code: String, n: Int, i: Int) -> Int do
  e = hl_digits_(code, n, i + 1)
  f = hl_digits_(code, n, e + 1)
  case hl_c(code, e) == 46 and f > e + 1 do
    false -> e
    true ->
      x = hl_c(code, f)
      sgn = hl_c(code, f + 1)
      d = case sgn == 43 or sgn == 45 do
        true -> f + 2
        false -> f + 1
      end
      g = hl_digits(code, n, d)
      case (x == 101 or x == 69) and g > d do
        true -> g
        false -> f
      end
  end
end

# (\$\W)|((\$|@@?)(\w+))
def hl_variable_end(code: String, n: Int, i: Int, c: Int) -> Int do
  c1 = hl_c(code, i + 1)
  case c == 36 do
    true ->
      case i + 1 < n and not(hl_is_word(c1)) do
        true -> hl_next_char(code, n, i + 1)
        false -> hl_word_run_1(code, n, i + 1)
      end
    false ->
      case c == 64 do
        false -> -1
        true ->
          case c1 == 64 and hl_is_word(hl_c(code, i + 2)) do
            true -> hl_word_run(code, n, i + 2)
            false -> hl_word_run_1(code, n, i + 1)
          end
      end
  end
end

# \w+ from i: its end, or -1 when there is not one word character.
def hl_word_run_1(code: String, n: Int, i: Int) -> Int do
  case hl_is_word(hl_c(code, i)) do
    true -> hl_word_run(code, n, i)
    false -> -1
  end
end

# ---------------------------------------------------------------------------
# Strings.

# The STRING mode's variants, in order: {begin, end} or nil. The ~S forms
# have no escapes and no interpolation; the others have both.
def hl_string_begin(code: String, i: Int) -> Any do
  case hl_c(code, i) do
    34 ->
      case hl_at(code, i, "\"\"\"") do
        true -> {"\"\"\"", "\"\"\""}
        false -> {"\"", "\""}
      end
    39 ->
      case hl_at(code, i, "'''") do
        true -> {"'''", "'''"}
        false -> {"'", "'"}
      end
    126 ->
      case hl_at(code, i, "~S\"\"\"") do
        true -> {"~S\"\"\"", "\"\"\""}
        false ->
          case hl_at(code, i, "~S\"") do
            true -> {"~S\"", "\""}
            false ->
              case hl_at(code, i, "~S'''") do
                true -> {"~S'''", "'''"}
                false ->
                  case hl_at(code, i, "~S'") do
                    true -> {"~S'", "'"}
                    false -> nil
                  end
              end
          end
      end
    _ -> nil
  end
end

def hl_string(code: String, n: Int, i: Int, open: String, close: String, o: Any) -> Any do
  raw = hl_c(code, i) == 126
  # esc 0: none; 1: \x skipped, no span (hljs.BACKSLASH_ESCAPE has no scope)
  esc = case raw do
    true -> 0
    false -> 1
  end
  j = i + length(open)
  r = hl_delim(code, n, j, j, close, esc, not(raw), hl_text(hl_open(o, "string"), code, i, j))
  case r do
    {o2, e} -> {hl_close(o2), e}
  end
end

# Sigil delimiters [/|([{<"'] and their closers; "" when c is not one.
def hl_sigil_close(c: Int) -> String do
  case c do
    47 -> "/"
    124 -> "|"
    40 -> ")"
    91 -> "]"
    123 -> "}"
    60 -> ">"
    34 -> "\""
    39 -> "'"
    _ -> ""
  end
end

# ~x followed by a delimiter at i+2. Lowercase sigils (and ~r) take escapes
# as spans and interpolate; uppercase ones only escape their own closer.
# Regex sigils also take up to seven modifier letters after the closer.
#
# In hljs the sigil is a wrapper mode whose delimited sections are
# sub-modes and whose own end is empty. Sub-modes are tried before the end,
# so a delimiter straight after a closer opens another section in the same
# span: ~H""" is ~H"" followed by a section running to the next ".
def hl_sigil(code: String, n: Int, i: Int, lower: Bool, regex: Bool, cls: String, o: Any) -> Any do
  hl_sigil_parts(code, n, i + 2, lower, regex, hl_text(hl_open(o, cls), code, i, i + 2))
end

def hl_sigil_parts(code: String, n: Int, j: Int, lower: Bool, regex: Bool, o: Any) -> Any do
  close = hl_sigil_close(hl_c(code, j))
  case j >= n or close == "" do
    true -> {hl_close(o), j}
    false ->
      esc = case lower do
        true -> 2
        false -> 3
      end
      r = hl_delim(code, n, j + 1, j + 1, close, esc, lower, hl_text(o, code, j, j + 1))
      case r do
        {o2, e} ->
          m = case regex do
            true -> hl_modifiers(code, n, e, 0)
            false -> e
          end
          hl_sigil_parts(code, n, m, lower, regex, hl_text(o2, code, e, m))
      end
  end
end

# [uismxfU]{0,7}
def hl_modifiers(code: String, n: Int, i: Int, k: Int) -> Int do
  c = hl_c(code, i)
  ok = c == 117 or c == 105 or c == 115 or c == 109 or c == 120 or c == 102 or c == 85
  case k < 7 and i < n and ok do
    true -> hl_modifiers(code, n, i + 1, k + 1)
    false -> i
  end
end

# The inside of a string or sigil, from i up to and including `close`, or to
# the end of input when it never closes. `run` is where pending text starts.
#   esc 0: backslash is ordinary
#   esc 1: backslash + one character is consumed, no span
#   esc 2: backslash + one character is an hljs-char escape_ span
#   esc 3: backslash + the closer is an hljs-char escape_ span
# Returns {sink, index after close}; the caller closes the string span.
def hl_delim(code: String, n: Int, i: Int, run: Int, close: String, esc: Int, subst: Bool, o: Any) -> Any do
  case i >= n do
    true -> {hl_text(o, code, run, n), n}
    false ->
      c = hl_c(code, i)
      case c == 92 and i + 1 < n and esc > 0 do
        true -> hl_delim_escape(code, n, i, run, close, esc, subst, o)
        false ->
          case subst and c == 35 and hl_c(code, i + 1) == 123 do
            true ->
              # Not the literal "#{": Blimp reads that as an unclosed
              # interpolation and the call fails at run time.
              o2 = hl_put(hl_open(hl_text(o, code, run, i), "subst"), concat("#", "{"))
              r = hl_default(code, n, i + 2, i + 2, o2, true)
              case r do
                {o3, e} -> hl_delim(code, n, e, e, close, esc, subst, hl_close(o3))
              end
            false ->
              case hl_at(code, i, close) do
                true -> {hl_text(o, code, run, i + length(close)), i + length(close)}
                false -> hl_delim(code, n, i + 1, run, close, esc, subst, o)
              end
          end
      end
  end
end

def hl_delim_escape(code: String, n: Int, i: Int, run: Int, close: String, esc: Int, subst: Bool, o: Any) -> Any do
  case esc do
    1 -> hl_delim(code, n, i + 2, run, close, esc, subst, o)
    2 ->
      e = hl_next_char(code, n, i + 1)
      hl_delim(code, n, e, e, close, esc, subst, hl_span(hl_text(o, code, run, i), "char escape_", code, i, e))
    _ ->
      case hl_at(code, i + 1, close) do
        true ->
          e = i + 1 + length(close)
          hl_delim(code, n, e, e, close, esc, subst, hl_span(hl_text(o, code, run, i), "char escape_", code, i, e))
        false -> hl_delim(code, n, i + 1, run, close, esc, subst, o)
      end
  end
end

# ---------------------------------------------------------------------------
# Symbols: ":" then strings and operator/names, as many as follow each
# other directly. Like a sigil, the symbol mode's end is empty and its
# sub-modes are tried first, so :"a"b is one symbol.

def hl_symbol(code: String, n: Int, i: Int, o: Any) -> Any do
  hl_symbol_parts(code, n, i + 1, hl_put(hl_open(o, "symbol"), ":"))
end

def hl_symbol_parts(code: String, n: Int, j: Int, o: Any) -> Any do
  s = hl_string_begin(code, j)
  case s do
    {open, close} ->
      r = hl_string(code, n, j, open, close, o)
      case r do
        {o2, e} -> hl_symbol_parts(code, n, e, o2)
      end
    _ ->
      e = hl_method_end(code, n, j)
      case e > j do
        true -> hl_symbol_parts(code, n, e, hl_text(o, code, j, e))
        false -> {hl_close(o), j}
      end
  end
end

# ELIXIR_METHOD_RE, first alternative that matches (JS alternation, not
# longest match): [a-zA-Z_]\w*[!?=]?|[-+~]@|<<|>>|=~|===?|<=>|[<>]=?|\*\*|
# [-/+%^&*~`|]|\[\]=?  Returns i when nothing matches.
def hl_method_end(code: String, n: Int, i: Int) -> Int do
  c = hl_c(code, i)
  c1 = hl_c(code, i + 1)
  case hl_is_ident_start(c) do
    true ->
      e = hl_word_run(code, n, i + 1)
      t = hl_c(code, e)
      case e < n and (t == 33 or t == 63 or t == 61) do
        true -> e + 1
        false -> e
      end
    false ->
      case (c == 45 or c == 43 or c == 126) and c1 == 64 do
        true -> i + 2
        false -> hl_method_ops(code, n, i, c, c1)
      end
  end
end

def hl_method_ops(code: String, n: Int, i: Int, c: Int, c1: Int) -> Int do
  case hl_at(code, i, "<<") or hl_at(code, i, ">>") or hl_at(code, i, "=~") do
    true -> i + 2
    false ->
      case hl_at(code, i, "===") do
        true -> i + 3
        false ->
          case hl_at(code, i, "==") do
            true -> i + 2
            false ->
              case hl_at(code, i, "<=>") do
                true -> i + 3
                false -> hl_method_ops2(code, n, i, c, c1)
              end
          end
      end
  end
end

def hl_method_ops2(code: String, n: Int, i: Int, c: Int, c1: Int) -> Int do
  case c == 60 or c == 62 do
    true ->
      case c1 == 61 do
        true -> i + 2
        false -> i + 1
      end
    false ->
      case hl_at(code, i, "**") do
        true -> i + 2
        false ->
          case contains("-/+%^&*~`|", slice(code, i, 1)) and i < n do
            true -> i + 1
            false ->
              case hl_at(code, i, "[]=") do
                true -> i + 3
                false ->
                  case hl_at(code, i, "[]") do
                    true -> i + 2
                    false -> i
                  end
              end
          end
      end
  end
end

# ---------------------------------------------------------------------------
# Comments: "#" to the end of the line, with doctags.

def hl_comment(code: String, n: Int, i: Int, o: Any) -> Any do
  e = hl_line_end(code, n, i)
  o2 = hl_doctags(code, i, e, i, hl_open(o, "comment"))
  {hl_close(o2), e}
end

# JS "$" in multiline mode stops before \n and before \r.
def hl_line_end(code: String, n: Int, i: Int) -> Int do
  c = hl_c(code, i)
  case i >= n or c == 10 or c == 13 do
    true -> i
    false -> hl_line_end(code, n, i + 1)
  end
end

def hl_doctags(code: String, j: Int, e: Int, run: Int, o: Any) -> Any do
  case j >= e do
    true -> hl_text(o, code, run, e)
    false ->
      t = hl_doctag_len(code, j)
      case t > 0 and j + t <= e do
        true -> hl_doctags(code, j + t, e, j + t, hl_span(hl_text(o, code, run, j), "doctag", code, j, j + t))
        false -> hl_doctags(code, j + 1, e, run, o)
      end
  end
end

def hl_doctag_len(code: String, j: Int) -> Int do
  tags = ["TODO:", "FIXME:", "NOTE:", "BUG:", "OPTIMIZE:", "HACK:", "XXX:"]
  hits = filter(tags, fn(t: String) -> Bool do hl_at(code, j, t) end)
  case hits do
    [t | _] -> length(t)
    _ -> 0
  end
end

# ---------------------------------------------------------------------------
# def / defmodule and friends: hljs "beginKeywords" modes.

# The word at i when it is one of the def-like words: whole word, not after
# a ".", not followed by a ".". {word, "function" | "class"} or nil.
def hl_def_word(code: String, n: Int, i: Int) -> Any do
  case hl_c(code, i) == 100 and hl_boundary(code, i) and hl_c(code, i - 1) != 46 do
    false -> nil
    true ->
      e = hl_word_run(code, n, i)
      after = hl_c(code, e)
      w = slice(code, i, e - i)
      case after == 46 do
        true -> nil
        false ->
          case w do
            "def" -> {w, "function"}
            "defp" -> {w, "function"}
            "defmacro" -> {w, "function"}
            "defmacrop" -> {w, "function"}
            "defmodule" -> {w, "class"}
            "defimpl" -> {w, "class"}
            "defprotocol" -> {w, "class"}
            "defrecord" -> {w, "class"}
            _ -> nil
          end
      end
  end
end

# <span class="hljs-function"><span class="hljs-keyword">def</span> <span
# class="hljs-title">name</span></span>. The title ends the outer mode. A
# function mode only ends at its title; a class mode also ends at the end of
# the line or a ";".
def hl_def(code: String, n: Int, i: Int, j: Int, cls: String, o: Any) -> Any do
  o2 = hl_span(hl_open(o, cls), "keyword", code, i, j)
  hl_def_scan(code, n, j, j, cls == "class", o2)
end

def hl_def_scan(code: String, n: Int, i: Int, run: Int, is_class: Bool, o: Any) -> Any do
  c = hl_c(code, i)
  case i >= n do
    true -> {hl_close(hl_text(o, code, run, n)), n}
    false ->
      case hl_is_ident_start(c) do
        true ->
          e = hl_ident_end(code, n, i)
          {hl_close(hl_span(hl_text(o, code, run, i), "title", code, i, e)), e}
        false ->
          case is_class and (c == 10 or c == 13) do
            true -> {hl_close(hl_text(o, code, run, i)), i}
            false ->
              case is_class and c == 59 do
                true -> {hl_close(hl_text(o, code, run, i + 1)), i + 1}
                false -> hl_def_scan(code, n, i + 1, run, is_class, o)
              end
          end
      end
  end
end

# ---------------------------------------------------------------------------
# A theme for the classes above, scoped to .hljs-*.
#
# Code blocks on the post page sit on PostLive's dark #1f2937 with #e5e7eb
# text (assets/post.css), so these are colours for a dark background: the
# page keeps the look it had, and gains the highlighting it never loaded.
def highlight_css() -> String do
  join([
    ".hljs-keyword, .hljs-literal { color: #93c5fd; font-weight: bold; }",
    ".hljs-string { color: #fca5a5; }",
    ".hljs-subst { color: #e5e7eb; }",
    ".hljs-char.escape_ { color: #fdba74; }",
    ".hljs-regex { color: #fdba74; }",
    ".hljs-comment { color: #9ca3af; font-style: italic; }",
    ".hljs-doctag { font-weight: bold; }",
    ".hljs-symbol { color: #d8b4fe; }",
    ".hljs-number { color: #5eead4; }",
    ".hljs-title { color: #fde68a; }",
    ".hljs-title.class_ { color: #86efac; }",
    ".hljs-variable { color: #fcd34d; }"
  ], "\n")
end

# ---------------------------------------------------------------------------
# Lines.
#
# The markdown renderer wraps each line of a code block in
# <span class="line" data-line="N">, as MDEx does. A string or a heredoc can
# span lines, so its hljs span has to be closed at the end of each line and
# opened again at the start of the next, or the line spans would nest inside
# it. highlight_lines does that and returns one balanced string per line.
#
# The input is highlight()'s output: text is escaped, so every "<" starts a
# tag, and the only tags are <span class="..."> and </span>.

def highlight_lines(lang: String, code: String) -> List do
  hl_lines_from(split(highlight(lang, code), "\n"), [], [])
end

# open: the open tags carried into this line, innermost first.
def hl_lines_from(lines: List, open: List, acc: List) -> List do
  case lines do
    [] -> reverse(acc)
    [line | rest] ->
      reopened = join(reverse(open), "")
      after = hl_track(drop_list(split(line, "<"), 1), open)
      closes = repeat("</span>", length(after))
      hl_lines_from(rest, after, [concat(reopened, line, closes) | acc])
  end
end

# Each piece is the text after a "<": "span class=...>..." or "/span>...".
def hl_track(pieces: List, open: List) -> List do
  case pieces do
    [] -> open
    [p | rest] ->
      case starts_with(p, "/span>") do
        true -> hl_track(rest, tail(open))
        false -> hl_track(rest, [concat("<", take(p, index_of(p, ">") + 1)) | open])
      end
  end
end
