# temper-core for Blimp.
#
# Blimp and Temper disagree in three places, and this file is the bridge:
#
#   - Blimp's Int is 64-bit and does not wrap; Temper's Int is 32-bit wrapping.
#   - Blimp's to_string drops a whole Float's decimal point: 1.0 prints as "1".
#   - Blimp strings are byte arrays over UTF-8; Temper strings are addressed by
#     code point.
#
# Everything here is plain Blimp so it can be read, tested and stepped through
# with the same tools as translated code.

# ── Int ──────────────────────────────────────────────

# Wrap to a signed 32-bit value, the way Temper's Int arithmetic does.
def temper_int32(n: Int) -> Int do
  m = rem(n, 4294967296)
  m2 = case m < 0 do
    true -> m + 4294967296
    _ -> m
  end
  case m2 >= 2147483648 do
    true -> m2 - 4294967296
    _ -> m2
  end
end

# ── Float ────────────────────────────────────────────

# Temper prints a whole float with its decimal point; Blimp does not.
def temper_float_to_string(f: Float) -> String do
  s = to_string(f)
  case s == "nan" do
    true -> "NaN"
    _ -> case s == "inf" do
      true -> "Infinity"
      _ -> case s == "-inf" do
        true -> "-Infinity"
        _ -> case slice(s, 0, 1) == "-" do
          true -> concat("-", temper_float_body(slice(s, 1, length(s) - 1)))
          _ -> temper_float_body(s)
        end
      end
    end
  end
end

# Temper writes a float the way JavaScript does: plainly until the exponent
# reaches 21 or falls to -7, and in exponent form past that, with a mantissa
# that always has a decimal point. Blimp's to_string expands instead --
# 1e25 comes out as twenty-six digits and 1e207 as two hundred and eight -- so
# the exponent has to be counted back out of the digits.
def temper_float_body(s: String) -> String do
  dot = temper_index_of_from(s, ".", 0)
  whole = case dot < 0 do
    true -> s
    _ -> slice(s, 0, dot)
  end
  frac = case dot < 0 do
    true -> ""
    _ -> slice(s, dot + 1, length(s) - dot - 1)
  end
  case whole == "0" do
    true -> temper_float_small(frac, s)
    _ -> temper_float_large(whole, frac, s)
  end
end

def temper_float_large(whole: String, frac: String, s: String) -> String do
  exponent = length(whole) - 1
  case exponent >= 21 do
    true -> temper_float_exp(concat(whole, frac), exponent)
    _ -> case empty?(frac) do
      true -> concat(s, ".0")
      _ -> s
    end
  end
end

def temper_float_small(frac: String, s: String) -> String do
  z = temper_leading_zeros(frac, 0)
  case z >= length(frac) do
    true -> "0.0"
    _ -> case z >= 6 do
      true -> temper_float_exp(slice(frac, z, length(frac) - z), 0 - z - 1)
      _ -> s
    end
  end
end

def temper_float_exp(digits: String, exponent: Int) -> String do
  sign = case exponent < 0 do
    true -> "-"
    _ -> "+"
  end
  mag = case exponent < 0 do
    true -> 0 - exponent
    _ -> exponent
  end
  concat(temper_float_mantissa(digits), concat("e", concat(sign, to_string(mag))))
end

# The point goes after the first digit, trailing zeros go, and one digit stays
# behind it: Temper writes 1e25 as 1.0e+25, not 1e+25.
def temper_float_mantissa(digits: String) -> String do
  rest = temper_strip_trailing_zeros(slice(digits, 1, length(digits) - 1))
  case empty?(rest) do
    true -> concat(slice(digits, 0, 1), ".0")
    _ -> concat(slice(digits, 0, 1), concat(".", rest))
  end
end

def temper_strip_trailing_zeros(s: String) -> String do
  case length(s) <= 1 do
    true -> s
    _ -> case slice(s, length(s) - 1, 1) == "0" do
      true -> temper_strip_trailing_zeros(slice(s, 0, length(s) - 1))
      _ -> s
    end
  end
end

def temper_leading_zeros(s: String, i: Int) -> Int do
  case i >= length(s) or slice(s, i, 1) != "0" do
    true -> i
    _ -> temper_leading_zeros(s, i + 1)
  end
end

# Blimp has no way to write an infinity, and refuses to divide by zero, so the
# two values IEEE arithmetic produces at the edges are built by overflowing.
def temper_float_inf() -> Float do
  1e308 * 1e10
end

def temper_float_nan() -> Float do
  temper_float_inf() - temper_float_inf()
end

# `f < 0.0` is false for a negative zero, and the sign of a zero decides the
# sign of the infinity it divides into. The printed form still carries it.
def temper_float_is_negative(f: Float) -> Bool do
  case f < 0.0 do
    true -> true
    _ -> slice(to_string(f), 0, 1) == "-"
  end
end

# Temper's Floats are totally ordered, and IEEE's are not: a negative zero sits
# below a positive one, a NaN equals itself, and a NaN is above everything.
# All three are false with Blimp's operators, so every Float comparison goes
# through these. `min` and `max` are not comparisons -- they answer NaN either
# way, which is what types/float/ops asks for.
def temper_float_eq(a: Float, b: Float) -> Bool do
  case a != a do
    true -> b != b
    _ -> case b != b do
      true -> false
      _ -> case a == b do
        true -> temper_float_is_negative(a) == temper_float_is_negative(b)
        _ -> false
      end
    end
  end
end

def temper_float_ne(a: Float, b: Float) -> Bool do
  not(temper_float_eq(a, b))
end

def temper_float_lt(a: Float, b: Float) -> Bool do
  case a != a do
    true -> false
    _ -> case b != b do
      true -> true
      _ -> case a == b do
        true -> temper_float_is_negative(a) and not(temper_float_is_negative(b))
        _ -> a < b
      end
    end
  end
end

def temper_float_gt(a: Float, b: Float) -> Bool do
  temper_float_lt(b, a)
end

def temper_float_le(a: Float, b: Float) -> Bool do
  temper_float_lt(a, b) or temper_float_eq(a, b)
end

def temper_float_ge(a: Float, b: Float) -> Bool do
  temper_float_le(b, a)
end

# An Int is a Float the moment it is added to one.
def temper_int_to_float(n: Int) -> Float do
  n + 0.0
end

# The checked form refuses an Int64 a Float64 cannot hold exactly, which is
# anything past 2^53-1. The unchecked one above does not ask.
def temper_int_to_float_checked(n: Int) -> Float do
  case n > 9007199254740991 or n < 0 - 9007199254740991 do
    true -> temper_bubble()
    _ -> n + 0.0
  end
end

# ── Parsing floats ───────────────────────────────────
#
# Blimp has to_int and no to_float, so this is the whole grammar: an optional
# sign, digits with at most one point, an optional exponent. Anything else
# bubbles, which is what `"totally".toFloat64()` has to do.

def temper_parse_float(s: String) -> Float do
  t = temper_trim(s)
  case t == "NaN" do
    true -> temper_float_nan()
    _ -> case t == "Infinity" do
      true -> temper_float_inf()
      _ -> case t == "-Infinity" do
        true -> 0.0 - temper_float_inf()
        _ -> case empty?(t) do
          true -> temper_bubble()
          _ -> temper_parse_float_sign(t)
        end
      end
    end
  end
end

def temper_parse_float_sign(t: String) -> Float do
  case slice(t, 0, 1) == "-" do
    # Not `0.0 - x`: that answers 0.0 for a zero, and "-0" has to parse to the
    # negative one Temper orders below it.
    true -> temper_parse_float_unsigned(slice(t, 1, length(t) - 1)) * (0.0 - 1.0)
    _ -> case slice(t, 0, 1) == "+" do
      true -> temper_parse_float_unsigned(slice(t, 1, length(t) - 1))
      _ -> temper_parse_float_unsigned(t)
    end
  end
end

def temper_parse_float_unsigned(t: String) -> Float do
  e = temper_find_exp(t, 0)
  case e < 0 do
    true -> temper_parse_decimal(t)
    _ ->
      mantissa = temper_parse_decimal(slice(t, 0, e))
      exponent = temper_parse_exponent(slice(t, e + 1, length(t) - e - 1))
      mantissa * pow(10.0, exponent + 0.0)
  end
end

def temper_find_exp(t: String, i: Int) -> Int do
  case i >= length(t) do
    true -> 0 - 1
    _ -> case slice(t, i, 1) == "e" or slice(t, i, 1) == "E" do
      true -> i
      _ -> temper_find_exp(t, i + 1)
    end
  end
end

def temper_parse_decimal(t: String) -> Float do
  dot = temper_index_of_from(t, ".", 0)
  case dot < 0 do
    true -> temper_digits_value(t) + 0.0
    _ -> temper_parse_frac(slice(t, 0, dot), slice(t, dot + 1, length(t) - dot - 1))
  end
end

# Digits are required on both sides of the point: Temper reads neither "2."
# nor ".2".
def temper_parse_frac(whole: String, frac: String) -> Float do
  case empty?(whole) or empty?(frac) do
    true -> temper_bubble()
    _ -> (temper_digits_value(concat(whole, frac)) + 0.0) / pow(10.0, length(frac) + 0.0)
  end
end

# `1.0e+25` is what temper_float_to_string writes, so the parser has to read
# its own output, and temper_parse_int64 takes a minus and not a plus.
def temper_parse_exponent(s: String) -> Int do
  case empty?(s) do
    true -> temper_bubble()
    _ -> case slice(s, 0, 1) == "+" do
      true -> temper_parse_int64(slice(s, 1, length(s) - 1), 10)
      _ -> temper_parse_int64(s, 10)
    end
  end
end

# Digits and nothing else. temper_parse_int64 reads its own sign, so handing it
# the mantissa directly made "--1" parse as 1.0 and a bare "-" as -0.0.
def temper_digits_value(s: String) -> Int do
  case empty?(s) or not(temper_all_digits(s, 0)) do
    true -> temper_bubble()
    _ -> temper_parse_int64(s, 10)
  end
end

def temper_all_digits(s: String, i: Int) -> Bool do
  case i >= length(s) do
    true -> true
    _ -> case char_code(s, i) >= 48 and char_code(s, i) <= 57 do
      true -> temper_all_digits(s, i + 1)
      _ -> false
    end
  end
end

# Temper's `/` on Floats is IEEE: by zero it gives an infinity, and 0.0 / 0.0
# gives a NaN. Blimp's `/` raises on a zero divisor, which is a reasonable
# thing for a language to do and not what Temper means.
def temper_float_div(a: Float, b: Float) -> Float do
  case b == 0.0 do
    true -> case a == 0.0 or a != a do
      true -> temper_float_nan()
      _ -> case temper_float_is_negative(a) != temper_float_is_negative(b) do
        true -> 0.0 - temper_float_inf()
        _ -> temper_float_inf()
      end
    end
    _ -> a / b
  end
end

# ── UTF-8 ────────────────────────────────────────────

# Byte count of the sequence that starts with byte b.
def u8_seq_len(b: Int) -> Int do
  case b < 128 do
    true -> 1
    _ -> case b < 224 do
      true -> 2
      _ -> case b < 240 do
        true -> 3
        _ -> 4
      end
    end
  end
end

# The code point whose sequence starts at byte index i.
def u8_decode_at(s: String, i: Int) -> Int do
  b0 = char_code(s, i)
  n = u8_seq_len(b0)
  case n == 1 do
    true -> b0
    _ -> case n == 2 do
      true -> (rem(b0, 32) * 64) + rem(char_code(s, i + 1), 64)
      _ -> case n == 3 do
        true -> (rem(b0, 16) * 4096) + (rem(char_code(s, i + 1), 64) * 64) + rem(char_code(s, i + 2), 64)
        _ -> (rem(b0, 8) * 262144) + (rem(char_code(s, i + 1), 64) * 4096) + (rem(char_code(s, i + 2), 64) * 64) + rem(char_code(s, i + 3), 64)
      end
    end
  end
end

# Encode one code point as UTF-8 bytes. Temper bubbles rather than encoding
# something that is not a code point: past the last one, or a surrogate half,
# which UTF-8 has no business carrying.
def u8_encode_checked(cp: Int) -> String do
  case cp < 0 or cp > 1114111 or (cp >= 55296 and cp <= 57343) do
    true -> temper_bubble()
    _ -> u8_encode(cp)
  end
end

def u8_encode(cp: Int) -> String do
  case cp < 128 do
    true -> from_char_code(cp)
    _ -> case cp < 2048 do
      true -> concat(from_char_code(192 + (cp / 64)), from_char_code(128 + rem(cp, 64)))
      _ -> case cp < 65536 do
        true -> concat(from_char_code(224 + (cp / 4096)),
                  concat(from_char_code(128 + rem(cp / 64, 64)), from_char_code(128 + rem(cp, 64))))
        _ -> concat(from_char_code(240 + (cp / 262144)),
               concat(from_char_code(128 + rem(cp / 4096, 64)),
                 concat(from_char_code(128 + rem(cp / 64, 64)), from_char_code(128 + rem(cp, 64)))))
      end
    end
  end
end

# Every code point in s, in order.
def u8_code_points(s: String) -> List do
  u8_cp_loop(s, 0, [])
end

def u8_cp_loop(s: String, i: Int, acc: List) -> List do
  case i >= length(s) do
    true -> acc
    _ ->
      cp = u8_decode_at(s, i)
      u8_cp_loop(s, i + u8_seq_len(char_code(s, i)), append(acc, cp))
  end
end

# String.fromCodePoints: every code point encoded and run together.
def temper_string_from_code_points(codes: Any) -> String do
  temper_from_cp_loop(temper_items(codes), "")
end

def temper_from_cp_loop(codes: List, acc: String) -> String do
  case empty?(codes) do
    true -> acc
    _ -> temper_from_cp_loop(tail(codes), concat(acc, u8_encode_checked(head(codes))))
  end
end

# Temper's String.length counts code points, not bytes.
def temper_string_length(s: String) -> Int do
  length(u8_code_points(s))
end

# Temper's String indices are byte offsets that must land on a sequence start,
# so advancing is a byte step of the current sequence's width.
#
# The end is as far as it goes: `char_code` past the end answers nil, and
# u8_seq_len takes an Int, so walking off the end used to stop the program
# rather than stop at the end. `"foo-bar".step(i, 100)` is the case that
# found it.
def temper_string_next(s: String, i: Int) -> Int do
  case i >= length(s) do
    true -> length(s)
    _ -> i + u8_seq_len(char_code(s, i))
  end
end

def temper_string_code_point_at(s: String, i: Int) -> Int do
  u8_decode_at(s, i)
end

# ── Float to Int ─────────────────────────────────────
#
# Temper truncates toward zero. Blimp's floor and ceil both answer Ints, and
# which one truncates depends on the sign.

def temper_float_trunc(f: Float) -> Int do
  case f < 0.0 do
    true -> ceil(f)
    _ -> floor(f)
  end
end

# Checked: a NaN or anything outside Int32 bubbles.
def temper_float_to_int32(f: Float) -> Int do
  case f != f or f <= 0.0 - 2147483649.0 or f >= 2147483648.0 do
    true -> temper_bubble()
    _ -> temper_float_trunc(f)
  end
end

# Unchecked: saturates at the ends, and a NaN is zero.
def temper_float_to_int32_unsafe(f: Float) -> Int do
  case f != f do
    true -> 0
    _ -> case f >= 2147483648.0 do
      true -> 2147483647
      _ -> case f <= 0.0 - 2147483649.0 do
        true -> 0 - 2147483648
        _ -> temper_float_trunc(f)
      end
    end
  end
end

def temper_float_to_int64(f: Float) -> Int do
  case f != f or f < 0.0 - 9007199254740991.0 or f > 9007199254740991.0 do
    true -> temper_bubble()
    _ -> temper_float_trunc(f)
  end
end

# The checked form above stops at 2^53-1, where a Float stops counting integers
# exactly. The unchecked one saturates at Int64's own ends instead: it is not
# claiming the answer is exact, only that it is in range.
def temper_float_to_int64_unsafe(f: Float) -> Int do
  case f != f do
    true -> 0
    _ -> case f >= 9223372036854775808.0 do
      true -> 9223372036854775807
      _ -> case f < 0.0 - 9223372036854775808.0 do
        true -> temper_int64_min()
        _ -> temper_float_trunc(f)
      end
    end
  end
end

# ── Int to String with a radix ───────────────────────
#
# Blimp's to_string takes no radix, and `cp.toString(16)` is how the string
# tests print a code point.

# The digits come off the negative side, because `0 - n` for the most negative
# Int is itself: negating first turned `(-2^63).toString(16)` into digits of a
# number that was still negative.
def temper_int_to_string_radix(n: Int, radix: Int) -> String do
  case n == 0 do
    true -> "0"
    _ -> case n < 0 do
      true -> concat("-", temper_radix_digits_neg(n, radix, ""))
      _ -> temper_radix_digits(n, radix, "")
    end
  end
end

def temper_radix_digits_neg(n: Int, radix: Int, acc: String) -> String do
  case n == 0 do
    true -> acc
    _ -> temper_radix_digits_neg(n / radix, radix, concat(temper_radix_digit(0 - rem(n, radix)), acc))
  end
end

def temper_radix_digits(n: Int, radix: Int, acc: String) -> String do
  case n == 0 do
    true -> acc
    _ -> temper_radix_digits(n / radix, radix, concat(temper_radix_digit(rem(n, radix)), acc))
  end
end

def temper_radix_digit(d: Int) -> String do
  case d < 10 do
    true -> from_char_code(48 + d)
    _ -> from_char_code(87 + d)
  end
end

# ── Checked division ─────────────────────────────────

# Temper's `/` and `%` on Int bubble on a zero divisor rather than trapping.
def temper_int_div(a: Int, b: Int) -> Int do
  case b == 0 do
    true -> bubble :divide_by_zero
    _ -> temper_int32(a / b)
  end
end

# ── Parsing integers with a radix ────────────────────
#
# Blimp's `to_int` reads decimal only and takes no radix, so `"7FFFFFFF"
# .toInt32(16)` needs this. The accumulator runs *negative*: the negative range
# is one wider than the positive one, so a positive accumulator could not hold
# Int64's minimum, and `"-8000000000000000"` has to parse.

def temper_int64_min() -> Int do
  0 - 9223372036854775807 - 1
end

def temper_digit_value(c: Int) -> Int do
  case c >= 48 and c <= 57 do
    true -> c - 48
    _ -> temper_digit_alpha(c)
  end
end

def temper_digit_alpha(c: Int) -> Int do
  case c >= 65 and c <= 90 do
    true -> c - 55
    _ -> temper_digit_lower(c)
  end
end

def temper_digit_lower(c: Int) -> Int do
  case c >= 97 and c <= 122 do
    true -> c - 87
    _ -> 0 - 1
  end
end

# The radix is optional in Temper and nil when left out, and the text may be
# padded: `" 2 ".toInt32()` is 2.
def temper_parse_int64(s: String, radix: Any) -> Int do
  t = temper_trim(s)
  r = case nil?(radix) do
    true -> 10
    _ -> radix
  end
  n = length(t)
  # Base 36 is as far as the digits go: `"20".toInt32(37)` is an error, not 74.
  case n == 0 or r < 2 or r > 36 do
    true -> temper_bubble()
    _ -> temper_parse_signed(t, r, n)
  end
end

def temper_trim(s: String) -> String do
  temper_trim_end(temper_trim_start(s))
end

# `or` evaluates both sides, so an empty string still reaches `char_code`,
# which answers nil past the end -- and a nil handed to `temper_is_space`,
# whose parameter is declared `Int`, is a type error rather than a false. The
# emptiness test has to be a `case`, which is the only thing here that does
# not evaluate the branch it does not take.
def temper_trim_start(s: String) -> String do
  case empty?(s) do
    true -> s
    _ -> temper_trim_start_at(s)
  end
end

def temper_trim_start_at(s: String) -> String do
  case temper_is_space(char_code(s, 0)) do
    true -> temper_trim_start(slice(s, 1, length(s) - 1))
    _ -> s
  end
end

def temper_trim_end(s: String) -> String do
  case empty?(s) do
    true -> s
    _ -> temper_trim_end_at(s)
  end
end

def temper_trim_end_at(s: String) -> String do
  case temper_is_space(char_code(s, length(s) - 1)) do
    true -> temper_trim_end(slice(s, 0, length(s) - 1))
    _ -> s
  end
end

def temper_is_space(c: Int) -> Bool do
  c == 32 or c == 9 or c == 10 or c == 13
end

def temper_parse_signed(s: String, radix: Int, n: Int) -> Int do
  case char_code(s, 0) == 45 do
    true -> temper_parse_from(s, radix, 1, n, true)
    _ -> temper_parse_from(s, radix, 0, n, false)
  end
end

def temper_parse_from(s: String, radix: Int, start: Int, n: Int, neg: Bool) -> Int do
  case start >= n do
    # A sign with no digits after it is not a number.
    true -> temper_bubble()
    _ -> temper_parse_end(temper_parse_digits(s, radix, start, n, 0), neg)
  end
end

def temper_parse_digits(s: String, radix: Int, i: Int, n: Int, acc: Int) -> Int do
  case i >= n do
    true -> acc
    _ -> temper_parse_digits(s, radix, i + 1, n, temper_parse_step(acc, radix, temper_digit_value(char_code(s, i))))
  end
end

def temper_parse_step(acc: Int, radix: Int, d: Int) -> Int do
  case d < 0 or d >= radix do
    true -> temper_bubble()
    _ -> temper_parse_scale(acc, radix, d)
  end
end

# Checked before multiplying, because the multiply itself now wraps silently.
def temper_parse_scale(acc: Int, radix: Int, d: Int) -> Int do
  case acc < temper_int64_min() / radix do
    true -> temper_bubble()
    _ -> temper_parse_subtract(acc * radix, d)
  end
end

def temper_parse_subtract(scaled: Int, d: Int) -> Int do
  case scaled < temper_int64_min() + d do
    true -> temper_bubble()
    _ -> scaled - d
  end
end

def temper_parse_end(acc: Int, neg: Bool) -> Int do
  case neg do
    true -> acc
    _ -> temper_parse_positive(acc)
  end
end

def temper_parse_positive(acc: Int) -> Int do
  case acc == temper_int64_min() do
    # The one magnitude that has no positive counterpart.
    true -> temper_bubble()
    _ -> 0 - acc
  end
end

def temper_parse_int32(s: String, radix: Any) -> Int do
  temper_fit_int32(temper_parse_int64(s, radix))
end

def temper_fit_int32(v: Int) -> Int do
  case v < 0 - 2147483648 or v > 2147483647 do
    true -> temper_bubble()
    _ -> v
  end
end

def temper_int_rem(a: Int, b: Int) -> Int do
  case b == 0 do
    true -> bubble :divide_by_zero
    _ -> rem(a, b)
  end
end

# ── Failure ──────────────────────────────────────────

# `bubble` only parses inside an actor handler or a case arm, never at the top
# of a `def` body, so these wrap it in a one-armed case to make it callable
# from anywhere. Both are catchable with try/catch.

def temper_bubble() -> Any do
  temper_raise(:temper_bubble)
end

# `bubble` only parses as an arm's body or inside a handler, never as a bare
# statement in a `def`, so everything that wants to raise a value from
# somewhere else goes through this arm.
def temper_raise(why: Any) -> Any do
  case true do
    true -> bubble why
  end
end

# Code the frontend refused, translated anyway.
#
# semantics/broken pushes deliberately bad Temper through every backend to
# check it degrades rather than crashing, so a `TODO()` in the translator is
# the wrong answer: it takes the compiler down and reports nothing.
#
# The reason is what the bubble carries: `bubble` takes any value, and the
# earlier parse error that suggested otherwise was `bubble` needing to be an
# arm's body rather than a bare statement in a `def`.
def temper_untranslatable(why: String) -> Any do
  case true do
    true -> bubble why
  end
end

def temper_panic() -> Any do
  case true do
    true -> bubble :temper_panic
  end
end

# ── Bit operations ───────────────────────────────────
#
# Blimp has no bitwise operators, so these do it arithmetically over the
# unsigned 32-bit view and wrap the result back to signed.

# Unsigned 32-bit view, so the bit loops only ever see non-negative numbers.
def temper_u32(n: Int) -> Int do
  m = rem(n, 4294967296)
  case m < 0 do
    true -> m + 4294967296
    _ -> m
  end
end

# One loop drives all three of and/or/xor; `which` picks the rule.
def temper_bitop(which: Atom, a: Int, b: Int) -> Int do
  temper_int32(temper_bitop_loop(which, temper_u32(a), temper_u32(b), 0, 1))
end

def temper_bit_rule(which: Atom, x: Int, y: Int) -> Int do
  case which do
    :and -> x * y
    :or -> case x + y > 0 do
      true -> 1
      _ -> 0
    end
    _ -> rem(x + y, 2)
  end
end

def temper_bitop_loop(which: Atom, a: Int, b: Int, acc: Int, place: Int) -> Int do
  case a == 0 and b == 0 do
    true -> acc
    _ -> temper_bitop_loop(
      which,
      a / 2,
      b / 2,
      acc + (temper_bit_rule(which, rem(a, 2), rem(b, 2)) * place),
      place * 2
    )
  end
end

def temper_bit_and(a: Int, b: Int) -> Int do temper_bitop(:and, a, b) end
def temper_bit_or(a: Int, b: Int) -> Int do temper_bitop(:or, a, b) end
def temper_bit_xor(a: Int, b: Int) -> Int do temper_bitop(:xor, a, b) end
def temper_bit_not(a: Int) -> Int do temper_int32(0 - a - 1) end

# ── Int64 bit operations ─────────────────────────────
#
# The 32-bit helpers above work on the unsigned image of a value, which needs
# 2^32 and fits. 2^64 does not, so these split the sign bit off and put it
# back: `temper_low63` is the value with that bit cleared, which for a negative
# number is what subtracting the minimum computes.

def temper_low63(n: Int) -> Int do
  case n < 0 do
    true -> n - temper_int64_min()
    _ -> n
  end
end

def temper_sign_bit(n: Int) -> Int do
  case n < 0 do
    true -> 1
    _ -> 0
  end
end

def temper_bitop64(which: Atom, a: Int, b: Int) -> Int do
  low = temper_bitop_loop(which, temper_low63(a), temper_low63(b), 0, 1)
  case temper_bit_rule(which, temper_sign_bit(a), temper_sign_bit(b)) == 1 do
    true -> low + temper_int64_min()
    _ -> low
  end
end

def temper_bit_and64(a: Int, b: Int) -> Int do temper_bitop64(:and, a, b) end
def temper_bit_or64(a: Int, b: Int) -> Int do temper_bitop64(:or, a, b) end
def temper_bit_xor64(a: Int, b: Int) -> Int do temper_bitop64(:xor, a, b) end
def temper_bit_not64(a: Int) -> Int do 0 - a - 1 end

# The multiply wraps, which is what a left shift past the top bit means.
def temper_shl64(a: Int, n: Int) -> Int do
  a * temper_pow2(temper_shift_count(n, 64))
end

def temper_shr64(a: Int, n: Int) -> Int do
  d = temper_pow2(temper_shift_count(n, 64))
  q = a / d
  case a < 0 and rem(a, d) != 0 do
    true -> q - 1
    _ -> q
  end
end

# Logical: shift a negative right by one arithmetically, clear the sign bit the
# copy left behind, then shift the rest of the way on a non-negative number.
def temper_ushr64(a: Int, n: Int) -> Int do
  k = temper_shift_count(n, 64)
  case k == 0 or a >= 0 do
    true -> temper_shr64(a, k)
    _ -> temper_low63(temper_shr64(a, 1)) / temper_pow2(k - 1)
  end
end

def temper_pow2(n: Int) -> Int do
  case n <= 0 do
    true -> 1
    _ -> 2 * temper_pow2(n - 1)
  end
end

# A shift count is its low bits, so `x << -1` is `x << 31` at 32 bits and
# `x << 63` at 64. Blimp's rem keeps the sign, so -1 stays -1 and 2^-1 is 1:
# the shift quietly did nothing.
def temper_shift_count(n: Int, width: Int) -> Int do
  k = rem(n, width)
  case k < 0 do
    true -> k + width
    _ -> k
  end
end

def temper_shl32(a: Int, n: Int) -> Int do
  temper_int32(a * temper_pow2(temper_shift_count(n, 32)))
end

# Arithmetic shift right: Blimp's `/` truncates toward zero, so a negative
# value needs the floor, which is what a shift means.
def temper_shr32(a: Int, n: Int) -> Int do
  d = temper_pow2(temper_shift_count(n, 32))
  q = a / d
  case a < 0 and rem(a, d) != 0 do
    true -> q - 1
    _ -> q
  end
end

def temper_ushr32(a: Int, n: Int) -> Int do
  temper_int32(temper_u32(a) / temper_pow2(temper_shift_count(n, 32)))
end

# ── Runtime type tests ───────────────────────────────

def temper_list_has(items: List, target: Any) -> Bool do
  case empty?(items) do
    true -> false
    _ -> case head(items) == target do
      true -> true
      _ -> temper_list_has(tail(items), target)
    end
  end
end

# Temper's `instanceof`. A primitive answers from type_of; an actor answers
# from the :__temper_types list every translated class carries, which names the
# class and its supertypes so a subtype test works.
def temper_is_a(value: Any, tag: Atom) -> Bool do
  case tag do
    # StringIndexOption is an Int here, split by sign, so these two tags are
    # predicates rather than type names. Temper asks both ways: `i is
    # StringIndex` and `i as NoStringIndex`.
    :StringIndex -> temper_is_string_index(value)
    :NoStringIndex -> temper_is_no_string_index(value)
    _ -> temper_has_type(value, tag)
  end
end

def temper_is_string_index(value: Any) -> Bool do
  case type_of(value) == :integer do
    true -> value >= 0
    _ -> false
  end
end

def temper_is_no_string_index(value: Any) -> Bool do
  case type_of(value) == :integer do
    true -> value < 0
    _ -> false
  end
end

def temper_has_type(value: Any, tag: Atom) -> Bool do
  t = type_of(value)
  case t == :actor_ref do
    true -> temper_list_has(value <- :__temper_types, tag)
    _ -> t == tag
  end
end

# ── Core API shims ───────────────────────────────────

# Blimp's slice takes a LENGTH, not an end index: slice("hello", 0, 4) is
# "hell". Temper's second argument is an exclusive end.
def temper_slice(s: Any, start: Int, stop: Int) -> Any do
  case stop <= start do
    true -> ""
    _ -> slice(s, start, stop - start)
  end
end

# Temper's String indices are byte offsets, and `end` is one past the last.
def temper_string_end(s: String) -> Int do
  length(s)
end

def temper_string_has_index(s: String, i: Int) -> Bool do
  i >= 0 and i < length(s)
end

# Some Temper conversions are no-ops in Blimp.
def temper_identity(x: Any) -> Any do
  x
end

# Temper's split, which Blimp's `split` is not: Blimp runs consecutive
# separators together and counts bytes, while Temper keeps every empty piece
# and an empty separator cuts between code points.
#
#     " g  h i".split(" ")   ["", "g", "", "h", "i"]
#     "def".split("")        ["d", "e", "f"]
#     "".split("")           []
#     "\u{1F30D}".split("")         ["\u{1F30D}"]     -- four bytes, one piece
def temper_string_split(s: String, sep: String) -> List do
  case sep == "" do
    true -> temper_string_code_points(s)
    _ -> temper_string_split_loop(s, sep, [])
  end
end

def temper_string_split_loop(s: String, sep: String, acc: List) -> List do
  i = temper_index_of_from(s, sep, 0)
  case i < 0 do
    true -> acc ++ [s]
    _ -> temper_string_split_loop(
      slice(s, i + length(sep), length(s) - i - length(sep)),
      sep,
      acc ++ [slice(s, 0, i)]
    )
  end
end

# `indexOf` answers a byte offset, or -1 when the needle is not there. A nil
# start means from the beginning.
def temper_string_index_of(s: String, needle: String, start: Any) -> Int do
  from = case nil?(start) do
    true -> 0
    _ -> start
  end
  temper_index_of_from(s, needle, from)
end

def temper_index_of_from(s: String, sub: String, i: Int) -> Int do
  case i + length(sub) > length(s) do
    true -> 0 - 1
    _ -> case slice(s, i, length(sub)) == sub do
      true -> i
      _ -> temper_index_of_from(s, sub, i + 1)
    end
  end
end

def temper_string_code_points(s: String) -> List do
  temper_code_points_loop(s, 0, [])
end

def temper_code_points_loop(s: String, i: Int, acc: List) -> List do
  case i >= length(s) do
    true -> acc
    _ ->
      n = u8_seq_len(char_code(s, i))
      temper_code_points_loop(s, i + n, acc ++ [slice(s, i, n)])
  end
end

# ── List operations ──────────────────────────────────
#
# Blimp has map, reduce and sort but no filter or join, and its `reduce` takes
# the initial value, so reduceFrom lines up with it directly.

def temper_filter(items: Any, keep: Any) -> List do
  temper_filter_loop(temper_items(items), keep, [])
end

def temper_filter_loop(items: List, keep: Any, acc: List) -> List do
  case empty?(items) do
    true -> acc
    _ ->
      x = head(items)
      acc2 = case keep(x) do
        true -> append(acc, x)
        _ -> acc
      end
      temper_filter_loop(tail(items), keep, acc2)
  end
end

def temper_join(source: Any, sep: String, show: Any) -> String do
  items = temper_items(source)
  case empty?(items) do
    true -> ""
    _ -> temper_join_loop(tail(items), sep, show, show(head(items)))
  end
end

def temper_join_loop(items: List, sep: String, show: Any, acc: String) -> String do
  case empty?(items) do
    true -> acc
    _ -> temper_join_loop(tail(items), sep, show, concat(acc, concat(sep, show(head(items)))))
  end
end

def temper_for_each(source: Any, body: Any) -> Any do
  items = temper_items(source)
  case empty?(items) do
    true -> nil
    _ ->
      body(head(items))
      temper_for_each(tail(items), body)
  end
end

# ── Comparison and float maths ───────────────────────

# Blimp cannot compare strings with < or >, so strings go byte by byte.
def temper_str_cmp(a: String, b: String) -> Int do
  temper_str_cmp_loop(a, b, 0)
end

def temper_str_cmp_loop(a: String, b: String, i: Int) -> Int do
  case i >= length(a) do
    true -> case i >= length(b) do
      true -> 0
      _ -> 0 - 1
    end
    _ -> case i >= length(b) do
      true -> 1
      _ ->
        x = char_code(a, i)
        y = char_code(b, i)
        case x == y do
          true -> temper_str_cmp_loop(a, b, i + 1)
          _ -> case x < y do
            true -> 0 - 1
            _ -> 1
          end
        end
    end
  end
end

# Temper's `<=>` is -1, 0 or 1.
def temper_cmp(a: Any, b: Any) -> Int do
  case type_of(a) == :string do
    true -> temper_str_cmp(a, b)
    _ -> case a < b do
      true -> 0 - 1
      _ -> case a > b do
        true -> 1
        _ -> 0
      end
    end
  end
end

def temper_str_lt(a: String, b: String) -> Bool do temper_str_cmp(a, b) < 0 end
def temper_str_le(a: String, b: String) -> Bool do temper_str_cmp(a, b) <= 0 end
def temper_str_gt(a: String, b: String) -> Bool do temper_str_cmp(a, b) > 0 end
def temper_str_ge(a: String, b: String) -> Bool do temper_str_cmp(a, b) >= 0 end

# Float remainder, truncated toward zero like Temper's.
def temper_fmod(a: Float, b: Float) -> Float do
  q = a / b
  t = case q < 0.0 do
    true -> 0.0 - floor(0.0 - q)
    _ -> floor(q)
  end
  a - (b * t)
end

# Temper's Float64.near, which is Python's math.isclose: within a relative
# tolerance of the larger magnitude, or within an absolute one. A nil argument
# is one the caller left out, so the defaults live here.
def temper_float_near(x: Float, y: Float, rel_tol: Any, abs_tol: Any) -> Bool do
  r = case nil?(rel_tol) do
    true -> 1e-9
    _ -> rel_tol
  end
  a = case nil?(abs_tol) do
    true -> 0.0
    _ -> abs_tol
  end
  margin = temper_float_max(temper_float_max(abs(x), abs(y)) * r, a)
  abs(x - y) <= margin
end

# Temper's ceil, floor and round answer a Float; Blimp's answer an Int, and
# adding 0.0 is how an Int becomes one.
def temper_float_ceil(f: Float) -> Float do
  ceil(f) + 0.0
end

def temper_float_floor(f: Float) -> Float do
  floor(f) + 0.0
end

def temper_float_round(f: Float) -> Float do
  round(f) + 0.0
end

# Blimp's min and max are Int-only, and its checker says so before the program
# runs.
# A NaN in either position wins, which is what Temper says and what a plain
# comparison does not do: every comparison with a NaN is false.
def temper_float_min(a: Float, b: Float) -> Float do
  case a != a or b != b do
    true -> temper_float_nan()
    _ -> case a < b do
      true -> a
      _ -> b
    end
  end
end

def temper_float_max(a: Float, b: Float) -> Float do
  case a != a or b != b do
    true -> temper_float_nan()
    _ -> case a > b do
      true -> a
      _ -> b
    end
  end
end

# -1.0, 1.0, or the zero itself: Temper keeps the sign of a signed zero, so
# `(-0.0).sign()` is -0.0 and not 0.0.
def temper_float_sign(f: Float) -> Float do
  case f > 0.0 do
    true -> 1.0
    _ -> case f < 0.0 do
      true -> 0.0 - 1.0
      _ -> f
    end
  end
end

# `**`. Blimp's pow takes a fractional exponent, so this is a rename; it used
# to be exponentiation by squaring and bubbled on anything but a whole number,
# which made `4.0 ** -0.5` an error rather than 0.5.
def temper_pow(base: Float, exponent: Float) -> Float do
  pow(base, exponent)
end

# ── Tests ────────────────────────────────────────────
#
# Blimp has no test framework to ask for a report, so a translated test module
# runs its own tests and writes the JUnit XML the harness reads. Each test is
# a `def` taking the Test it reports to; an assertion that fails records the
# message its closure returns, and one that passes never calls the closure.

actor TemperTest do
  state failures: List :: []

  on :assert(ok: Bool, msg: Any) do
    next = case ok do
      true -> failures
      _ -> append(failures, msg())
    end
    become failures: next
    reply nil
  end

  on :failures do
    reply failures
  end
end

def temper_run_tests(tests: List, path: String) -> Any do
  results = temper_run_tests_loop(tests, [])
  # A report nobody can read is a failed run: the harness reads this file, and
  # `write_file` answers false rather than raising, so ignoring the answer
  # would turn "could not write" into "all tests passed".
  wrote = write_file(path, temper_junit_xml(results))
  case wrote do
    true -> nil
    _ -> puts(concat("could not write ", path))
  end
  already = case wrote do
    true -> 0
    _ -> 1
  end
  temper_report_tests(results, already)
end

def temper_run_tests_loop(tests: List, acc: List) -> List do
  case empty?(tests) do
    true -> acc
    _ ->
      entry = head(tests)
      temper_run_tests_loop(tail(tests), append(acc, [elem(entry, 0), temper_run_one(elem(entry, 1))]))
  end
end

# A test that bubbles has failed, and what it managed to assert before that
# still counts: the messages come back either way.
def temper_run_one(body: Any) -> List do
  t = spawn TemperTest
  try do
    body(t)
    t <- :failures
  catch do
    append(t <- :failures, "test raised")
  end
end

# A run that reported a failure exits non-zero, because a test runner that
# says nothing to the shell is a test runner nobody notices.
def temper_report_tests(results: List, failed: Int) -> Any do
  case empty?(results) do
    true -> case failed > 0 do
      true -> exit(1)
      _ -> nil
    end
    _ ->
      entry = head(results)
      failures = elem(entry, 1)
      mark = case empty?(failures) do
        true -> "ok   "
        _ -> "FAIL "
      end
      puts(concat(mark, elem(entry, 0)))
      temper_report_tests(tail(results), failed + length(failures))
  end
end

def temper_junit_xml(results: List) -> String do
  concat(
    concat("<testsuites>\n<testsuite name=\"blimp\" tests=\"", to_string(length(results))),
    concat(
      concat("\" failures=\"", to_string(temper_count_failed(results, 0))),
      concat("\" time=\"0\">\n", concat(temper_junit_cases(results, ""), "</testsuite>\n</testsuites>\n"))
    )
  )
end

def temper_count_failed(results: List, n: Int) -> Int do
  case empty?(results) do
    true -> n
    _ ->
      next = case empty?(elem(head(results), 1)) do
        true -> n
        _ -> n + 1
      end
      temper_count_failed(tail(results), next)
  end
end

def temper_junit_cases(results: List, acc: String) -> String do
  case empty?(results) do
    true -> acc
    _ -> temper_junit_cases(tail(results), concat(acc, temper_junit_case(head(results))))
  end
end

def temper_junit_case(entry: List) -> String do
  name = temper_xml_escape(elem(entry, 0))
  failures = elem(entry, 1)
  open = concat(concat("<testcase name=\"", name), "\" time=\"0\" classname=\"blimp\">")
  case empty?(failures) do
    true -> concat(open, "</testcase>\n")
    _ ->
      why = temper_xml_escape(temper_join_failures(failures, ""))
      concat(open, concat(concat("<failure message=\"", why), concat("\">", concat(why, "</failure></testcase>\n"))))
  end
end

def temper_join_failures(failures: List, acc: String) -> String do
  case empty?(failures) do
    true -> acc
    _ ->
      next = case empty?(acc) do
        true -> head(failures)
        _ -> concat(acc, concat(", ", head(failures)))
      end
      temper_join_failures(tail(failures), next)
  end
end

# The message is a Temper string and lands in both an attribute and the
# element body, so the five that matter all go.
def temper_xml_escape(s: String) -> String do
  temper_xml_escape_loop(s, 0, "")
end

def temper_xml_escape_loop(s: String, i: Int, acc: String) -> String do
  case i >= length(s) do
    true -> acc
    _ -> temper_xml_escape_loop(s, i + 1, concat(acc, temper_xml_char(slice(s, i, 1))))
  end
end

def temper_xml_char(c: String) -> String do
  case c == "&" do
    true -> "&amp;"
    _ -> case c == "<" do
      true -> "&lt;"
      _ -> case c == ">" do
        true -> "&gt;"
        _ -> case c == "\"" do
          true -> "&quot;"
          _ -> case c == "'" do
            true -> "&apos;"
            _ -> c
          end
        end
      end
    end
  end
end

# ── Mutable lists ────────────────────────────────────
#
# Temper's ListBuilder is mutable and Blimp's lists are not, so a builder is
# an actor holding a list. Every handler assigns the field name -- which
# shadows the state -- and publishes with one `become`.

actor TemperListBuilder do
  state items: List :: []

  on :__temper_types do reply [:ListBuilder, :Listed] end
  on :items do reply items end
  on :length do reply length(items) end
  on :isEmpty do reply empty?(items) end
  on :get(i: Int) do reply elem(items, i) end

  on :add(x: Any) do
    items = append(items, x)
    become items: items
    reply nil
  end

  on :add_at(x: Any, at: Int) do
    items = temper_list_insert(items, at, x)
    become items: items
    reply nil
  end

  # splice answers the items it removed, and takes nil for either bound: no
  # index means from the start, no count means to the end. The index is
  # clamped, so `splice(length, nil, xs)` appends.
  on :splice_from(index: Any) do
    start = temper_splice_start(index, length(items))
    removed = temper_list_slice(items, start, length(items))
    items = temper_list_slice(items, 0, start)
    become items: items
    reply removed
  end

  on :splice_range(index: Any, removeCount: Any) do
    start = temper_splice_start(index, length(items))
    stop = temper_splice_stop(start, removeCount, length(items))
    removed = temper_list_slice(items, start, stop)
    items = temper_list_slice(items, 0, start) ++ temper_list_slice(items, stop, length(items))
    become items: items
    reply removed
  end

  on :splice(index: Any, removeCount: Any, newValues: Any) do
    start = temper_splice_start(index, length(items))
    stop = temper_splice_stop(start, removeCount, length(items))
    removed = temper_list_slice(items, start, stop)
    before = temper_list_slice(items, 0, start)
    after = temper_list_slice(items, stop, length(items))
    items = (before ++ temper_items(newValues)) ++ after
    become items: items
    reply removed
  end

  on :addAll(xs: Any) do
    items = items ++ temper_items(xs)
    become items: items
    reply nil
  end

  on :addAll_at(xs: Any, at: Int) do
    before = temper_list_slice(items, 0, at)
    after = temper_list_slice(items, at, length(items))
    items = (before ++ temper_items(xs)) ++ after
    become items: items
    reply nil
  end

  on :set(i: Int, v: Any) do
    items = set_at(items, i, v)
    become items: items
    reply nil
  end

  on :reverse do
    items = reverse(items)
    become items: items
    reply nil
  end

  on :clear do
    become items: []
    reply nil
  end

  on :removeLast do
    n = length(items)
    last = elem(items, n - 1)
    items = temper_list_slice(items, 0, n - 1)
    become items: items
    reply last
  end

  on :sort(cmp: Any) do
    items = temper_sort(items, cmp)
    become items: items
    reply nil
  end
end

# A sequence argument may be a plain list or a builder actor; this is what
# lets one set of operations serve both.
def temper_items(x: Any) -> List do
  case nil?(x) do
    true -> []
    _ -> case type_of(x) == :actor_ref do
      true -> x <- :items
      _ -> x
    end
  end
end

# The bounds of a splice, which take nil for "from the start" and "to the end"
# and clamp to what is there. Negative counts remove nothing, as in every other
# backend's temper-core.
def temper_splice_start(index: Any, n: Int) -> Int do
  case nil?(index) or index < 0 do
    true -> 0
    _ -> case index > n do
      true -> n
      _ -> index
    end
  end
end

def temper_splice_stop(start: Int, removeCount: Any, n: Int) -> Int do
  count = case nil?(removeCount) do
    true -> n
    _ -> case removeCount < 0 do
      true -> 0
      _ -> removeCount
    end
  end
  stop = start + count
  case stop > n do
    true -> n
    _ -> stop
  end
end

# `getOr` answers the fallback for an index that is not there, where `get`
# bubbles.
def temper_get_or(source: Any, index: Int, fallback: Any) -> Any do
  items = temper_items(source)
  case index < 0 or index >= length(items) do
    true -> fallback
    _ -> elem(items, index)
  end
end

# ── HTTP ─────────────────────────────────────────────
#
# std/net leaves `sendRequest` and the three NetResponse members with no body.
# Every other backend hands them to a library -- be-py to `requests`, be-js to
# `fetch`. Blimp has `tcp_connect` and a socket, so this is the client.
#
# Synchronous: the request is made and read to completion before
# `sendRequest` answers, and the promise it answers is already settled. Temper
# code still awaits it, which costs one resumption and reads the same.

# std/net says "Backends may or may not support all request features in which
# case, send should return a broken promise". A bubble out of the URL parser or
# the response parser is one of those cases, and it was reaching the caller as
# a bubble instead -- past the `orelse` that a broken promise would have fed.
def temper_net_send(url: String, method: String, body: Any, mime: Any) -> Any do
  try do
    temper_net_send_or_bubble(url, method, body, mime)
  catch e do
    temper_net_broken_because(e)
  end
end

def temper_net_send_or_bubble(url: String, method: String, body: Any, mime: Any) -> Any do
  where = temper_url_parts(url)
  fd = tcp_connect(elem(where, 0), elem(where, 1))
  case nil?(fd) do
    true -> temper_net_broken()
    _ -> temper_net_exchange(fd, where, method, body, mime)
  end
end

def temper_net_broken() -> Any do
  temper_net_broken_because("net: the host could not be reached")
end

def temper_net_broken_because(why: Any) -> Any do
  p = temper_new_promise()
  temper_promise_break_with(p, why)
  p
end

def temper_net_exchange(fd: Int, where: List, method: String, body: Any, mime: Any) -> Any do
  ignore_method = method
  text = case nil?(body) do
    true -> ""
    _ -> body
  end
  tcp_write(fd, temper_http_request(where, method, text, mime))
  raw = temper_http_drain(fd, "")
  tcp_close(fd)
  p = temper_new_promise()
  temper_promise_complete(p, temper_http_response(raw, method))
  p
end

# `Connection: close` is not politeness, it is the read loop's terminator: the
# only thing that tells this where the body ends is the server hanging up.
def temper_http_request(where: List, method: String, body: String, mime: Any) -> String do
  head = concat(method, concat(" ", concat(elem(where, 2), " HTTP/1.1\r\n")))
  # The authority as written, port and all: a server behind a non-default port
  # matches on what the client asked for, and dropping the port is how a
  # virtual host serves the wrong site.
  host = concat("Host: ", concat(elem(where, 3), "\r\n"))
  ctype = case nil?(mime) do
    true -> ""
    _ -> concat("Content-Type: ", concat(mime, "\r\n"))
  end
  clen = concat("Content-Length: ", concat(to_string(length(body)), "\r\n"))
  # Saying nothing here does not mean "send it uncompressed". RFC 9110 12.5.3:
  # "If no Accept-Encoding header field is in the request, any content coding
  # is considered acceptable by the user agent." Silence is the *widest*
  # possible answer, not the narrowest. Nothing in this client can inflate a
  # gzip stream, so it says what it can actually read.
  cenc = "Accept-Encoding: identity\r\n"
  concat(head, concat(host, concat(ctype, concat(clen, concat(cenc, concat("Connection: close\r\n\r\n", body))))))
end

# `tcp_read` answers nil for "would block" and the empty string at end of
# stream, so both have to stop the loop.
def temper_http_drain(fd: Int, acc: String) -> String do
  chunk = tcp_read(fd)
  case nil?(chunk) do
    true -> acc
    _ -> temper_http_more(fd, acc, chunk)
  end
end

def temper_http_more(fd: Int, acc: String, chunk: String) -> String do
  case empty?(chunk) do
    true -> acc
    _ -> temper_http_drain(fd, concat(acc, chunk))
  end
end

# [host, port, path, hostheader]
#
# The scheme is checked rather than discarded. Discarding it meant `https://`
# went out in cleartext on port 80 and came back 200, which is a wrong answer
# dressed as a right one -- the caller has no way to find out it was not
# encrypted.
def temper_url_parts(url: String) -> List do
  after = split(url, "://")
  case length(after) > 1 do
    true -> temper_url_scheme(downcase(elem(after, 0)), elem(after, 1))
    _ -> temper_url_authority(url)
  end
end

def temper_url_scheme(scheme: String, rest: String) -> List do
  case scheme == "http" do
    true -> temper_url_authority(rest)
    _ -> bubble concat("net: no support for the scheme ", scheme)
  end
end

# The authority ends at the first `/`, `?` or `#`, and the three are not
# interchangeable. A `#fragment` never goes on the wire -- it is for whoever
# opened the URL -- and a `?query` does. Cutting only at `/` left the query
# attached to the port, so `http://host?q=1` was refused with
# "the port is not a number: 8762?q=1", which is a message asserting something
# false about a URL that is fine.
def temper_url_authority(whole: String) -> List do
  rest = elem(split(whole, "#"), 0)
  q = split(rest, "?")
  query = case length(q) > 1 do
    true -> concat("?", temper_join_query(q, 1, ""))
    _ -> ""
  end
  cut = split(elem(q, 0), "/")
  hostport = elem(cut, 0)
  path = case length(cut) > 1 do
    true -> concat("/", temper_join_rest(cut, 1, ""))
    _ -> "/"
  end
  temper_url_hostport(hostport, concat(path, query))
end

# A query can contain a `?`, so everything after the first one is the query.
def temper_join_query(parts: List, i: Int, acc: String) -> String do
  case i >= length(parts) do
    true -> acc
    _ -> temper_join_query(parts, i + 1, temper_join_query_piece(acc, elem(parts, i)))
  end
end

def temper_join_query_piece(acc: String, piece: String) -> String do
  case empty?(acc) do
    true -> piece
    _ -> concat(acc, concat("?", piece))
  end
end

# An IPv6 literal is bracketed and full of colons, and userinfo puts an `@`
# before the host. Splitting on `:` gets both wrong, so both are refused by
# name rather than mis-parsed into a connection somewhere else.
def temper_url_hostport(hostport: String, path: String) -> List do
  bad = contains(hostport, "@") or contains(hostport, "[")
  case bad do
    true -> bubble concat("net: no support for this authority: ", hostport)
    _ -> temper_url_split_port(hostport, path)
  end
end

def temper_url_split_port(hostport: String, path: String) -> List do
  hp = split(hostport, ":")
  port = case length(hp) > 1 do
    true -> temper_url_port(elem(hp, 1))
    _ -> 80
  end
  case empty?(elem(hp, 0)) do
    true -> bubble "net: the URL has no host"
    _ -> [elem(hp, 0), port, path, hostport]
  end
end

# `temper_parse_int32` bubbles a bare `:temper_bubble` on anything that is not
# a number, so `http://host:port` said nothing about which part was wrong. And
# a port outside 1..65535 is not a port.
def temper_url_port(text: String) -> Int do
  n = try do
    temper_parse_int32(text, 10)
  catch e do
    temper_raise(concat("net: the port is not a number: ", text))
  end
  case n >= 1 and n <= 65535 do
    true -> n
    _ -> bubble concat("net: the port is out of range: ", text)
  end
end

def temper_join_rest(parts: List, i: Int, acc: String) -> String do
  case i >= length(parts) do
    true -> acc
    _ -> temper_join_rest(parts, i + 1, temper_join_piece(acc, elem(parts, i)))
  end
end

def temper_join_piece(acc: String, piece: String) -> String do
  case empty?(acc) do
    true -> piece
    _ -> concat(acc, concat("/", piece))
  end
end

actor TemperNetResponse do
  state code: Int :: 0
  state ctype: Any :: nil
  state text: String :: ""

  on :__init(c: Int, t: Any, b: String) do
    become code: c, ctype: t, text: b
    reply nil
  end

  on :status do reply code end
  on :contentType do reply ctype end

  # A Promise, because that is what std/net declares, even though the body was
  # read before this object existed.
  on :bodyContent do
    p = temper_new_promise()
    temper_promise_complete(p, text)
    reply p
  end
end

def temper_http_response(raw: String, method: String) -> Any do
  split_at = split(raw, "\r\n\r\n")
  head = elem(split_at, 0)
  body = case length(split_at) > 1 do
    true -> temper_join_body(split_at, 1, "")
    _ -> ""
  end
  lines = split(head, "\r\n")
  decoded = temper_http_decode(lines, body)
  temper_http_check_length(lines, decoded, method)
  r = spawn TemperNetResponse
  r <- :__init(temper_http_status(lines), temper_http_content_type(lines, 1), decoded)
  r
end

# `tcp_read` answers the empty string both when the peer closes cleanly and
# when it resets, so a connection dropped halfway through a body looks exactly
# like a body that ended. The server already said how long it would be.
# A chunked body is not a body. It is a sequence of `<hex size>\r\n<bytes>\r\n`
# ending in a zero-length chunk, and handing it to the caller unread gave them
# a string with the sizes still in it -- `5\r\nhello\r\n1\r\n \r\n6\r\nworld!`
# where the answer is `hello world!`. That is not a missing feature, it is a
# wrong answer that looks like a right one, which is the thing this project
# has a rule against.
#
# HTTP/1.1 servers reach for chunked whenever they do not know the length in
# advance, which is most of the time something is generated rather than read
# off a disk.
def temper_http_decode(lines: List, body: String) -> String do
  temper_http_check_encoding(lines)
  te = temper_http_header(lines, 1, "transfer-encoding")
  # Not `not(nil?(te)) and contains(downcase(te), ...)`. `and` evaluates both
  # sides, so a response with no Transfer-Encoding handed nil to `downcase`
  # and the whole request died -- which is chapter 71's finding, made again by
  # the person who wrote chapter 71.
  r = case nil?(te) do
    true -> body
    _ -> temper_http_decode_with(te, body)
  end
  r
end

# A server that encodes a body anyway is not one this can read, and handing
# back deflate bytes as a `String` is the same wrong-answer-that-looks-right
# the chunked case was.
def temper_http_check_encoding(lines: List) -> Any do
  ce = temper_http_header(lines, 1, "content-encoding")
  r = case nil?(ce) do
    true -> nil
    _ -> temper_http_check_encoding_with(ce)
  end
  r
end

def temper_http_check_encoding_with(ce: String) -> Any do
  r = case downcase(temper_trim(ce)) == "identity" do
    true -> nil
    _ -> temper_raise(concat("net: a response body encoded with ", ce))
  end
  r
end

def temper_http_decode_with(te: String, body: String) -> String do
  r = case contains(downcase(te), "chunked") do
    true -> temper_http_dechunk(body, 0, "")
    _ -> body
  end
  r
end

def temper_http_dechunk(s: String, i: Int, acc: String) -> String do
  e = temper_find_from(s, "\r\n", i)
  case e < 0 do
    true -> temper_raise("net: a chunked body ended in the middle of a chunk header")
    _ -> temper_http_dechunk_size(s, i, e, acc)
  end
end

# A chunk header may carry extensions after a `;`. Nothing here reads them.
def temper_http_dechunk_size(s: String, i: Int, e: Int, acc: String) -> String do
  size = temper_hex_value(elem(split(slice(s, i, e - i), ";"), 0))
  case size == 0 do
    true -> acc
    _ -> temper_http_dechunk_take(s, e + 2, size, acc)
  end
end

def temper_http_dechunk_take(s: String, at: Int, size: Int, acc: String) -> String do
  case at + size > length(s) do
    true -> temper_raise("net: a chunked body stopped early")
    _ -> temper_http_dechunk(s, at + size + 2, concat(acc, slice(s, at, size)))
  end
end

def temper_find_from(s: String, needle: String, from: Int) -> Int do
  case from + length(needle) > length(s) do
    true -> 0 - 1
    _ -> temper_find_at(s, needle, from)
  end
end

def temper_find_at(s: String, needle: String, at: Int) -> Int do
  case slice(s, at, length(needle)) == needle do
    true -> at
    _ -> temper_find_from(s, needle, at + 1)
  end
end

def temper_hex_value(text: String) -> Int do
  temper_hex_loop(temper_trim(text), 0, 0)
end

def temper_hex_loop(s: String, i: Int, acc: Int) -> Int do
  case i >= length(s) do
    true -> acc
    _ -> temper_hex_loop(s, i + 1, acc * 16 + temper_hex_digit(char_code(s, i)))
  end
end

def temper_hex_digit(c: Int) -> Int do
  d = case c >= 48 and c <= 57 do
    true -> c - 48
    _ -> temper_hex_letter(c)
  end
  d
end

def temper_hex_letter(c: Int) -> Int do
  d = case c >= 97 and c <= 102 do
    true -> c - 87
    _ -> temper_hex_upper(c)
  end
  d
end

def temper_hex_upper(c: Int) -> Int do
  d = case c >= 65 and c <= 70 do
    true -> c - 55
    _ -> temper_raise("net: a chunk size that is not hexadecimal")
  end
  d
end

# Three kinds of response carry a `Content-Length` and no body: a HEAD, which
# reports what a GET would have returned, and a 204 or a 304, which say there
# is nothing to send. Comparing the declared length against nothing turned
# every one of them into a broken promise.
#
# The check is not skipped for them, it is inverted: they must have no body.
# A HEAD that arrives carrying twenty bytes is a server doing something the
# caller cannot use, and handing it over quietly is how it would go unnoticed.
def temper_http_check_length(lines: List, body: String, method: String) -> Any do
  bodiless = upcase(method) == "HEAD" or temper_http_bodiless_status(lines)
  case bodiless do
    true -> temper_http_expect_empty(body)
    _ -> temper_http_check_declared(lines, body)
  end
end

def temper_http_bodiless_status(lines: List) -> Bool do
  code = temper_http_status(lines)
  code == 204 or code == 304
end

def temper_http_expect_empty(body: String) -> Any do
  case empty?(body) do
    true -> nil
    _ -> temper_raise(concat("net: a response that should carry no body carried ", concat(to_string(length(body)), " bytes")))
  end
end

def temper_http_check_declared(lines: List, body: String) -> Any do
  declared = temper_http_header(lines, 1, "content-length")
  case nil?(declared) do
    true -> nil
    _ -> temper_http_compare_length(declared, body)
  end
end

def temper_http_compare_length(declared: String, body: String) -> Any do
  n = try do
    temper_parse_int32(declared, 10)
  catch e do
    0 - 1
  end
  short = n >= 0 and length(body) < n
  case short do
    true -> temper_raise(concat("net: the response body stopped early, ", concat(to_string(length(body)), concat(" bytes of ", declared))))
    _ -> nil
  end
end

# A body can contain a blank line, so re-joining everything after the first one
# is not the same as taking the second piece.
def temper_join_body(parts: List, i: Int, acc: String) -> String do
  case i >= length(parts) do
    true -> acc
    _ -> temper_join_body(parts, i + 1, temper_join_body_piece(acc, elem(parts, i)))
  end
end

def temper_join_body_piece(acc: String, piece: String) -> String do
  case empty?(acc) do
    true -> piece
    _ -> concat(acc, concat("\r\n\r\n", piece))
  end
end

def temper_http_status(lines: List) -> Int do
  fields = split(elem(lines, 0), " ")
  case length(fields) > 1 do
    true -> temper_parse_int32(elem(fields, 1), 10)
    _ -> 0
  end
end

def temper_http_content_type(lines: List, i: Int) -> Any do
  temper_http_header(lines, i, "content-type")
end

def temper_http_header(lines: List, i: Int, want: String) -> Any do
  case i >= length(lines) do
    true -> nil
    _ -> temper_http_header_line(lines, i, want)
  end
end

def temper_http_header_line(lines: List, i: Int, want: String) -> Any do
  colon = split(elem(lines, i), ":")
  hit = length(colon) > 1 and downcase(elem(colon, 0)) == want
  case hit do
    true -> temper_trim(temper_join_rest_colon(colon, 1, ""))
    _ -> temper_http_header(lines, i + 1, want)
  end
end

# A content type can contain a colon in its parameters, so the value is
# everything after the first one.
def temper_join_rest_colon(parts: List, i: Int, acc: String) -> String do
  case i >= length(parts) do
    true -> acc
    _ -> temper_join_rest_colon(parts, i + 1, temper_join_colon_piece(acc, elem(parts, i)))
  end
end

def temper_join_colon_piece(acc: String, piece: String) -> String do
  case empty?(acc) do
    true -> piece
    _ -> concat(acc, concat(":", piece))
  end
end

# ── Promises ────────────────────────────────
#
# Single-threaded: there is no scheduler and no queue, and completing a promise
# resumes whatever was waiting on it right there.
#
# Waiters are a list. be-rust keeps one slot and says so -- "Provide only one
# bonus listener for now. TODO Do we need more?" -- and copying that meant a
# second generator awaiting the same unsettled promise silently replaced the
# first, which then never woke. be-cpp had already moved to a vector. Two
# `await`s on one promise is ordinary Temper.
#
# The waiting generators are *replied* rather than resumed inside the handler.
# Resuming there would re-enter the actor while it is still in the middle of a
# `become`, and the state the handler was about to commit would be the state
# the resumed code sees.

actor TemperPromise do
  state settled: Bool :: false
  state broken: Bool :: false
  state held: Any :: nil
  state waiting: List :: []

  # "The API doesn't prevent multiple resolution, but the first one wins",
  # says the test, and be-cpp's `breakpromise` guards the same way. A second
  # settle is not an error; it is ignored, and it wakes nothing, because the
  # first one already did.
  on :settle(v: Any, brk: Bool) do
    case settled do
      true -> reply []
      _ ->
        w = waiting
        become settled: true, broken: brk, held: v, waiting: []
        reply w
    end
  end

  on :onReady(task: Any) do
    case settled do
      true -> reply [task]
      _ ->
        become waiting: append(waiting, task)
        reply []
    end
  end

  on :isBroken do reply broken end
  on :held do reply held end
end

def temper_new_promise() -> Any do
  spawn TemperPromise
end

# The builder and the promise are the same actor. Temper keeps them apart so
# that handing out a promise does not hand out the right to complete it; Blimp
# has no way to express that, and pretending otherwise with a wrapper would
# cost an actor per promise and protect nothing.
def temper_promise_of(b: Any) -> Any do
  b
end

def temper_promise_complete(b: Any, v: Any) -> Any do
  temper_promise_resume(b <- :settle(v, false))
end

def temper_promise_break(b: Any) -> Any do
  temper_promise_break_with(b, nil)
end

# A broken promise can carry why it broke. `breakPromise()` from Temper has no
# argument and so carries nothing, but temper-core breaks promises of its own
# -- a URL it cannot parse, a host it cannot reach -- and those reasons went
# nowhere: every message written for them was unreachable, because the only
# thing reading a broken promise raised a bare `:temper_bubble`.
def temper_promise_break_with(b: Any, why: Any) -> Any do
  temper_promise_resume(b <- :settle(why, true))
end

def temper_promise_resume(tasks: List) -> Any do
  case empty?(tasks) do
    true -> nil
    _ ->
      temper_generator_next(head(tasks))
      temper_promise_resume(tail(tasks))
  end
end

def temper_awake_upon(p: Any, gen: Any) -> Any do
  temper_promise_resume(p <- :onReady(gen))
end

def temper_promise_result(p: Any) -> Any do
  case p <- :isBroken do
    true -> temper_promise_raise(p <- :held)
    _ -> p <- :held
  end
end

def temper_promise_raise(why: Any) -> Any do
  case nil?(why) do
    true -> temper_bubble()
    _ -> bubble why
  end
end

# `async { ... }` builds a generator and drives it. Whatever it awaits arranges
# its own resumption through `temper_awake_upon`.
#
# One step is all this does. A generator that awaits something already settled
# runs to the end inside that step; one that awaits a timer or a keypress
# stops, parked on the promise's `waiting` list, and `temper_run_async` is what
# eventually wakes it.
def temper_async(factory: Any) -> Any do
  temper_generator_next(factory())
end

# ── The scheduler ────────────────────────────────────
#
# Blimp has one thread and no event loop. Two `async` blocks that both wait --
# one on 200ms, one on a keypress -- have to take turns, and before this they
# did not: `temper_sleep` and `temper_read_line` blocked and answered a promise
# that was already settled, so whichever block ran first ran to completion.
# Snake read every key before drawing its first frame.
#
# So waiting is no longer done where the waiting is asked for. `sleep` and
# `readLine` hand back an unsettled promise and record what it is waiting for,
# and one loop at the end of the program does all the waiting in one place --
# which is what an event loop is.
#
# The promise actor already parked generators on `waiting` for an unsettled
# promise. Nothing had ever left one unsettled.

actor TemperScheduler do
  # [due_ms, promise], not kept in order: there are never many.
  state timers: List :: []
  # Promises waiting for a line, oldest first.
  state readers: List :: []

  on :add_timer(due: Int, p: Any) do
    become timers: append(timers, [due, p])
    reply nil
  end

  on :add_reader(p: Any) do
    become readers: append(readers, p)
    reply nil
  end

  on :timers do reply timers end
  on :readers do reply readers end

  on :take_reader do
    case empty?(readers) do
      true -> reply nil
      _ ->
        first = elem(readers, 0)
        become readers: tail(readers)
        reply first
    end
  end

  # Hand back the timers that are due and keep the rest.
  on :take_due(at: Int) do
    due = filter(timers, fn(t: List) do elem(t, 0) <= at end)
    become timers: filter(timers, fn(t: List) do elem(t, 0) > at end)
    reply due
  end
end

temper_the_scheduler = spawn TemperScheduler

def temper_sleep(ms: Int) -> Any do
  p = temper_new_promise()
  temper_the_scheduler <- :add_timer(now_ms() + ms, p)
  p
end

def temper_read_line() -> Any do
  p = temper_new_promise()
  temper_the_scheduler <- :add_reader(p)
  p
end

# Run until nothing is waiting any more.
#
# Emitted at the end of every translated program. With nothing queued it does
# one comparison and returns, which is what happens in every program that does
# not use `async`.
def temper_run_async() -> Any do
  timers = temper_the_scheduler <- :timers
  readers = temper_the_scheduler <- :readers
  case empty?(timers) and empty?(readers) do
    true -> nil
    _ -> temper_run_async_step(timers, readers)
  end
end

def temper_run_async_step(timers: List, readers: List) -> Any do
  now = now_ms()
  # How long there is to wait before the earliest timer comes due. With no
  # timer at all, a tenth of a second, so a program waiting only on a key is
  # not a spin loop.
  wait = case empty?(timers) do
    true -> 100
    _ -> temper_earliest_due(timers, 0, now + 100000) - now
  end
  temper_run_async_wait(readers, wait)
  temper_wake_due(now_ms())
  temper_run_async()
end

# Wait for a keypress if anything wants one, and for the clock otherwise.
#
# `tcp_poll` is poll(2) under a name that has only ever been used on sockets.
# Stdin is fd 0 and poll does not care, so one call covers both kinds of
# waiting: it returns as soon as a line can be read, or when the wait is up.
def temper_run_async_wait(readers: List, wait: Int) -> Any do
  ms = case wait < 0 do
    true -> 0
    _ -> wait
  end
  r = case empty?(readers) do
    true -> sleep_ms(ms)
    _ -> temper_poll_and_rest(ms)
  end
  r
end

# A poll that answers early with nothing to read would send this loop straight
# round again, and with the next timer still not due there would be nothing to
# do but poll again: a spin, at a whole core, for as long as the program runs.
# That is not hypothetical -- `poll` on a /dev/null stdin does exactly this on
# macOS -- so the rest of the wait is slept off rather than trusted away.
def temper_poll_and_rest(ms: Int) -> Any do
  before = now_ms()
  ready = tcp_poll([0], ms)
  woke = not(empty?(ready))
  r = case woke do
    true -> temper_wake_reader()
    _ -> temper_rest_of(ms - (now_ms() - before))
  end
  r
end

def temper_rest_of(left: Int) -> Any do
  r = case left > 0 do
    true -> sleep_ms(left)
    _ -> nil
  end
  r
end

# `read_line` blocks, and it is called only once poll has said a read will not
# block. At end of input it answers nil, which is the null the Temper
# signature promises, so the waiting block sees its stream end rather than
# waiting for a line that is never coming.
def temper_wake_reader() -> Any do
  p = temper_the_scheduler <- :take_reader
  r = case nil?(p) do
    true -> nil
    _ -> temper_promise_complete(p, read_line())
  end
  r
end

def temper_wake_due(at: Int) -> Any do
  each(temper_the_scheduler <- :take_due(at), fn(t: List) do
    temper_promise_complete(elem(t, 1), 0)
  end)
end

def temper_earliest_due(timers: List, i: Int, best: Int) -> Int do
  case i >= length(timers) do
    true -> best
    _ -> temper_earliest_due(timers, i + 1, temper_min_int(best, elem(elem(timers, i), 0)))
  end
end

def temper_min_int(a: Int, b: Int) -> Int do
  case a < b do
    true -> a
    _ -> b
  end
end

# ── Regex: the pattern parser ────────────────────────
#
# Temper's RegexFormatter renders a RegexNode tree into a pattern string in
# whatever dialect the backend asked for, then hands it back to be compiled.
# The dialect is narrow because the formatter is the only thing writing it:
# `(?:...)`, `(?<name>...)`, `[a-z]`, `|`, `+ * ?`, `^ $ . \b \d \s \w`, and
# `\u{N}` decimal, which is what temper_regex_push_code writes.
#
# A node is a list tagged with an atom:
#   [:lit, code]            one code point
#   [:set, negated, pairs]  pairs are [lo, hi]
#   [:cls, kind, negated]   kind is :d, :s or :w
#   [:any] [:bol] [:eol] [:wordb]
#   [:seq, nodes]  [:alt, branches]
#   [:rep, node, min, max]  max -1 is unbounded
#   [:cap, name, node]

# Every read of the pattern that is not already bounds-checked goes through
# this. `elem` past the end of a list answers nil, and nil compares unequal to
# every code point, so an unterminated pattern walked off the end: `[abc`
# looped until the heap ceiling and `a\` died with a bare TypeError. A pattern
# that stops in the middle of something now says so.
def temper_rx_at(p: List, i: Int) -> Int do
  case i >= length(p) do
    true -> bubble "regex: the pattern ends in the middle of something"
    _ -> elem(p, i)
  end
end

# `temper_rx_alt` stops at a `)` or at the end of the pattern, so stopping
# anywhere else is impossible and stopping early means there was a `)` with no
# `(`. Taking the node and discarding the rest is what compiled `a)b` to `a`.
def temper_rx_parse(pattern: String) -> Any do
  p = u8_code_points(pattern)
  r = temper_rx_alt(p, 0)
  case elem(r, 1) >= length(p) do
    true -> elem(r, 0)
    _ -> bubble "regex: a closing paren with nothing open"
  end
end

def temper_rx_alt(p: List, i: Int) -> List do
  first = temper_rx_seq(p, i)
  temper_rx_alt_more(p, elem(first, 1), [elem(first, 0)])
end

def temper_rx_alt_more(p: List, i: Int, acc: List) -> List do
  more = i < length(p) and elem(p, i) == 124
  case more do
    true ->
      nxt = temper_rx_seq(p, i + 1)
      temper_rx_alt_more(p, elem(nxt, 1), append(acc, elem(nxt, 0)))
    _ -> temper_rx_one_or(acc, i, :alt)
  end
end

# A sequence or alternation of one is that one, so the common pattern does not
# pay for a wrapper the matcher would have to walk through.
def temper_rx_one_or(acc: List, i: Int, tag: Atom) -> List do
  n = case length(acc) == 1 do
    true -> elem(acc, 0)
    _ -> [tag, acc]
  end
  [n, i]
end

def temper_rx_seq(p: List, i: Int) -> List do
  temper_rx_seq_loop(p, i, [])
end

def temper_rx_seq_loop(p: List, i: Int, acc: List) -> List do
  stop = i >= length(p) or elem(p, i) == 124 or elem(p, i) == 41
  case stop do
    true -> temper_rx_seq_end(acc, i)
    _ ->
      one = temper_rx_rep(p, i)
      temper_rx_seq_loop(p, elem(one, 1), append(acc, elem(one, 0)))
  end
end

# An empty branch matches the empty string, which `(^|,)` needs when neither
# side is there.
def temper_rx_seq_end(acc: List, i: Int) -> List do
  r = case empty?(acc) do
    true -> [[:seq, []], i]
    _ -> temper_rx_one_or(acc, i, :seq)
  end
  r
end

def temper_rx_rep(p: List, i: Int) -> List do
  a = temper_rx_atom(p, i)
  temper_rx_rep_loop(p, elem(a, 1), elem(a, 0))
end

# An unbounded repetition of an unbounded repetition is one repetition.
#
# `pushRepeat` wraps its body in `(?:...)` before adding the quantifier, so
# `new Repeat(new Repeat(x, 0, null), 0, null)` is written `(?:(?:x)*)*` and
# is ordinary Temper. Matched as written it is exponential: the outer loop can
# split n characters between its iterations in 2^(n-1) ways and a backtracking
# matcher tries all of them. Twelve characters exhausted a 2 GB heap.
#
#   (x*)*  (x*)+  (x+)*  ->  x*        (x+)+  ->  x+
#
# Only when the body holds no capture. The collapsed node matches the same
# strings either way, but which iteration a group inside it ends up recording
# is not the same question, and that one has an answer the tests depend on.
def temper_rx_collapse(node: Any, lo: Int, hi: Int) -> List do
  inner_lo = elem(node, 2)
  # Both bounds unbounded, and the inner minimum at most one.
  #
  # `lo * inner_lo` is only the right new minimum when one iteration of the
  # outer loop can produce every count the inner loop can. It cannot for
  # `(x{2,})*`, whose language is "nothing, or two or more" -- `pushRepeat`
  # writes that for `Repeat(Repeat(x, 2, null), 0, null)` and the first
  # version of this collapsed it to `x*`, which accepts a single `x`.
  # An outer minimum of at least one means every reachable total is `lo *
  # inner_lo` or more, so `(x{2,})+` is `x{2,}`. Only an outer minimum of zero
  # needs the inner minimum small, because `(x{2,})*` is "nothing, or two or
  # more" and no single repetition says that.
  ok = hi < 0 and elem(node, 3) < 0 and (lo >= 1 or inner_lo <= 1)
  r = case ok and not(temper_rx_has_cap(elem(node, 1))) do
    true -> [:rep, elem(node, 1), lo * inner_lo, 0 - 1]
    _ -> [:rep, node, lo, hi]
  end
  r
end

def temper_rx_rep_node(node: Any, lo: Int, hi: Int) -> List do
  r = case elem(node, 0) == :rep do
    true -> temper_rx_collapse(node, lo, hi)
    _ -> [:rep, node, lo, hi]
  end
  r
end

def temper_rx_has_cap(node: Any) -> Bool do
  tag = elem(node, 0)
  r = case tag == :cap do
    true -> true
    _ -> temper_rx_has_cap_in(node, tag)
  end
  r
end

def temper_rx_has_cap_in(node: Any, tag: Atom) -> Bool do
  r = case tag == :seq or tag == :alt do
    true -> temper_rx_any_has_cap(elem(node, 1), 0)
    _ -> temper_rx_has_cap_rep(node, tag)
  end
  r
end

def temper_rx_has_cap_rep(node: Any, tag: Atom) -> Bool do
  r = case tag == :rep do
    true -> temper_rx_has_cap(elem(node, 1))
    _ -> false
  end
  r
end

def temper_rx_any_has_cap(nodes: List, i: Int) -> Bool do
  r = case i >= length(nodes) do
    true -> false
    _ -> temper_rx_any_has_cap_at(nodes, i)
  end
  r
end

def temper_rx_any_has_cap_at(nodes: List, i: Int) -> Bool do
  r = case temper_rx_has_cap(elem(nodes, i)) do
    true -> true
    _ -> temper_rx_any_has_cap(nodes, i + 1)
  end
  r
end

def temper_rx_rep_loop(p: List, i: Int, node: Any) -> List do
  c = case i < length(p) do
    true -> elem(p, i)
    _ -> 0
  end
  r = case c == 43 do
    true -> temper_rx_rep_loop(p, i + 1, temper_rx_rep_node(node, 1, 0 - 1))
    _ -> temper_rx_rep_star(p, i, node, c)
  end
  r
end

def temper_rx_rep_star(p: List, i: Int, node: Any, c: Int) -> List do
  r = case c == 42 do
    true -> temper_rx_rep_loop(p, i + 1, temper_rx_rep_node(node, 0, 0 - 1))
    _ -> temper_rx_rep_opt(p, i, node, c)
  end
  r
end

def temper_rx_rep_opt(p: List, i: Int, node: Any, c: Int) -> List do
  r = case c == 63 do
    true -> temper_rx_rep_loop(p, i + 1, [:rep, node, 0, 1])
    _ -> temper_rx_rep_brace(p, i, node, c)
  end
  r
end

# `pushRepeat` writes `{min}`, `{min,}` or `{min,max}` for every bound that is
# not one of `? * +`. Reading `{` as a literal instead does not fail, it
# matches a brace -- a wrong answer rather than a crash, which is the shape of
# bug this project has a rule against.
#
# The digit test after `{` is belt and braces rather than the load-bearing
# thing an earlier comment here claimed. A literal brace is on both formatters'
# escape list, so it arrives as `\{` and never reaches this, and
# `regexCompileFormatted` has exactly one caller. A bare `{` can only be a
# repeat.
def temper_rx_rep_brace(p: List, i: Int, node: Any, c: Int) -> List do
  r = case c == 123 do
    true -> temper_rx_rep_maybe_bound(p, i, node)
    _ -> [node, i]
  end
  r
end

def temper_rx_rep_maybe_bound(p: List, i: Int, node: Any) -> List do
  r = case temper_rx_digit_at(p, i + 1) do
    true -> temper_rx_rep_bound(p, i + 1, node)
    _ -> [node, i]
  end
  r
end

def temper_rx_digit_at(p: List, i: Int) -> Bool do
  r = case i >= length(p) do
    true -> false
    _ -> temper_rx_is_digit(elem(p, i))
  end
  r
end

def temper_rx_rep_bound(p: List, i: Int, node: Any) -> List do
  lo = temper_rx_rep_num(p, i, 0)
  temper_rx_rep_after_lo(p, elem(lo, 1), node, elem(lo, 0))
end

def temper_rx_rep_num(p: List, i: Int, acc: Int) -> List do
  case temper_rx_digit_at(p, i) do
    true -> temper_rx_rep_num(p, i + 1, acc * 10 + (elem(p, i) - 48))
    _ -> [acc, i]
  end
end

def temper_rx_rep_after_lo(p: List, i: Int, node: Any, lo: Int) -> List do
  r = case temper_rx_at(p, i) == 125 do
    true -> temper_rx_rep_loop(p, i + 1, [:rep, node, lo, lo])
    _ -> temper_rx_rep_comma(p, i + 1, node, lo)
  end
  r
end

def temper_rx_rep_comma(p: List, i: Int, node: Any, lo: Int) -> List do
  r = case temper_rx_at(p, i) == 125 do
    true -> temper_rx_rep_loop(p, i + 1, [:rep, node, lo, 0 - 1])
    _ -> temper_rx_rep_hi(p, i, node, lo)
  end
  r
end

# `Repeat` validates nothing, so `new Repeat(x, 1, 0)` is constructible and
# formats as `{1,0}`. Compiling it gives a pattern that cannot match anything,
# ever, and answers false rather than saying why. Node and Python both refuse
# it where it is written; this refuses it where it is read.
def temper_rx_rep_hi(p: List, i: Int, node: Any, lo: Int) -> List do
  hi = temper_rx_rep_num(p, i, 0)
  case elem(hi, 0) < lo do
    true -> temper_raise(concat("regex: a repeat of at least ", concat(to_string(lo), concat(" and at most ", concat(to_string(elem(hi, 0)), " can never match")))))
    _ -> temper_rx_rep_close(p, elem(hi, 1), node, lo, elem(hi, 0))
  end
end

# Stepping past the `}` without checking it is there swallowed whatever stood
# in its place: `a{2,3Xb` compiled to exactly `a{2,3}b`, losing the `X`.
def temper_rx_rep_close(p: List, i: Int, node: Any, lo: Int, hi: Int) -> List do
  case temper_rx_at(p, i) == 125 do
    true -> temper_rx_rep_loop(p, i + 1, temper_rx_rep_node(node, lo, hi))
    _ -> temper_raise("regex: a repeat bound is never closed")
  end
end

def temper_rx_atom(p: List, i: Int) -> List do
  c = temper_rx_at(p, i)
  r = case c == 40 do
    true -> temper_rx_group(p, i + 1)
    _ -> temper_rx_atom_set(p, i, c)
  end
  r
end

def temper_rx_atom_set(p: List, i: Int, c: Int) -> List do
  r = case c == 91 do
    true -> temper_rx_set(p, i + 1)
    _ -> temper_rx_atom_esc(p, i, c)
  end
  r
end

def temper_rx_atom_esc(p: List, i: Int, c: Int) -> List do
  r = case c == 92 do
    true -> temper_rx_escape(p, i + 1)
    _ -> temper_rx_atom_special(p, i, c)
  end
  r
end

def temper_rx_atom_special(p: List, i: Int, c: Int) -> List do
  r = case c == 46 do
    true -> [[:any], i + 1]
    _ -> temper_rx_atom_bol(p, i, c)
  end
  r
end

def temper_rx_atom_bol(p: List, i: Int, c: Int) -> List do
  r = case c == 94 do
    true -> [[:bol], i + 1]
    _ -> temper_rx_atom_eol(p, i, c)
  end
  r
end

def temper_rx_atom_eol(p: List, i: Int, c: Int) -> List do
  r = case c == 36 do
    true -> [[:eol], i + 1]
    _ -> [[:lit, c], i + 1]
  end
  r
end

def temper_rx_group(p: List, i: Int) -> List do
  r = case temper_rx_at(p, i) == 63 do
    true -> temper_rx_group_q(p, i + 1)
    _ -> temper_rx_group_body(p, i, "")
  end
  r
end

def temper_rx_group_q(p: List, i: Int) -> List do
  r = case temper_rx_at(p, i) == 58 do
    true -> temper_rx_group_body(p, i + 1, "")
    _ -> temper_rx_group_name(p, i + 1, "")
  end
  r
end

def temper_rx_group_name(p: List, i: Int, name: String) -> List do
  r = case temper_rx_at(p, i) == 62 do
    true -> temper_rx_group_body(p, i + 1, name)
    _ -> temper_rx_group_name(p, i + 1, concat(name, u8_encode_checked(temper_rx_at(p, i))))
  end
  r
end

def temper_rx_group_body(p: List, i: Int, name: String) -> List do
  inner = temper_rx_alt(p, i)
  node = case length(name) == 0 do
    true -> elem(inner, 0)
    _ -> [:cap, name, elem(inner, 0)]
  end
  # Asking `temper_rx_at` whether the next character is a `)` bubbles with the
  # generic "ends in the middle of something" when there is no next character,
  # so the branch that said a group was never closed was unreachable -- 30,761
  # fuzzed patterns never produced it. The position is what to test.
  case elem(inner, 1) >= length(p) do
    true -> bubble "regex: a group is never closed"
    _ -> [node, elem(inner, 1) + 1]
  end
end

def temper_rx_escape(p: List, i: Int) -> List do
  c = temper_rx_at(p, i)
  r = case c == 117 do
    true -> temper_rx_ucode(p, i + 2, 0)
    _ -> temper_rx_escape_named(p, i, c)
  end
  r
end

# `\u{N}` with N in decimal, because temper_regex_push_code writes it in
# decimal: this file is both ends of that escape.
def temper_rx_ucode(p: List, i: Int, acc: Int) -> List do
  c = temper_rx_at(p, i)
  r = case c == 125 do
    true -> [[:lit, acc], i + 1]
    _ -> temper_rx_ucode(p, i + 1, acc * 10 + (c - 48))
  end
  r
end

def temper_rx_escape_named(p: List, i: Int, c: Int) -> List do
  cls = temper_rx_class_of(c)
  r = case nil?(cls) do
    true -> [[:lit, temper_rx_unescape(c)], i + 1]
    _ -> [cls, i + 1]
  end
  r
end

def temper_rx_class_of(c: Int) -> Any do
  r = case c == 100 do
    true -> [:cls, :d, false]
    _ -> temper_rx_class_of_s(c)
  end
  r
end

def temper_rx_class_of_s(c: Int) -> Any do
  r = case c == 115 do
    true -> [:cls, :s, false]
    _ -> temper_rx_class_of_w(c)
  end
  r
end

def temper_rx_class_of_w(c: Int) -> Any do
  r = case c == 119 do
    true -> [:cls, :w, false]
    _ -> temper_rx_class_of_neg(c)
  end
  r
end

def temper_rx_class_of_neg(c: Int) -> Any do
  r = case c == 68 do
    true -> [:cls, :d, true]
    _ -> temper_rx_class_of_neg_s(c)
  end
  r
end

def temper_rx_class_of_neg_s(c: Int) -> Any do
  r = case c == 83 do
    true -> [:cls, :s, true]
    _ -> temper_rx_class_of_neg_w(c)
  end
  r
end

def temper_rx_class_of_neg_w(c: Int) -> Any do
  r = case c == 87 do
    true -> [:cls, :w, true]
    _ -> temper_rx_class_of_b(c)
  end
  r
end

def temper_rx_class_of_b(c: Int) -> Any do
  r = case c == 98 do
    true -> [:wordb]
    _ -> nil
  end
  r
end

def temper_rx_unescape(c: Int) -> Int do
  r = case c == 110 do
    true -> 10
    _ -> temper_rx_unescape_t(c)
  end
  r
end

def temper_rx_unescape_t(c: Int) -> Int do
  r = case c == 116 do
    true -> 9
    _ -> temper_rx_unescape_r(c)
  end
  r
end

def temper_rx_unescape_r(c: Int) -> Int do
  r = case c == 114 do
    true -> 13
    _ -> c
  end
  r
end

def temper_rx_set(p: List, i: Int) -> List do
  neg = temper_rx_at(p, i) == 94
  j = case neg do
    true -> i + 1
    _ -> i
  end
  temper_rx_set_loop(p, j, [], neg)
end

def temper_rx_set_loop(p: List, i: Int, acc: List, neg: Bool) -> List do
  case temper_rx_at(p, i) == 93 do
    true -> [[:set, neg, acc], i + 1]
    _ -> temper_rx_set_item(p, i, acc, neg)
  end
end

# A set item is either [:range, lo, hi] or a whole [:cls, kind, negated]:
# `[\s\-]` is a class and a literal side by side, and a range endpoint is not
# the only thing that can appear between the brackets.
def temper_rx_set_item(p: List, i: Int, acc: List, neg: Bool) -> List do
  case temper_rx_at(p, i) == 92 do
    true -> temper_rx_set_backslash(p, i + 1, acc, neg)
    _ -> temper_rx_set_range(p, i, acc, neg)
  end
end

# Split in two rather than written as `not(nil?(cls)) and elem(cls, 0) == :cls`,
# because Blimp's `and` evaluates both sides: `false and elem(nil, 0)` raises.
# A `case` arm is the only thing here that does not run until it is chosen.
def temper_rx_set_backslash(p: List, i: Int, acc: List, neg: Bool) -> List do
  cls = temper_rx_class_of(temper_rx_at(p, i))
  r = case nil?(cls) do
    true -> temper_rx_set_range(p, i - 1, acc, neg)
    _ -> temper_rx_set_class(p, i, acc, neg, cls)
  end
  r
end

def temper_rx_set_class(p: List, i: Int, acc: List, neg: Bool, cls: List) -> List do
  r = case elem(cls, 0) == :cls do
    true -> temper_rx_set_loop(p, i + 1, append(acc, cls), neg)
    _ -> temper_rx_set_range(p, i - 1, acc, neg)
  end
  r
end

def temper_rx_set_range(p: List, i: Int, acc: List, neg: Bool) -> List do
  first = temper_rx_set_code(p, i)
  lo = elem(first, 0)
  j = elem(first, 1)
  ranged = j + 1 < length(p) and elem(p, j) == 45 and elem(p, j + 1) != 93
  case ranged do
    true ->
      second = temper_rx_set_code(p, j + 1)
      temper_rx_set_loop(p, elem(second, 1), append(acc, [:range, lo, elem(second, 0)]), neg)
    _ -> temper_rx_set_loop(p, j, append(acc, [:range, lo, lo]), neg)
  end
end

def temper_rx_set_code(p: List, i: Int) -> List do
  c = temper_rx_at(p, i)
  r = case c == 92 do
    true -> temper_rx_set_escape(p, i + 1)
    _ -> [c, i + 1]
  end
  r
end

def temper_rx_set_escape(p: List, i: Int) -> List do
  c = temper_rx_at(p, i)
  r = case c == 117 do
    true -> temper_rx_set_ucode(p, i + 2, 0)
    _ -> temper_rx_set_plain(p, i, c)
  end
  r
end

def temper_rx_set_ucode(p: List, i: Int, acc: Int) -> List do
  c = temper_rx_at(p, i)
  r = case c == 125 do
    true -> [acc, i + 1]
    _ -> temper_rx_set_ucode(p, i + 1, acc * 10 + (c - 48))
  end
  r
end

def temper_rx_set_plain(p: List, i: Int, c: Int) -> List do
  ignore = p
  [temper_rx_unescape(c), i + 1]
end

# ── Regex: the matcher ───────────────────────────────
#
# Backtracking, in continuation-passing style: every node is handed a `k` to
# call with the position it reached, and answers nil for "no match from here".
# The alternative is an explicit backtrack stack, and `k` is the same thing
# written in the language instead of in a data structure.
#
# `cps` is the subject decoded once into code points. Positions are indices
# into it, not byte offsets -- the byte offsets come back at the very end,
# because a Temper StringIndex is one.

def temper_rx_match(node: Any, cps: List, pos: Int, caps: List, k: Any) -> Any do
  tag = elem(node, 0)
  case tag == :lit do
    true -> temper_rx_m_lit(node, cps, pos, caps, k)
    _ -> temper_rx_m_set(node, tag, cps, pos, caps, k)
  end
end

def temper_rx_m_lit(node: Any, cps: List, pos: Int, caps: List, k: Any) -> Any do
  case pos < length(cps) and elem(cps, pos) == elem(node, 1) do
    true -> k(pos + 1, caps)
    _ -> nil
  end
end

def temper_rx_m_set(node: Any, tag: Atom, cps: List, pos: Int, caps: List, k: Any) -> Any do
  case tag == :set do
    true -> temper_rx_m_test(temper_rx_in_set(node, cps, pos), cps, pos, caps, k)
    _ -> temper_rx_m_cls(node, tag, cps, pos, caps, k)
  end
end

def temper_rx_m_cls(node: Any, tag: Atom, cps: List, pos: Int, caps: List, k: Any) -> Any do
  case tag == :cls do
    true -> temper_rx_m_test(temper_rx_in_cls(node, cps, pos), cps, pos, caps, k)
    _ -> temper_rx_m_any(node, tag, cps, pos, caps, k)
  end
end

# "In default mode, matches any Unicode code point except newline", which
# std/regex says about Dot and this did not do.
def temper_rx_m_any(node: Any, tag: Atom, cps: List, pos: Int, caps: List, k: Any) -> Any do
  case tag == :any do
    true -> temper_rx_m_test(pos < length(cps) and elem(cps, pos) != 10, cps, pos, caps, k)
    _ -> temper_rx_m_bol(node, tag, cps, pos, caps, k)
  end
end

# Consumes one code point when `ok`.
def temper_rx_m_test(ok: Bool, cps: List, pos: Int, caps: List, k: Any) -> Any do
  ignore = cps
  case ok do
    true -> k(pos + 1, caps)
    _ -> nil
  end
end

# Consumes nothing.
def temper_rx_m_here(ok: Bool, pos: Int, caps: List, k: Any) -> Any do
  case ok do
    true -> k(pos, caps)
    _ -> nil
  end
end

def temper_rx_m_bol(node: Any, tag: Atom, cps: List, pos: Int, caps: List, k: Any) -> Any do
  case tag == :bol do
    true -> temper_rx_m_here(pos == 0, pos, caps, k)
    _ -> temper_rx_m_eol(node, tag, cps, pos, caps, k)
  end
end

def temper_rx_m_eol(node: Any, tag: Atom, cps: List, pos: Int, caps: List, k: Any) -> Any do
  case tag == :eol do
    true -> temper_rx_m_here(pos == length(cps), pos, caps, k)
    _ -> temper_rx_m_wordb(node, tag, cps, pos, caps, k)
  end
end

def temper_rx_m_wordb(node: Any, tag: Atom, cps: List, pos: Int, caps: List, k: Any) -> Any do
  case tag == :wordb do
    true -> temper_rx_m_here(temper_rx_at_wordb(cps, pos), pos, caps, k)
    _ -> temper_rx_m_seq(node, tag, cps, pos, caps, k)
  end
end

def temper_rx_m_seq(node: Any, tag: Atom, cps: List, pos: Int, caps: List, k: Any) -> Any do
  case tag == :seq do
    true -> temper_rx_seq_at(elem(node, 1), 0, cps, pos, caps, k)
    _ -> temper_rx_m_alt(node, tag, cps, pos, caps, k)
  end
end

def temper_rx_m_alt(node: Any, tag: Atom, cps: List, pos: Int, caps: List, k: Any) -> Any do
  case tag == :alt do
    true -> temper_rx_alt_at(elem(node, 1), 0, cps, pos, caps, k)
    _ -> temper_rx_m_rep(node, tag, cps, pos, caps, k)
  end
end

def temper_rx_m_rep(node: Any, tag: Atom, cps: List, pos: Int, caps: List, k: Any) -> Any do
  case tag == :rep do
    true -> temper_rx_rep_at(elem(node, 1), elem(node, 2), elem(node, 3), 0, cps, pos, caps, k)
    _ -> temper_rx_m_cap(node, tag, cps, pos, caps, k)
  end
end

def temper_rx_m_cap(node: Any, tag: Atom, cps: List, pos: Int, caps: List, k: Any) -> Any do
  case tag == :cap do
    true -> temper_rx_cap_at(node, cps, pos, caps, k)
    _ -> bubble :regex_unknown_node
  end
end

def temper_rx_cap_at(node: Any, cps: List, pos: Int, caps: List, k: Any) -> Any do
  name = elem(node, 1)
  start = pos
  temper_rx_match(elem(node, 2), cps, pos, caps, fn (p2: Int, c2: List) -> Any do
    k(p2, append(c2, [name, start, p2]))
  end)
end

def temper_rx_seq_at(nodes: List, idx: Int, cps: List, pos: Int, caps: List, k: Any) -> Any do
  case idx >= length(nodes) do
    true -> k(pos, caps)
    _ -> temper_rx_match(elem(nodes, idx), cps, pos, caps, fn (p2: Int, c2: List) -> Any do
      temper_rx_seq_at(nodes, idx + 1, cps, p2, c2, k)
    end)
  end
end

def temper_rx_alt_at(branches: List, idx: Int, cps: List, pos: Int, caps: List, k: Any) -> Any do
  case idx >= length(branches) do
    true -> nil
    _ ->
      got = temper_rx_match(elem(branches, idx), cps, pos, caps, k)
      case nil?(got) do
        true -> temper_rx_alt_at(branches, idx + 1, cps, pos, caps, k)
        _ -> got
      end
  end
end

# Greedy: take one more if the body still can, and fall back to stopping.
#
# The `p2 == pos` guard is the whole of the zero-advance problem. `(^|,)\s*`
# against "apples, bananas" matches the empty string at the start, and without
# this a `*` over something that can match nothing loops until the heap runs
# out. One empty iteration is allowed, because that is what lets a `+` whose
# body is empty satisfy its minimum; a second is refused.
def temper_rx_rep_at(node: Any, lo: Int, hi: Int, n: Int, cps: List, pos: Int, caps: List, k: Any) -> Any do
  room = hi < 0 or n < hi
  more = case room do
    true -> temper_rx_match(node, cps, pos, caps, fn (p2: Int, c2: List) -> Any do
      temper_rx_rep_step(node, lo, hi, n, pos, p2, cps, c2, k)
    end)
    _ -> nil
  end
  case nil?(more) do
    true -> temper_rx_m_here(n >= lo, pos, caps, k)
    _ -> more
  end
end

def temper_rx_rep_step(node: Any, lo: Int, hi: Int, n: Int, pos: Int, p2: Int, cps: List, c2: List, k: Any) -> Any do
  case p2 == pos do
    true -> temper_rx_m_here(n + 1 >= lo, p2, c2, k)
    _ -> temper_rx_rep_at(node, lo, hi, n + 1, cps, p2, c2, k)
  end
end

def temper_rx_in_set(node: Any, cps: List, pos: Int) -> Bool do
  r = case pos >= length(cps) do
    true -> false
    _ -> temper_rx_ranges_hit(elem(node, 2), 0, elem(cps, pos)) != elem(node, 1)
  end
  r
end

def temper_rx_ranges_hit(pairs: List, i: Int, c: Int) -> Bool do
  case i >= length(pairs) do
    true -> false
    _ -> temper_rx_range_or_next(pairs, i, c)
  end
end

def temper_rx_range_or_next(pairs: List, i: Int, c: Int) -> Bool do
  case temper_rx_item_hit(elem(pairs, i), c) do
    true -> true
    _ -> temper_rx_ranges_hit(pairs, i + 1, c)
  end
end

def temper_rx_item_hit(item: List, c: Int) -> Bool do
  r = case elem(item, 0) == :range do
    true -> c >= elem(item, 1) and c <= elem(item, 2)
    _ -> temper_rx_cls_hit(elem(item, 1), c) != elem(item, 2)
  end
  r
end

def temper_rx_in_cls(node: Any, cps: List, pos: Int) -> Bool do
  r = case pos >= length(cps) do
    true -> false
    _ -> temper_rx_cls_hit(elem(node, 1), elem(cps, pos)) != elem(node, 2)
  end
  r
end

def temper_rx_cls_hit(kind: Atom, c: Int) -> Bool do
  r = case kind == :d do
    true -> temper_rx_is_digit(c)
    _ -> temper_rx_cls_hit_s(kind, c)
  end
  r
end

def temper_rx_cls_hit_s(kind: Atom, c: Int) -> Bool do
  r = case kind == :s do
    true -> temper_rx_is_space(c)
    _ -> temper_rx_is_word(c)
  end
  r
end

def temper_rx_is_digit(c: Int) -> Bool do
  c >= 48 and c <= 57
end

def temper_rx_is_space(c: Int) -> Bool do
  c == 32 or c == 9 or c == 10 or c == 13 or c == 11 or c == 12
end

def temper_rx_is_word(c: Int) -> Bool do
  alpha = (c >= 97 and c <= 122) or (c >= 65 and c <= 90)
  alpha or temper_rx_is_digit(c) or c == 95
end

def temper_rx_at_wordb(cps: List, pos: Int) -> Bool do
  temper_rx_word_at(cps, pos - 1) != temper_rx_word_at(cps, pos)
end

# Out of range is not a word character. Asked as `i >= 0 and is_word(elem(...))`
# this crashed instead: `and` evaluates both sides, `elem` past the end answers
# nil, and `temper_rx_is_word` declares its parameter `Int`, so the nil is a
# type error rather than a false.
def temper_rx_word_at(cps: List, i: Int) -> Bool do
  case i >= 0 and i < length(cps) do
    true -> temper_rx_is_word(elem(cps, i))
    _ -> false
  end
end

# ── Regex: search ────────────────────────────────────

# The leftmost match at or after `at`, as [begin, end, captures], or nil.
def temper_rx_search(node: Any, cps: List, at: Int) -> Any do
  case at > length(cps) do
    true -> nil
    _ -> temper_rx_search_here(node, cps, at)
  end
end

def temper_rx_search_here(node: Any, cps: List, at: Int) -> Any do
  got = temper_rx_match(node, cps, at, [], fn (p2: Int, c2: List) -> Any do
    [p2, c2]
  end)
  case nil?(got) do
    true -> temper_rx_search(node, cps, at + 1)
    _ -> [at, elem(got, 0), elem(got, 1)]
  end
end

# ── Regex: what Temper asks for ──────────────────────
#
# A connected instance method is handed its receiver first, which is why
# everything but the static `regexCompileFormatted` takes a leading `me`. It
# cannot be called `self`: that is a Blimp keyword, and a parameter named it is
# a parse error 1500 lines into the spliced prelude, reported against the
# prelude rather than against anything a reader would connect to it.

# The formatter asks how this dialect spells a numeric code escape. Decimal
# inside `\u{}`, because temper_rx_ucode is the only thing that reads it back.
def temper_regex_push_code(me: Any, out: Any, code: Int, inside_set: Bool) -> Any do
  ignore = me
  ignore2 = inside_set
  out <- :append(concat("\\u{", concat(to_string(code), "}")))
  nil
end

# The compiled form is the parsed tree, with the subject-independent work done
# once. `data` is the RegexNode the pattern came from, which nothing here
# needs: the formatted string says everything the tree does.
def temper_regex_compile(data: Any, formatted: String) -> Any do
  ignore = data
  temper_rx_parse(formatted)
end

def temper_regex_found(me: Any, compiled: Any, text: String) -> Bool do
  ignore = me
  not(nil?(temper_rx_search(compiled, u8_code_points(text), 0)))
end

# A Temper StringIndex is a byte offset, and the matcher counts code points,
# so every entry point converts at the boundary. `temper_rx_offsets` is that
# conversion in one direction and `temper_rx_cp_index` in the other.
def temper_rx_offsets(s: String) -> List do
  temper_rx_offsets_loop(s, 0, [])
end

def temper_rx_offsets_loop(s: String, i: Int, acc: List) -> List do
  case i >= length(s) do
    true -> append(acc, length(s))
    _ -> temper_rx_offsets_loop(s, i + u8_seq_len(char_code(s, i)), append(acc, i))
  end
end

def temper_rx_cp_index(offs: List, byte_at: Int) -> Int do
  temper_rx_cp_index_loop(offs, 0, byte_at)
end

def temper_rx_cp_index_loop(offs: List, i: Int, byte_at: Int) -> Int do
  case i >= length(offs) or elem(offs, i) >= byte_at do
    true -> i
    _ -> temper_rx_cp_index_loop(offs, i + 1, byte_at)
  end
end

def temper_rx_slice(s: String, offs: List, from: Int, to: Int) -> String do
  slice(s, elem(offs, from), elem(offs, to) - elem(offs, from))
end

actor TemperGroup do
  state gname: String :: ""
  state gvalue: String :: ""
  state gbegin: Int :: 0
  state gend: Int :: 0

  on :__init(n: String, v: String, b: Int, e: Int) do
    gname = n
    gvalue = v
    gbegin = b
    gend = e
    become gname: gname, gvalue: gvalue, gbegin: gbegin, gend: gend
    reply nil
  end

  on :name do reply gname end
  on :value do reply gvalue end
  on :begin do reply gbegin end
  on :end do reply gend end
end

def temper_rx_group(n: String, v: String, b: Int, e: Int) -> Any do
  g = spawn TemperGroup
  g <- :__init(n, v, b, e)
  g
end

actor TemperMatch do
  state mfull: Any :: nil
  state mgroups: Any :: nil

  on :__init(f: Any, gs: Any) do
    mfull = f
    mgroups = gs
    become mfull: mfull, mgroups: mgroups
    reply nil
  end

  on :full do reply mfull end
  on :groups do reply mgroups end
end

# A Group the translated program reads is a Group only in the sense that it
# answers `:name`, `:value`, `:begin` and `:end`. Blimp actors are duck-typed
# and a Temper property read is a send, so temper-core can make one without
# naming the translated class -- which it could not do anyway, since the name
# depends on the translation.
def temper_rx_build_match(text: String, offs: List, m: List) -> Any do
  full = temper_rx_group("full", temper_rx_slice(text, offs, elem(m, 0), elem(m, 1)), elem(offs, elem(m, 0)), elem(offs, elem(m, 1)))
  groups = temper_new_map()
  groups <- :set("full", full)
  temper_rx_fill_groups(groups, text, offs, elem(m, 2), 0)
  match = spawn TemperMatch
  match <- :__init(full, groups)
  match
end

# Later wins: a capture inside a repetition records once per iteration, and
# `(?<x>d)|(?<y>e)` over "ee" ends with the last `e`, which is what the test
# asks for.
def temper_rx_fill_groups(groups: Any, text: String, offs: List, caps: List, i: Int) -> Any do
  r = case i >= length(caps) do
    true -> groups
    _ ->
      c = elem(caps, i)
      groups <- :set(elem(c, 0), temper_rx_group(elem(c, 0), temper_rx_slice(text, offs, elem(c, 1), elem(c, 2)), elem(offs, elem(c, 1)), elem(offs, elem(c, 2))))
      temper_rx_fill_groups(groups, text, offs, caps, i + 1)
  end
  r
end

def temper_regex_find(me: Any, compiled: Any, text: String, begin: Any, refs: Any) -> Any do
  ignore = me
  ignore2 = refs
  offs = temper_rx_offsets(text)
  m = temper_rx_search(compiled, u8_code_points(text), temper_rx_cp_index(offs, begin))
  r = case nil?(m) do
    true -> temper_bubble()
    _ -> temper_rx_build_match(text, offs, m)
  end
  r
end

def temper_regex_replace(me: Any, compiled: Any, text: String, fmt: Any, refs: Any) -> String do
  ignore = me
  ignore2 = refs
  temper_rx_replace_loop(compiled, text, u8_code_points(text), temper_rx_offsets(text), fmt, 0, "")
end

def temper_rx_replace_loop(node: Any, text: String, cps: List, offs: List, fmt: Any, pos: Int, acc: String) -> String do
  m = temper_rx_search(node, cps, pos)
  case nil?(m) do
    true -> concat(acc, temper_rx_slice(text, offs, pos, length(cps)))
    _ -> temper_rx_replace_one(node, text, cps, offs, fmt, pos, acc, m)
  end
end

def temper_rx_replace_one(node: Any, text: String, cps: List, offs: List, fmt: Any, pos: Int, acc: String, m: List) -> String do
  before = temper_rx_slice(text, offs, pos, elem(m, 0))
  piece = fmt(temper_rx_build_match(text, offs, m))
  so_far = concat(acc, concat(before, piece))
  case elem(m, 1) == elem(m, 0) do
    true -> temper_rx_replace_empty(node, text, cps, offs, fmt, elem(m, 0), so_far)
    _ -> temper_rx_replace_loop(node, text, cps, offs, fmt, elem(m, 1), so_far)
  end
end

# A zero-length match has to be stepped over by hand, or the next search finds
# the same one and the loop never ends. `(^|,)\s*` matches the empty string at
# the start of every list this is used on.
def temper_rx_replace_empty(node: Any, text: String, cps: List, offs: List, fmt: Any, at: Int, acc: String) -> String do
  case at >= length(cps) do
    true -> acc
    _ -> temper_rx_replace_loop(node, text, cps, offs, fmt, at + 1, concat(acc, temper_rx_slice(text, offs, at, at + 1)))
  end
end

def temper_regex_split(me: Any, compiled: Any, text: String, refs: Any) -> List do
  ignore = me
  ignore2 = refs
  temper_rx_split_loop(compiled, text, u8_code_points(text), temper_rx_offsets(text), 0, 0, [])
end

# Two positions, not one. `at` is where the next piece starts; `from` is where
# to look for the next separator. They come apart on a zero-length match,
# which has to be stepped over or the same one is found forever -- and the
# first version stepped over the code point as well as the match, so
# `split("(?:x)*", "abc")` answered [""] instead of ["a", "b", "c"].
def temper_rx_split_loop(node: Any, text: String, cps: List, offs: List, at: Int, from: Int, acc: List) -> List do
  m = temper_rx_search(node, cps, from)
  case nil?(m) do
    true -> append(acc, temper_rx_slice(text, offs, at, length(cps)))
    _ -> temper_rx_split_one(node, text, cps, offs, at, acc, m)
  end
end

def temper_rx_split_one(node: Any, text: String, cps: List, offs: List, at: Int, acc: List, m: List) -> List do
  case elem(m, 1) == elem(m, 0) do
    true -> temper_rx_split_empty(node, text, cps, offs, at, acc, elem(m, 0))
    _ -> temper_rx_split_loop(node, text, cps, offs, elem(m, 1), elem(m, 1), append(acc, temper_rx_slice(text, offs, at, elem(m, 0))))
  end
end

# An empty separator at the start of the piece splits nothing, so it is looked
# past rather than acted on. That is what makes `split("^", "abc")` answer
# ["abc"] rather than ["", "abc"], which is what every other backend's split
# does with a zero-length match at the beginning.
def temper_rx_split_empty(node: Any, text: String, cps: List, offs: List, at: Int, acc: List, b: Int) -> List do
  case b >= length(cps) do
    true -> append(acc, temper_rx_slice(text, offs, at, length(cps)))
    _ -> temper_rx_split_empty_at(node, text, cps, offs, at, acc, b)
  end
end

def temper_rx_split_empty_at(node: Any, text: String, cps: List, offs: List, at: Int, acc: List, b: Int) -> List do
  case b == at do
    true -> temper_rx_split_loop(node, text, cps, offs, at, b + 1, acc)
    _ -> temper_rx_split_loop(node, text, cps, offs, b, b + 1, append(acc, temper_rx_slice(text, offs, at, b)))
  end
end

# ── Generators ──────────────────────────────────
#
# BlimpSupportNetwork says "Blimp never needs generators", and the state
# machine lowering is why: a `yield` is gone before the backend sees the tree.
# What it leaves behind is a plain function that has to be called once per
# step, and something has to remember when it has run out. That something is
# what `adaptGeneratorFn` builds, and every backend supplies it.
#
# be-rust models a result as an Option -- `doneResult()` is None and
# `ValueResult(v)` is Some(v). The same two shapes fit a list, where the empty
# list is done, so `isDone` is `empty?`.

def temper_done_result() -> List do
  []
end

def temper_value_result(v: Any) -> List do
  [v]
end

actor TemperGenerator do
  state step: Any :: nil
  state done: Bool :: false

  on :init(f: Any) do
    step = f
    become step: step
    reply nil
  end

  # The step function is handed the generator, because the lowered machine can
  # yield back into it. Blimp actors have no `self`, so the caller passes the
  # handle it is already holding.
  on :next(me: Any) do
    r = case done do
      true -> []
      _ -> step(me)
    end
    fin = empty?(r)
    become done: fin
    reply r
  end

  on :done do
    reply done
  end

  on :close do
    become done: true
    reply nil
  end
end

def temper_adapt_generator_fn(f: Any) -> Any do
  g = spawn TemperGenerator
  g <- :init(f)
  g
end

def temper_generator_next(g: Any) -> Any do
  g <- :next(g)
end

# ── Date ─────────────────────────────────────────────
#
# A Date is [year, month, day] and nothing mutates one, so unlike the builders
# it needs no actor. The two conversions are Howard Hinnant's days_from_civil
# and civil_from_days: the calendar is shifted to start in March so that a leap
# day falls at the end of a year and the arithmetic stops having a special
# case.

# The constructor bubbles on a day the month does not have, which is the one
# piece of Date behaviour that is not arithmetic. February is the whole reason:
# `daysInMonth[2]` is 28 and the 29th is legal only in a leap year.
def temper_new_date(y: Int, m: Int, d: Int) -> List do
  ok = m >= 1 and m <= 12 and d >= 1 and d <= temper_days_in_month(y, m)
  r = case ok do
    true -> [y, m, d]
    _ -> temper_bubble()
  end
  r
end

def temper_days_in_month(y: Int, m: Int) -> Int do
  n = case m == 2 do
    true -> temper_february_days(y)
    _ -> elem([31, 0, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31], m - 1)
  end
  n
end

def temper_february_days(y: Int) -> Int do
  n = case temper_is_leap_year(y) do
    true -> 29
    _ -> 28
  end
  n
end

def temper_is_leap_year(y: Int) -> Bool do
  rem(y, 4) == 0 and (rem(y, 100) != 0 or rem(y, 400) == 0)
end

def temper_date_year(d: List) -> Int do
  elem(d, 0)
end

def temper_date_month(d: List) -> Int do
  elem(d, 1)
end

def temper_date_day(d: List) -> Int do
  elem(d, 2)
end

def temper_days_from_civil(y0: Int, m: Int, d: Int) -> Int do
  y = case m <= 2 do
    true -> y0 - 1
    _ -> y0
  end
  era = case y >= 0 do
    true -> y / 400
    _ -> (y - 399) / 400
  end
  yoe = y - era * 400
  mp = rem(m + 9, 12)
  doy = (153 * mp + 2) / 5 + d - 1
  doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  era * 146097 + doe - 719468
end

def temper_civil_from_days(z0: Int) -> List do
  z = z0 + 719468
  era = case z >= 0 do
    true -> z / 146097
    _ -> (z - 146096) / 146097
  end
  doe = z - era * 146097
  yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  y = yoe + era * 400
  doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  mp = (5 * doy + 2) / 153
  d = doy - (153 * mp + 2) / 5 + 1
  m = case mp < 10 do
    true -> mp + 3
    _ -> mp - 9
  end
  year = case m <= 2 do
    true -> y + 1
    _ -> y
  end
  [year, m, d]
end

# 1970-01-01 was a Thursday, and Temper counts Monday as 1.
def temper_date_day_of_week(date: List) -> Int do
  days = temper_days_from_civil(elem(date, 0), elem(date, 1), elem(date, 2))
  rem(rem(days + 3, 7) + 7, 7) + 1
end

# `now()` counts seconds since the epoch, and a Date is the day it lands in.
def temper_date_today() -> List do
  temper_civil_from_days(now() / 86400)
end

# A leading minus is a negative year, not a fourth field, so it comes off
# before the split. Going through the constructor is what makes "2023-02-30"
# bubble; splitting straight into a triple accepted it.
def temper_date_from_iso(s: String) -> List do
  r = case temper_leading_minus(s) do
    true -> temper_date_from_iso_parts(slice(s, 1, length(s)), 0 - 1)
    _ -> temper_date_from_iso_parts(s, 1)
  end
  r
end

# Temper's parser walks in from the end -- two characters of day, a dash, two
# of month, a dash, and at least four characters of year counting the sign. So
# "2023-2-3" and "999-01-01" are rejected there, and were accepted here.
def temper_date_from_iso_parts(s: String, sign: Int) -> List do
  parts = split(s, "-")
  # Blimp has no line continuation, so the width checks are named rather than
  # written as one `and` chain across four lines -- and `and` evaluates both
  # sides, so a `parts` that is not three long has to stop the chain in a
  # `case` rather than by being false.
  r = case length(parts) == 3 do
    true -> temper_date_from_iso_wide(parts, sign)
    _ -> temper_bubble()
  end
  r
end

def temper_date_from_iso_wide(parts: List, sign: Int) -> List do
  wide = length(elem(parts, 0)) + temper_sign_width(sign) >= 4
  ok = wide and length(elem(parts, 1)) == 2 and length(elem(parts, 2)) == 2
  r = case ok do
    true -> temper_new_date(
      temper_iso_int(concat(temper_sign_text(sign), elem(parts, 0))),
      temper_iso_int(elem(parts, 1)),
      temper_iso_int(elem(parts, 2)),
    )
    _ -> temper_bubble()
  end
  r
end

# The sign goes back onto the field rather than multiplying the result,
# because `temper_parse_int32` trims: parsing "  23" and negating it accepts
# "-  23-01-01", which `toInt32` handed the whole field rejects.
def temper_sign_text(sign: Int) -> String do
  t = case sign < 0 do
    true -> "-"
    _ -> ""
  end
  t
end

def temper_sign_width(sign: Int) -> Int do
  n = case sign < 0 do
    true -> 1
    _ -> 0
  end
  n
end

# `to_int` is Zig's parseInt over an i64, so it takes a leading `+`, takes `_`
# as a digit separator, takes numbers no Int can hold, and raises rather than
# bubbling on a field that is not a number at all. `toInt32` is what Temper
# calls, and `temper_parse_int32` is already that -- sign-strict, trimming and
# range-checked, and it bubbles. So there is nothing left to catch.
def temper_iso_int(s: String) -> Int do
  temper_parse_int32(s, 10)
end

def temper_leading_minus(s: String) -> Bool do
  length(s) > 0 and char_at(s, 0) == "-"
end

# Four digits for the year even when it is 12, which is the case that catches
# a backend adding 1900 or 2000 to a two-digit year.
def temper_date_to_string(d: List) -> String do
  concat(
    temper_pad(to_string(elem(d, 0)), 4),
    concat("-", concat(temper_pad(to_string(elem(d, 1)), 2), concat("-", temper_pad(to_string(elem(d, 2)), 2))))
  )
end

# `padTo` puts the sign outside the zeros, so year -1 is "-0001". Padding the
# whole string instead gives "00-1", which is the shape of the two-digit-year
# bug this test exists to catch, only at the other end of the range.
def temper_pad(s: String, width: Int) -> String do
  r = case temper_leading_minus(s) do
    true -> concat("-", temper_pad_digits(slice(s, 1, length(s)), width))
    _ -> temper_pad_digits(s, width)
  end
  r
end

def temper_pad_digits(s: String, width: Int) -> String do
  case length(s) >= width do
    true -> s
    _ -> temper_pad_digits(concat("0", s), width)
  end
end

# Whole years: the anniversary has to have arrived.
def temper_date_years_between(a: List, b: List) -> Int do
  years = elem(b, 0) - elem(a, 0)
  before = case elem(b, 1) < elem(a, 1) do
    true -> true
    _ -> elem(b, 1) == elem(a, 1) and elem(b, 2) < elem(a, 2)
  end
  case before do
    true -> years - 1
    _ -> years
  end
end

# ── DenseBitVector ───────────────────────────────────
#
# Dense is a promise about memory, not about behaviour, and Blimp has no packed
# representation to make it with: a list of booleans answers the same
# questions. myers-diff is the program that leans on it.

actor TemperBitVector do
  # A list of chunks, each a list of `temper_bits_chunk` booleans. One flat
  # list would be simpler and is what this was: `set_at` copies the list it is
  # given, so setting n bits one at a time copied n elements n times. Myers
  # diff sets bits one at a time, and 16,000 of them exhausted a 2 GB heap.
  # Chunking makes a set copy the chunk list plus one chunk instead of
  # everything -- about 4,000 elements at a million bits rather than a million.
  state chunks: List :: []

  # A bit the vector has never stored reads as false, which core.temper spells
  # out: "if a bit has not previously been set then it is assumed to be false".
  on :get(i: Int) do
    b = case i >= 0 and i / temper_bits_chunk() < length(chunks) do
      true -> elem(elem(chunks, i / temper_bits_chunk()), rem(i, temper_bits_chunk()))
      _ -> false
    end
    reply b
  end

  on :set(i: Int, b: Bool) do
    chunks = temper_bits_set(chunks, i, b)
    become chunks: chunks
    reply nil
  end
end

def temper_bits_chunk() -> Int do
  256
end

# A negative index is not "past the end": `core.temper` reaches
# `ListBuilder.set` with it, which panics, so this bubbles rather than
# clamping. Blimp's `set_at` clamps, which silently wrote bit 0.
def temper_bits_set(chunks: List, i: Int, b: Bool) -> List do
  r = case i < 0 do
    true -> temper_bubble()
    _ -> temper_bits_set_at(chunks, i, b)
  end
  r
end

def temper_bits_set_at(chunks: List, i: Int, b: Bool) -> List do
  ci = i / temper_bits_chunk()
  grown = temper_bits_grow(chunks, ci, b)
  r = case ci < length(grown) do
    true -> set_at(grown, ci, set_at(elem(grown, ci), rem(i, temper_bits_chunk()), b))
    _ -> grown
  end
  r
end

# Storage only has to grow for a true bit, since everything past the end is
# already false.
def temper_bits_grow(chunks: List, ci: Int, b: Bool) -> List do
  r = case ci < length(chunks) or not(b) do
    true -> chunks
    _ -> chunks ++ temper_repeat(temper_falses_n(temper_bits_chunk()), ci + 1 - length(chunks))
  end
  r
end

# Appending one element at a time copies the whole list each time, which makes
# building n of them quadratic. Building half and joining it to itself costs
# n + n/2 + n/4 + ... slots, so it is linear, and the same list object is read
# twice rather than walked twice.
def temper_falses_n(n: Int) -> List do
  temper_repeat(false, n)
end

def temper_repeat(x: Any, n: Int) -> List do
  r = case n <= 0 do
    true -> []
    _ -> temper_repeat_halves(x, n)
  end
  r
end

def temper_repeat_halves(x: Any, n: Int) -> List do
  half = temper_repeat(x, n / 2)
  joined = half ++ half
  r = case rem(n, 2) == 0 do
    true -> joined
    _ -> append(joined, x)
  end
  r
end

# The capacity is discarded. It is a promise about memory, and Blimp has no
# packed representation to spend it on -- but the reason not to honour it
# anyway is that pre-filling would allocate every chunk up front for a vector
# that may only ever touch a few. Since `get` past the end already answers
# false and `set` grows on demand, an empty list is observationally identical
# and O(1).
def temper_new_bit_vector(capacity: Int) -> Any do
  ignore = capacity
  spawn TemperBitVector
end

# ── Deque ────────────────────────────────────────────
#
# A list held by an actor, like the builders above: adds go on the end and
# removes come off the front, which is what breadth-first work wants.

actor TemperDeque do
  state items: List :: []

  on :add(x: Any) do
    items = append(items, x)
    become items: items
    reply nil
  end

  on :removeFirst do
    first = head(items)
    items = tail(items)
    become items: items
    reply first
  end

  on :isEmpty do
    reply empty?(items)
  end

  on :items do
    reply items
  end
end

def temper_new_deque() -> Any do
  spawn TemperDeque
end

def temper_new_list_builder() -> Any do
  spawn TemperListBuilder
end

# Blimp's slice is strings only, so lists get their own.
# A negative start is clamped, not counted from the end: Temper's slice takes
# an exclusive end and clamps both bounds, so `slice(-2, 0)` is empty rather
# than whatever `elem` makes of a negative index.
def temper_list_slice(items: List, start: Int, stop: Int) -> List do
  from = case start < 0 do
    true -> 0
    _ -> start
  end
  temper_list_slice_loop(items, from, stop, from, [])
end

def temper_list_slice_loop(items: List, start: Int, stop: Int, i: Int, acc: List) -> List do
  case i >= stop or i >= length(items) do
    true -> acc
    _ -> temper_list_slice_loop(items, start, stop, i + 1, append(acc, elem(items, i)))
  end
end

# Blimp's sort takes no comparator, so this is an insertion sort over one.
def temper_sort(items: Any, cmp: Any) -> List do
  temper_sort_loop(temper_items(items), [], cmp)
end

def temper_sort_loop(remaining: List, acc: List, cmp: Any) -> List do
  case empty?(remaining) do
    true -> acc
    _ -> temper_sort_loop(tail(remaining), temper_insert(acc, head(remaining), cmp), cmp)
  end
end

def temper_insert(sorted: List, x: Any, cmp: Any) -> List do
  temper_insert_loop(sorted, x, cmp, [])
end

def temper_insert_loop(rest: List, x: Any, cmp: Any, acc: List) -> List do
  case empty?(rest) do
    true -> append(acc, x)
    _ ->
      h = head(rest)
      # Strictly less than: an item equal to one already placed goes after it,
      # which is what makes the sort stable. With `<= 0` a run of equal items
      # comes out reversed, and sorting by one field of a record showed it.
      case cmp(x, h) < 0 do
        true -> (append(acc, x)) ++ rest
        _ -> temper_insert_loop(tail(rest), x, cmp, append(acc, h))
      end
  end
end

# Sequence operations that accept either a list or a builder.
def temper_len(x: Any) -> Int do length(temper_items(x)) end
def temper_is_empty(x: Any) -> Bool do
  case type_of(x) == :string do
    true -> empty?(x)
    _ -> empty?(temper_items(x))
  end
end
def temper_get(x: Any, i: Int) -> Any do elem(temper_items(x), i) end
def temper_map(x: Any, f: Any) -> List do map(temper_items(x), f) end
def temper_reduce(x: Any, init: Any, f: Any) -> Any do reduce(temper_items(x), init, f) end
def temper_to_list(x: Any) -> List do temper_items(x) end

def temper_new_list_builder_from(items: Any) -> Any do
  b = spawn TemperListBuilder
  b <- :addAll(temper_items(items))
  b
end

# Blimp handlers dispatch on name alone, not arity, so the two shapes of
# Temper's ListBuilder.add reach different messages.
def temper_list_insert(items: List, at: Int, x: Any) -> List do
  (temper_list_slice(items, 0, at) ++ [x]) ++ temper_list_slice(items, at, length(items))
end

# Temper's `as` can fail. Blimp's actors dispatch on whatever they are, so the
# check has to be explicit.
def temper_cast(value: Any, tag: Atom) -> Any do
  case temper_is_a(value, tag) do
    true -> value
    _ -> temper_bubble()
  end
end

# ── Mutable captures ─────────────────────────────────
#
# A Blimp closure captures the values of names already bound when it is made,
# and an assignment inside it is local to it. Temper closures capture by
# reference and may assign, so a local a nested function writes to lives in a
# cell instead, and the closure captures the cell.

actor TemperCell do
  state value: Any :: nil
  on :get do reply value end
  on :set(v: Any) do
    become value: v
    reply nil
  end
end

def temper_new_cell(v: Any) -> Any do
  c = spawn TemperCell
  c <- :set(v)
  c
end

# ── Mutable strings ──────────────────────────────────
#
# StringBuilder is mutable for the same reason ListBuilder is, and gets the
# same answer: an actor holding the value.

actor TemperStringBuilder do
  state text: String :: ""

  on :__temper_types do reply [:StringBuilder] end
  on :text do reply text end
  on :toString do reply text end
  on :isEmpty do reply empty?(text) end

  # Temper's String indices are byte offsets, and `end` is one past the last.
  on :end do reply length(text) end

  on :append(s: String) do
    text = concat(text, s)
    become text: text
    reply nil
  end

  # Temper's appendCodePoint bubbles on anything that is not a code point:
  # past the maximum, or in the surrogate range, which UTF-8 never encodes.
  on :appendCodePoint(cp: Int) do
    case temper_is_code_point(cp) do
      true ->
        text = concat(text, u8_encode(cp))
        become text: text
        reply nil
      _ -> bubble :not_a_code_point
    end
  end

  on :appendBetween(source: String, from: Int, to: Int) do
    text = concat(text, temper_slice(source, from, to))
    become text: text
    reply nil
  end

  on :clear do
    become text: ""
    reply nil
  end
end

def temper_new_string_builder() -> Any do
  spawn TemperStringBuilder
end

# ── String indices ───────────────────────────────────
#
# A Temper StringIndex is a byte offset that has to land on the start of a
# UTF-8 sequence, so stepping is a sequence-width walk rather than arithmetic.

def temper_string_prev(s: String, i: Int) -> Int do
  temper_string_prev_loop(s, i - 1)
end

def temper_string_prev_loop(s: String, i: Int) -> Int do
  case i <= 0 do
    true -> 0
    _ -> case rem(char_code(s, i), 256) >= 128 and rem(char_code(s, i), 256) < 192 do
      true -> temper_string_prev_loop(s, i - 1)
      _ -> i
    end
  end
end

def temper_string_step(s: String, i: Int, by: Int) -> Int do
  case by == 0 do
    true -> i
    _ -> case by > 0 do
      true -> temper_string_step(s, temper_string_next(s, i), by - 1)
      _ -> temper_string_step(s, temper_string_prev(s, i), by + 1)
    end
  end
end

def temper_string_count_between(s: String, from: Int, to: Int) -> Int do
  temper_string_count_loop(s, from, to, 0)
end

def temper_string_count_loop(s: String, i: Int, to: Int, n: Int) -> Int do
  case i >= to or i >= length(s) do
    true -> n
    _ -> temper_string_count_loop(s, temper_string_next(s, i), to, n + 1)
  end
end

def temper_string_has_at_least(s: String, from: Int, to: Int, least: Int) -> Bool do
  temper_string_count_between(s, from, to) >= least
end

# Temper's String.begin is the index of the first code point. Blimp's string
# indices are byte offsets, so it is 0. It arrives as a static property read,
# which the backend flattens to this name.
static_String__begin = 0

# StringIndexOption is either a byte offset or the absence of one. Offsets are
# non-negative, and core.temper requires `none` to sort before every valid
# index, so -1 is the only value that can stand for it.
static_StringIndex__none = 0 - 1

def temper_is_code_point(cp: Int) -> Bool do
  case cp < 0 or cp > 1114111 do
    true -> false
    _ -> cp < 55296 or cp > 57343
  end
end

# Temper's reduce with no initial value folds from the first element, and
# bubbles on an empty sequence because there is nothing to start from.
def temper_reduce1(source: Any, f: Any) -> Any do
  items = temper_items(source)
  case empty?(items) do
    true -> temper_bubble()
    _ -> reduce(tail(items), head(items), f)
  end
end

def temper_reduce_from_index(source: Any, init: Any, index: Int, f: Any) -> Any do
  items = temper_items(source)
  reduce(temper_list_slice(items, index, length(items)), init, f)
end

# ── Maps ─────────────────────────────────────────────
#
# Blimp's own maps take string keys only, and Temper's take anything that is a
# MapKey, so a map here is an actor holding a list of [key, value] entries.
# Lookup is linear, which is honest rather than fast; a hashed version would
# need a hash Blimp does not expose.

actor TemperPair do
  state k: Any :: nil
  state v: Any :: nil
  on :__temper_types do reply [:Pair] end
  on :key do reply k end
  on :value do reply v end
  on :__new(key: Any, value: Any) do
    k = key
    v = value
    become k: k, v: v
    reply nil
  end
end

def temper_new_pair(key: Any, value: Any) -> Any do
  p = spawn TemperPair
  p <- :__new(key, value)
  p
end

actor TemperMap do
  state entries: List :: []

  on :__temper_types do reply [:Map, :MapBuilder, :Mapped] end
  on :entries do reply entries end
  on :length do reply length(entries) end
  on :isEmpty do reply empty?(entries) end
  on :keys do reply map(entries, fn(e: List) do elem(e, 0) end) end
  on :values do reply map(entries, fn(e: List) do elem(e, 1) end) end
  on :toList do reply map(entries, fn(e: List) do temper_new_pair(elem(e, 0), elem(e, 1)) end) end
  on :has(key: Any) do reply temper_entry_index(entries, key) >= 0 end

  on :get(key: Any) do
    i = temper_entry_index(entries, key)
    case i < 0 do
      true -> bubble :no_such_key
      _ -> reply elem(elem(entries, i), 1)
    end
  end

  on :getOr(key: Any, fallback: Any) do
    i = temper_entry_index(entries, key)
    case i < 0 do
      true -> reply fallback
      _ -> reply elem(elem(entries, i), 1)
    end
  end

  on :set(key: Any, value: Any) do
    i = temper_entry_index(entries, key)
    entries = case i < 0 do
      true -> append(entries, [key, value])
      _ -> set_at(entries, i, [key, value])
    end
    become entries: entries
    reply nil
  end

  on :remove(key: Any) do
    i = temper_entry_index(entries, key)
    case i < 0 do
      true -> bubble :no_such_key
      _ ->
        old = elem(elem(entries, i), 1)
        before = temper_list_slice(entries, 0, i)
        after = temper_list_slice(entries, i + 1, length(entries))
        entries = before ++ after
        become entries: entries
        reply old
    end
  end

  on :clear do
    become entries: []
    reply nil
  end

  on :forEach(body: Any) do
    temper_for_each(entries, fn(e: List) do body(elem(e, 0), elem(e, 1)) end)
    reply nil
  end

  on :copyFrom(other: Any) do
    entries = other <- :entries
    become entries: entries
    reply nil
  end
end

def temper_entry_index(entries: List, key: Any) -> Int do
  temper_entry_index_loop(entries, key, 0)
end

def temper_entry_index_loop(entries: List, key: Any, i: Int) -> Int do
  case i >= length(entries) do
    true -> 0 - 1
    _ -> case elem(elem(entries, i), 0) == key do
      true -> i
      _ -> temper_entry_index_loop(entries, key, i + 1)
    end
  end
end

def temper_new_map() -> Any do
  spawn TemperMap
end

# Temper's Map constructor also takes a list of Pairs. Blimp handlers have a
# fixed arity, so that shape gets its own helper rather than a default
# argument, and it fills by sending `:set` per pair instead of building the
# entry list in one handler: `:set` already replaces a duplicate key, and two
# `become`s in one handler would not compose anyway.
def temper_new_map_from(pairs: List) -> Any do
  m = spawn TemperMap
  temper_map_fill(m, pairs, 0)
end

def temper_map_fill(m: Any, pairs: List, i: Int) -> Any do
  case i >= length(pairs) do
    true -> m
    _ ->
      p = elem(pairs, i)
      m <- :set(p <- :key, p <- :value)
      temper_map_fill(m, pairs, i + 1)
  end
end

def temper_copy_map(source: Any) -> Any do
  m = spawn TemperMap
  m <- :copyFrom(source)
  m
end

def temper_map_to_list_with(source: Any, f: Any) -> List do
  map(source <- :entries, fn(e: List) do f(elem(e, 0), elem(e, 1)) end)
end


actor Up do
  on :__temper_types do
    reply[:Up, :Direction]
  end
  on :__new do
    reply nil
  end
end
actor Down do
  on :__temper_types do
    reply[:Down, :Direction]
  end
  on :__new do
    reply nil
  end
end
actor Left do
  on :__temper_types do
    reply[:Left, :Direction]
  end
  on :__new do
    reply nil
  end
end
actor Right do
  on :__temper_types do
    reply[:Right, :Direction]
  end
  on :__new do
    reply nil
  end
end
actor Point do
  state x__108: Any :: nil
  state y__109: Any :: nil
  on :__temper_types do
    reply[:Point]
  end
  on :__new(x__111: Any, y__112: Any) do
    x__108 = x__111
    y__109 = y__112
    become x__108: x__108, y__109: y__109
    reply nil
  end
  on :x do
    reply x__108
  end
  on :y do
    reply y__109
  end
end
actor Playing do
  on :__temper_types do
    reply[:Playing, :GameStatus]
  end
  on :__new do
    reply nil
  end
end
actor GameOver do
  on :__temper_types do
    reply[:GameOver, :GameStatus]
  end
  on :__new do
    reply nil
  end
end
actor RandomResult do
  state value__123: Any :: nil
  state nextSeed__124: Any :: nil
  on :__temper_types do
    reply[:RandomResult]
  end
  on :__new(value__126: Any, nextSeed__127: Any) do
    value__123 = value__126
    nextSeed__124 = nextSeed__127
    become value__123: value__123, nextSeed__124: nextSeed__124
    reply nil
  end
  on :value do
    reply value__123
  end
  on :nextSeed do
    reply nextSeed__124
  end
end
actor SnakeGame do
  state width__135: Any :: nil
  state height__136: Any :: nil
  state snake__137: Any :: nil
  state direction__138: Any :: nil
  state food__139: Any :: nil
  state score__140: Any :: nil
  state status__141: Any :: nil
  state rngSeed__142: Any :: nil
  on :__temper_types do
    reply[:SnakeGame]
  end
  on :__new(width__144: Any, height__145: Any, snake__146: Any, direction__147: Any, food__148: Any, score__149: Any, status__150: Any, rngSeed__151: Any) do
    width__135 = width__144
    height__136 = height__145
    snake__137 = snake__146
    direction__138 = direction__147
    food__139 = food__148
    score__140 = score__149
