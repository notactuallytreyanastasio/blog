# Database password - generate with: openssl rand -hex 32
DB_PASSWORD=changeme

# Phoenix secret key base - generate with: mix phx.gen.secret
SECRET_KEY_BASE=changeme

# Domain (default: bobbby.online)
PHX_HOST=bobbby.online

# Optional app secrets
RECEIPT_PRINTER_API_TOKEN=
LIVE_DRAFT_TOKEN=
FINDER_ADMIN_PASSWORD=
BLINKS_API_TOKEN=

# OpenAI key for /ziggy "Ask the Graph" chat (blank disables the feature)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
# Required to unlock the /ziggy chat tab at all — generate with: openssl rand -hex 6
ZIGGY_CHAT_PASSWORD=

