{
  "name": "A full game of Wordle",
  "description": "Switches off hard mode (on by default, and it rejects any guess that ignores a discovered letter), types six common guesses on the on-screen keyboard, reaches game over and starts a new game. Whether a guess is right depends on the day's word.",
  "onFailure": "continue",
  "steps": [
    {
      "do": "Open Wordle",
      "action": {
        "type": "goto",
        "url": "/wordle"
      },
      "expect": [
        {
          "type": "visible",
          "target": "id:game-board"
        }
      ]
    },
    {
      "do": "Dismiss the hard-mode notice",
      "action": {
        "type": "click",
        "target": "role:button:Got it!"
      },
      "expect": [
        {
          "type": "hidden",
          "target": "role:button:Got it!"
        }
      ]
    },
    {
      "do": "Turn hard mode off",
      "action": {
        "type": "click",
        "target": "role:button:HARD MODE"
      },
